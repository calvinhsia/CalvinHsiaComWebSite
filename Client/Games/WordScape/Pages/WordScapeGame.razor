@page "/wordscape"
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@inject WordScapeGameService GameService
@inject GameSettingsService SettingsService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="wordscape-container">

    @if (_showSettings)
    {
        <div class="settings-panel">
            <h3>Settings</h3>
            <div class="form-group">
                <label for="minLength">Min Word Length:</label>
                <input id="minLength" type="number" @bind="_settings.MinWordLength" min="3" max="8" class="form-control" />
            </div>
            <div class="form-group">
                <label for="maxLength">Max Word Length:</label>
                <input id="maxLength" type="number" @bind="_settings.MaxWordLength" min="4" max="10" class="form-control" />
            </div>
            <button class="btn btn-success" @onclick="SaveSettings">Save Settings</button>
            <button class="btn btn-secondary" @onclick="ToggleSettings">Cancel</button>
        </div>
    }

    @if (_puzzleState is not null)
    {
        <div class="game-layout">
            <!-- Center Area -->
            <div class="center-area">
                @if (_isGenerating)
                {
                    <div class="generation-progress">
                        <div class="progress-spinner">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div class="progress-status">@_generationStatus</div>
                    </div>
                }
                else
                {
                    <!-- Crossword Grid -->
                    <div class="crossword-grid">
                        <div class="grid-container" 
                             style="grid-template-columns: repeat(@(_puzzleState?.LegacyGrid?.MaxX ?? 1), 32px); grid-template-rows: repeat(@(_puzzleState?.LegacyGrid?.MaxY ?? 1), 32px);">
                            @for (int y = 0; y < (_puzzleState?.LegacyGrid?.MaxY ?? 0); y++)
                            {
                                @for (int x = 0; x < (_puzzleState?.LegacyGrid?.MaxX ?? 0); x++)
                                {
                                    var cell = _puzzleState?.LegacyGrid?.Cells?.FirstOrDefault(c => c.X == x && c.Y == y);
                                    if (cell is not null && !cell.IsBlank)
                                    {
                                        var localX = x; // capture for lambda
                                        var localY = y; // capture for lambda
                                        var isClicked = _clickedCell.HasValue && _clickedCell.Value.X == x && _clickedCell.Value.Y == y;
                                        <div class="grid-cell @(cell.IsRevealed ? "revealed" : "hidden") @(isClicked ? "clicked-highlight" : "")" 
                                             style="grid-column: @(x + 1); grid-row: @(y + 1);"
                                             @onclick="@(() => OnGridCellClick(localX, localY))">
                                            @if (cell.IsRevealed)
                                            {
                                                @cell.Letter.ToString().ToUpper()
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>

                    <!-- UPDATED: Current Word Display with Timer -->
                    <div class="current-word-container">
                        <div class="current-word-display @_currentWordStatusClass">@_currentWord</div>
                        <div class="timer-display">@_timerDisplay</div>
                    </div>

                    <!-- UPDATED: Narrow Layout - Stats and Controls on sides of circle -->
                    <div class="narrow-layout-controls">
                        <div class="narrow-circle-container">
                            <div class="narrow-stats">
                                <div class="narrow-stat-item">
                                    <div class="narrow-stat-value">@(_puzzleState?.Score ?? 0)</div>
                                    <div class="narrow-stat-label">Score</div>
                                </div>
                                <div class="narrow-stat-item">
                                    <!-- FIXED: Show only grid words found vs total possible words -->
                                    <div class="narrow-stat-value">@(_puzzleState?.FoundWords.Count(fw => fw.Type == FoundWordType.SubWordInGrid) ?? 0)/@(_puzzleState?.PossibleWords.Count ?? 0)</div>
                                    <div class="narrow-stat-label">Words</div>
                                </div>
                                <div class="narrow-stat-item">
                                    <div class="narrow-stat-value">@_hintCount</div>
                                    <div class="narrow-stat-label">Hints</div>
                                </div>
                            </div>

                            <!-- Circle Letters - UPDATED: Font size increased by 20% and made bold -->
                            <div class="letter-wheel" @ref="letterWheelElement">
                                <svg width="364" height="364" viewBox="0 0 364 364"
                                     @onmousemove="@HandleMouseMove"
                                     @onmousemove:preventDefault="true"
                                     @onmouseup="@HandleSvgMouseUp"
                                     @ontouchstart="@HandleTouchStart"
                                     @ontouchstart:preventDefault="true"
                                     @ontouchmove="@HandleTouchMove"
                                     @ontouchmove:preventDefault="true"
                                     @ontouchend="@HandleTouchEnd"
                                     @ontouchend:preventDefault="true"
                                     @oncontextmenu:preventDefault="true"
                                     style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none;">
                                    <!-- Circle border - increased radius by 30% -->
                                    <circle cx="182" cy="182" r="117" fill="none" stroke="#ccc" stroke-width="2" />
                                    
                                    <!-- Connection line -->
                                    @if (_selectedLetters.Any())
                                    {
                                        <polyline points="@GetPolylinePoints()" 
                                                  fill="none" 
                                                  stroke="#007bff" 
                                                  stroke-width="3" />
                                    }

                                    <!-- Letters -->
                                    @for (int i = 0; i < _circleLetters.Count; i++)
                                    {
                                        var letter = _circleLetters[i];
                                        var isSelected = _selectedLetters.Contains(i);
                                        var index = i; // capture for lambda
                                        
                                        <g class="letter-container @(isSelected ? "selected" : "")"
                                           data-letter-index="@index"
                                           @onmousedown="@(() => StartSelection(index))"
                                           @onmouseover="@(() => ContinueSelection(index))"
                                           @onmouseup="@(() => EndSelection())"
                                           @ontouchstart="@((e) => HandleLetterTouchStart(e, index))"
                                           @ontouchstart:preventDefault="true"
                                           @oncontextmenu:preventDefault="true"
                                           style="touch-action: none; cursor: pointer; -webkit-touch-callout: none; -webkit-user-select: none;">
                                            
                                            <!-- Circle radius increased by 30% from 25 to 32.5 -->
                                            <circle cx="@letter.X" 
                                                    cy="@letter.Y" 
                                                    r="32.5" 
                                                    fill="@(isSelected ? "#007bff" : "#f8f9fa")" 
                                                    stroke="@(isSelected ? "#0056b3" : "#dee2e6")" 
                                                    stroke-width="2" />
                                            
                                            <!-- Font size increased by 20% from 23.4 to 28, made bold -->
                                            <text x="@letter.X" 
                                                  y="@(letter.Y + 8)" 
                                                  text-anchor="middle" 
                                                  font-family="Arial, sans-serif" 
                                                  font-size="28" 
                                                  font-weight="bold" 
                                                  fill="@(isSelected ? "white" : "black")"
                                                  pointer-events="none">
                                                @letter.Letter
                                            </text>
                                        </g>
                                    }
                                </svg>
                            </div>

                            <div class="narrow-controls">
                                <button class="btn btn-secondary btn-narrow" @onclick="ToggleSettings" disabled="@_isGenerating" title="Settings">
                                    ⚙️
                                </button>
                                <button class="btn btn-primary btn-narrow" @onclick="NewGame" disabled="@_isGenerating" title="New Game">
                                    @if (_isGenerating)
                                    {
                                        <span class="spinner-border spinner-border-xs" role="status" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span>🎮</span>
                                    }
                                </button>
                                <button class="btn btn-info btn-narrow" @onclick="ShuffleCircleLetters" disabled="@_isGenerating" title="Shuffle">
                                    🔀
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- FIXED: Message moved below circle -->
                    <div class="game-message-center">
                        @if (!string.IsNullOrEmpty(_message))
                        {
                            <div class="message">@_message</div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- UPDATED: Found Words always displayed below the game -->
        <div class="found-words">
            <!-- FIXED: Show only grid words found vs total possible words -->
            <h4>Found Words (@(_puzzleState?.FoundWords.Count(fw => fw.Type == FoundWordType.SubWordInGrid) ?? 0)/@(_puzzleState?.PossibleWords.Count ?? 0))</h4>
            <div class="words-list-container">
                <div class="words-list multi-column">
                    @foreach (var foundWord in _puzzleState?.FoundWords?.OrderBy(fw => fw.Word) ?? Enumerable.Empty<FoundWord>())
                    {
                        <div class="found-word @GetWordCssClass(foundWord.Type)" 
                             @onclick="@(() => OpenDictionaryDefinition(foundWord.Word))"
                             title="Click to look up definition">
                            @foundWord.Word
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_puzzleState?.IsComplete == true)
        {
            <div class="alert alert-success">
                <h3>Congratulations!</h3>
                <!-- FIXED: Show only grid words count in completion message -->
                <p>You found all @(_puzzleState?.PossibleWords?.Count ?? 0) words!</p>
                <p>Final Score: @(_puzzleState?.Score ?? 0)</p>
                <p>Hints Used: @_hintCount</p>
                <p>Time Taken: @_timerDisplay</p>
            </div>
        }
    }
</div>

@code {
    private PuzzleState? _puzzleState;
    private GameSettings _settings = new();
    private bool _showSettings = false;
    private string _message = "";
    private string _currentWord = "";
    private string _currentWordStatusClass = "";
    private int _hintCount = 0;

    // Timer fields
    private DateTime _gameStartTime;
    private string _timerDisplay = "0:00";
    private System.Threading.Timer? _displayTimer;
    private bool _gameCompleted = false;

    private List<CircleLetter> _circleLetters = new();
    private List<int> _selectedLetters = new();
    private bool _isSelecting = false;
    private System.Threading.Timer? _hideTimer;
    private (int X, int Y)? _clickedCell = null;
    private System.Threading.Timer? _clickHighlightTimer;
    private ElementReference letterWheelElement;
    private bool _isGenerating = false;
    private string _generationStatus = "";

    // Background puzzle generation
    private Task<PuzzleState?>? _taskGenNextPuzzle = null;
    private CancellationTokenSource? _cancellationTokenSource = null;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.LoadSettingsAsync();
        if (_settings.MaxWordLength > 11) {
            _settings.MaxWordLength = 11; // for testing, we'll keep them fast
        }
        await NewGame();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Simple delay to ensure touch handling works
            await Task.Delay(100);
            Console.WriteLine("✅ Component rendered and ready for touch");
        }
    }

    // Timer methods
    private void StartGameTimer()
    {
        _gameStartTime = DateTime.Now;
        _gameCompleted = false;
        _timerDisplay = "0:00";

        _displayTimer?.Dispose();
        _displayTimer = new System.Threading.Timer(UpdateTimerDisplay, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async void UpdateTimerDisplay(object? state)
    {
        if (_gameCompleted) return;

        var elapsed = DateTime.Now - _gameStartTime;
        _timerDisplay = $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}";

        await InvokeAsync(StateHasChanged);
    }

    private void StopGameTimer()
    {
        _gameCompleted = true;
        _displayTimer?.Dispose();
        _displayTimer = null;
    }

    // Handle touch start on the SVG (for drag outside letters)
    private void HandleTouchStart(TouchEventArgs e)
    {
        Console.WriteLine("📱 SVG Touch start detected");
        // This will be handled by individual letter touch events
    }

    // Handle touch move on the SVG
    private async void HandleTouchMove(TouchEventArgs e)
    {
        if (!_isSelecting) return;

        Console.WriteLine("📱 SVG Touch move detected");

        // Get touch coordinates and find the letter under the touch
        if (e.ChangedTouches.Length > 0)
        {
            var touch = e.ChangedTouches[0];
            var hitIndex = await GetLetterIndexFromCoordinatesAsync(touch.ClientX, touch.ClientY);
            if (hitIndex >= 0)
            {
                ContinueSelection(hitIndex);
            }
            else
            {
                // Touch is outside any letter - check if it's outside the wheel area
                var isOutsideWheel = await IsOutsideLetterWheelAsync(touch.ClientX, touch.ClientY);
                if (isOutsideWheel)
                {
                    Console.WriteLine("👆 Touch moved outside wheel - aborting word");
                    EndSelection(abortSelection: true);
                }
            }
        }
    }

    // Handle touch end on the SVG
    private void HandleTouchEnd(TouchEventArgs e)
    {
        Console.WriteLine("📱 SVG Touch end detected");
        if (_isSelecting)
        {
            EndSelection();
        }
    }

    // Handle touch start on individual letters
    private void HandleLetterTouchStart(TouchEventArgs e, int index)
    {
        Console.WriteLine($"📱 Letter {index} touch start detected");
        StartSelection(index);
    }

    private async Task NewGame()
    {
        // Reset hint count for new game
        _hintCount = 0;

        // Check if we have a pre-generated puzzle ready
        if (_taskGenNextPuzzle is not null)
        {
            Console.WriteLine("🚀 Using pre-generated puzzle from background task");
            try
            {
                // Use the pre-generated puzzle
                _puzzleState = await _taskGenNextPuzzle;
                _taskGenNextPuzzle = null; // Clear the task

                if (_puzzleState is not null)
                {
                    await SetupNewPuzzle();
                    StartBackgroundPuzzleGeneration();
                    // Start the game timer after successful puzzle setup
                    StartGameTimer();
                    StateHasChanged();
                    return;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error with pre-generated puzzle: {ex.Message}");
                _taskGenNextPuzzle = null; // Clear failed task
            }
        }

        // Fall back to synchronous generation with progress indicator
        bool showProgress = _settings.MaxWordLength >= 9;

        _isGenerating = showProgress;
        if (showProgress)
        {
            _generationStatus = "Initializing...";
        }
        await ResetGameState();

        if (showProgress)
        {
            await Task.Delay(500); // Allow UI to update and show initializing
        }

        try
        {
            if (showProgress)
            {
                _generationStatus = "Generating words...";
                StateHasChanged();
                await Task.Delay(300);
            }

            _puzzleState = await GameService.GeneratePuzzleAsync(_settings);

            if (_puzzleState is not null)
            {
                if (showProgress)
                {
                    _generationStatus = "Creating circle...";
                    StateHasChanged();
                    await Task.Delay(300);
                }

                CreateCircleLetters();

                if (showProgress)
                {
                    _generationStatus = "Finalizing...";
                    StateHasChanged();
                    await Task.Delay(200);
                }

                _message = $"New puzzle created! Target: {_puzzleState.TargetWord}, Words to find: {_puzzleState.PossibleWords.Count}";

                // Start the game timer after successful puzzle creation
                StartGameTimer();

                // Clear message after 3 seconds
                _ = Task.Delay(3000).ContinueWith(_ => 
                {
                    if (_message.Contains("New puzzle created"))
                        _message = "";
                    InvokeAsync(StateHasChanged);
                });

                StartBackgroundPuzzleGeneration();
            }
            else
            {
                _message = "Failed to generate puzzle - puzzle state is null";
            }
        }
        catch (Exception ex)
        {
            _message = $"Error generating puzzle: {ex.Message}";
            Console.WriteLine($"NewGame Error: {ex}");
        }
        finally
        {
            _isGenerating = false;
            _generationStatus = "";
            StateHasChanged();
        }
    }

    private async Task SetupNewPuzzle()
    {
        await Task.Yield();
        _message = "";
        _selectedLetters.Clear();
        _currentWord = "";
        _currentWordStatusClass = "";
        _hideTimer?.Dispose();
        _hideTimer = null;

        CreateCircleLetters();
        _message = $"New puzzle ready! Target: {_puzzleState?.TargetWord}, Words to find: {_puzzleState?.PossibleWords.Count}";

        // Clear message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            if (_message.Contains("New puzzle ready"))
                _message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ResetGameState()
    {
        await Task.Yield();
        _message = "";
        _puzzleState = null;
        _selectedLetters.Clear();
        _currentWord = "";
        _currentWordStatusClass = "";
        _hideTimer?.Dispose();
        _hideTimer = null;
        _hintCount = 0;
        StateHasChanged();
    }

    private void CreateCircleLetters()
    {
        if (_puzzleState is null) return;

        _circleLetters.Clear();
        var letters = _puzzleState.CircleLetters;
        var radius = 117.0;  // Increased from 90 by 30% for larger, finger-friendly circle
        var centerX = 182.0;  // Updated to match new SVG center (364/2)
        var centerY = 182.0;  // Updated to match new SVG center (364/2)

        for (int i = 0; i < letters.Count; i++)
        {
            var angle = (2 * Math.PI * i) / letters.Count - (Math.PI / 2); // Start at top
            var x = centerX + radius * Math.Cos(angle);
            var y = centerY + radius * Math.Sin(angle);

            _circleLetters.Add(new CircleLetter
            {
                Letter = letters[i],
                X = x,
                Y = y,
                Index = i
            });
        }
    }

    private void ShuffleCircleLetters()
    {
        if (_puzzleState is null || _circleLetters.Count == 0) return;

        // Clear any current selection
        _selectedLetters.Clear();
        _currentWord = "";
        _currentWordStatusClass = "";
        _message = "";

        // Create a new randomized list of letters
        var shuffledLetters = _puzzleState.CircleLetters.ToList();

        // Fisher-Yates shuffle algorithm
        var random = new Random();
        for (int i = shuffledLetters.Count - 1; i > 0; i--)
        {
            int j = random.Next(i + 1);
            (shuffledLetters[i], shuffledLetters[j]) = (shuffledLetters[j], shuffledLetters[i]);
        }

        // Update the puzzle state with new order
        _puzzleState.CircleLetters = shuffledLetters;

        // Recreate the circle positions with new letter order
        CreateCircleLetters();

        Console.WriteLine($"🔀 Shuffled circle letters: {string.Join("", shuffledLetters)}");

        // Trigger UI update
        StateHasChanged();
    }

    private void StartSelection(int index)
    {
        ClearSelection();
        _currentWordStatusClass = "";
        _selectedLetters.Add(index);
        _isSelecting = true;
        UpdateCurrentWord();
        Console.WriteLine($"🎯 Started selection with letter {index}: '{_currentWord}'");
        StateHasChanged();
    }

    private void ContinueSelection(int index)
    {
        if (!_isSelecting) return;

        // Check if this is the penultimate (second-to-last) letter
        // If so, allow undo by removing the last letter
        if (_selectedLetters.Count >= 2 && _selectedLetters[_selectedLetters.Count - 2] == index)
        {
            // Remove the last selected letter (undo)
            var removedIndex = _selectedLetters[_selectedLetters.Count - 1];
            _selectedLetters.RemoveAt(_selectedLetters.Count - 1);
            Console.WriteLine($"🔙 Undo: Removed letter at index {removedIndex}, current word: '{string.Join("", _selectedLetters.Select(i => _circleLetters[i].Letter))}'");
            UpdateCurrentWord();
            StateHasChanged();
            return;
        }

        // Only add if not already selected and not backtracking
        if (!_selectedLetters.Contains(index))
        {
            _selectedLetters.Add(index);
            Console.WriteLine($"➕ Added letter at index {index}, current word: '{_currentWord}'");
            UpdateCurrentWord();
            StateHasChanged();
        }
    }

    private void EndSelection(bool abortSelection = false)
    {
        _isSelecting = false;
        if (abortSelection)
        {
            ClearSelection();
        }
        Console.WriteLine($"🏁 Ended selection with word: '{_currentWord}'");

        // Automatically submit the word when selection ends
        if (!string.IsNullOrEmpty(_currentWord))
        {
            if (_currentWord.Length >= _settings.MinWordLength) {
                SubmitWord();
            } else
            {
                ClearSelection();
            }
        }
        StateHasChanged();
    }

    private async void HandleMouseMove(MouseEventArgs e)
    {
        if (!_isSelecting) return;

        // Get mouse coordinates and find the letter under the cursor
        var hitIndex = await GetLetterIndexFromCoordinatesAsync(e.ClientX, e.ClientY);
        if (hitIndex >= 0)
        {
            ContinueSelection(hitIndex);
        }
        else if (_isSelecting && _selectedLetters.Any())
        {
            // Mouse is outside any letter - check if it's outside the wheel area
            var isOutsideWheel = await IsOutsideLetterWheelAsync(e.ClientX, e.ClientY);
            if (isOutsideWheel)
            {
                Console.WriteLine("🖱️ Mouse moved outside wheel - aborting word");
                EndSelection(abortSelection: true);
            }
        }
    }

    private async Task<int> GetLetterIndexFromCoordinatesAsync(double clientX, double clientY)
    {
        try
        {
            // Use JavaScript interop to convert client coordinates to SVG coordinates
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return -1;

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];

            // Check each letter circle for hit detection - updated radius to 32.5
            for (int i = 0; i < _circleLetters.Count; i++)
            {
                var letter = _circleLetters[i];
                var distance = Math.Sqrt(Math.Pow(svgX - letter.X, 2) + Math.Pow(svgY - letter.Y, 2));
                if (distance <= 32.5) // Circle radius is now 32.5 (increased by 30%)
                {
                    return i;
                }
            }
            return -1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in coordinate conversion: {ex.Message}");
            return -1;
        }
    }

    private async Task<bool> IsOutsideLetterWheelAsync(double clientX, double clientY)
    {
        try
        {
            // Convert client coordinates to SVG coordinates
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return true; // If conversion fails, assume outside

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];

            // Check if the point is outside the main circle (radius 117 + some padding)
            var centerX = 182; // Updated center
            var centerY = 182; // Updated center
            var wheelRadius = 117 + 59; // Main wheel radius plus padding
            var distanceFromCenter = Math.Sqrt(Math.Pow(svgX - centerX, 2) + Math.Pow(svgY - centerY, 2));

            return distanceFromCenter > wheelRadius;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking if outside wheel: {ex.Message}");
            return true; // If error occurs, assume outside
        }
    }

    private async void HandleSvgMouseUp(MouseEventArgs e)
    {
        if (!_isSelecting) return;

        // Check if mouse up occurred outside any letter
        var hitIndex = await GetLetterIndexFromCoordinatesAsync(e.ClientX, e.ClientY);
        if (hitIndex < 0 && _selectedLetters.Any())
        {
            Console.WriteLine("🖱️ Mouse released outside letter - auto-submitting word");
            EndSelection();
        }
    }

    private void UpdateCurrentWord()
    {
        _currentWord = string.Join("", _selectedLetters.Select(i => _circleLetters[i].Letter));
    }

    private void ClearSelection()
    {
        _selectedLetters.Clear();
        _currentWord = "";
        _isSelecting = false;
        // Note: Don't clear _currentWordStatusClass here - we want to keep the status display
    }

    private void SubmitWord()
    {
        if (string.IsNullOrEmpty(_currentWord) || _puzzleState is null) return;

        // Check minimum word length - if below minimum, show status and keep displayed
        if (_currentWord.Length < _settings.MinWordLength)
        {
            _currentWordStatusClass = "word-status-too-short";
            _message = $"Word must be at least {_settings.MinWordLength} letters long.";

            // Clear selection but keep word displayed with status
            _selectedLetters.Clear();
            _isSelecting = false;

            StateHasChanged();

            // Clear message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ => 
            {
                _message = "";
                InvokeAsync(StateHasChanged);
            });
            return;
        }

        // Check if this word was already guessed
        if (_puzzleState.FoundWords.Any(fw => fw.Word == _currentWord))
        {
            _currentWordStatusClass = "word-status-already-found";
            _message = $"You already guessed '{_currentWord}'.";
        }
        else
        {
            // Always validate and add the word to the found list (even if invalid)
            var wordType = GameService.ValidateWord(_currentWord, _puzzleState);
            var foundWord = new FoundWord { Word = _currentWord, Type = wordType };

            // Add the word to found words regardless of its validity
            _puzzleState.FoundWords.Add(foundWord);

            // If it's a grid word, also reveal it in the grid
            if (wordType == FoundWordType.SubWordInGrid)
            {
                GameService.ShowWordInGrid(_currentWord, _puzzleState);
            }

            // Set appropriate status class based on word type
            _currentWordStatusClass = wordType switch
            {
                FoundWordType.SubWordInGrid => "word-status-in-grid",
                FoundWordType.SubWordInLargeDictionary => "word-status-in-large-dict",
                FoundWordType.SubWordNotInGrid => "word-status-in-small-dict",
                FoundWordType.SubWordNotAWord => "word-status-not-found",
                _ => ""
            };

            // Set appropriate message based on word type
            _message = wordType switch
            {
                FoundWordType.SubWordInGrid => $"Great! You found '{_currentWord}'!",
                FoundWordType.SubWordInLargeDictionary => $"'{_currentWord}' is a valid word (large dictionary)!",
                FoundWordType.SubWordNotInGrid => $"'{_currentWord}' is a valid word but not in this puzzle.",
                FoundWordType.SubWordNotAWord => $"'{_currentWord}' is not a valid word.",
                _ => $"'{_currentWord}' was added to your list."
            };
        }

        // Clear selection but keep word displayed with status
        _selectedLetters.Clear();
        _isSelecting = false;

        // Check if game is complete and stop timer
        if (_puzzleState?.IsComplete == true)
        {
            StopGameTimer();
        }

        StateHasChanged();

        // Clear message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private string GetPolylinePoints()
    {
        if (!_selectedLetters.Any()) return "";

        var points = _selectedLetters.Select(i => $"{_circleLetters[i].X},{_circleLetters[i].Y}");
        return string.Join(" ", points);
    }

    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
    }

    private async Task SaveSettings()
    {
        // Validate settings
        if (_settings.MinWordLength >= _settings.MaxWordLength)
        {
            _settings.MinWordLength = _settings.MaxWordLength - 1;
        }

        if (_settings.MinWordLength < 3) _settings.MinWordLength = 3;
        if (_settings.MaxWordLength > 10) _settings.MaxWordLength = 10;

        await SettingsService.SaveSettingsAsync(_settings);
        _showSettings = false;

        // Cancel any background generation since settings changed
        _cancellationTokenSource?.Cancel();
        _taskGenNextPuzzle = null;

        // Restart background generation with new settings if we have a current puzzle
        if (_puzzleState is not null)
        {
            StartBackgroundPuzzleGeneration();
        }

        _message = "Settings saved! Click 'New Game' to apply changes.";

        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _message = "";
            InvokeAsync(StateHasChanged);
        });

        StateHasChanged();
    }

    private void OnGridCellClick(int x, int y)
    {
        // Highlight the clicked cell
        _clickedCell = (x, y);

        // Cancel existing highlight timer
        _clickHighlightTimer?.Dispose();

        // Set timer to remove highlight after 300ms
        _clickHighlightTimer = new System.Threading.Timer(async _ =>
        {
            _clickedCell = null;
            await InvokeAsync(StateHasChanged);
        }, null, 300, Timeout.Infinite);

        if (_puzzleState is null) 
        {
            _message = "❌ Puzzle state is null";
            StateHasChanged();
            return;
        }

        // Find the cell at this position
        var cell = _puzzleState.LegacyGrid?.Cells?.FirstOrDefault(c => c.X == x && c.Y == y);
        if (cell is not null && !cell.IsBlank && !cell.IsRevealed)
        {
            // Increment hint count when revealing a letter
            _hintCount++;

            // Reveal only this single letter
            cell.IsRevealed = true;
            _message = $"Hint #{_hintCount}: Revealed letter '{cell.Letter.ToString().ToUpper()}' at ({x}, {y})";

            // Hide the cell after 2 seconds
            _hideTimer?.Dispose();
            _hideTimer = new System.Threading.Timer(async _ =>
            {
                // Check if this cell is part of any found word before hiding
                bool isPartOfFoundWord = false;
                foreach (var foundWord in _puzzleState.FoundWords.Where(fw => fw.Type == FoundWordType.SubWordInGrid))
                {
                    if (_puzzleState.Grid is not null && _puzzleState.Grid._dictPlacedWords.TryGetValue(foundWord.Word, out var placement))
                    {
                        for (int i = 0; i < foundWord.Word.Length; i++)
                        {
                            int wordX = placement.IsHoriz ? placement.nX + i : placement.nX;
                            int wordY = placement.IsHoriz ? placement.nY : placement.nY + i;

                            if (wordX == x && wordY == y)
                            {
                                isPartOfFoundWord = true;
                                break;
                            }
                        }
                    }
                    if (isPartOfFoundWord)
                    {
                        break;
                    }
                }
                
                // Only hide if not part of a found word
                if (!isPartOfFoundWord && cell.IsRevealed)
                {
                    cell.IsRevealed = false;
                    await InvokeAsync(StateHasChanged);
                }
            }, null, 2000, Timeout.Infinite);
            
            StateHasChanged();
        }
        else if (cell is not null && cell.IsRevealed)
        {
            _message = $"Letter '{cell.Letter.ToString().ToUpper()}' is already revealed at ({x}, {y})";
            StateHasChanged();
        }
        else
        {
            _message = $"No letter to reveal at ({x}, {y})";
            StateHasChanged();
        }
        
        // Clear message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            if (_message.Contains($"at ({x}, {y})"))
                _message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private void StartBackgroundPuzzleGeneration()
    {
        // Cancel any existing background generation
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        
        _cancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _cancellationTokenSource.Token;
        
        Console.WriteLine("🔄 Starting background puzzle generation...");
        
        // Start the background task
        _taskGenNextPuzzle = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1000, cancellationToken); // Small delay before starting generation
                if (cancellationToken.IsCancellationRequested) return null;
                
                Console.WriteLine("🎮 Generating next puzzle in background...");
                var nextPuzzle = await GameService.GeneratePuzzleAsync(_settings);
                
                if (cancellationToken.IsCancellationRequested) return null;
                
                Console.WriteLine($"✅ Background puzzle generated: {nextPuzzle?.TargetWord}");
                return nextPuzzle;
            }
            catch (OperationCanceledException)
            {
                Console.WriteLine("🛑 Background puzzle generation cancelled");
                return null;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error in background puzzle generation: {ex.Message}");
                return null;
            }
        }, cancellationToken);
    }

    private async Task OpenDictionaryDefinition(string word)
    {
        // Open Merriam-Webster dictionary definition in a new tab/window
        // This matches the original WordScape implementation
        var url = $"https://www.merriam-webster.com/dictionary/{word.ToLower()}";
        await JSRuntime.InvokeVoidAsync("openUrl", url);
    }

    private string GetWordCssClass(FoundWordType wordType)
    {
        return wordType switch
        {
            FoundWordType.SubWordInGrid => "word-in-grid",
            FoundWordType.SubWordInLargeDictionary => "word-in-large-dict",
            FoundWordType.SubWordNotInGrid => "word-in-small-dict",
            FoundWordType.SubWordNotAWord => "word-not-found",
            _ => ""
        };
    }

    public void Dispose()
    {
        _hideTimer?.Dispose();
        _clickHighlightTimer?.Dispose();
        _displayTimer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
