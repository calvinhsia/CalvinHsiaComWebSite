@* Cartoon Animation History & Description Component *@
@namespace BlazorWasm.Games.Cartoon

<div class="cartoon-history">
	<h3>📜 About Cartoon Animation</h3>
	
	<div class="history-section">
		<p>
			<strong>Cartoon</strong> is a frame-by-frame animation program that lets you create hand-drawn animations 
			with smooth interpolation between keyframes. Draw your frames, and the program automatically generates 
			intermediate frames to create fluid motion.
		</p>
	</div>

	<div class="history-section">
		<h4>🕰️ Historical Origins</h4>
		<p>
			This animation system was originally developed in 1982 using C and C++ on an original IBM PC with 640K memory and 2 floppy disk drives.
			It was demonstrated at the Honolulu Academy of Arts in 1984, showcasing early computer-generated animation techniques.
			Over the years I've rewritten it with more modern techologies, such as C#, Windows Presentation Foundation.
			This version was written with help from Github Copilot. I just showed Copilot my WPF version.
		</p>
	</div>

	<div class="history-section">
		<h4>🔄 Modern Recreation</h4>
		<p>
			This is a modern Blazor WebAssembly recreation of the original program, 
			preserving the core interpolation algorithms while adding contemporary features like:
		</p>
		<ul>
			<li>Browser-based canvas rendering with HTML5</li>
			<li>Touch and mouse input support</li>
			<li>Automatic state persistence</li>
			<li>URL-based animation sharing</li>
			<li>Responsive design for all screen sizes</li>
		</ul>
	</div>
</div>
