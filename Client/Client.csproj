<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Client</RootNamespace>
  </PropertyGroup>

  <!-- Development-only: Disable static web asset caching -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <BlazorCacheBootResources>false</BlazorCacheBootResources>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

	<!-- Exclude Roslyn analyzers from runtime bundle (build-time only) -->
	<Target Name="RemoveCodeAnalysisFromPublish" AfterTargets="ResolveBlazorPublishAssets" BeforeTargets="GeneratePublishWasmBootJson">
		<ItemGroup>
			<!-- Remove from Blazor publish assets -->
			<BlazorPublishAsset Remove="@(BlazorPublishAsset)" Condition="$([System.String]::Copy('%(BlazorPublishAsset.Filename)').Contains('CodeAnalysis'))" />
			<!-- Remove from WASM assemblies to bundle -->
			<_WasmAssembliesToBundle Remove="@(_WasmAssembliesToBundle)" Condition="$([System.String]::Copy('%(_WasmAssembliesToBundle.Filename)').Contains('CodeAnalysis'))" />
			<WasmAssembliesToBundle Remove="@(WasmAssembliesToBundle)" Condition="$([System.String]::Copy('%(WasmAssembliesToBundle.Filename)').Contains('CodeAnalysis'))" />
			<!-- Remove from resolved files to publish -->
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('CodeAnalysis'))" />
		</ItemGroup>
		<Message Text="Excluded CodeAnalysis assemblies from Blazor publish assets" Importance="high" />
	</Target>
	
	<!-- Clean up CodeAnalysis files from disk and boot JSON after publish -->
	<Target Name="CleanupCodeAnalysisFiles" AfterTargets="GeneratePublishWasmBootJson">
		<ItemGroup>
			<CodeAnalysisFilesToDelete Include="$(PublishDir)wwwroot\_framework\**\*CodeAnalysis*.wasm" />
			<CodeAnalysisFilesToDelete Include="$(PublishDir)wwwroot\_framework\**\*CodeAnalysis*.dll" />
		</ItemGroup>
		<Delete Files="@(CodeAnalysisFilesToDelete)" />
		
		<!-- Manually clean the boot JSON file -->
		<PropertyGroup>
			<BootJsonPath>$(PublishDir)wwwroot\_framework\blazor.boot.json</BootJsonPath>
		</PropertyGroup>
		<Exec Command="powershell -Command &quot;$json = Get-Content '$(BootJsonPath)' | ConvertFrom-Json; $json.resources.assembly = $json.resources.assembly | Select-Object -Property * -ExcludeProperty *CodeAnalysis*; $json.resources.satelliteResources.PSObject.Properties | ForEach-Object { $_.Value = $_.Value | Select-Object -Property * -ExcludeProperty *CodeAnalysis* }; $json | ConvertTo-Json -Depth 10 | Set-Content '$(BootJsonPath)'&quot;" 
			  Condition="'$(OS)' == 'Windows_NT'" />
		<Exec Command="python3 -c &quot;import json; f=open('$(BootJsonPath)', 'r+'); data=json.load(f); data['resources']['assembly']={k:v for k,v in data['resources']['assembly'].items() if 'CodeAnalysis' not in k}; [data['resources']['satelliteResources'].__setitem__(lang, {k:v for k,v in files.items() if 'CodeAnalysis' not in k}) for lang, files in data['resources']['satelliteResources'].items()]; f.seek(0); f.truncate(); json.dump(data, f, indent=2); f.close()&quot;" 
			  Condition="'$(OS)' != 'Windows_NT'" />
		
		<Message Text="Deleted @(CodeAnalysisFilesToDelete->Count()) CodeAnalysis files and cleaned boot JSON" Importance="high" />
	</Target>
	
	<ItemGroup>
    <PackageReference Include="DictionaryLib_Calvin_Hsia" Version="1.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.JSInterop.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="8.0.0" />

  </ItemGroup>

  <ItemGroup>
    <Page Include="Pages\MSGraph.razor.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
