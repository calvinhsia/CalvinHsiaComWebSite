        {
            FoundWordType.SubWordInGrid => "word-in-grid",
            FoundWordType.SubWordInLargeDictionary => "word-in-large-dict",
            FoundWordType.SubWordNotInGrid => "word-in-small-dict",
            FoundWordType.SubWordNotAWord => "word-not-found",
            _ => ""
        };
    }

    public void Dispose()
    {
        // Save game state before component is disposed (when user navigates away)
        _ = Task.Run(async () =>
        {
            try
            {
                await SaveGameState();
                Console.WriteLine("?? Game state saved on component disposal");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"? Failed to save game state on disposal: {ex.Message}");
            }
        });

        // FIXED: Dispose all hint timers
        foreach (var timer in _hintingCells.Values)
        {
            timer?.Dispose();
        }
        _hintingCells.Clear();
        
        _clickHighlightTimer?.Dispose();
        _displayTimer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}