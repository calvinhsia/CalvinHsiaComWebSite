    // Animate grid cells for celebration - Better Windows compatibility
    private async Task AnimateGridCelebration()
    {
        try
        {
            if (_puzzleState?.LegacyGrid?.Cells == null) return;

            var revealedCells = _puzzleState.LegacyGrid.Cells
                .Where(c => !c.IsBlank && c.IsRevealed)
                .ToList();

            if (!revealedCells.Any()) 
            {
                DebugHelper.Log("No revealed cells to animate");
                return;
            }

            DebugHelper.Log($"Starting grid celebration animation for {revealedCells.Count} cells");

            try 
            {
                // Try the enhanced all-at-once animation first (better for Windows)
                var animatedCount = await JSRuntime.InvokeAsync<int>("animateAllGridCells");
                DebugHelper.Log($"Successfully animated {animatedCount} grid cells using enhanced method");
            }
            catch (Exception jsEx)
            {
                DebugHelper.LogError($"Enhanced animation failed, falling back to individual cell animation: {jsEx.Message}");
                
                // Fallback to individual cell animation
                for (int i = 0; i < revealedCells.Count; i++)
                {
                    var cellIndex = i;
                    var delay = i * 50; // 50ms delay between each cell

                    _ = Task.Delay(delay).ContinueWith(async _ =>
                    {
                        try
                        {
                            await JSRuntime.InvokeVoidAsync("addCelebrationFlash", cellIndex);
                        }
                        catch (Exception ex)
                        {
                            DebugHelper.LogError($"Individual cell animation error for cell {cellIndex}: {ex}");
                        }
                    });
                }
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"AnimateGridCelebration error: {ex}");
        }
    }

