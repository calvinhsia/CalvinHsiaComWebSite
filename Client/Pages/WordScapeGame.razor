            else
            {
                // Touch is outside any letter but still in container - continue without ending selection
                // Only end if touch goes way outside the container area
                var isVeryFarOutside = await IsVeryFarOutsideContainerAsync(touch.ClientX, touch.ClientY);
                if (isVeryFarOutside)
                {
                    Console.WriteLine("?? Touch moved very far outside container - aborting word");
                    await EndSelection(abortSelection: true);
                }
            }
        }
