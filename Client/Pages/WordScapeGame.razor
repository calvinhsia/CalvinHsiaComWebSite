@page "/wordscape"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@using WordScapeBlazorWasm.Shared
@inject WordScapeGameService GameService
@inject GameSettingsService SettingsService
@inject GameStateService StateService
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [AllowAnonymous]

<div class="wordscape-fixed-game">
    @* Add debugging info while game loads *@
    @if (_puzzleState is null && !_isGenerating)
    {
        <div class="game-loading">
            <div class="alert alert-info">
                <h4>WordScape Game Loading...</h4>
                <p>Status: @(_debugInfo ?? "Initializing game...")</p>
                <p>Settings loaded: @(_settings != null)</p>
                <p>Service available: @(GameService != null)</p>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p>Message: @_message</p>
                }
                <button class="btn btn-primary" @onclick="ForceNewGame">Force Start Game</button>
            </div>
        </div>
    }

    @if (_puzzleState is not null)
    {
        <!-- Crossword Grid -->
        <div class="game-grid">
            @if (_isGenerating)
            {
                <div class="generation-progress">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="progress-status">@_generationStatus</div>
                </div>
            }
            else
            {
                <div class="grid-container" 
                     style="grid-template-columns: repeat(@(_puzzleState?.LegacyGrid?.MaxX ?? 1), 28.8px); grid-template-rows: repeat(@(_puzzleState?.LegacyGrid?.MaxY ?? 1), 28.8px);">
                    @for (int y = 0; y < (_puzzleState?.LegacyGrid?.MaxY ?? 0); y++)
                    {
                        @for (int x = 0; x < (_puzzleState?.LegacyGrid?.MaxX ?? 0); x++)
                        {
                            var cell = _puzzleState?.LegacyGrid?.Cells?.FirstOrDefault(c => c.X == x && c.Y == y);
                            if (cell is not null && !cell.IsBlank)
                            {
                                var localX = x;
                                var localY = y;
                                var isClicked = _clickedCell.HasValue && _clickedCell.Value.X == x && _clickedCell.Value.Y == y;
                                var isHinting = _hintingCells.ContainsKey((x, y));
                                <div class="grid-cell @(cell.IsRevealed ? "revealed" : "hidden") @(isClicked ? "clicked-highlight" : "") @(isHinting ? "hint-reveal" : "")" 
                                     style="grid-column: @(x + 1); grid-row: @(y + 1);"
                                     @onclick="@(() => OnGridCellClick(localX, localY))">
                                    @if (cell.IsRevealed || isHinting)
                                    {
                                        @cell.Letter.ToString().ToUpper()
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }
        </div>

        <!-- Current Word Display with buttons -->
        <div class="current-word-bar">
            <button class="settings-button" @onclick="ToggleSettings" disabled="@_isGenerating" title="Settings">
                <span class="icon-fallback">&#9881;</span><span class="text-fallback">SET</span>
            </button>
            <div class="current-word-display @_currentWordStatusClass" 
                 @onclick="@(() => OnCurrentWordClick())"
                 title="@(string.IsNullOrEmpty(_currentWord) ? "Current word will appear here" : $"Click to look up '{_currentWord}' in dictionary")">
                @_currentWord
            </div>
            <button class="newgame-button" @onclick="NewGame" disabled="@_isGenerating" title="New Game">
                @if (_isGenerating)
                {
                    <span class="spinner-border spinner-border-xs" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span class="icon-fallback">&#8862;</span><span class="text-fallback">NEW</span>
                }
            </button>
        </div>

        <!-- Letter Wheel -->
        <div class="game-wheel">
            <div class="wheel-container">
                <div class="corner corner-topleft">
                    <div class="corner-label">Score</div>
                    <div class="corner-value">@(_puzzleState?.Score ?? 0)</div>
                </div>
                <div class="corner corner-topright">
                    <div class="corner-label">Words</div>
                    <div class="corner-value">@(_puzzleState?.FoundWords.Count(fw => fw.Type == FoundWordType.SubWordInGrid) ?? 0)/@(_puzzleState?.PossibleWords.Count ?? 0)</div>
                </div>
                <div class="corner corner-bottomleft">
                    <div class="corner-label">Hints</div>
                    <div class="corner-value">@_hintCount</div>
                </div>
                <div class="corner corner-bottomright">
                    <div class="corner-label">Timer</div>
                    <div class="corner-value">@_timerDisplay</div>
                </div>

                <div class="letter-wheel @((_puzzleState?.IsComplete == true) ? "game-complete" : "")" @ref="letterWheelElement">
                    <svg width="600" height="600" viewBox="0 0 600 600"
                         @onmousemove="@HandleMouseMove"
                         @onmousemove:preventDefault="true"
                         @onmouseup="@HandleSvgMouseUp"
                         @ontouchstart="@HandleTouchStart"
                         @ontouchstart:preventDefault="true"
                         @ontouchmove="@HandleTouchMove"
                         @ontouchmove:preventDefault="true"
                         @ontouchend="@HandleTouchEnd"
                         @ontouchend:preventDefault="true"
                         @oncontextmenu:preventDefault="true"
                         style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none;">
                    
                        <circle cx="300" cy="300" r="250" fill="none" stroke="#007bff" stroke-width="4" />
                   
                        @if (_selectedLetters.Any())
                        {
                            <polyline points="@GetPolylinePoints()" 
                                      fill="none" 
                                      stroke="#ff6b35" 
                                      stroke-width="4" />
                        }

                        @for (int i = 0; i < _circleLetters.Count; i++)
                        {
                            var letter = _circleLetters[i];
                            var isSelected = _selectedLetters.Contains(i);
                            var index = i;
                            
                            <g class="letter-container @(isSelected ? "selected" : "")"
                               data-letter-index="@index"
                               @onmousedown="@(() => StartSelection(index))"
                               @onmouseover="@(() => ContinueSelection(index))"
                               @onmouseup="@(() => EndSelection())"
                               @ontouchstart="@((e) => HandleLetterTouchStart(e, index))"
                               @ontouchstart:preventDefault="true"
                               @oncontextmenu:preventDefault="true"
                               style="touch-action: none; cursor: pointer; -webkit-touch-callout: none; -webkit-user-select: none;">
                            
                                <circle cx="@letter.X" 
                                        cy="@letter.Y" 
                                        r="54" 
                                        fill="@(isSelected ? "#007bff" : "#f8f9fa")" 
                                        stroke="#007bff" 
                                        stroke-width="@(isSelected ? 4 : 3)" />
                            
                                <text x="@letter.X" 
                                      y="@(letter.Y + 14)" 
                                      text-anchor="middle" 
                                      font-family="Arial, sans-serif" 
                                      font-size="58" 
                                      font-weight="bold" 
                                      fill="@(isSelected ? "white" : "black")"
                                      pointer-events="none"
                                      style="-webkit-touch-callout: none; -webkit-user-select: none; user-select: none;">
                                    @letter.Letter
                                </text>
                            </g>
                        }
                    </svg>
                    <button class="center-shuffle-button" @onclick="ShuffleCircleLetters" disabled="@(_isGenerating || (_puzzleState?.IsComplete == true))" title="Shuffle">
                        <span class="icon-fallback">↻</span><span class="text-fallback">MIX</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Message -->
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="game-message">@_message</div>
        }

        <!-- Found Words List -->
        <div class="found-words-section">
            <h4>Found Words (@(_puzzleState?.FoundWords.Count(fw => fw.Type == FoundWordType.SubWordInGrid) ?? 0)/@(_puzzleState?.PossibleWords.Count ?? 0))</h4>
            <div class="words-list multi-column">
                @foreach (var foundWord in _puzzleState?.FoundWords?.OrderBy(fw => fw.Word) ?? Enumerable.Empty<FoundWord>())
                {
                    <div class="found-word @GetWordCssClass(foundWord.Type) @GetWordAnimationClass(foundWord.Word)" 
                         @onclick="@(() => OpenDictionaryDefinition(foundWord.Word))"
                         title="Click to look up definition">
                        @foundWord.Word
                    </div>
                }
            </div>
        </div>

        <!-- Settings panel -->
        @if (_showSettings)
        {
            <div class="settings-overlay">
                <div class="settings-panel">
                    <h3>Settings</h3>
                    <div class="form-group">
                        <label for="minLength">Min Word Length:</label>
                        <input id="minLength" type="number" @bind="_settings.MinWordLength" min="3" max="8" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="maxLength">Max Word Length:</label>
                        <input id="maxLength" type="number" @bind="_settings.MaxWordLength" min="4" max="10" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="gridSize">Grid Size (auto-calculated):</label>
                        <input id="gridSize" type="text" value="@(_settings.GridWidth)x@(_settings.GridHeight) (max 18x18)" readonly class="form-control" title="Grid size is automatically calculated based on your device screen width. Android devices can use wider grids." />
                    </div>
                    
                    <div class="debug-controls">
                        <h4>Debug Options</h4>
                        <div class="checkbox-group">
                            <input type="checkbox" id="debugMode" @bind="_settings.IsDebugEnabled" @bind:after="OnDebugModeChanged" />
                            <label for="debugMode">Enable Debug Mode (fixed random seed for consistent results)</label>
                        </div>
                    </div>
                    
                    <button class="btn btn-success" @onclick="SaveSettings">Save Settings</button>
                    <button class="btn btn-secondary" @onclick="ToggleSettings">Cancel</button>
                </div>
            </div>
        }
    }

    <!-- Enhanced Congratulations Overlay -->
    @if (_puzzleState?.IsComplete == true && _showCongratulations)
    {
        <div class="congratulations-overlay" @onclick="CloseCongratulations">
            <div class="congratulations-panel" @onclick:stopPropagation="true">
                <h3> Congratulations! </h3>
                <div class="final-stats">
                    <div class="final-stat-item">
                        <div class="final-stat-value">@(_puzzleState?.PossibleWords?.Count ?? 0)</div>
                        <div class="final-stat-label">Words Found</div>
                    </div>
                    <div class="final-stat-item">
                        <div class="final-stat-value">@(_puzzleState?.Score ?? 0)</div>
                        <div class="final-stat-label">Final Score</div>
                    </div>
                    <div class="final-stat-item">
                        <div class="final-stat-value">@_hintCount</div>
                        <div class="final-stat-label">Hints Used</div>
                    </div>
                    <div class="final-stat-item">
                        <div class="final-stat-value">@_timerDisplay</div>
                        <div class="final-stat-label">Time Taken</div>
                    </div>
                </div>
                <button class="play-again-btn" @onclick="NewGame">
                    Play Again
                </button>
                <div style="margin-top: 15px; font-size: 12px; color: #6c757d;">
                    Click anywhere outside to close
                </div>
            </div>
        </div>
    }
</div>

@code {
    private PuzzleState? _puzzleState;
    private GameSettings _settings = new();
    private bool _showSettings = false;
    private string _message = "";
    private string _currentWord = "";
    private string _currentWordStatusClass = "";
    private int _hintCount = 0;

    private DateTime _gameStartTime;
    private string _timerDisplay = "0:00";
    private System.Threading.Timer? _displayTimer;
    private bool _gameCompleted = false;

    private List<CircleLetter> _circleLetters = new();
    private List<int> _selectedLetters = new();
    private bool _isSelecting = false;

    private Dictionary<(int X, int Y), System.Threading.Timer> _hintingCells = new();

    private (int X, int Y)? _clickedCell = null;
    private System.Threading.Timer? _clickHighlightTimer;
    private ElementReference letterWheelElement;
    private bool _isGenerating = false;
    private string _generationStatus = "";

    private CancellationTokenSource? _cancellationTokenSource = null;
    private string? _debugInfo = null;

    // Animation and congratulations support
    private bool _showCongratulations = false;
    private readonly HashSet<string> _recentlyAddedWords = new();
    private readonly Dictionary<string, System.Threading.Timer> _wordHighlightTimers = new();

    // Add reference for JavaScript interop
    private DotNetObjectReference<WordScapeGame>? _dotNetHelper;

    // Helper class for JavaScript interop
    public class GridSize
    {
        public int width { get; set; } = 15;
        public int height { get; set; } = 15;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            DebugHelper.Log("WordScapeGame: OnInitializedAsync started");

            // Create DotNet reference for JavaScript callbacks
            _dotNetHelper = DotNetObjectReference.Create(this);

            _debugInfo = "Loading settings...";
            StateHasChanged();

            if (SettingsService == null)
            {
                _debugInfo = "SettingsService is null!";
                DebugHelper.LogError("SettingsService is null!");
                StateHasChanged();
                return;
            }

            _settings = await SettingsService.LoadSettingsAsync();
            DebugHelper.Log($"Settings loaded: MinLength={_settings?.MinWordLength}, MaxLength={_settings?.MaxWordLength}");

            if (_settings.MaxWordLength > 11) {
                _settings.MaxWordLength = 11;
            }

            _debugInfo = "Restoring game state...";
            StateHasChanged();

            // Try to restore previous game state
            var savedState = await StateService.LoadWordScapeStateAsync();
            bool stateRestored = false;

            if (savedState != null && !string.IsNullOrEmpty(savedState.TargetWord))
            {
                DebugHelper.Log($"Restoring WordScape state - Target: {savedState.TargetWord}, Score: {savedState.Score}");
                stateRestored = await RestoreFromSavedState(savedState);
            }

            if (!stateRestored)
            {
                _debugInfo = "Starting new game...";
                StateHasChanged();

                if (GameService == null)
                {
                    _debugInfo = "GameService is null!";
                    DebugHelper.LogError("GameService is null!");
                    StateHasChanged();
                    return;
                }

                DebugHelper.Log("No saved state or restoration failed, starting new game...");
                await NewGame();
            }

            DebugHelper.Log("WordScapeGame: OnInitializedAsync completed successfully");
        }
        catch (Exception ex)
        {
            _debugInfo = $"Error in initialization: {ex.Message}";
            _message = $"Initialization error: {ex.Message}";
            DebugHelper.LogError($"WordScapeGame initialization error: {ex}");
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            try
            {
                // Wait a bit for JavaScript to fully load, then register with state manager
                await Task.Delay(500);

                var gameStateManagerExists = await JSRuntime.InvokeAsync<string>("eval", 
                    "typeof window.gameStateManager !== 'undefined' && typeof window.gameStateManager.registerGame === 'function' ? 'true' : 'false'");

                if (gameStateManagerExists == "true")
                {
                    await JSRuntime.InvokeVoidAsync("gameStateManager.registerGame", "wordscape", _dotNetHelper);
                    DebugHelper.Log("WordScape registered with game state manager");
                }
                else
                {
                    DebugHelper.LogWarning("gameStateManager not available yet, retrying...");

                    // Retry after additional delay
                    await Task.Delay(1000);
                    var retryAvailable = await JSRuntime.InvokeAsync<string>("eval", 
                        "typeof window.gameStateManager !== 'undefined' && typeof window.gameStateManager.registerGame === 'function' ? 'true' : 'false'");

                    if (retryAvailable == "true")
                    {
                        await JSRuntime.InvokeVoidAsync("gameStateManager.registerGame", "wordscape", _dotNetHelper);
                        DebugHelper.Log("WordScape registered with game state manager (retry)");
                    }
                    else
                    {
                        DebugHelper.LogWarning("gameStateManager still not available after retry - game will work without state management");
                    }
                }
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"Error registering with game state manager: {ex}");
            }
        }

        // Apply Android grid positioning fix after render
        if (firstRender || _puzzleState != null)
        {
            try
            {
                await Task.Delay(200); // Allow DOM to settle
                await JSRuntime.InvokeVoidAsync("fixAndroidGridPosition");
                await JSRuntime.InvokeVoidAsync("makeGridEdgeToEdgeAndroid");
                await JSRuntime.InvokeVoidAsync("forceAndroidFullWidth");
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"Android positioning fix in OnAfterRenderAsync failed: {ex.Message}");
            }
        }
    }

    // JavaScript interop method for automatic state saving
    [JSInvokable]
    public async Task SaveGameStateFromJS(string reason)
    {
        try
        {
            DebugHelper.Log($"WordScape: Saving state from JS trigger - {reason}");
            await SaveGameState();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in SaveGameStateFromJS: {ex}");
        }
    }

    public void Dispose()
    {
        try
        {
            // Unregister from game state manager
            if (_dotNetHelper != null)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        var gameStateManagerExists = await JSRuntime.InvokeAsync<string>("eval", 
                            @"typeof window.gameStateManager !== 'undefined' && 
                              typeof window.gameStateManager.unregisterGame === 'function' ? 'true' : 'false'");

                        if (gameStateManagerExists == "true")
                        {
                            await JSRuntime.InvokeVoidAsync("gameStateManager.unregisterGame");
                        }
                        _dotNetHelper.Dispose();
                    }
                    catch (Exception ex)
                    {
                        DebugHelper.LogError($"Error unregistering game state manager: {ex}");
                    }
                });
            }

            // Clean up all timers including new ones
            foreach (var timer in _hintingCells.Values) timer?.Dispose();
            _hintingCells.Clear();

            foreach (var timer in _wordHighlightTimers.Values) timer?.Dispose();
            _wordHighlightTimers.Clear();

            _clickHighlightTimer?.Dispose();
            _displayTimer?.Dispose();
            _cancellationTokenSource?.Cancel();
            _cancellationTokenSource?.Dispose();

            // Save final state on dispose
            if (_puzzleState != null)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await SaveGameState();
                    }
                    catch (Exception ex)
                    {
                        DebugHelper.LogError($"Error saving WordScape state on dispose: {ex}");
                    }
                });
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Dispose error: {ex.Message}");
        }
    }

    // Core game methods
    private async Task<bool> RestoreFromSavedState(WordScapePersistentState savedState)
    {
        try
        {
            // Restore game timing
            _hintCount = savedState.HintCount;
            _gameStartTime = savedState.GameStartTime;
            _gameCompleted = savedState.GameCompleted;
            _currentWord = savedState.CurrentWord;
            _selectedLetters = savedState.SelectedLetters;
            _isSelecting = savedState.IsSelecting;
            _settings = savedState.Settings;

            // Create puzzle state from saved data without generating new grid
            _puzzleState = new PuzzleState
            {
                TargetWord = savedState.TargetWord,
                PossibleWords = savedState.PossibleWords,
                CircleLetters = savedState.CircleLetters,
                FoundWords = new HashSet<FoundWord>(savedState.FoundWords)
            };

            // Restore the grid from saved grid state if available
            if (savedState.GridState != null)
            {
                DebugHelper.Log("Restoring WordScape grid from saved grid state");
                _puzzleState.RestoreGridState(savedState.GridState);

                // Create a compatible GenGrid for the restored state
                var wordContainer = new WordContainer 
                { 
                    InitialWord = savedState.TargetWord, 
                    subwords = savedState.PossibleWords 
                };

                var genGrid = new GenGrid(savedState.GridState.MaxX, savedState.GridState.MaxY, wordContainer, new Random(1));
                genGrid._chars = _puzzleState.LegacyGrid.Letters;
                genGrid._MaxX = savedState.GridState.MaxX;
                genGrid._MaxY = savedState.GridState.MaxY;

                // Restore placed words from saved grid state
                foreach (var kvp in savedState.GridState.PlacedWords)
                {
                    genGrid._dictPlacedWords[kvp.Key] = new LtrPlaced
                    {
                        nX = kvp.Value.StartX,
                        nY = kvp.Value.StartY,
                        IsHoriz = kvp.Value.IsHorizontal
                    };
                }

                _puzzleState.Grid = genGrid;
            }
            else
            {
                DebugHelper.Log("No saved grid state, generating new grid...");
                // No saved grid state, generate new one but keep other saved data
                _puzzleState.Grid = await GameService.GenerateCrosswordGridAsync(_puzzleState.PossibleWords, _puzzleState.TargetWord, _settings);
            }

            CreateCircleLetters();

            if (!_gameCompleted)
            {
                StartGameTimer();
            }

            StartBackgroundPuzzleGeneration();

            _message = $"Game restored! Continue playing from where you left off.";
            StateHasChanged();

            DebugHelper.Log("WordScape state successfully restored");
            return true;
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error restoring WordScape state: {ex}");
            await StateService.ClearWordScapeStateAsync();
        }

        return false;
    }

    private async Task ForceNewGame()
    {
        try
        {
            _debugInfo = "Force starting new game...";
            StateHasChanged();

            _puzzleState = null;
            await StateService.ClearWordScapeStateAsync();
            await NewGame();
        }
        catch (Exception ex)
        {
            _debugInfo = $"Force game error: {ex.Message}";
            _message = $"Force game error: {ex.Message}";
            DebugHelper.LogError($"ForceNewGame error: {ex}");
            StateHasChanged();
        }
    }

    private async Task NewGame()
    {
        try
        {
            DebugHelper.Log("NewGame: Starting...");

            _hintCount = 0;
            _currentWord = "";
            _currentWordStatusClass = "";
            _showCongratulations = false;
            _recentlyAddedWords.Clear();

            // Clean up animation timers
            foreach (var timer in _wordHighlightTimers.Values) timer?.Dispose();
            _wordHighlightTimers.Clear();

            foreach (var timer in _hintingCells.Values) timer?.Dispose();
            _hintingCells.Clear();
            await StateService.ClearWordScapeStateAsync();

            _isGenerating = true;
            _generationStatus = "Calculating optimal grid size...";
            StateHasChanged();

            DebugHelper.Log("Calculating optimal grid size...");

            int gridWidth = 15, gridHeight = 15;

            try
            {
                var optimalGridSize = await JSRuntime.InvokeAsync<GridSize>("calculateOptimalGridSize");

                if (optimalGridSize != null)
                {
                    gridWidth = Math.Min(18, Math.Max(8, optimalGridSize.width));
                    gridHeight = Math.Min(18, Math.Max(8, optimalGridSize.height));
                    DebugHelper.Log($"Optimal grid size: {gridWidth}x{gridHeight}");
                }
                else
                {
                    DebugHelper.Log("No grid size returned from JS, using defaults");
                }
            }
            catch (Exception jsEx)
            {
                DebugHelper.LogError($"Error calculating grid size, using defaults: {jsEx.Message}");
            }

            _settings.GridWidth = gridWidth;
            _settings.GridHeight = gridHeight;

            _generationStatus = $"Generating {_settings.GridWidth}x{_settings.GridHeight} puzzle...";
            StateHasChanged();

            DebugHelper.Log("Calling GameService.GeneratePuzzleAsync...");
            _puzzleState = await GameService.GeneratePuzzleAsync(_settings);
            DebugHelper.Log($"Puzzle generation completed. Puzzle is null: {_puzzleState == null}");

            if (_puzzleState is not null)
            {
                DebugHelper.Log($"Puzzle created! Target: {_puzzleState.TargetWord}, Words: {_puzzleState.PossibleWords?.Count ?? 0}");

                CreateCircleLetters();
                StartGameTimer();
                StartBackgroundPuzzleGeneration();
                _message = $"New {_settings.GridWidth}x{_settings.GridHeight} puzzle created! Target: {_puzzleState.TargetWord}, Words to find: {_puzzleState.PossibleWords.Count}";
                await SaveGameState();

                // Apply Android grid positioning fix after puzzle is created
                try
                {
                    await Task.Delay(500);
                    await JSRuntime.InvokeVoidAsync("fixAndroidGridPosition");
                    await JSRuntime.InvokeVoidAsync("makeGridEdgeToEdgeAndroid");
                    await JSRuntime.InvokeVoidAsync("forceAndroidFullWidth");
                }
                catch (Exception posEx)
                {
                    DebugHelper.LogError($"Android positioning fix failed: {posEx.Message}");
                }

                DebugHelper.Log("Game setup completed successfully");
            }
            else
            {
                _message = "Failed to generate puzzle";
                DebugHelper.LogError("Failed to generate puzzle");
            }
        }
        catch (Exception ex)
        {
            _message = $"Error generating puzzle: {ex.Message}";
            DebugHelper.LogError($"NewGame error: {ex}");
        }
        finally
        {
            _isGenerating = false;
            _generationStatus = "";
            StateHasChanged();
            DebugHelper.Log("NewGame: Finally block completed");
        }
    }

    private void CreateCircleLetters()
    {
        if (_puzzleState is null) return;

        _circleLetters.Clear();
        var letters = _puzzleState.CircleLetters;
        var radius = 250.0;
        var centerX = 300.0;
        var centerY = 300.0;

        for (int i = 0; i < letters.Count; i++)
        {
            var angle = (2 * Math.PI * i) / letters.Count - (Math.PI / 2);
            var x = centerX + radius * Math.Cos(angle);
            var y = centerY + radius * Math.Sin(angle);

            _circleLetters.Add(new CircleLetter
            {
                Letter = letters[i],
                X = x,
                Y = y,
                Index = i
            });
        }
