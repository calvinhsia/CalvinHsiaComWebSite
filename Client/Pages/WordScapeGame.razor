    private async Task<int> GetLetterIndexFromCoordinatesAsync(double clientX, double clientY)
    {
        try
        {
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return -1;

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];
            var extraPadding = 20;

            for (int i = 0; i < _circleLetters.Count; i++)
            {
                var letter = _circleLetters[i];
                var distance = Math.Sqrt(Math.Pow(svgX - letter.X, 2) + Math.Pow(svgY - letter.Y, 2));
                if (distance <= 54 + extraPadding)
                {
                    return i;
                }
            }
            return -1;
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"GetLetterIndexFromCoordinatesAsync error: {ex.Message}");
            return -1;
        }
    }

    private async Task<bool> IsOutsideLetterWheelAsync(double clientX, double clientY)
    {
        try
        {
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return true;

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];

            var centerX = 300.0;
            var centerY = 300.0;
            var wheelRadius = 250 + 70;
            var extraPaddingWheel = 20;
            var distanceFromCenter = Math.Sqrt(Math.Pow(svgX - centerX, 2) + Math.Pow(svgY - centerY, 2));

            return distanceFromCenter > wheelRadius + extraPaddingWheel;
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"IsOutsideLetterWheelAsync error: {ex.Message}");
            return true;
        }
    }

    // ? IMPROVED: Trigger grid word reveal animation for specific word placement
    private async Task TriggerGridWordReveal(string word)
    {
        try
        {
            if (string.IsNullOrEmpty(word) || _puzzleState?.Grid == null) return;
            
            DebugHelper.Log($"?? Triggering grid word reveal animation for: {word}");
            
            // Get the word placement information
            if (_puzzleState.Grid._dictPlacedWords.TryGetValue(word, out var placement))
            {
                var wordPlacement = new
                {
                    startX = placement.nX,
                    startY = placement.nY,
                    isHorizontal = placement.IsHoriz,
                    length = word.Length
                };
                
                DebugHelper.Log($"?? Word placement found: ({placement.nX}, {placement.nY}), horizontal: {placement.IsHoriz}, length: {word.Length}");
                
                // Small delay to ensure DOM has updated with revealed cells
                await Task.Delay(100);
                
                // Use the improved animation that targets ONLY the specific cells for this word
                var animatedCount = await JSRuntime.InvokeAsync<int>("animateSpecificWordReveal", word, wordPlacement);
                DebugHelper.Log($"? Successfully animated {animatedCount} specific cells for word '{word}' (should only animate cells for this word)");
            }
            else
            {
                DebugHelper.LogWarning($"?? Word placement not found for '{word}' in _dictPlacedWords - this word may not be placed in the grid properly");
                
                // In this case, we should NOT animate anything since we don't know which cells belong to this word
                // This prevents animating all cells when we can't find the specific word placement
                DebugHelper.Log($"?? Skipping animation for '{word}' - no placement data means we can't animate specific cells");
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"? Error triggering grid word reveal animation for '{word}': {ex.Message}");
        }
    }

    private async Task SubmitWord()
    {
        if (string.IsNullOrEmpty(_currentWord) || _puzzleState is null) return;

        try
        {
            if (_currentWord.Length < _settings.MinWordLength)
            {
                _currentWordStatusClass = "word-status-too-short";
                _message = $"Word must be at least {_settings.MinWordLength} letters long.";
                _selectedLetters.Clear();
                _isSelecting = false;
                StateHasChanged();
                _ = Task.Delay(3000).ContinueWith(_ => 
                {
                    _message = "";
                    InvokeAsync(StateHasChanged);
                });
                return;
            }

            if (_puzzleState.FoundWords.Any(fw => fw.Word == _currentWord))
            {
                _currentWordStatusClass = "word-status-already-found";
                _message = $"You already guessed '{_currentWord}'.";

                _ = Task.Delay(3000).ContinueWith(_ => 
                {
                    _message = "";
                    InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                var wordType = GameService.ValidateWord(_currentWord, _puzzleState);
                var foundWord = new FoundWord { Word = _currentWord, Type = wordType };
                _puzzleState.FoundWords.Add(foundWord);

                if (wordType == FoundWordType.SubWordInGrid)
                {
                    GameService.ShowWordInGrid(_currentWord, _puzzleState);
                    // Animate the newly found word and grid cells
                    AnimateNewWord(_currentWord);
                    // ? NEW: Animate grid cells when word is revealed
                    await TriggerGridWordReveal(_currentWord);
                }

                _currentWordStatusClass = wordType switch
                {
                    FoundWordType.SubWordInGrid => "word-status-in-grid",
                    FoundWordType.SubWordInLargeDictionary => "word-status-in-large-dict",
                    FoundWordType.SubWordNotInGrid => "word-status-in-small-dict",
                    FoundWordType.SubWordNotAWord => "word-status-not-found",
                    _ => ""
                };

                _message = wordType switch
                {
                    FoundWordType.SubWordInGrid => $"Great! You found '{_currentWord}'!",
                    FoundWordType.SubWordInLargeDictionary => $"'{_currentWord}' is a valid word (large dictionary)!",
                    FoundWordType.SubWordNotInGrid => $"'{_currentWord}' is a valid word but not in this puzzle.",
                    FoundWordType.SubWordNotAWord => $"'{_currentWord}' is not a valid word.",
                    _ => $"'{_currentWord}' was added to your list."
                };
            }

            _selectedLetters.Clear();
            _isSelecting = false;

            // Check for game completion and show enhanced congratulations
            if (_puzzleState?.IsComplete == true)
            {
                _displayTimer?.Dispose();
                _gameCompleted = true;
                await ShowCongratulations();
            }

            await SaveGameState();
            StateHasChanged();

            _ = Task.Delay(3000).ContinueWith(_ => 
            {
                _message = "";
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"SubmitWord error: {ex}");
            _message = "Error submitting word";
            StateHasChanged();
        }
    }

    // Animate newly added word
    private void AnimateNewWord(string word)
    {
        try
        {
            if (string.IsNullOrEmpty(word)) return;

            _recentlyAddedWords.Add(word);
            StateHasChanged();

            // Remove animation class after animation completes
            var timer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    _recentlyAddedWords.Remove(word);
                    if (_wordHighlightTimers.TryGetValue(word, out var existingTimer))
                    {
                        existingTimer.Dispose();
                        _wordHighlightTimers.Remove(word);
                    }
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    DebugHelper.LogError($"AnimateNewWord timer error: {ex}");
                }
            }, null, 3000, Timeout.Infinite);

            _wordHighlightTimers[word] = timer;
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"AnimateNewWord error: {ex}");
        }
    }

