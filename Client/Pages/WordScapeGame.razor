    private async Task<int> GetLetterIndexFromCoordinatesAsync(double clientX, double clientY)
    {
        try
        {
            // Use JavaScript interop to convert client coordinates to SVG coordinates
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return -1;

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];

            // Check each letter circle for hit detection - updated radius to 50
            for (int i = 0; i < _circleLetters.Count; i++)
            {
                var letter = _circleLetters[i];
                var distance = Math.Sqrt(Math.Pow(svgX - letter.X, 2) + Math.Pow(svgY - letter.Y, 2));
                if (distance <= 50) // Circle radius is now 50 (increased for bigger wheel)
                {
                    return i;
                }
            }
            return -1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in coordinate conversion: {ex.Message}");
            return -1;
        }
    }

