@page "/wordscape"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@inject WordScapeGameService GameService
@inject GameSettingsService SettingsService
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [AllowAnonymous]

<div class="wordscape-fixed-game">
        <style>
            .wordscape-fixed-game { padding: 20px; font-family: Arial, sans-serif; }
            .alert { padding: 15px; margin: 10px 0; border-radius: 5px; }
            .alert-info { background: #d1ecf1; border: 1px solid #bee5eb; color: #0c5460; }
            .btn { padding: 8px 16px; margin: 5px; border: none; border-radius: 3px; cursor: pointer; }
            .btn-primary { background: #007bff; color: white; }
            .game-grid { margin: 20px 0; }
            .grid-container { display: grid; gap: 1px; background: #ddd; padding: 10px; }
            .grid-cell { background: white; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border: 1px solid #ccc; }
            .revealed { background: #e8f5e8; }
            .hidden { background: #f5f5f5; }
        </style>

        @* Add debugging info while game loads *@
        @if (_puzzleState is null && !_isGenerating)
        {
            <div class="game-loading">
                <div class="alert alert-info">
                    <h4>?? WordScape Game Loading...</h4>
                    <p>Status: @(_debugInfo ?? "Initializing game...")</p>
                    <p>Settings loaded: @(_settings != null)</p>
                    <p>Service available: @(GameService != null)</p>
                    @if (!string.IsNullOrEmpty(_message))
                    {
                        <p>Message: @_message</p>
                    }
                    <button class="btn btn-primary" @onclick="ForceNewGame">Force Start Game</button>
                </div>
            </div>
        }

        @if (_puzzleState is not null)
        {
            <!-- Crossword Grid -->
            <div class="game-grid">
                @if (_isGenerating)
                {
                    <div class="generation-progress">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="progress-status">@_generationStatus</div>
                    </div>
                }
                else
                {
                    <div class="grid-container" 
                         style="grid-template-columns: repeat(@(_puzzleState?.LegacyGrid?.MaxX ?? 1), 28.8px); grid-template-rows: repeat(@(_puzzleState?.LegacyGrid?.MaxY ?? 1), 28.8px);">
                        @for (int y = 0; y < (_puzzleState?.LegacyGrid?.MaxY ?? 0); y++)
                        {
                            @for (int x = 0; x < (_puzzleState?.LegacyGrid?.MaxX ?? 0); x++)
                            {
                                var cell = _puzzleState?.LegacyGrid?.Cells?.FirstOrDefault(c => c.X == x && c.Y == y);
                                if (cell is not null && !cell.IsBlank)
                                {
                                    var localX = x;
                                    var localY = y;
                                    var isClicked = _clickedCell.HasValue && _clickedCell.Value.X == x && _clickedCell.Value.Y == y;
                                    var isHinting = _hintingCells.ContainsKey((x, y));
                                    <div class="grid-cell @(cell.IsRevealed ? "revealed" : "hidden") @(isClicked ? "clicked-highlight" : "") @(isHinting ? "hint-reveal" : "")" 
                                         style="grid-column: @(x + 1); grid-row: @(y + 1);"
                                         @onclick="@(() => OnGridCellClick(localX, localY))">
                                        @if (cell.IsRevealed || isHinting)
                                        {
                                            @cell.Letter.ToString().ToUpper()
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            </div>

            <!-- Current Word Display with buttons -->
            <div class="current-word-bar">
                <button class="settings-button" @onclick="ToggleSettings" disabled="@_isGenerating" title="Settings">
                    <span class="icon-fallback">&#9881;</span><span class="text-fallback">SET</span>
                </button>
                <div class="current-word-display @_currentWordStatusClass" 
                     @onclick="@(() => OnCurrentWordClick())"
                     title="@(string.IsNullOrEmpty(_currentWord) ? "Current word will appear here" : $"Click to look up '{_currentWord}' in dictionary")">
                    @_currentWord
                </div>
                <button class="newgame-button" @onclick="NewGame" disabled="@_isGenerating" title="New Game">
                    @if (_isGenerating)
                    {
                        <span class="spinner-border spinner-border-xs" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="icon-fallback">&#127918;</span><span class="text-fallback">NEW</span>
                    }
                </button>
            </div>

            <!-- Letter Wheel -->
            <div class="game-wheel">
                <div class="wheel-container">
                    <div class="corner corner-topleft">
                        <div class="corner-label">Score</div>
                        <div class="corner-value">@(_puzzleState?.Score ?? 0)</div>
                    </div>
                    <div class="corner corner-topright">
                        <div class="corner-label">Words</div>
                        <div class="corner-value">@(_puzzleState?.FoundWords.Count(fw => fw.Type == FoundWordType.SubWordInGrid) ?? 0)/@(_puzzleState?.PossibleWords.Count ?? 0)</div>
                    </div>
                    <div class="corner corner-bottomleft">
                        <div class="corner-label">Hints</div>
                        <div class="corner-value">@_hintCount</div>
                    </div>
                    <div class="corner corner-bottomright">
                        <div class="corner-label">Timer</div>
                        <div class="corner-value">@_timerDisplay</div>
                    </div>

                    <div class="letter-wheel" @ref="letterWheelElement">
                        <svg width="600" height="600" viewBox="0 0 600 600"
                             @onmousemove="@HandleMouseMove"
                             @onmousemove:preventDefault="true"
                             @onmouseup="@HandleSvgMouseUp"
                             @ontouchstart="@HandleTouchStart"
                             @ontouchstart:preventDefault="true"
                             @ontouchmove="@HandleTouchMove"
                             @ontouchmove:preventDefault="true"
                             @ontouchend="@HandleTouchEnd"
                             @ontouchend:preventDefault="true"
                             @oncontextmenu:preventDefault="true"
                             style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none;">
                        
                            <circle cx="300" cy="300" r="250" fill="none" stroke="#007bff" stroke-width="4" />
                       
                            @if (_selectedLetters.Any())
                            {
                                <polyline points="@GetPolylinePoints()" 
                                          fill="none" 
                                          stroke="#007bff" 
                                          stroke-width="3" />
                            }

                            @for (int i = 0; i < _circleLetters.Count; i++)
                            {
                                var letter = _circleLetters[i];
                                var isSelected = _selectedLetters.Contains(i);
                                var index = i;
                                
                                <g class="letter-container @(isSelected ? "selected" : "")"
                                   data-letter-index="@index"
                                   @onmousedown="@(() => StartSelection(index))"
                                   @onmouseover="@(() => ContinueSelection(index))"
                                   @onmouseup="@(() => EndSelection())"
                                   @ontouchstart="@((e) => HandleLetterTouchStart(e, index))"
                                   @ontouchstart:preventDefault="true"
                                   @oncontextmenu:preventDefault="true"
                                   style="touch-action: none; cursor: pointer; -webkit-touch-callout: none; -webkit-user-select: none;">
                                
                                    <circle cx="@letter.X" 
                                            cy="@letter.Y" 
                                            r="54" 
                                            fill="@(isSelected ? "#007bff" : "#f8f9fa")" 
                                            stroke="#007bff" 
                                            stroke-width="@(isSelected ? 4 : 3)" />
                                
                                    <text x="@letter.X" 
                                          y="@(letter.Y + 14)" 
                                          text-anchor="middle" 
                                          font-family="Arial, sans-serif" 
                                          font-size="46" 
                                          font-weight="bold" 
                                          fill="@(isSelected ? "white" : "black")"
                                          pointer-events="none"
                                          style="-webkit-touch-callout: none; -webkit-user-select: none; user-select: none;">
                                        @letter.Letter
                                    </text>
                                </g>
                            }
                        </svg>
                        <button class="center-shuffle-button" @onclick="ShuffleCircleLetters" disabled="@_isGenerating" title="Shuffle">
                            <span class="icon-fallback">&#128256;</span><span class="text-fallback">MIX</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Message -->
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="game-message">@_message</div>
            }

            <!-- Found Words List -->
            <div class="found-words-section">
                @if (_puzzleState?.IsComplete == true)
                {
                    <div class="alert alert-success">
                        <h3>Congratulations!</h3>
                        <p>You found all @(_puzzleState?.PossibleWords?.Count ?? 0) words!</p>
                        <p>Final Score: @(_puzzleState?.Score ?? 0)</p>
                        <p>Hints Used: @_hintCount</p>
                        <p>Time Taken: @_timerDisplay</p>
                    </div>
                }

                <h4>Found Words (@(_puzzleState?.FoundWords.Count(fw => fw.Type == FoundWordType.SubWordInGrid) ?? 0)/@(_puzzleState?.PossibleWords.Count ?? 0))</h4>
                <div class="words-list multi-column">
                    @foreach (var foundWord in _puzzleState?.FoundWords?.OrderBy(fw => fw.Word) ?? Enumerable.Empty<FoundWord>())
                    {
                        <div class="found-word @GetWordCssClass(foundWord.Type)" 
                             @onclick="@(() => OpenDictionaryDefinition(foundWord.Word))"
                             title="Click to look up definition">
                            @foundWord.Word
                        </div>
                    }
                </div>
            </div>

            <!-- Settings panel -->
            @if (_showSettings)
            {
                <div class="settings-overlay">
                    <div class="settings-panel">
                        <h3>Settings</h3>
                        <div class="form-group">
                            <label for="minLength">Min Word Length:</label>
                            <input id="minLength" type="number" @bind="_settings.MinWordLength" min="3" max="8" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="maxLength">Max Word Length:</label>
                            <input id="maxLength" type="number" @bind="_settings.MaxWordLength" min="4" max="10" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="gridSize">Grid Size (auto-calculated):</label>
                            <input id="gridSize" type="text" value="@(_settings.GridWidth)x@(_settings.GridHeight) (max 18x18)" readonly class="form-control" title="Grid size is automatically calculated based on your device screen width. Android devices can use wider grids." />
                        </div>
                        
                        <div class="debug-controls">
                            <h4>Debug Options</h4>
                            <div class="checkbox-group">
                                <input type="checkbox" id="debugMode" @bind="_settings.IsDebugEnabled" @bind:after="OnDebugModeChanged" />
                                <label for="debugMode">Enable Debug Mode (fixed random seed for consistent results)</label>
                            </div>
                        </div>
                        
                        <button class="btn btn-success" @onclick="SaveSettings">Save Settings</button>
                        <button class="btn btn-secondary" @onclick="ToggleSettings">Cancel</button>
                    </div>
                </div>
            }
        }
    </div>

@code {
    private PuzzleState? _puzzleState;
    private GameSettings _settings = new();
    private bool _showSettings = false;
    private string _message = "";
    private string _currentWord = "";
    private string _currentWordStatusClass = "";
    private int _hintCount = 0;

    private DateTime _gameStartTime;
    private string _timerDisplay = "0:00";
    private System.Threading.Timer? _displayTimer;
    private bool _gameCompleted = false;

    private List<CircleLetter> _circleLetters = new();
    private List<int> _selectedLetters = new();
    private bool _isSelecting = false;
    
    private Dictionary<(int X, int Y), System.Threading.Timer> _hintingCells = new();
    
    private (int X, int Y)? _clickedCell = null;
    private System.Threading.Timer? _clickHighlightTimer;
    private ElementReference letterWheelElement;
    private bool _isGenerating = false;
    private string _generationStatus = "";

    private Task<PuzzleState?>? _taskGenNextPuzzle = null;
    private CancellationTokenSource? _cancellationTokenSource = null;

    private const string GAME_STATE_KEY = "wordscape_game_state";

    private string? _debugInfo = null;

    // Helper class for JavaScript interop
    public class GridSize
    {
        public int width { get; set; } = 15;
        public int height { get; set; } = 15;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("?? WordScapeGame: OnInitializedAsync started");
            
            _debugInfo = "Loading settings...";
            StateHasChanged();
            
            if (SettingsService == null)
            {
                _debugInfo = "? SettingsService is null!";
                Console.WriteLine("? SettingsService is null!");
                StateHasChanged();
                return;
            }
            
            _settings = await SettingsService.LoadSettingsAsync();
            Console.WriteLine($"?? Settings loaded: MinLength={_settings?.MinWordLength}, MaxLength={_settings?.MaxWordLength}");
            
            if (_settings.MaxWordLength > 11) {
                _settings.MaxWordLength = 11;
            }
            
            _debugInfo = "Restoring game state...";
            StateHasChanged();
            
            await RestoreGameState();
            
            _debugInfo = "Checking GameService...";
            StateHasChanged();
            
            if (GameService == null)
            {
                _debugInfo = "? GameService is null!";
                Console.WriteLine("? GameService is null!");
                StateHasChanged();
                return;
            }
            
            _debugInfo = "Starting new game...";
            StateHasChanged();
            
            Console.WriteLine($"?? Puzzle state is null: {_puzzleState == null}");
            
            if (_puzzleState == null)
            {
                Console.WriteLine("?? Starting new game...");
                await NewGame();
            }
            else
            {
                Console.WriteLine("?? Using existing puzzle state");
                StateHasChanged();
            }
            
            Console.WriteLine("? WordScapeGame: OnInitializedAsync completed successfully");
        }
        catch (Exception ex)
        {
            _debugInfo = $"? Error in initialization: {ex.Message}";
            _message = $"Initialization error: {ex.Message}";
            Console.WriteLine($"? WordScapeGame initialization error: {ex}");
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        
        // ADDED: Apply Android grid positioning fix after render
        if (firstRender || _puzzleState != null)
        {
            try
            {
                await Task.Delay(200); // Allow DOM to settle
                await JSRuntime.InvokeVoidAsync("fixAndroidGridPosition");
                await JSRuntime.InvokeVoidAsync("makeGridEdgeToEdgeAndroid");
                await JSRuntime.InvokeVoidAsync("forceAndroidFullWidth");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"?? Android positioning fix in OnAfterRenderAsync failed: {ex.Message}");
            }
        }
    }

    private async Task ForceNewGame()
    {
        try
        {
            _debugInfo = "Force starting new game...";
            StateHasChanged();
            
            _puzzleState = null;
            await NewGame();
        }
        catch (Exception ex)
        {
            _debugInfo = $"Force game error: {ex.Message}";
            _message = $"Force game error: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task NewGame()
    {
        try
        {
            Console.WriteLine("?? NewGame: Starting...");
            
            _hintCount = 0;
            foreach (var timer in _hintingCells.Values) timer?.Dispose();
            _hintingCells.Clear();
            await ClearGameState();

            _isGenerating = true;
            _generationStatus = "Calculating optimal grid size...";
            StateHasChanged();

            Console.WriteLine("?? Calculating optimal grid size...");
            
            // FIXED: Use typed JavaScript interop for more reliable results
            int gridWidth = 15, gridHeight = 15; // Default values
            
            try
            {
                var optimalGridSize = await JSRuntime.InvokeAsync<GridSize>("calculateOptimalGridSize");
                
                if (optimalGridSize != null)
                {
                    gridWidth = Math.Min(18, Math.Max(8, optimalGridSize.width));
                    gridHeight = Math.Min(18, Math.Max(8, optimalGridSize.height));
                    Console.WriteLine($"?? Optimal grid size: {gridWidth}x{gridHeight}");
                }
                else
                {
                    Console.WriteLine("?? No grid size returned from JS, using defaults");
                }
            }
            catch (Exception jsEx)
            {
                Console.WriteLine($"?? Error calculating grid size, using defaults: {jsEx.Message}");
                // Use defaults: gridWidth = 15, gridHeight = 15
            }
            
            // Update settings with calculated grid size
            _settings.GridWidth = gridWidth;
            _settings.GridHeight = gridHeight;
            
            _generationStatus = $"Generating {_settings.GridWidth}x{_settings.GridHeight} puzzle...";
            StateHasChanged();
            
            Console.WriteLine($"?? Calling GameService.GeneratePuzzleAsync...");
            _puzzleState = await GameService.GeneratePuzzleAsync(_settings);
            Console.WriteLine($"?? Puzzle generation completed. Puzzle is null: {_puzzleState == null}");
            
            if (_puzzleState is not null)
            {
                Console.WriteLine($"? Puzzle created! Target: {_puzzleState.TargetWord}, Words: {_puzzleState.PossibleWords?.Count ?? 0}");
                
                CreateCircleLetters();
                StartGameTimer();
                StartBackgroundPuzzleGeneration();
                _message = $"New {_settings.GridWidth}x{_settings.GridHeight} puzzle created! Target: {_puzzleState.TargetWord}, Words to find: {_puzzleState.PossibleWords.Count}";
                await SaveGameState();
                
                // ADDED: Apply Android grid positioning fix after puzzle is created
                try
                {
                    await Task.Delay(500); // Allow DOM to update
                    await JSRuntime.InvokeVoidAsync("fixAndroidGridPosition");
                    await JSRuntime.InvokeVoidAsync("makeGridEdgeToEdgeAndroid");
                    await JSRuntime.InvokeVoidAsync("forceAndroidFullWidth");
                }
                catch (Exception posEx)
                {
                    Console.WriteLine($"?? Android positioning fix failed: {posEx.Message}");
                }
                
                Console.WriteLine("?? Game setup completed successfully");
            }
            else
            {
                _message = "Failed to generate puzzle";
                Console.WriteLine("? Failed to generate puzzle");
            }
        }
        catch (Exception ex)
        {
            _message = $"Error generating puzzle: {ex.Message}";
            Console.WriteLine($"? NewGame error: {ex}")
;        }
        finally
        {
            _isGenerating = false;
            _generationStatus = "";
            StateHasChanged();
            Console.WriteLine("?? NewGame: Finally block completed");
        }
    }

    private void CreateCircleLetters()
    {
        if (_puzzleState is null) return;

        _circleLetters.Clear();
        var letters = _puzzleState.CircleLetters;
        var radius = 250.0;
        var centerX = 300.0;
        var centerY = 300.0;

        for (int i = 0; i < letters.Count; i++)
        {
            var angle = (2 * Math.PI * i) / letters.Count - (Math.PI / 2);
            var x = centerX + radius * Math.Cos(angle);
            var y = centerY + radius * Math.Sin(angle);

            _circleLetters.Add(new CircleLetter
            {
                Letter = letters[i],
                X = x,
                Y = y,
                Index = i
            });
        }
    }

    private void StartGameTimer()
    {
        _gameStartTime = DateTime.Now;
        _gameCompleted = false;
        _timerDisplay = "0:00";
        _displayTimer?.Dispose();
        _displayTimer = new System.Threading.Timer(UpdateTimerDisplay, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async void UpdateTimerDisplay(object? state)
    {
        if (_gameCompleted) return;
        var elapsed = DateTime.Now - _gameStartTime;
        _timerDisplay = $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}";
        await InvokeAsync(StateHasChanged);
    }

    private string GetPolylinePoints()
    {
        if (!_selectedLetters.Any()) return "";
        var points = _selectedLetters.Select(i => $"{_circleLetters[i].X},{_circleLetters[i].Y}");
        return string.Join(" ", points);
    }

    private void StartBackgroundPuzzleGeneration()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
    }

    private void HandleTouchStart(TouchEventArgs e) { }

    private async void HandleTouchMove(TouchEventArgs e)
    {
        if (!_isSelecting) return;

        if (e.ChangedTouches.Length > 0)
        {
            var touch = e.ChangedTouches[0];
            var hitIndex = await GetLetterIndexFromCoordinatesAsync(touch.ClientX, touch.ClientY);
            if (hitIndex >= 0)
            {
                await ContinueSelection(hitIndex);
            }
            else
            {
                var isOutsideWheel = await IsOutsideLetterWheelAsync(touch.ClientX, touch.ClientY);
                if (isOutsideWheel)
                {
                    await EndSelection(abortSelection: true);
                }
            }
        }
    }

    private async void HandleTouchEnd(TouchEventArgs e)
    {
        if (_isSelecting)
        {
            await EndSelection();
        }
    }

    private async void HandleLetterTouchStart(TouchEventArgs e, int index)
    {
        await StartSelection(index);
    }

    private async void HandleMouseMove(MouseEventArgs e)
    {
        if (!_isSelecting) return;

        var hitIndex = await GetLetterIndexFromCoordinatesAsync(e.ClientX, e.ClientY);
        if (hitIndex >= 0)
        {
            await ContinueSelection(hitIndex);
        }
        else if (_isSelecting && _selectedLetters.Any())
        {
            var isOutsideWheel = await IsOutsideLetterWheelAsync(e.ClientX, e.ClientY);
            if (isOutsideWheel)
            {
                await EndSelection(abortSelection: true);
            }
        }
    }

    private async void HandleSvgMouseUp(MouseEventArgs e)
    {
        if (!_isSelecting) return;

        var hitIndex = await GetLetterIndexFromCoordinatesAsync(e.ClientX, e.ClientY);
        if (hitIndex < 0 && _selectedLetters.Any())
        {
            await EndSelection();
        }
    }

    private async Task StartSelection(int index)
    {
        ClearSelection();
        _currentWordStatusClass = "";
        _selectedLetters.Add(index);
        _isSelecting = true;
        UpdateCurrentWord();
        StateHasChanged();
    }

    private async Task ContinueSelection(int index)
    {
        if (!_isSelecting) return;

        if (_selectedLetters.Count >= 2 && _selectedLetters[_selectedLetters.Count - 2] == index)
        {
            _selectedLetters.RemoveAt(_selectedLetters.Count - 1);
            UpdateCurrentWord();
            StateHasChanged();
            return;
        }

        if (!_selectedLetters.Contains(index))
        {
            _selectedLetters.Add(index);
            UpdateCurrentWord();
            StateHasChanged();
        }
    }

    private async Task EndSelection(bool abortSelection = false)
    {
        _isSelecting = false;
        if (abortSelection)
        {
            ClearSelection();
        }

        if (!string.IsNullOrEmpty(_currentWord))
        {
            if (_currentWord.Length >= _settings.MinWordLength) {
                await SubmitWord();
            } else
            {
                ClearSelection();
            }
        }
        StateHasChanged();
    }

    private void UpdateCurrentWord()
    {
        _currentWord = string.Join("", _selectedLetters.Select(i => _circleLetters[i].Letter));
    }

    private void ClearSelection()
    {
        _selectedLetters.Clear();
        _currentWord = "";
        _isSelecting = false;
    }

    private async Task<int> GetLetterIndexFromCoordinatesAsync(double clientX, double clientY)
    {
        try
        {
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return -1;

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];

            for (int i = 0; i < _circleLetters.Count; i++)
            {
                var letter = _circleLetters[i];
                var distance = Math.Sqrt(Math.Pow(svgX - letter.X, 2) + Math.Pow(svgY - letter.Y, 2));
                if (distance <= 54)
                {
                    return i;
                }
            }
            return -1;
        }
        catch (Exception ex)
        {
            return -1;
        }
    }

    private async Task<bool> IsOutsideLetterWheelAsync(double clientX, double clientY)
    {
        try
        {
            var svgCoords = await JSRuntime.InvokeAsync<double[]>("convertClientToSVGCoordinates", letterWheelElement, clientX, clientY);
            if (svgCoords is null || svgCoords.Length < 2) return true;

            var svgX = svgCoords[0];
            var svgY = svgCoords[1];

            var centerX = 300.0;
            var centerY = 300.0;
            var wheelRadius = 250 + 70;
            var distanceFromCenter = Math.Sqrt(Math.Pow(svgX - centerX, 2) + Math.Pow(svgY - centerY, 2));

            return distanceFromCenter > wheelRadius;
        }
        catch (Exception ex)
        {
            return true;
        }
    }

    private async Task SubmitWord()
    {
        if (string.IsNullOrEmpty(_currentWord) || _puzzleState is null) return;

        if (_currentWord.Length < _settings.MinWordLength)
        {
            _currentWordStatusClass = "word-status-too-short";
            _message = $"Word must be at least {_settings.MinWordLength} letters long.";
            _selectedLetters.Clear();
            _isSelecting = false;
            StateHasChanged();
            _ = Task.Delay(3000).ContinueWith(_ => 
            {
                _message = "";
                InvokeAsync(StateHasChanged);
            });
            return;
        }

        if (_puzzleState.FoundWords.Any(fw => fw.Word == _currentWord))
        {
            _currentWordStatusClass = "word-status-already-found";
            _message = $"You already guessed '{_currentWord}'.";
        }
        else
        {
            var wordType = GameService.ValidateWord(_currentWord, _puzzleState);
            var foundWord = new FoundWord { Word = _currentWord, Type = wordType };
            _puzzleState.FoundWords.Add(foundWord);

            if (wordType == FoundWordType.SubWordInGrid)
            {
                GameService.ShowWordInGrid(_currentWord, _puzzleState);
            }

            _currentWordStatusClass = wordType switch
            {
                FoundWordType.SubWordInGrid => "word-status-in-grid",
                FoundWordType.SubWordInLargeDictionary => "word-status-in-large-dict",
                FoundWordType.SubWordNotInGrid => "word-status-in-small-dict",
                FoundWordType.SubWordNotAWord => "word-status-not-found",
                _ => ""
            };

            _message = wordType switch
            {
                FoundWordType.SubWordInGrid => $"Great! You found '{_currentWord}'!",
                FoundWordType.SubWordInLargeDictionary => $"'{_currentWord}' is a valid word (large dictionary)!",
                FoundWordType.SubWordNotInGrid => $"'{_currentWord}' is a valid word but not in this puzzle.",
                FoundWordType.SubWordNotAWord => $"'{_currentWord}' is not a valid word.",
                _ => $"'{_currentWord}' was added to your list."
            };
        }

        _selectedLetters.Clear();
        _isSelecting = false;

        if (_puzzleState?.IsComplete == true)
        {
            _displayTimer?.Dispose();
            _gameCompleted = true;
        }

        await SaveGameState();
        StateHasChanged();

        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task SaveGameState()
    {
        try
        {
            var gameStateJson = System.Text.Json.JsonSerializer.Serialize(new
            {
                HintCount = _hintCount,
                GameStartTime = _gameStartTime,
                GameCompleted = _gameCompleted,
                CurrentWord = _currentWord,
                Message = _message
            });
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", GAME_STATE_KEY, gameStateJson);
        }
        catch (Exception ex)
        {
            // Silent error handling
        }
    }

    private async Task RestoreGameState()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", GAME_STATE_KEY);
        }
        catch (Exception ex)
        {
            // Silent error handling
        }
    }

    private async Task ClearGameState()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", GAME_STATE_KEY);
        }
        catch (Exception ex)
        {
            // Silent error handling
        }
    }

    private async void OnGridCellClick(int x, int y)
    {
        _clickedCell = (x, y);
        _clickHighlightTimer?.Dispose();
        _clickHighlightTimer = new System.Threading.Timer(async _ =>
        {
            _clickedCell = null;
            await InvokeAsync(StateHasChanged);
        }, null, 300, Timeout.Infinite);

        if (_puzzleState is null) 
        {
            _message = "? Puzzle state is null";
            StateHasChanged();
            return;
        }

        var cell = _puzzleState.LegacyGrid?.Cells?.FirstOrDefault(c => c.X == x && c.Y == y);
        if (cell is not null && !cell.IsBlank && !cell.IsRevealed)
        {
            var cellKey = (x, y);
            
            if (_hintingCells.ContainsKey(cellKey))
            {
                _message = $"Letter at ({x}, {y}) is already being shown as a hint";
                StateHasChanged();
                return;
            }

            _hintCount++;
            _message = $"Hint #{_hintCount}: Revealing letter '{cell.Letter.ToString().ToUpper()}' at ({x}, {y})";

            var hintTimer = new System.Threading.Timer(async _ =>
            {
                bool isPartOfFoundWord = false;
                foreach (var foundWord in _puzzleState.FoundWords.Where(fw => fw.Type == FoundWordType.SubWordInGrid))
                {
                    if (_puzzleState.Grid is not null && _puzzleState.Grid._dictPlacedWords.TryGetValue(foundWord.Word, out var placement))
                    {
                        for (int i = 0; i < foundWord.Word.Length; i++)
                        {
                            int wordX = placement.IsHoriz ? placement.nX + i : placement.nX;
                            int wordY = placement.IsHoriz ? placement.nY : placement.nY + i;

                            if (wordX == x && wordY == y)
                            {
                                isPartOfFoundWord = true;
                                break;
                            }
                        }
                    }
                    if (isPartOfFoundWord) break;
                }
                
                if (_hintingCells.ContainsKey(cellKey))
                {
                    _hintingCells[cellKey]?.Dispose();
                    _hintingCells.Remove(cellKey);
                }

                if (isPartOfFoundWord)
                {
                    cell.IsRevealed = true;
                }
                
                await InvokeAsync(StateHasChanged);
                
            }, null, 2000, Timeout.Infinite);

            _hintingCells[cellKey] = hintTimer;
            await SaveGameState();
            StateHasChanged();
        }
        else if (cell is not null && cell.IsRevealed)
        {
            _message = $"Letter '{cell.Letter.ToString().ToUpper()}' is already revealed at ({x}, {y})";
            StateHasChanged();
        }
        else
        {
            _message = $"No letter to reveal at ({x}, {y})";
            StateHasChanged();
        }
        
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            if (_message.Contains($"at ({x}, {y})"))
                _message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task OnCurrentWordClick()
    {
        if (!string.IsNullOrEmpty(_currentWord) && _currentWord.Length >= 3)
        {
            await OpenDictionaryDefinition(_currentWord);
        }
