    private Task StartSelection(int index)
    {
        try
        {
            // FIXED: Prevent word selection when game is complete
            if (_puzzleState?.IsComplete == true)
            {
                return Task.CompletedTask;
            }

            ClearSelection();
            _currentWordStatusClass = "";
            _selectedLetters.Add(index);
            _isSelecting = true;
            UpdateCurrentWord();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"StartSelection error: {ex.Message}");
        }
        return Task.CompletedTask;
    }

    private Task ContinueSelection(int index)
    {
        if (!_isSelecting) return Task.CompletedTask;
        
        // FIXED: Prevent continuing selection when game is complete
        if (_puzzleState?.IsComplete == true)
        {
            return Task.CompletedTask;
        }

        try
        {
            if (_selectedLetters.Count >= 2 && _selectedLetters[_selectedLetters.Count - 2] == index)
            {
                _selectedLetters.RemoveAt(_selectedLetters.Count - 1);
                UpdateCurrentWord();
                StateHasChanged();
                return Task.CompletedTask;
            }

            if (!_selectedLetters.Contains(index))
            {
                _selectedLetters.Add(index);
                UpdateCurrentWord();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"ContinueSelection error: {ex.Message}");
        }
        return Task.CompletedTask;
    }

    private async Task EndSelection(bool abortSelection = false)
    {
        try
        {
            _isSelecting = false;
            if (abortSelection)
            {
                ClearSelection();
            }

            // FIXED: Prevent word submission when game is complete
            if (_puzzleState?.IsComplete == true)
            {
                ClearSelection();
                StateHasChanged();
                return;
            }

            if (!string.IsNullOrEmpty(_currentWord))
            {
                if (_currentWord.Length >= _settings.MinWordLength) {
                    await SubmitWord();
                } else
                {
                    ClearSelection();
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"EndSelection error: {ex.Message}");
        }
    }

    private void UpdateCurrentWord()
    {
