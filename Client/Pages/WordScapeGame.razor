    private List<GridCellState> GetRevealedCellStates()
    {
        var cellStates = new List<GridCellState>();
        
        if (_puzzleState?.LegacyGrid?.Cells != null)
        {
            foreach (var cell in _puzzleState.LegacyGrid.Cells)
            {
                cellStates.Add(new GridCellState
                {
                    X = cell.X,
                    Y = cell.Y,
                    Letter = cell.Letter,
                    IsRevealed = cell.IsRevealed,
                    IsBlank = cell.IsBlank
                });
            }
        }

        return cellStates;
    }
