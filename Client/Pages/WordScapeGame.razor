    {
        _showSettings = !_showSettings;
    }

    private void OnDebugModeChanged()
    {
        var isEnabled = _settings.IsDebugEnabled;
        DebugHelper.SetDebugMode(isEnabled);
        
        if (isEnabled)
        {
            _message = "Debug mode enabled - check browser console for debug logs and CSS regions";
        }
        else
        {
            _message = "Debug mode disabled - CSS regions hidden";
        }
        
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _message = "";
            InvokeAsync(StateHasChanged);
        });
        
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        if (_settings.MinWordLength >= _settings.MaxWordLength)
        {
            _settings.MinWordLength = _settings.MaxWordLength - 1;
        }

        if (_settings.MinWordLength < 3) _settings.MinWordLength = 3;
        if (_settings.MaxWordLength > 10) _settings.MaxWordLength = 10;

        await SettingsService.SaveSettingsAsync(_settings);
        _showSettings = false;

        _cancellationTokenSource?.Cancel();
        _taskGenNextPuzzle = null;

        if (_puzzleState is not null)
        {
            StartBackgroundPuzzleGeneration();
        }

        _message = "Settings saved! New games will use the updated settings.";

        await Task.Delay(1000);
        await NewGame();

        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _message = "";
            InvokeAsync(StateHasChanged);
        });

        StateHasChanged();
    }

    private async void ShuffleCircleLetters()
    {
        if (_puzzleState is null || _circleLetters.Count == 0) return;

        _selectedLetters.Clear();
        _currentWord = "";
        _currentWordStatusClass = "";
        _message = "";

        var shuffledLetters = _puzzleState.CircleLetters.ToList();

        var random = new Random();
        for (int i = shuffledLetters.Count - 1; i > 0; i--)
        {
            int j = random.Next(i + 1);
            (shuffledLetters[i], shuffledLetters[j]) = (shuffledLetters[j], shuffledLetters[i]);
        }

        _puzzleState.CircleLetters = shuffledLetters;
        CreateCircleLetters();

        Console.WriteLine($"?? Shuffled circle letters: {string.Join("", shuffledLetters)}");

        await SaveGameState();
        StateHasChanged();
    }

    public void Dispose()
    {
        foreach (var timer in _hintingCells.Values) timer?.Dispose();
        _hintingCells.Clear();
        _clickHighlightTimer?.Dispose();
        _displayTimer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}