@page "/bounce"
@using Microsoft.AspNetCore.Authorization
@using BlazorWasm.Services
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@inject RandomService RandomService
@inject CssLoaderService CssLoader
@inject Client.Services.ApplicationInsightsLogger AppInsights
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Bounce - Physics Simulation</PageTitle>

<div class="bounce-container">
	<!-- Top Controls -->
	<div class="bounce-controls-top">
		<div class="bounce-stats">
			<label>Balls: @_balls.Count</label>
			<label>FPS: @_fps</label>
		</div>

		<div class="bounce-settings">
			<label title="Number of balls">
				<span>Count:</span>
				<input type="range" min="1" max="100" step="1"
					   @bind="_ballCount" @bind:event="oninput" style="width: 100px;" />
				<span class="val">@_ballCount</span>
			</label>

			<label title="Ball size">
				<span>Size:</span>
				<input type="range" min="5" max="50" step="1"
					   @bind="_ballSize" @bind:event="oninput" style="width: 100px;" />
				<span class="val">@_ballSize</span>
			</label>
		</div>

		<div class="bounce-action-buttons">
			<button @onclick="ApplyBallCount" class="btn-sm" title="Apply new count">Apply Count</button>
			<button @onclick="TogglePause" class="btn-sm" title="Pause/Resume">@(_isPaused ? "▶️ Resume" : "⏸️ Pause")</button>
			<button @onclick="Reset" class="btn-sm" title="Reset simulation">🔄 Reset</button>
			<button @onclick="RandomizeVelocities" class="btn-sm" title="Give balls random velocities">🎲 Random</button>
		</div>
	</div>

	<!-- Canvas Area -->
	<div class="bounce-canvas-section">
		<canvas id="bounceCanvas" class="bounce-canvas"
				@onclick="OnCanvasClick">
		</canvas>
	</div>

	<!-- Bottom Controls -->
	<div class="bounce-controls-bottom">
		<label title="Gravity">
			<span>Gravity:</span>
			<input type="range" min="0" max="2" step="0.1"
				   @bind="_gravity" @bind:event="oninput" style="width: 100px;" />
			<span class="val">@_gravity.ToString("F1")</span>
		</label>

		<label title="Elasticity (bounce factor)">
			<span>Bounce:</span>
			<input type="range" min="0" max="1" step="0.05"
				   @bind="_elasticity" @bind:event="oninput" style="width: 100px;" />
			<span class="val">@_elasticity.ToString("F2")</span>
		</label>

		<label title="Air resistance">
			<span>Drag:</span>
			<input type="range" min="0.9" max="1.0" step="0.01"
				   @bind="_airResistance" @bind:event="oninput" style="width: 100px;" />
			<span class="val">@_airResistance.ToString("F2")</span>
		</label>
	</div>
</div>

@code {
	// Vector struct for cleaner physics calculations
	private record struct Vector2D(double X, double Y)
	{
		public static Vector2D operator +(Vector2D a, Vector2D b) => new(a.X + b.X, a.Y + b.Y);
		public static Vector2D operator -(Vector2D a, Vector2D b) => new(a.X - b.X, a.Y - b.Y);
		public static Vector2D operator *(Vector2D v, double scalar) => new(v.X * scalar, v.Y * scalar);
		public static Vector2D operator /(Vector2D v, double scalar) => new(v.X / scalar, v.Y / scalar);
		public static Vector2D operator -(Vector2D v) => new(-v.X, -v.Y);

		public double Length => Math.Sqrt(X * X + Y * Y);
		public Vector2D Normalized => Length > 0 ? this / Length : this;
		public double Dot(Vector2D other) => X * other.X + Y * other.Y;
	}

	//Helper class for JavaScript interop with explicit properties
	private class BallJsData
	{
		public double x { get; set; }
		public double y { get; set; }
		public double vx { get; set; }
		public double vy { get; set; }
		public double radius { get; set; }
		public string color { get; set; } = "";
	}

	// Ball using Vector2D for position and velocity
	private record struct Ball(Vector2D Position, Vector2D Velocity, double Radius, string Color)
	{
		// Helper method for JavaScript interop - returns properly serializable class
		public BallJsData ToJsFormat() => new BallJsData
		{
			x = Position.X,
			y = Position.Y,
			vx = Velocity.X,
			vy = Velocity.Y,
			radius = Radius,
			color = Color
		};
	}

	private List<Ball> _balls = new();
	private int _ballCount = 50;
	private double _ballSize = 10;
	private double _gravity = 0.0;
	private double _elasticity = 1.0;
	private double _airResistance = 1.0;
	private bool _isPaused = false;
	private bool _isInitialized = false;
	private System.Threading.Timer? _animationTimer;
	private Random _random = null!; // Will be initialized from RandomService
	private DateTime _lastFrameTime = DateTime.Now;
	private int _fps = 0;
	private int _frameCount = 0;
	private DateTime _lastFpsUpdate = DateTime.Now;

	private double _canvasWidth = 1200;
	private double _canvasHeight = 800;
	private DotNetObjectReference<Bounce>? _dotNetRef;

	// NEW: Called by JavaScript when canvas resizes
	[JSInvokable]
	public async Task OnCanvasResized(double width, double height)
	{
		DebugHelper.Log($"[Bounce] Canvas resized to {width}x{height}", true);
		
		_canvasWidth = width;
		_canvasHeight = height;
		
		// Update ball positions if they're outside new bounds
		var updatedBalls = new List<Ball>();
		foreach (var ball in _balls)
		{
			var x = Math.Clamp(ball.Position.X, ball.Radius, _canvasWidth - ball.Radius);
			var y = Math.Clamp(ball.Position.Y, ball.Radius, _canvasHeight - ball.Radius);
			
			updatedBalls.Add(new Ball(
				new Vector2D(x, y),
				ball.Velocity,
				ball.Radius,
				ball.Color
			));
		}
		_balls = updatedBalls;
		
		await InvokeAsync(StateHasChanged);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// Load CSS on demand
			await CssLoader.LoadCssAsync(GameCss.Bounce.Path, GameCss.Bounce.Version);
			_ = AppInsights.TrackPageActivationAsync("Bounce");

			DebugHelper.Log("[Bounce] OnAfterRenderAsync - First render starting", true);

			// Initialize random from centralized service (respects debug mode)
			_random = RandomService.GetRandom();
			DebugHelper.Log($"[Bounce] {RandomService.GetStateDescription()}", true);

			// Create DotNet reference for JS callbacks
			_dotNetRef = DotNetObjectReference.Create(this);

			await JSRuntime.InvokeVoidAsync("initBounceCanvas", "bounceCanvas");
			_isInitialized = true;

			DebugHelper.Log("[Bounce] Canvas initialized, setting up resize listener", true);

			// Set the component reference using dedicated helper function
			await JSRuntime.InvokeVoidAsync("setBounceComponentRef", _dotNetRef);

			// Set up resize listener
			await JSRuntime.InvokeVoidAsync("setupBounceResize");

			// Get initial canvas dimensions
			var dimensions = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("getBounceCanvasDimensions");
			_canvasWidth = dimensions.GetProperty("width").GetDouble();
			_canvasHeight = dimensions.GetProperty("height").GetDouble();

			DebugHelper.Log($"[Bounce] Canvas dimensions: {_canvasWidth}x{_canvasHeight}", true);

			// Initialize balls
			InitializeBalls();

			// Start animation
			StartAnimation();

			DebugHelper.Log("[Bounce] Initialization complete", true);

			StateHasChanged();
		}
	}

	private void InitializeBalls()
	{
		_balls.Clear();

		for (int i = 0; i < _ballCount; i++)
		{
			var position = new Vector2D(
				_random.NextDouble() * (_canvasWidth - _ballSize * 2) + _ballSize,
				_random.NextDouble() * (_canvasHeight / 2) // Start in top half
			);
			
			var velocity = new Vector2D(
				(_random.NextDouble() - 0.5) * 10, // Random horizontal velocity
				_random.NextDouble() * 5 // Random downward velocity
			);
			
			var color = GetRandomColor();

			_balls.Add(new Ball(position, velocity, _ballSize, color));
		}

		DebugHelper.Log($"[Bounce] Initialized {_ballCount} balls", true);
	}

	private string GetRandomColor()
	{
		var colors = new[]
		{
			"#FF0000", "#00FF00", "#0000FF", "#FFFF00", "#FF00FF", "#00FFFF",
			"#FFA500", "#800080", "#FFC0CB", "#A52A2A", "#87CEEB", "#90EE90"
		};
		return colors[_random.Next(colors.Length)];
	}

	private void StartAnimation()
	{
		_animationTimer?.Dispose();
		_lastFrameTime = DateTime.Now;

		_animationTimer = new System.Threading.Timer(async _ =>
		{
			if (!_isPaused && _isInitialized)
			{
				var now = DateTime.Now;
				var deltaTime = (now - _lastFrameTime).TotalSeconds;
				_lastFrameTime = now;

				// Limit delta time to prevent large jumps
				if (deltaTime > 0.1) deltaTime = 0.1;

				UpdatePhysics(deltaTime);
				await RenderFrame();

				// Update FPS
				_frameCount++;
				if ((now - _lastFpsUpdate).TotalSeconds >= 1.0)
				{
					_fps = _frameCount;
					_frameCount = 0;
					_lastFpsUpdate = now;
					await InvokeAsync(StateHasChanged);
				}
			}
		}, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(16)); // ~60 FPS
	}

	private void UpdatePhysics(double deltaTime)
	{
		var updatedBalls = new List<Ball>();
		var timeScale = deltaTime * 60; // Scale by 60 for consistent physics

		foreach (var ball in _balls)
		{
			// Apply gravity
			var gravityForce = new Vector2D(0, _gravity * timeScale);
			var velocity = ball.Velocity + gravityForce;

			// Apply air resistance
			velocity *= _airResistance;

			// Update position
			var position = ball.Position + velocity * timeScale;

			// Check left edge
			if (position.X - ball.Radius < 0)
			{
				position = new Vector2D(ball.Radius, position.Y);
				velocity = new Vector2D(-velocity.X * _elasticity, velocity.Y);
			}
			// Check right edge
			else if (position.X + ball.Radius > _canvasWidth)
			{
				position = new Vector2D(_canvasWidth - ball.Radius, position.Y);
				velocity = new Vector2D(-velocity.X * _elasticity, velocity.Y);
			}

			// Check top edge
			if (position.Y - ball.Radius < 0)
			{
				position = new Vector2D(position.X, ball.Radius);
				velocity = new Vector2D(velocity.X, -velocity.Y * _elasticity);
			}
			// Check bottom edge
			else if (position.Y + ball.Radius > _canvasHeight)
			{
				position = new Vector2D(position.X, _canvasHeight - ball.Radius);
				velocity = new Vector2D(velocity.X, -velocity.Y * _elasticity);
			}

			updatedBalls.Add(new Ball(position, velocity, ball.Radius, ball.Color));
		}

		// Handle ball-to-ball collisions
		HandleBallCollisions(updatedBalls);

		_balls = updatedBalls;
	}

	private void HandleBallCollisions(List<Ball> balls)
	{
		// Check each pair of balls for collision
		for (int i = 0; i < balls.Count; i++)
		{
			for (int j = i + 1; j < balls.Count; j++)
			{
				var ball1 = balls[i];
				var ball2 = balls[j];

				// Calculate distance between centers using vector operations
				var delta = ball2.Position - ball1.Position;
				var distance = delta.Length;

				// Check if balls are colliding
				var minDistance = ball1.Radius + ball2.Radius;
				if (distance < minDistance && distance > 0)
				{
					// Collision normal (normalized direction from ball1 to ball2)
					var normal = delta.Normalized;
					
					// Tangent perpendicular to normal
					var tangent = new Vector2D(-normal.Y, normal.X);

					// Project velocities onto normal and tangent
					var v1n = ball1.Velocity.Dot(normal);
					var v1t = ball1.Velocity.Dot(tangent);
					var v2n = ball2.Velocity.Dot(normal);
					var v2t = ball2.Velocity.Dot(tangent);

					// Do not resolve if velocities are separating
					if (v1n - v2n <= 0) continue;

					// In elastic collision with equal mass, normal velocities are exchanged
					// Tangent velocities remain unchanged
					var v1nNew = v2n * _elasticity;
					var v2nNew = v1n * _elasticity;

					// Convert back to x,y coordinates
					var velocity1 = normal * v1nNew + tangent * v1t;
					var velocity2 = normal * v2nNew + tangent * v2t;

					// Separate the balls to prevent overlap
					var overlap = minDistance - distance;
					var separation = normal * (overlap * 0.5);

					balls[i] = new Ball(
						ball1.Position - separation,
						velocity1,
						ball1.Radius,
						ball1.Color
					);

					balls[j] = new Ball(
						ball2.Position + separation,
						velocity2,
						ball2.Radius,
						ball2.Color
					);
				}
			}
		}
	}

	private async Task RenderFrame()
	{
		try
		{
			// Convert balls to JavaScript-compatible format
			var ballsForJs = _balls.Select(b => b.ToJsFormat()).ToArray();
			
			// Pass array as single parameter with explicit typing
			await JSRuntime.InvokeVoidAsync("bounceRenderFrame", new object[] { ballsForJs });
		}
		catch (Exception ex)
		{
			DebugHelper.LogError($"[Bounce] Render error: {ex.Message}");
		}
	}

	private void TogglePause()
	{
		_isPaused = !_isPaused;
		StateHasChanged();
	}

	private void Reset()
	{
		_isPaused = false;
		InitializeBalls();
		StateHasChanged();
	}

	private void ApplyBallCount()
	{
		InitializeBalls();
		StateHasChanged();
	}

	private void RandomizeVelocities()
	{
		var updatedBalls = new List<Ball>();

		foreach (var ball in _balls)
		{
			// Give each ball a random velocity in all directions
			var velocity = new Vector2D(
				(_random.NextDouble() - 0.5) * 20, // -10 to +10
				(_random.NextDouble() - 0.5) * 20  // -10 to +10
			);

			updatedBalls.Add(new Ball(ball.Position, velocity, ball.Radius, ball.Color));
		}

		_balls = updatedBalls;
		DebugHelper.Log("[Bounce] Randomized velocities for all balls", true);
		StateHasChanged();
	}

	private async Task OnCanvasClick(MouseEventArgs e)
	{
		if (!_isInitialized) return;

		// Get current canvas dimensions
		var dimensions = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("getBounceCanvasDimensions");
		_canvasWidth = dimensions.GetProperty("width").GetDouble();
		_canvasHeight = dimensions.GetProperty("height").GetDouble();

		// Add a new ball at click position
		var x = Math.Max(_ballSize, Math.Min(_canvasWidth - _ballSize, e.OffsetX));
		var y = Math.Max(_ballSize, Math.Min(_canvasHeight - _ballSize, e.OffsetY));

		var position = new Vector2D(x, y);
		var velocity = new Vector2D(
			(_random.NextDouble() - 0.5) * 10,
			(_random.NextDouble() - 0.5) * 10
		);
		var color = GetRandomColor();

		_balls.Add(new Ball(position, velocity, _ballSize, color));
		DebugHelper.Log($"[Bounce] Added ball at ({x}, {y})", true);
	}

	public void Dispose()
	{
		_animationTimer?.Dispose();
		_dotNetRef?.Dispose();
	}
}
