@page "/vision"
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject Client.Services.ApplicationInsightsLogger AppInsights
@implements IAsyncDisposable
@attribute [AllowAnonymous]

<PageTitle>Vision - Image FFT &amp; Processing</PageTitle>

<div class="vision-page">
    <h3>👁️ Vision — Image FFT &amp; Processing</h3>

    <!-- ── Input Controls ─────────────────────────────────────────── -->
    <div class="vision-section">
        <h5>📥 Load Image</h5>
        <div class="vision-row">
            <label class="btn btn-sm btn-primary" style="cursor:pointer;">
                📂 File
                <InputFile OnChange="OnFileSelected" accept="image/*" style="display:none;" />
            </label>
            <button class="btn btn-sm btn-secondary" @onclick="PasteFromClipboard">📋 Paste</button>
            <button class="btn btn-sm @(_cameraActive ? "btn-danger" : "btn-success")" @onclick="ToggleCamera">
                @(_cameraActive ? "⏹ Stop Camera" : "📷 Camera")
            </button>
            @if (!_cameraActive && _cameras.Count > 0)
            {
                <select class="form-select form-select-sm" style="width:auto;max-width:260px;"
                        @bind="_selectedDeviceId">
                    @foreach (var cam in _cameras)
                    {
                        <option value="@cam.DeviceId">@cam.Label</option>
                    }
                </select>
            }
            @if (_cameraActive)
            {
                <button class="btn btn-sm btn-info" @onclick="CaptureFrame">📸 Snapshot</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearImage" disabled="@(!_hasImage && !_cameraActive)">🗑️ Clear</button>
        </div>

        @* Hidden video element used by JS live preview — never shown directly *@
        <video id="visionCameraVideo" autoplay playsinline muted
               style="display:none;" aria-hidden="true"></video>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="vision-status @(_isError ? "vision-error" : "vision-info")">@_statusMessage</div>
        }
    </div>

    <!-- ── Filter Controls ────────────────────────────────────────── -->
    <div class="vision-section" style="@(_hasImage ? "" : "opacity:0.4;pointer-events:none;")">
        <h5>🎛️ Filter</h5>
        <div class="vision-row vision-filter-grid">
            @foreach (var f in _filters)
            {
                <button class="btn btn-sm @(_selectedFilter == f.Key ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SelectFilter(f.Key)">
                    @f.Label
                </button>
            }
        </div>
        <div class="vision-row" style="margin-top:6px;gap:12px;">
            <span style="font-size:0.85em;color:#888;">Frequency domain: Low-pass, High-pass, Band-pass &nbsp;|&nbsp; Spatial: Grayscale, Sharpen, Blur, Sobel Edges, Emboss, Invert</span>
        </div>
    </div>

    <!-- ── Three-panel display ────────────────────────────────────── -->
    <div class="vision-panels">
        <div class="vision-panel">
            <div class="vision-panel-title">🖼️ Original</div>
            <div class="vision-canvas-wrap">
                <canvas id="visionOrigCanvas"></canvas>
                @if (!_hasImage)
                {
                    <div class="vision-placeholder">Load an image to begin</div>
                }
            </div>
        </div>

        <div class="vision-panel">
            <div class="vision-panel-title">✨ Result</div>
            <div class="vision-canvas-wrap">
                <canvas id="visionResultCanvas"></canvas>
                @if (!_hasImage)
                {
                    <div class="vision-placeholder">Filtered result appears here</div>
                }
            </div>
        </div>

        <div class="vision-panel">
            <div class="vision-panel-title">📊 FFT Magnitude (log, DC-centered)</div>
            <div class="vision-canvas-wrap">
                <canvas id="visionFftCanvas"></canvas>
                @if (!_hasImage)
                {
                    <div class="vision-placeholder">FFT appears here</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    record FilterDef(string Key, string Label);

    bool _hasImage = false;
    bool _isError = false;
    string _statusMessage = "";
    string _selectedFilter = "edge_sobel_spatial";
    bool _busy = false;
    bool _cameraActive = false;
    string _selectedDeviceId = "";
    List<CameraDevice> _cameras = [];

    record CameraDevice(string DeviceId, string Label);

    async Task EnumerateCamerasAsync()
    {
        try
        {
            var raw = await JSRuntime.InvokeAsync<JsonElement[]>("visionGame.enumerateCameras");
            _cameras = raw?.Select(j => new CameraDevice(
                j.GetProperty("deviceId").GetString() ?? "",
                j.GetProperty("label").GetString() ?? "Camera")).ToList() ?? [];

            static int Score(string label)
            {
                var l = label.ToLowerInvariant();
                if (l.Contains("phone") || l.Contains("link") || l.Contains("virtual") ||
                    l.Contains("obs")   || l.Contains("droid") || l.Contains("iriun") ||
                    l.Contains("epoccam") || l.Contains("camo"))
                    return -1;
                if (l.Contains("integrated") || l.Contains("built-in") ||
                    l.Contains("webcam")     || l.Contains("hd camera") ||
                    l.Contains("ir camera")  || l.Contains("facetime"))
                    return 2;
                return 1;
            }
            var preferred = _cameras.OrderByDescending(c => Score(c.Label)).FirstOrDefault();
            _selectedDeviceId = preferred?.DeviceId ?? "";
            StateHasChanged();
        }
        catch { /* camera API unavailable (e.g. no HTTPS in some browsers) */ }
    }

    readonly FilterDef[] _filters =
    [
        new("none",                 "🔄 None (original)"),
        new("lowpass",              "🔵 Low-pass (sharp)"),
        new("lowpass_soft",         "🔵 Low-pass (soft)"),
        new("highpass",             "🔴 High-pass"),
        new("bandpass",             "🟡 Band-pass"),
        new("grayscale",            "⬜ Grayscale"),
        new("sharpen",              "🔪 Sharpen"),
        new("blur",                 "💧 Blur"),
        new("edge_sobel_spatial",   "✏️ Sobel Edges"),
        new("emboss",               "🪨 Emboss"),
        new("invert",               "🔁 Invert"),
    ];

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            SetStatus("Loading…", false);
            var file = e.File;
            // Read as base64 data URL
            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            var bytes = new byte[file.Size];
            await stream.ReadExactlyAsync(bytes);
            var b64 = Convert.ToBase64String(bytes);
            var dataUrl = $"data:{file.ContentType};base64,{b64}";
            await LoadDataUrl(dataUrl);
        }
        catch (Exception ex)
        {
            SetStatus($"Error loading file: {ex.Message}", true);
        }
    }

    async Task PasteFromClipboard()
    {
        try
        {
            SetStatus("Pasting from clipboard…", false);
            var result = await JSRuntime.InvokeAsync<object>("visionGame.pasteFromClipboard",
                "visionOrigCanvas", "visionFftCanvas");
            if (result == null)
            {
                SetStatus("No image found in clipboard. Copy an image first, then paste.", true);
                return;
            }
            _hasImage = true;
            _selectedFilter = "none";
            SetStatus("Clipboard image loaded.", false);
            await ApplyFilterToResult();
        }
        catch (Exception ex)
        {
            SetStatus($"Clipboard error: {ex.Message}", true);
        }
    }

    async Task LoadDataUrl(string dataUrl)
    {
        var result = await JSRuntime.InvokeAsync<object>("visionGame.loadImageFromDataUrl",
            dataUrl, "visionOrigCanvas", "visionFftCanvas");
        _hasImage = result != null;
        _selectedFilter = "none";
        SetStatus(_hasImage ? "Image loaded. Choose a filter to process." : "Failed to load image.", !_hasImage);
        if (_hasImage) await ApplyFilterToResult();
    }

    async Task SelectFilter(string key)
    {
        _selectedFilter = key;
        if (_cameraActive)
        {
            // Camera is live — just update the filter name; the RAF loop picks it up instantly
            await JSRuntime.InvokeVoidAsync("visionGame.setLiveFilter", key);
            return;
        }
        if (!_hasImage) return;
        await ApplyFilterToResult();
    }

    async Task ApplyFilterToResult()
    {
        if (!_hasImage) return;
        _busy = true;
        SetStatus("Processing…", false);
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("visionGame.applyFilter",
                _selectedFilter, "visionFftCanvas", "visionResultCanvas");
            SetStatus("Done.", false);
        }
        catch (Exception ex)
        {
            SetStatus($"Filter error: {ex.Message}", true);
        }
        finally
        {
            _busy = false;
        }
    }

    async Task ClearImage()
    {
        if (_cameraActive)
        {
            await JSRuntime.InvokeVoidAsync("visionGame.stopCamera", "visionCameraVideo");
            _cameraActive = false;
        }
        await JSRuntime.InvokeVoidAsync("visionGame.clearImage");
        _hasImage = false;
        _selectedFilter = "none";
        SetStatus("", false);
        // Clear canvases
        foreach (var id in new[] { "visionOrigCanvas", "visionFftCanvas", "visionResultCanvas" })
            await JSRuntime.InvokeVoidAsync("eval",
                $"(()=>{{const c=document.getElementById('{id}');if(c){{c.width=1;c.height=1;}}}})()");
    }

    async Task ToggleCamera()
    {
        if (_cameraActive)
        {
            await JSRuntime.InvokeVoidAsync("visionGame.stopCamera", "visionCameraVideo");
            _cameraActive = false;
            _hasImage = false;
            SetStatus("Camera stopped.", false);
        }
        else
        {
            _cameraActive = true;
            StateHasChanged(); // render the video element first
            await Task.Delay(50); // give Blazor time to render <video> into DOM

            // Start with whatever the browser default is — this triggers the one permission prompt.
            var ok = await JSRuntime.InvokeAsync<bool>("visionGame.startCamera",
                "visionCameraVideo", _selectedDeviceId);
            if (!ok)
            {
                _cameraActive = false;
                SetStatus("Could not access camera. Check browser permissions.", true);
                return;
            }

            SetStatus("Camera active — live preview running. Choose a filter or click Snapshot.", false);

            // Now that permission is granted, enumerate devices so the picker is populated.
            // Labels are only non-empty after permission has been granted.
            bool didSwitch = false;
            if (_cameras.Count == 0)
            {
                await EnumerateCamerasAsync();
                // If scoring picked a better device than the default, switch to it silently
                // BEFORE starting the live preview so we only start the RAF loop once.
                if (!string.IsNullOrEmpty(_selectedDeviceId))
                {
                    var currentTrack = await JSRuntime.InvokeAsync<string>(
                        "visionGame.getActiveCameraDeviceId");
                    Console.WriteLine($"[Vision] current track={currentTrack} preferred={_selectedDeviceId}");
                    if (currentTrack != _selectedDeviceId)
                    {
                        Console.WriteLine($"[Vision] switching to preferred device {_selectedDeviceId}");
                        var switched = await JSRuntime.InvokeAsync<bool>("visionGame.startCamera",
                            "visionCameraVideo", _selectedDeviceId);
                        Console.WriteLine($"[Vision] switched={switched}");
                        didSwitch = switched;
                    }
                }
            }

            Console.WriteLine($"[Vision] starting live preview, didSwitch={didSwitch}");
            await JSRuntime.InvokeVoidAsync("visionGame.startLivePreview",
                "visionCameraVideo", "visionOrigCanvas", "visionFftCanvas", "visionResultCanvas",
                _selectedFilter);
            _hasImage = true;  // treat live feed as having an image so filters are enabled
            Console.WriteLine($"[Vision] live preview started");
        }
    }

    async Task CaptureFrame()
    {
        // Stop the live loop so the frozen frame isn't immediately overwritten
        await JSRuntime.InvokeVoidAsync("visionGame.stopLivePreview");
        await JSRuntime.InvokeVoidAsync("visionGame.stopCamera", "visionCameraVideo");
        _cameraActive = false;

        SetStatus("Snapshot captured. Choose a filter to process.", false);
        // The live preview already drew the last frame into visionOrigCanvas;
        // tell the pipeline to treat it as the current image and apply the filter.
        await JSRuntime.InvokeVoidAsync("visionGame.freezeLiveFrame",
            "visionOrigCanvas", "visionFftCanvas");
        _hasImage = true;
        await ApplyFilterToResult();
    }

    void SetStatus(string msg, bool isError)
    {
        _statusMessage = msg;
        _isError = isError;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("visionGame.stopCamera", "visionCameraVideo"); } catch { }
        try { await JSRuntime.InvokeVoidAsync("visionGame.clearImage"); } catch { }
    }
}
