@page "/wordament"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@using WordScapeBlazorWasm.Shared
@inject WordamentGameService GameService
@inject GameStateService StateService
@inject DebugHelper DebugHelper
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Wordament - 4x4 Word Game</PageTitle>

<div class="wordament-game-container">
    @if (_gameState == null)
    {
        <div class="text-center">
            <div class="loading-spinner"></div>
            <p>Loading game...</p>
            <button class="btn btn-primary" @onclick="StartNewGame">Start Game</button>
        </div>
    }
    else if (_gameState.IsGameComplete && _showGameOverScreen)
    {
        <!-- Game Over Screen -->
        <div class="game-over-overlay" @onclick="DismissGameOver">
            <div class="game-over-panel" @onclick:stopPropagation="true">
                <button class="modal-close-btn" @onclick="DismissGameOver" title="Close">×</button>
                
                <h2 class="game-over-title">
                    @if (_settings.GameMode == WordamentGameMode.LongWord && _gameState.OriginalWordFound)
                    {
                        <span class="success-title">🎉 You Found It! 🎉</span>
                    }
                    else
                    {
                        <span>*** Game Over! ***</span>
                    }
                </h2>
                
                <div class="game-over-actions">
                    <button class="play-again-btn" @onclick="StartNewGame">Play Again</button>
                    <button class="view-results-btn" @onclick="DismissGameOver">View Results</button>
                </div>
            </div>
        </div>
    }
    else if (_gameState.IsGameComplete && !_showGameOverScreen)
    {
        <!-- Show comprehensive game results -->
        <div class="wordament-results-container">
            <!-- Action Buttons at Top -->
            <div class="results-top-actions">
                <button class="btn btn-primary" @onclick="StartNewGame">🆕 New Game</button>
                <button class="btn btn-secondary" @onclick="() => _showGameOverScreen = true">📊 Back to Summary</button>
            </div>

            <!-- Compact Results Header -->
            <div class="results-header compact">
                <h3>Game Results</h3>
                
                <!-- Final Stats -->
                <div class="final-stats compact">
                    @if (_settings.GameMode == WordamentGameMode.Timer)
                    {
                        <div class="final-stat">
                            <div class="stat-label">Score</div>
                            <div class="stat-value">@_gameState.Score</div>
                        </div>
                        <div class="final-stat">
                            <div class="stat-label">Words</div>
                            <div class="stat-value">@_gameState.FoundWords.Count</div>
                        </div>
                        <div class="final-stat">
                            <div class="stat-label">Time</div>
                            <div class="stat-value">@FormatTime(TimeSpan.FromMinutes(_settings.GameDurationMinutes) - _gameState.TimeRemaining)</div>
                        </div>
                    }
                    else
                    {
                        <div class="final-stat">
                            <div class="stat-label">Time</div>
                            <div class="stat-value">@FormatTime(_gameState.ElapsedTime)</div>
                        </div>
                        <div class="final-stat">
                            <div class="stat-label">Words</div>
                            <div class="stat-value">@_gameState.FoundWords.Count</div>
                        </div>
                        @if (_settings.GameMode == WordamentGameMode.LongWord)
                        {
                            <div class="final-stat">
                                <div class="stat-label">Target</div>
                                <div class="stat-value @(_gameState.OriginalWordFound ? "success" : "")">
                                    @_gameState.OriginalWord @(_gameState.OriginalWordFound ? "✓" : "")
                                </div>
                            </div>
                            <div class="final-stat">
                                <div class="stat-label">Hints</div>
                                <div class="stat-value">@_gameState.HintsUsed</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Final Grid Display (disabled) -->
            <div class="results-grid-container compact">
                <h4>Final Grid</h4>
                <div class="wordament-grid-container">
                    <div class="wordament-grid disabled">
                        @for (int y = 0; y < WordamentGrid.Size; y++)
                        {
                            @for (int x = 0; x < WordamentGrid.Size; x++)
                            {
                                var cell = _gameState.Grid.Cells[x, y];
                                
                                <div class="wordament-cell disabled @(cell.IsSpecial ? "special" : "")" 
                                     data-x="@x" 
                                     data-y="@y">
                                    
                                    @if (cell.IsSpecial)
                                    {
                                        <div class="special-indicator">@GetSpecialCellText(cell.SpecialType)</div>
                                    }
                                    
                                    @cell.Letter
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Found Words Section -->
            @if (_gameState.FoundWords.Any())
            {
                <div class="results-section compact">
                    <h4>Words You Found (@_gameState.FoundWords.Count)</h4>
                    <div class="words-list multi-column">
                        @foreach (var word in SortWordsByDictionaryAndAlpha(_gameState.FoundWords))
                        {
                            <div class="found-word @GetWordamentWordCssClass(word)" 
                                 title="@DictionaryHelper.GetDictionaryClickTooltip(word.Word, GetWordamentWordTooltip(word))"
                                 @onclick="@(() => DictionaryHelper.OpenDictionaryDefinitionAsync(JSRuntime, word.Word))"
                                 style="cursor: pointer;">
                                @word.Word
                                @if (_settings.GameMode == WordamentGameMode.Timer)
                                {
                                    <div class="word-score">+@word.Score</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- All Possible Words Section - Always shown -->
            <div class="results-section compact">
                <div class="section-header">
                    <h4>All Possible Words @((_allPossibleWords?.Count ?? 0) > 0 ? $"({_allPossibleWords!.Count})" : "")</h4>
                </div>
                
                @if (_isLoadingWords)
                {
                    <div class="loading-words">
                        <div class="loading-spinner"></div>
                        <p>Loading all possible words...</p>
                    </div>
                }
                else if (_allPossibleWords != null && _allPossibleWords.Any())
                {
                    @if (_settings.GameMode == WordamentGameMode.Timer)
                    {
                        <!-- Timer Mode: Show missed words and complete list -->
                        @if (GetMissedWords().Any())
                        {
                            <div class="missed-words-section">
                                <h5>Words You Missed (@GetMissedWords().Count)</h5>
                                <div class="words-list multi-column missed">
                                    @foreach (var word in SortWordsByDictionaryAndAlpha(GetMissedWords()))
                                    {
                                        <div class="found-word @GetWordamentWordCssClass(word) missed-word-clean" 
                                             title="@DictionaryHelper.GetDictionaryClickTooltip(word.Word, GetWordamentWordTooltip(word))"
                                             @onclick="@(() => DictionaryHelper.OpenDictionaryDefinitionAsync(JSRuntime, word.Word))"
                                             style="cursor: pointer;">
                                            @word.Word
                                            @if (_settings.GameMode == WordamentGameMode.Timer)
                                            {
                                                <div class="word-score">+@word.Score</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- All Words (sorted by category) -->
                        <div class="all-words-section">
                            <h5>Complete Word List</h5>
                            <div class="words-list multi-column">
                                @foreach (var word in SortWordsByDictionaryAndAlpha(_allPossibleWords))
                                {
                                    var wasFound = _gameState.FoundWords.Any(fw => fw.Word.Equals(word.Word, StringComparison.OrdinalIgnoreCase));
                                    <div class="found-word @GetWordamentWordCssClass(word) @(wasFound ? "found-word-highlight-clean" : "missed-word-clean")" 
                                         title="@DictionaryHelper.GetDictionaryClickTooltip(word.Word, GetWordamentWordTooltip(word) + (wasFound ? " ✓ Found" : " ✗ Missed"))"
                                         @onclick="@(() => DictionaryHelper.OpenDictionaryDefinitionAsync(JSRuntime, word.Word))"
                                         style="cursor: pointer;">
                                        @word.Word
                                        @if (_settings.GameMode == WordamentGameMode.Timer)
                                        {
                                            <div class="word-score">+@word.Score</div>
                                        }
                                        @if (wasFound)
                                        {
                                            <span class="found-indicator">✓</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- LongWord Mode: Show only complete list without missed words section -->
                        <div class="all-words-section">
                            <div class="words-list multi-column">
                                @foreach (var word in SortWordsByDictionaryAndAlpha(_allPossibleWords))
                                {
                                    var wasFound = _gameState.FoundWords.Any(fw => fw.Word.Equals(word.Word, StringComparison.OrdinalIgnoreCase));
                                    var isTargetWord = word.Word.Equals(_gameState.OriginalWord, StringComparison.OrdinalIgnoreCase);
                                    <div class="found-word @GetWordamentWordCssClass(word) @(wasFound ? "found-word-highlight-clean" : "") @(isTargetWord ? "target-word" : "")" 
                                         title="@DictionaryHelper.GetDictionaryClickTooltip(word.Word, GetWordamentWordTooltip(word) + (wasFound ? " ✓ Found" : "") + (isTargetWord ? " 🎯 Target Word" : ""))"
                                         @onclick="@(() => DictionaryHelper.OpenDictionaryDefinitionAsync(JSRuntime, word.Word))"
                                         style="cursor: pointer;">
                                        @word.Word
                                        @if (wasFound)
                                        {
                                            <span class="found-indicator">✓</span>
                                        }
                                        @if (isTargetWord)
                                        {
                                            <span class="target-indicator">🎯</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="loading-words">
                        <p>Words will appear here after the game loads all possibilities...</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Game Stats and Settings Row -->
        <div class="stats-and-settings-row">
            <button class="settings-button compact" @onclick="ToggleSettings" title="Settings">
                <span class="icon-fallback">⚙</span><span class="text-fallback">SET</span>
            </button>
            
            <div class="game-stats compact">
                @if (_settings.GameMode == WordamentGameMode.Timer)
                {
                    <div class="stat-item">
                        <div class="stat-value">@_gameState.Score</div>
                        <div class="stat-label">Score</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value timer @(_gameState.TimeRemaining.TotalSeconds <= 30 ? "warning" : "")">
                            @FormatTime(_gameState.TimeRemaining)
                        </div>
                        <div class="stat-label">Time Left</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@_gameState.FoundWords.Count</div>
                        <div class="stat-label">Words</div>
                    </div>
                }
                else
                {
                    <div class="stat-item">
                        <div class="stat-value timer">@FormatTime(_gameState.ElapsedTime)</div>
                        <div class="stat-label">Time</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@_gameState.HintsUsed</div>
                        <div class="stat-label">Hints Used</div>
                    </div>
                }
            </div>

            @if (_settings.GameMode == WordamentGameMode.LongWord && GameService.AreHintsAvailable(_gameState))
            {
                <button class="hint-button-compact" @onclick="UseHint" title="Get Hint">
                    <span class="icon-fallback">💭</span><span class="text-fallback">HINT</span>
                </button>
            }
        </div>

        <!-- Current Word Display -->
        <div class="current-word-display">
            <div class="current-word @GetCurrentWordDisplayClass()">
                @if (!string.IsNullOrEmpty(_hintDisplay))
                {
                    <span style="color: #007bff; font-style: italic;">HINT: @_hintDisplay</span>
                }
                else if (!string.IsNullOrEmpty(GetCurrentWordToDisplay()))
                {
                    @GetCurrentWordToDisplay()
                }
                else
                {
                    @if (_settings.GameMode == WordamentGameMode.LongWord)
                    {
                        <span style="color: #999;">Find the hidden long word!</span>
                    }
                    else
                    {
                        <span style="color: #999;">Drag to form words</span>
                    }
                }
            </div>
        </div>

        <!-- 4x4 Grid - Using JavaScript for ALL mouse and touch handling -->
        <div class="wordament-grid-container" @ref="gridContainer">
            <div class="wordament-grid" 
                 @oncontextmenu:preventDefault="true"
                 style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;">
                @for (int y = 0; y < WordamentGrid.Size; y++)
                {
                    @for (int x = 0; x < WordamentGrid.Size; x++)
                    {
                        var cell = _gameState.Grid.Cells[x, y];
                        var position = new GridPosition(x, y);
                        
                        <div class="wordament-cell @GetCellClass(cell)" 
                             data-x="@x" 
                             data-y="@y"
                             style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none;">
                            
                            @if (cell.IsSpecial)
                            {
                                <div class="special-indicator">@GetSpecialCellText(cell.SpecialType)</div>
                            }
                            
                            @cell.Letter
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Game Controls -->
        <div class="wordament-controls">
            <button class="control-button new-game-button" @onclick="StartNewGame">
                <span class="icon-fallback">🆕</span><span class="text-fallback">NEW GAME</span>
            </button>
        </div>

        <!-- Found Words -->
        @if (_gameState.FoundWords.Any())
        {
            <div class="found-words-section">
                <h4>Found Words (@_gameState.FoundWords.Count)</h4>
                <div class="words-list multi-column">
                    @foreach (var word in SortWordsByDictionaryAndAlpha(_gameState.FoundWords))
                    {
                        <div class="found-word @GetWordamentWordCssClass(word) @GetWordamentAnimationClass(word.Word)" 
                             title="@DictionaryHelper.GetDictionaryClickTooltip(word.Word, GetWordamentWordTooltip(word))"
                             @onclick="@(() => DictionaryHelper.OpenDictionaryDefinitionAsync(JSRuntime, word.Word))"
                             style="cursor: pointer;">
                            @word.Word
                            @if (_settings.GameMode == WordamentGameMode.Timer)
                            {
                                <div class="word-score">+@word.Score</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- Settings Modal -->
    @if (_showSettings)
    {
        <div class="settings-modal-overlay" @onclick="ToggleSettings">
            <div class="settings-modal-content" @onclick:stopPropagation="true">
                <div class="settings-header">
                    <h3 class="settings-title">Settings</h3>
                    <button class="settings-close" @onclick="ToggleSettings" title="Close">×</button>
                </div>
                
                <div class="settings-body">
                    <div class="setting-group">
                        <label class="setting-label">Game Mode</label>
                        <div class="game-mode-options">
                            <div class="game-mode-option @(_tempSettings.GameMode == WordamentGameMode.Timer ? "selected" : "")"
                                 @onclick="@(() => _tempSettings.GameMode = WordamentGameMode.Timer)">
                                <div class="mode-title">⏱️ Timer Mode</div>
                                <div class="mode-description">Race against the clock to find as many words as possible in 3 minutes</div>
                            </div>
                            <div class="game-mode-option @(_tempSettings.GameMode == WordamentGameMode.LongWord ? "selected" : "")"
                                 @onclick="@(() => _tempSettings.GameMode = WordamentGameMode.LongWord)">
                                <div class="mode-title">🎯 Long Word Mode</div>
                                <div class="mode-description">Find the specific long word hidden in the grid</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="setting-group">
                        <label class="setting-label">Minimum Word Length: @_tempSettings.MinWordLength letters</label>
                        <input type="range" 
                               @bind="_tempSettings.MinWordLength" 
                               @bind:event="oninput"
                               min="3" 
                               max="6" 
                               step="1"
                               class="form-range" />
                    </div>

                    <div class="setting-group">
                        <label class="setting-label">Debug Options</label>
                        <div class="debug-controls">
                            <div class="checkbox-group">
                                <input type="checkbox" id="debugModeWordament" @bind="_tempSettings.IsDebugEnabled" />
                                <label for="debugModeWordament">Enable Debug Mode (detailed logging for troubleshooting)</label>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="settings-footer">
                    <button class="settings-btn settings-btn-cancel" @onclick="CancelSettings">Cancel</button>
                    <button class="settings-btn settings-btn-save" @onclick="SaveSettings">Save Settings</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message">@_errorMessage</div>
    }
</div>

@code {
    private WordamentGameState? _gameState;
    private WordamentSettings _settings = new();
    private WordamentSettings _tempSettings = new();
    private List<GridPosition> _selectedPath = new();
    private string _currentWord = "";
    private string _hintDisplay = "";
    private System.Threading.Timer? _gameTimer;
    private System.Threading.Timer? _hintTimer;
    private string? _errorMessage;
    private bool _isDragging = false;
    private ElementReference gridContainer;
    private bool _showSettings = false;
    private bool _showGameOverScreen = true;
    private readonly HashSet<string> _recentlyAddedWords = new();
    private List<WordamentFoundWord>? _allPossibleWords = null;
    private bool _isLoadingWords = false;
    private DotNetObjectReference<WordamentGame>? _dotNetHelper;
    private bool _jsInitialized = false; // NEW: Flag to prevent infinite loops

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LogDebug("Wordament: OnInitializedAsync started");
            _dotNetHelper = DotNetObjectReference.Create(this);

            try
            {
                var savedSettings = await StateService.LoadWordamentSettingsAsync();
                if (savedSettings != null)
                {
                    _settings = savedSettings;
                    LogDebug($"Settings loaded from storage: GameMode={_settings.GameMode}, Debug={_settings.IsDebugEnabled}");
                    
                    // Update DebugHelper with the loaded debug setting
                    DebugHelper.SetDebugMode(_settings.IsDebugEnabled);
                }
                else
                {
                    _settings = GameService.GetDefaultSettings();
                    LogDebug("Using default settings");
                }
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"Error loading settings, using defaults: {ex}");
                _settings = GameService.GetDefaultSettings();
            }

            var savedState = await StateService.LoadWordamentStateAsync();
            bool stateRestored = false;

            if (savedState?.GameState != null && savedState.GameState.IsGameActive)
            {
                LogDebug($"Restoring Wordament state - Score: {savedState.GameState.Score}, Words: {savedState.GameState.FoundWords.Count}");
                stateRestored = RestoreFromSavedState(savedState);
            }

            if (!stateRestored)
            {
                LogDebug("No saved state or restoration failed, starting new game...");
                await StartNewGame();
            }
            else
            {
                LogDebug("Wordament state successfully restored");
                _errorMessage = null;
                StateHasChanged();
            }

            LogDebug("Wordament: Initialization completed successfully");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to initialize game: {ex.Message}";
            DebugHelper.LogError($"Wordament initialization error: {ex}");
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("registerWordamentBlazorComponent", _dotNetHelper);
                LogDebug("Wordament registered with JavaScript");

                await JSRuntime.InvokeVoidAsync("initializeWordament");
                LogDebug("Wordament JavaScript initialized");
                _jsInitialized = true; // Mark as initialized
                
                // Set JavaScript debug mode to match C# debug mode
                try
                {
                    await JSRuntime.InvokeVoidAsync("setWordamentDebugMode", _settings.IsDebugEnabled, true);
                    LogDebug($"JavaScript debug mode set to: {_settings.IsDebugEnabled}");
                }
                catch (Exception jsEx)
                {
                    DebugHelper.LogError($"Error setting JavaScript debug mode: {jsEx.Message}");
                }
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"Error initializing Wordament JavaScript: {ex}");
            }
        }
    }

    private bool RestoreFromSavedState(WordamentGameStateDto savedState)
    {
        try
        {
            if (savedState.GameState == null) return false;

            _gameState = savedState.GameState;
            _settings = savedState.Settings ?? GameService.GetDefaultSettings();

            // Update DebugHelper with restored debug setting
            DebugHelper.SetDebugMode(_settings.IsDebugEnabled);

            if (_gameState.GameMode != _settings.GameMode)
            {
                LogDebug($"Updating game state GameMode from {_gameState.GameMode} to {_settings.GameMode}");
                _gameState.GameMode = _settings.GameMode;
            }

            if (savedState.GridState != null)
            {
                LogDebug("Restoring Wordament grid from saved grid state");
                _gameState.Grid.RestoreGrid(savedState.GridState);
            }

            _selectedPath = _gameState.SelectedPath ?? new List<GridPosition>();
            _currentWord = _gameState.CurrentPath ?? "";
            _isDragging = false;

            if (_selectedPath.Any())
            {
                GameService.UpdateSelection(_selectedPath, _gameState.Grid);
                UpdateCurrentWord();
            }

            if (_gameState.IsGameActive)
            {
                StartGameTimer();
            }
            else
            {
                _showGameOverScreen = true;
            }

            return true;
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error restoring Wordament state: {ex}");
            return false;
        }
    }

    private async Task StartNewGame()
    {
        try
        {
            LogDebug($"Starting new Wordament game - Mode: {_settings.GameMode}");

            await StateService.ClearWordamentStateAsync();

            _gameState = GameService.CreateNewGame(_settings);
            _selectedPath.Clear();
            _currentWord = "";
            _errorMessage = null;
            _isDragging = false;
            _showGameOverScreen = true;
            _recentlyAddedWords.Clear();

            _allPossibleWords = null;
            _isLoadingWords = false;

            StartGameTimer();
            await SaveGameState();
            
            // CRITICAL: Reset JavaScript initialization flag for new games
            _jsInitialized = false;

            StateHasChanged();
            
            // CRITICAL: Always reinitialize JavaScript for new games to ensure touch/click works
            try
            {
                await Task.Delay(200); // Give DOM more time to update completely
                await JSRuntime.InvokeVoidAsync("initializeWordament");
                _jsInitialized = true;
                LogDebug("JavaScript reinitialized for new game - touch/click should work");
            }
            catch (Exception jsEx)
            {
                DebugHelper.LogError($"Error reinitializing JavaScript for new game: {jsEx.Message}");
                _jsInitialized = false; // Mark as failed so it can retry
            }
            
            LogDebug($"New Wordament game started successfully - Mode: {_settings.GameMode}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to start new game: {ex.Message}";
            DebugHelper.LogError($"Failed to start new Wordament game: {ex}");
            StateHasChanged();
        }
    }

    private void StartGameTimer()
    {
        _gameTimer?.Dispose();
        _gameTimer = new System.Threading.Timer(async _ =>
        {
            if (_gameState != null && _gameState.IsGameActive)
            {
                GameService.UpdateGameTimer(_gameState, TimeSpan.FromSeconds(1));

                if (_settings.GameMode == WordamentGameMode.LongWord)
                {
                    GameService.CheckLongWordGameComplete(_gameState, _settings);
                }

                var totalSeconds = _settings.GameMode == WordamentGameMode.Timer ? 
                    (int)_gameState.TimeRemaining.TotalSeconds : 
                    (int)_gameState.ElapsedTime.TotalSeconds;

                if (totalSeconds % 10 == 0)
                {
                    await SaveGameState();
                }

                await InvokeAsync(StateHasChanged);

                if (!_gameState.IsGameActive)
                {
                    LogDebug($"Game completed - Mode: {_settings.GameMode}");
                    _gameTimer?.Dispose();
                    _gameTimer = null;
                    await SaveGameState();

                    // Load all possible words for any completed game mode
                    if (_allPossibleWords == null)
                    {
                        LogDebug("Starting to load all possible words for completed game");
                        _ = InvokeAsync(LoadAllPossibleWords);
                    }
                }
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task SaveGameState()
    {
        try
        {
            if (_gameState == null) return;

            _gameState.SelectedPath = _selectedPath;
            _gameState.CurrentPath = _currentWord;

            var stateDto = new WordamentGameStateDto
            {
                GameState = _gameState,
                Settings = _settings,
                IsPaused = false,
                GridState = _gameState.Grid.SerializeGrid()
            };

            await StateService.SaveWordamentStateAsync(stateDto);
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"SaveGameState error: {ex.Message}");
        }
    }

    private async Task LoadAllPossibleWords()
    {
        if (_gameState == null || _isLoadingWords)
            return;

        try
        {
            _isLoadingWords = true;
            StateHasChanged();

            LogDebug("Loading all possible words for completed game...");
            _allPossibleWords = await GameService.FindAllWordsInGridUsingSeekWordAsync(_gameState.Grid, _settings.MinWordLength);
            LogDebug($"Loaded {_allPossibleWords?.Count ?? 0} possible words");

            _isLoadingWords = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error loading all possible words: {ex}");
            _errorMessage = $"Error loading word list: {ex.Message}";
            _isLoadingWords = false;
            StateHasChanged();
        }
    }

    // JavaScript interop methods for both desktop mouse and mobile touch handling
