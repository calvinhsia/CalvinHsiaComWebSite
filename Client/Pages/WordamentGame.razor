@page "/wordament"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@inject WordamentGameService GameService
@inject DebugHelper DebugHelper
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Wordament - 4x4 Word Game</PageTitle>

<div class="wordament-game-container">
    <div class="wordament-header">
        <h1 class="wordament-title">Wordament</h1>
        <p>Find words by connecting adjacent letters in the 4×4 grid!</p>
    </div>

    @if (_gameState == null)
    {
        <div class="text-center">
            <div class="loading-spinner"></div>
            <p>Loading game...</p>
            <button class="btn btn-primary" @onclick="StartNewGame">Start Game</button>
        </div>
    }
    else if (_gameState.IsGameComplete)
    {
        <div class="game-over-screen">
            <h2 class="game-over-title">Game Over!</h2>
            <div class="final-stats">
                <div class="final-stat-item">
                    <div class="final-stat-value">@_gameState.Score</div>
                    <div class="final-stat-label">Final Score</div>
                </div>
                <div class="final-stat-item">
                    <div class="final-stat-value">@_gameState.FoundWords.Count</div>
                    <div class="final-stat-label">Words Found</div>
                </div>
                <div class="final-stat-item">
                    <div class="final-stat-value">@(_gameState.FoundWords.Any() ? _gameState.FoundWords.Max(w => w.Word.Length) : 0)</div>
                    <div class="final-stat-label">Longest Word</div>
                </div>
            </div>
            
            <button class="control-button new-game-button" @onclick="StartNewGame">
                Play Again
            </button>
        </div>
    }
    else
    {
        <!-- Game Stats -->
        <div class="game-stats">
            <div class="stat-item">
                <div class="stat-value">@_gameState.Score</div>
                <div class="stat-label">Score</div>
            </div>
            <div class="stat-item">
                <div class="stat-value timer @(_gameState.TimeRemaining.TotalSeconds <= 30 ? "warning" : "")">
                    @FormatTime(_gameState.TimeRemaining)
                </div>
                <div class="stat-label">Time</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">@_gameState.FoundWords.Count</div>
                <div class="stat-label">Words</div>
            </div>
        </div>

        <!-- Current Word Display -->
        <div class="current-word-display">
            <div class="current-word @GetCurrentWordClass()">
                @if (string.IsNullOrEmpty(_currentWord))
                {
                    <span style="color: #999;">Drag to connect letters and form a word</span>
                }
                else
                {
                    @_currentWord
                }
            </div>
        </div>

        <!-- 4x4 Grid with Touch/Drag Support -->
        <div class="wordament-grid-container" @ref="gridContainer">
            <div class="wordament-grid" 
                 @onmousedown="OnGridMouseDown"
                 @onmouseup="OnGridMouseUp"
                 @onmouseleave="OnGridMouseLeave"
                 @ontouchstart="OnGridTouchStart"
                 @ontouchstart:preventDefault="true"
                 @ontouchend="OnGridTouchEnd"
                 @ontouchend:preventDefault="true"
                 @ontouchmove="OnGridTouchMove"
                 @ontouchmove:preventDefault="true"
                 @oncontextmenu:preventDefault="true"
                 style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none;">
                @for (int y = 0; y < WordamentGrid.Size; y++)
                {
                    @for (int x = 0; x < WordamentGrid.Size; x++)
                    {
                        var cell = _gameState.Grid.Cells[x, y];
                        var position = new GridPosition(x, y);
                        
                        <div class="wordament-cell @GetCellClass(cell)" 
                             data-x="@x" 
                             data-y="@y"
                             @onmouseenter="() => OnCellMouseEnter(position)"
                             @onmouseleave="() => OnCellMouseLeave(position)">
                            
                            @if (cell.IsSpecial)
                            {
                                <div class="special-indicator">@GetSpecialCellText(cell.SpecialType)</div>
                            }
                            
                            @cell.Letter
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Game Controls -->
        <div class="wordament-controls">
            <button class="control-button submit-button" 
                    @onclick="SubmitCurrentWord"
                    disabled="@(string.IsNullOrEmpty(_currentWord) || !_gameState.IsGameActive)">
                Submit Word
            </button>
            
            <button class="control-button clear-button" 
                    @onclick="ClearSelection"
                    disabled="@(!_gameState.IsGameActive || _selectedPath.Count == 0)">
                Clear
            </button>
            
            <button class="control-button new-game-button" @onclick="StartNewGame">
                New Game
            </button>
        </div>

        <!-- Found Words -->
        @if (_gameState.FoundWords.Any())
        {
            <div class="found-words-section">
                <h3 class="found-words-header">Found Words (@_gameState.FoundWords.Count)</h3>
                <div class="found-words-container">
                    <div class="found-words-list">
                        @foreach (var word in _gameState.FoundWords.OrderByDescending(w => w.Score))
                        {
                            <div class="found-word-item @word.GetDisplayClass()">
                                <span class="found-word-text">@word.Word</span>
                                <span class="found-word-score">+@word.Score</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    <!-- Debug Information -->
    @if (DebugHelper.IsDebugEnabled && !string.IsNullOrEmpty(_debugInfo))
    {
        <div class="debug-info">
            Debug Info:
            @_debugInfo
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message">
            @_errorMessage
        </div>
    }
</div>

@code {
    private WordamentGameState? _gameState;
    private WordamentSettings _settings = new();
    private List<GridPosition> _selectedPath = new();
    private string _currentWord = "";
    private System.Threading.Timer? _gameTimer;
    private string? _debugInfo;
    private string? _errorMessage;
    private bool _isDragging = false;
    private ElementReference gridContainer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            DebugHelper.Log("Wordament: OnInitializedAsync started");
            
            _settings = GameService.GetDefaultSettings();
            await StartNewGame();
            
            DebugHelper.Log("Wordament: Initialization completed successfully");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to initialize game: {ex.Message}";
            DebugHelper.LogError($"Wordament initialization error: {ex}");
            StateHasChanged();
        }
    }

    private async Task StartNewGame()
    {
        try
        {
            DebugHelper.Log("Starting new Wordament game");
            
            _gameState = GameService.CreateNewGame(_settings);
            _selectedPath.Clear();
            _currentWord = "";
            _errorMessage = null;
            _isDragging = false;
            _debugInfo = DebugHelper.IsDebugEnabled ? $"Game started at {DateTime.Now:HH:mm:ss}" : null;

            // Start the game timer
            StartGameTimer();
            
            StateHasChanged();
            DebugHelper.Log("New Wordament game started successfully");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to start new game: {ex.Message}";
            DebugHelper.LogError($"Failed to start new Wordament game: {ex}");
            StateHasChanged();
        }
    }

    private void StartGameTimer()
    {
        _gameTimer?.Dispose();
        _gameTimer = new System.Threading.Timer(async _ =>
        {
            if (_gameState != null && _gameState.IsGameActive)
            {
                GameService.UpdateGameTimer(_gameState, TimeSpan.FromSeconds(1));
                await InvokeAsync(StateHasChanged);
                
                if (!_gameState.IsGameActive)
                {
                    DebugHelper.Log("Game timer expired");
                    _gameTimer?.Dispose();
                    _gameTimer = null;
                }
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Mouse Events for Desktop
    private async Task OnGridMouseDown(MouseEventArgs e)
    {
        if (_gameState == null || !_gameState.IsGameActive) return;
        
        try
        {
            var position = await GetGridPositionFromEvent(e.ClientX, e.ClientY);
            if (position != null)
            {
                DebugHelper.LogTouch($"Mouse down at grid position {position}");
                StartSelection(position);
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnGridMouseDown: {ex}");
        }
    }

    private async Task OnGridMouseUp(MouseEventArgs e)
    {
        if (_gameState == null || !_gameState.IsGameActive) return;
        
        try
        {
            DebugHelper.LogTouch("Mouse up - ending selection");
            await EndSelection();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnGridMouseUp: {ex}");
        }
    }

    private async Task OnGridMouseLeave(MouseEventArgs e)
    {
        if (_isDragging)
        {
            DebugHelper.LogTouch("Mouse left grid - ending selection");
            await EndSelection();
        }
    }

    private async Task OnCellMouseEnter(GridPosition position)
    {
        if (_gameState == null || !_gameState.IsGameActive || !_isDragging) return;

        try
        {
            DebugHelper.LogTouch($"Mouse entered cell {position}");
            await AddToPath(position);
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnCellMouseEnter: {ex}");
        }
    }

    private void OnCellMouseLeave(GridPosition position)
    {
        // Optional: Could implement path trimming, but for now we keep the simpler approach
    }

    // Touch Events for Mobile
    private async Task OnGridTouchStart(TouchEventArgs e)
    {
        if (_gameState == null || !_gameState.IsGameActive) return;
        
        try
        {
            if (e.Touches.Length > 0)
            {
                var touch = e.Touches[0];
                var position = await GetGridPositionFromEvent(touch.ClientX, touch.ClientY);
                if (position != null)
                {
                    DebugHelper.LogTouch($"Touch start at grid position {position}");
                    StartSelection(position);
                }
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnGridTouchStart: {ex}");
        }
    }

    private async Task OnGridTouchMove(TouchEventArgs e)
    {
        if (_gameState == null || !_gameState.IsGameActive || !_isDragging) return;
        
        try
        {
            if (e.Touches.Length > 0)
            {
                var touch = e.Touches[0];
                var position = await GetGridPositionFromEvent(touch.ClientX, touch.ClientY);
                if (position != null)
                {
                    DebugHelper.LogTouch($"Touch move to grid position {position}");
                    await AddToPath(position);
                }
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnGridTouchMove: {ex}");
        }
    }

    private async Task OnGridTouchEnd(TouchEventArgs e)
    {
        if (_gameState == null || !_gameState.IsGameActive) return;
        
        try
        {
            DebugHelper.LogTouch("Touch end - ending selection");
            await EndSelection();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnGridTouchEnd: {ex}");
        }
    }

    // Helper Methods for Touch/Drag Logic
    private async Task<GridPosition?> GetGridPositionFromEvent(double clientX, double clientY)
    {
        try
        {
            // Use JavaScript to find which cell is under the coordinates
            var result = await JSRuntime.InvokeAsync<int[]>("getWordamentCellFromCoordinates", gridContainer, clientX, clientY);
            if (result != null && result.Length == 2)
            {
                var x = result[0];
                var y = result[1];
                if (x >= 0 && x < WordamentGrid.Size && y >= 0 && y < WordamentGrid.Size)
                {
                    return new GridPosition(x, y);
                }
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error getting grid position from coordinates: {ex}");
        }
        return null;
    }

    private void StartSelection(GridPosition position)
    {
        _selectedPath.Clear();
        _selectedPath.Add(position);
        _isDragging = true;
        UpdateCurrentWord();
        GameService.UpdateSelection(_selectedPath, _gameState!.Grid);
        StateHasChanged();
        
        if (DebugHelper.IsDebugEnabled)
        {
            _debugInfo = $"Started selection at {position}";
        }
    }

    private async Task AddToPath(GridPosition position)
    {
        if (_selectedPath.Count == 0) return;

        var lastPosition = _selectedPath.Last();
        
        // Check if this position is already in the path
        if (_selectedPath.Any(p => p.Equals(position)))
        {
            // If it's the previous position, allow backtracking
            if (_selectedPath.Count > 1 && _selectedPath[_selectedPath.Count - 2].Equals(position))
            {
                _selectedPath.RemoveAt(_selectedPath.Count - 1);
                UpdateCurrentWord();
                GameService.UpdateSelection(_selectedPath, _gameState!.Grid);
                StateHasChanged();
            }
            return;
        }

        // Check if the new position is adjacent to the last position
        if (_gameState!.Grid.AreAdjacent(lastPosition, position))
        {
            _selectedPath.Add(position);
            UpdateCurrentWord();
            GameService.UpdateSelection(_selectedPath, _gameState.Grid);
            StateHasChanged();
            
            if (DebugHelper.IsDebugEnabled)
            {
                _debugInfo = $"Path: {string.Join(" -> ", _selectedPath.Select(p => $"({p.X},{p.Y})"))}";
            }
        }
    }

    private async Task EndSelection()
    {
        _isDragging = false;
        
        if (_selectedPath.Count > 0 && !string.IsNullOrEmpty(_currentWord))
        {
            // Auto-submit if we have a valid word
            if (GameService.IsValidWord(_currentWord, _settings.MinWordLength))
            {
                await SubmitCurrentWord();
                return;
            }
        }
        
        // Clear selection if no valid word
        if (_selectedPath.Count <= 1 || string.IsNullOrEmpty(_currentWord) || 
            !GameService.IsValidWord(_currentWord, _settings.MinWordLength))
        {
            ClearSelection();
        }
    }

    private void UpdateCurrentWord()
    {
        if (_gameState == null) return;
        
        _currentWord = GameService.GetWordFromPath(_selectedPath, _gameState.Grid);
    }

    private async Task SubmitCurrentWord()
    {
        if (_gameState == null || string.IsNullOrEmpty(_currentWord) || !_gameState.IsGameActive) return;

        try
        {
            // Check if word was already found
            if (_gameState.FoundWords.Any(w => w.Word.Equals(_currentWord, StringComparison.OrdinalIgnoreCase)))
            {
                _errorMessage = "Word already found!";
                ClearSelection();
                return;
            }

            var foundWord = GameService.SubmitWord(_selectedPath, _gameState.Grid, _settings);
            
            if (foundWord != null)
            {
                _gameState.FoundWords.Add(foundWord);
                _gameState.Score += foundWord.Score;
                
                DebugHelper.Log($"Word '{foundWord.Word}' submitted successfully for {foundWord.Score} points");
                _errorMessage = null;
                
                // Show success feedback
                if (DebugHelper.IsDebugEnabled)
                {
                    _debugInfo = $"Added '{foundWord.Word}' for {foundWord.Score} points at {DateTime.Now:HH:mm:ss}";
                }
            }
            else
            {
                _errorMessage = $"'{_currentWord}' is not a valid word or is too short.";
                DebugHelper.Log($"Invalid word submission: '{_currentWord}'");
            }

            ClearSelection();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error submitting word: {ex.Message}";
            DebugHelper.LogError($"Error submitting word: {ex}");
            ClearSelection();
        }
    }

    private void ClearSelection()
    {
        _selectedPath.Clear();
        _currentWord = "";
        _isDragging = false;
        _errorMessage = null;
        
        if (_gameState != null)
        {
            GameService.ClearSelection(_gameState.Grid);
        }
        
        StateHasChanged();
    }

    private string GetCellClass(WordamentCell cell)
    {
        var classes = new List<string>();
        
        if (cell.IsSelected) classes.Add("selected");
        if (cell.IsHighlighted) classes.Add("highlighted");
        if (!_gameState?.IsGameActive ?? true) classes.Add("disabled");
        
        if (cell.IsSpecial)
        {
            classes.Add("special");
            classes.Add(cell.SpecialType switch
            {
                SpecialCellType.DoubleLetter => "double-letter",
                SpecialCellType.TripleLetter => "triple-letter", 
                SpecialCellType.DoubleWord => "double-word",
                SpecialCellType.TripleWord => "triple-word",
                _ => ""
            });
        }
        
        return string.Join(" ", classes.Where(c => !string.IsNullOrEmpty(c)));
    }

    private string GetCurrentWordClass()
    {
        if (string.IsNullOrEmpty(_currentWord)) return "";
        
        bool isValid = GameService.IsValidWord(_currentWord, _settings.MinWordLength);
        bool alreadyFound = _gameState?.FoundWords.Any(w => w.Word.Equals(_currentWord, StringComparison.OrdinalIgnoreCase)) ?? false;
        
        if (alreadyFound) return "invalid";
        return isValid ? "valid" : "invalid";
    }

    private string GetSpecialCellText(SpecialCellType type)
    {
        return type switch
        {
            SpecialCellType.DoubleLetter => "DL",
            SpecialCellType.TripleLetter => "TL",
            SpecialCellType.DoubleWord => "DW", 
            SpecialCellType.TripleWord => "TW",
            _ => ""
        };
    }

    private string FormatTime(TimeSpan time)
    {
        if (time.TotalSeconds <= 0) return "0:00";
        
        var minutes = (int)time.TotalMinutes;
        var seconds = time.Seconds;
        return $"{minutes}:{seconds:D2}";
    }

    public void Dispose()
    {
        _gameTimer?.Dispose();
        _gameTimer = null;
    }
}