            var position = new GridPosition(x, y);
            var positionChanged = await AddToPath(position);
            if (positionChanged)
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnDesktopDragBacktrack: {ex}");
