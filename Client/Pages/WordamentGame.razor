        try
        {
            LogTouch($"OnDesktopDragMove called with position ({x},{y})");
            var position = new GridPosition(x, y);
            var positionChanged = await AddToPath(position);
            if (positionChanged)
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnDesktopDragMove: {ex}");
        }
    }

    [JSInvokable]
    public async Task OnDesktopDragBacktrack(int x, int y)
    {
        if (_gameState == null || !_gameState.IsGameActive || !_isDragging) return;

