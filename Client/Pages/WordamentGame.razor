@page "/wordament"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@inject WordamentGameService GameService
@inject GameStateService StateService
@inject DebugHelper DebugHelper
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Wordament - 4x4 Word Game</PageTitle>

<div class="wordament-game-container">
    @if (_gameState == null)
    {
        <div class="text-center">
            <div class="loading-spinner"></div>
            <p>Loading game...</p>
            <button class="btn btn-primary" @onclick="StartNewGame">Start Game</button>
        </div>
    }
    else if (_gameState.IsGameComplete && _showGameOverScreen)
    {
        <!-- Game Over Screen -->
        <div class="game-over-overlay" @onclick="DismissGameOver">
            <div class="game-over-panel" @onclick:stopPropagation="true">
                <!-- MOBILE-FRIENDLY: Add close button in top-right corner -->
                <button class="modal-close-btn" @onclick="DismissGameOver" title="Close">
                    ✕
                </button>
                
                <h2 class="game-over-title">
                    @if (_settings.GameMode == WordamentGameMode.LongWord && _gameState.OriginalWordFound)
                    {
                        <span>🎉 You Found It! 🎉</span>
                    }
                    else
                    {
                        <span>🎮 Game Over! 🎮</span>
                    }
                </h2>
                
                @if (_settings.GameMode == WordamentGameMode.LongWord && _gameState.OriginalWordFound)
                {
                    <div style="text-align: center; margin: 20px 0;">
                        <h3 style="color: #28a745;">🎯 Target Word: @_gameState.OriginalWord</h3>
                        <p style="font-size: 1.2rem;">⏱️ Found in @FormatTime(_gameState.ElapsedTime)</p>
                    </div>
                }
                
                <div class="final-stats">
                    @if (_settings.GameMode == WordamentGameMode.Timer)
                    {
                        <div class="final-stat-item">
                            <div class="final-stat-value">@_gameState.Score</div>
                            <div class="final-stat-label">Final Score</div>
                        </div>
                        <div class="final-stat-item">
                            <div class="final-stat-value">@_gameState.FoundWords.Count</div>
                            <div class="final-stat-label">Words Found</div>
                        </div>
                    }
                    else
                    {
                        <div class="final-stat-item">
                            <div class="final-stat-value">@FormatTime(_gameState.ElapsedTime)</div>
                            <div class="final-stat-label">Time Taken</div>
                        </div>
                        <div class="final-stat-item">
                            <div class="final-stat-value">@_gameState.HintsUsed</div>
                            <div class="final-stat-label">Hints Used</div>
                        </div>
                    }
                    
                    <div class="final-stat-item">
                        <div class="final-stat-value">@(_gameState.FoundWords.Any() ? _gameState.FoundWords.Max(w => w.Word.Length) : 0)</div>
                        <div class="final-stat-label">Longest Word</div>
                    </div>
                </div>
                
                <!-- NEW: Show all possible words button for LongWord mode -->
                @if (_settings.GameMode == WordamentGameMode.LongWord && !string.IsNullOrEmpty(_gameState.OriginalWord))
                {
                    <div style="text-align: center; margin: 20px 0;">
                        @if (_allPossibleWords == null)
                        {
                            <button class="btn btn-secondary" @onclick="LoadAllPossibleWords" disabled="@_isLoadingWords">
                                @if (_isLoadingWords)
                                {
                                    <span>🔍 Finding words...</span>
                                }
                                else
                                {
                                    <span>📚 Show All Possible Words</span>
                                }
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-info" @onclick="() => _showAllWords = !_showAllWords">
                                @if (_showAllWords)
                                {
                                    <span>🔼 Hide Word List</span>
                                }
                                else
                                {
                                    <span>📚 Show All @_allPossibleWords.Count Words</span>
                                }
                            </button>
                        }
                    </div>
                }
                
                <!-- MOBILE-FRIENDLY: Action buttons row -->
                <div class="game-over-actions">
                    <button class="play-again-btn" @onclick="StartNewGame">
                        🆕 Play Again
                    </button>
                    <button class="view-results-btn" @onclick="DismissGameOver">
                        📊 View Results
                    </button>
                </div>
                
                <!-- MOBILE-FRIENDLY: Improved instruction text -->
                <div class="dismiss-instruction">
                    <span class="mobile-instruction">Tap "View Results" or ✕ to see word analysis</span>
                    <span class="desktop-instruction">Click anywhere outside to view results</span>
                </div>
            </div>
        </div>
    }
    else if (_gameState.IsGameComplete && !_showGameOverScreen)
    {
        <!-- Completed Game View - Show results and word lists -->
        <div class="completed-game-view">
            <div class="game-header">
                <h2>
                    @if (_settings.GameMode == WordamentGameMode.LongWord && _gameState.OriginalWordFound)
                    {
                        <span style="color: #28a745;">🎉 Victory! Target Word Found! 🎉</span>
                    }
                    else
                    {
                        <span style="color: #6c757d;">🎮 Game Completed 🎮</span>
                    }
                </h2>
                
                @if (_settings.GameMode == WordamentGameMode.LongWord)
                {
                    <div style="text-align: center; margin: 15px 0;">
                        <h3 style="color: #2c5aa0;">🎯 Target: @_gameState.OriginalWord (@_gameState.OriginalWord.Length letters)</h3>
                        <p>⏱️ Completed in @FormatTime(_gameState.ElapsedTime) with @_gameState.HintsUsed hints used</p>
                    </div>
                }
                
                <div class="text-center" style="margin: 15px 0;">
                    <button class="btn btn-primary" @onclick="StartNewGame">🆕 New Game</button>
                    <button class="btn btn-secondary" @onclick="() => _showGameOverScreen = true">📊 Show Summary</button>
                </div>
            </div>

            <!-- FIXED: Show the completed game grid for reference -->
            <div class="completed-grid-container">
                <h4 style="text-align: center; margin-bottom: 10px; color: #495057;">Game Grid</h4>
                <div class="wordament-grid-container">
                    <div class="wordament-grid completed-grid"
                         style="pointer-events: none; opacity: 0.9;">
                        @for (int y = 0; y < WordamentGrid.Size; y++)
                        {
                            @for (int x = 0; x < WordamentGrid.Size; x++)
                            {
                                var cell = _gameState.Grid.Cells[x, y];
                                var position = new GridPosition(x, y);

                                <div class="wordament-cell completed-cell"
                                     data-x="@x"
                                     data-y="@y">

                                    @if (cell.IsSpecial)
                                    {
                                        <div class="special-indicator">@GetSpecialCellText(cell.SpecialType)</div>
                                    }

                                    @cell.Letter
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Two-column layout for found words vs all possible words -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <!-- Left Column: Found Words -->
                <div class="found-words-section">
                    <h4>Your Words (@_gameState.FoundWords.Count found)</h4>
                    <div class="words-list multi-column">
                        @foreach (var word in _gameState.FoundWords.OrderBy(w => w.Word).ThenBy(w => w.Word.Length))
                        {
                            <div class="found-word @GetWordamentWordCssClass(word)" 
                                 title="@GetWordamentWordTooltip(word)">
                                @word.Word
                                @if (_settings.GameMode == WordamentGameMode.Timer && word.Score > 0)
                                {
                                    <div class="word-score">+@word.Score</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Right Column: All Possible Words (for LongWord mode) -->
                @if (_settings.GameMode == WordamentGameMode.LongWord)
                {
                    <div class="all-words-section">
                        <h4>
                            All Possible Words
                            @if (_allPossibleWords != null)
                            {
                                <span>(@_allPossibleWords.Count total)</span>
                            }
                        </h4>
                        
                        @if (_allPossibleWords == null)
                        {
                            <div class="text-center" style="padding: 20px;">
                                <button class="btn btn-info" @onclick="LoadAllPossibleWords" disabled="@_isLoadingWords">
                                    @if (_isLoadingWords)
                                    {
                                        <span class="loading-spinner" style="width: 20px; height: 20px; margin-right: 8px;"></span>
                                        <span>Finding words...</span>
                                    }
                                    else
                                    {
                                        <span>📚 Load All Words</span>
                                    }
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="words-list multi-column">
                                @foreach (var word in _allPossibleWords.OrderBy(w => w.Word.Length).ThenBy(w => w.Word))
                                {
                                    var isFound = _gameState.FoundWords.Any(fw => fw.Word.Equals(word.Word, StringComparison.OrdinalIgnoreCase));
                                    <div class="possible-word @GetPossibleWordClass(word, isFound)" 
                                         title="@GetPossibleWordTooltip(word, isFound)">
                                        @if (isFound)
                                        {
                                            <span style="text-decoration: none; font-weight: bold;">✓ @word.Word</span>
                                        }
                                        else
                                        {
                                            <span style="opacity: 0.7;">@word.Word</span>
                                        }
                                    </div>
                                }
                            </div>
                            
                            <!-- Word Statistics -->
                            <div style="margin-top: 15px; font-size: 0.9rem; color: #666;">
                                <div>Found: @_gameState.FoundWords.Count / @_allPossibleWords.Count words (@GetCompletionPercentage()%)</div>
                                <div>Missed: @(_allPossibleWords.Count - _gameState.FoundWords.Count) words</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- FIXED: Compact Stats and Settings Row -->
        <div class="stats-and-settings-row">
            <!-- Settings Button -->
            <button class="settings-button compact" @onclick="ShowSettings" title="Game Settings">
                <span class="icon-fallback">⚙️</span>
            </button>
            
            <!-- Game Stats -->
            <div class="game-stats compact">
                @if (_settings.GameMode == WordamentGameMode.Timer)
                {
                    <div class="stat-item">
                        <div class="stat-value">@_gameState.Score</div>
                        <div class="stat-label">Score</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value timer @(_gameState.TimeRemaining.TotalSeconds <= 30 ? "warning" : "")">
                            @FormatTime(_gameState.TimeRemaining)
                        </div>
                        <div class="stat-label">Time Left</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@_gameState.FoundWords.Count</div>
                        <div class="stat-label">Words</div>
                    </div>
                }
                else
                {
                    @* LongWord mode *@
                    <div class="stat-item">
                        <div class="stat-value timer">
                            @FormatTime(_gameState.ElapsedTime)
                        </div>
                        <div class="stat-label">Time</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@_gameState.HintsUsed</div>
                        <div class="stat-label">Hints Used</div>
                    </div>
                    @if (_settings.GameMode == WordamentGameMode.LongWord && GameService.AreHintsAvailable(_gameState))
                    {
                        <div class="stat-item">
                            <button class="hint-button-compact" @onclick="UseHint" title="Get Hint">
                                💭
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- FIXED: Current Word Display - Single hint source only -->
        <div class="current-word-display">
            <div class="current-word @GetCurrentWordClass()">
                @if (!string.IsNullOrEmpty(_hintDisplay))
                {
                    <span style="color: #007bff; font-style: italic;">💭 @_hintDisplay</span>
                }
                else if (!string.IsNullOrEmpty(_currentWord))
                {
                    @_currentWord
                }
                else
                {
                    @if (_settings.GameMode == WordamentGameMode.LongWord)
                    {
                        <span style="color: #999;">Find the hidden long word!</span>
                    }
                    else
                    {
                        <span style="color: #999;">Drag to connect letters and form a word</span>
                    }
                }
            </div>
        </div>

        <!-- 4x4 Grid with Touch/Drag Support -->
        <div class="wordament-grid-container" @ref="gridContainer">
            <div class="wordament-grid" 
                 @onmousedown="OnGridMouseDown"
                 @onmousemove="OnGridMouseMove"
                 @onmouseup="OnGridMouseUp"
                 @onmouseleave="OnGridMouseLeave"
                 @ontouchstart="OnGridTouchStart"
                 @ontouchstart:preventDefault="true"
                 @ontouchend="OnGridTouchEnd"
                 @ontouchend:preventDefault="true"
                 @ontouchmove="OnGridTouchMove"
                 @ontouchmove:preventDefault="true"
                 @oncontextmenu:preventDefault="true"
                 style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;">
                @for (int y = 0; y < WordamentGrid.Size; y++)
                {
                    @for (int x = 0; x < WordamentGrid.Size; x++)
                    {
                        var cell = _gameState.Grid.Cells[x, y];
                        var position = new GridPosition(x, y);
                        
                        <div class="wordament-cell @GetCellClass(cell)" 
                             data-x="@x" 
                             data-y="@y"
                             style="touch-action: none; user-select: none; -webkit-touch-callout: none; -webkit-user-select: none;">
                            
                            @if (cell.IsSpecial)
                            {
                                <div class="special-indicator">@GetSpecialCellText(cell.SpecialType)</div>
                            }
                            
                            @cell.Letter
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Game Controls -->
        <div class="wordament-controls">
            <button class="control-button new-game-button" @onclick="StartNewGame">
                <span class="icon-fallback">🆕</span><span class="text-fallback">NEW GAME</span>
            </button>
        </div>

        <!-- Found Words -->
        @if (_gameState.FoundWords.Any())
        {
            <div class="found-words-section">
                <h4>Found Words (@_gameState.FoundWords.Count)</h4>
                <div class="words-list multi-column">
                    @foreach (var word in _gameState.FoundWords.OrderBy(w => w.Word).ThenBy(w => w.Word.Length))
                    {
                        <div class="found-word @GetWordamentWordCssClass(word) @GetWordamentAnimationClass(word.Word)" 
                             title="@GetWordamentWordTooltip(word)">
                            @word.Word
                            @if (_settings.GameMode == WordamentGameMode.Timer)
                            {
                                <div class="word-score">+@word.Score</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message">
            @_errorMessage
        </div>
    }
</div>

<!-- Word List Modal for Game Over Screen (LongWord mode) -->
@if (_settings.GameMode == WordamentGameMode.LongWord && _showAllWords && _allPossibleWords != null)
{
    <div class="settings-modal-overlay" @onclick="() => _showAllWords = false">
        <div class="settings-modal-content" @onclick:stopPropagation="true" style="max-width: 700px; max-height: 80vh;">
            <div class="settings-header">
                <h2 class="settings-title">All Possible Words (@_allPossibleWords.Count)</h2>
                <button class="settings-close" @onclick="() => _showAllWords = false" title="Close">&times;</button>
            </div>
            
            <div class="settings-body" style="max-height: 60vh; overflow-y: auto;">
                <div style="margin-bottom: 15px;">
                    <strong>Target Word:</strong> @_gameState.OriginalWord (@_gameState.OriginalWord.Length letters)
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px;">
                    @foreach (var word in _allPossibleWords.OrderBy(w => w.Word.Length).ThenBy(w => w.Word))
                    {
                        var isFound = _gameState.FoundWords.Any(fw => fw.Word.Equals(word.Word, StringComparison.OrdinalIgnoreCase));
                        <div class="possible-word @GetPossibleWordClass(word, isFound)" 
                             title="@GetPossibleWordTooltip(word, isFound)"
                             style="padding: 6px; text-align: center; border-radius: 4px; font-size: 0.9rem;">
                            @if (isFound)
                            {
                                <span style="font-weight: bold;">✓ @word.Word</span>
                            }
                            else
                            {
                                <span style="opacity: 0.7;">@word.Word</span>
                            }
                        </div>
                    }
                </div>
                
                <div style="margin-top: 20px; padding: 10px; background: #f8f9fa; border-radius: 6px;">
                    <div><strong>Statistics:</strong></div>
                    <div>Found: @_gameState.FoundWords.Count / @_allPossibleWords.Count words (@GetCompletionPercentage()%)</div>
                    <div>Missed: @(_allPossibleWords.Count - _gameState.FoundWords.Count) words</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- FIXED: Settings Modal with proper styling -->
@if (_showSettings)
{
    <div class="settings-modal-overlay" @onclick="HideSettings">
        <div class="settings-modal-content" @onclick:stopPropagation="true">
            <div class="settings-header">
                <h2 class="settings-title">Game Settings</h2>
                <button class="settings-close" @onclick="HideSettings" title="Close">&times;</button>
            </div>
            
            <div class="settings-body">
                <div class="setting-group">
                    <label class="setting-label">Game Mode</label>
                    <div class="game-mode-options">
                        <div class="game-mode-option @(_tempSettings.GameMode == WordamentGameMode.Timer ? "selected" : "")"
                             @onclick="() => SelectGameMode(WordamentGameMode.Timer)">
                            <div class="mode-title">⏱️ Timer Mode</div>
                            <div class="mode-description">Find as many words as possible in 3 minutes</div>
                        </div>
                        <div class="game-mode-option @(_tempSettings.GameMode == WordamentGameMode.LongWord ? "selected" : "")"
                             @onclick="() => SelectGameMode(WordamentGameMode.LongWord)">
                            <div class="mode-title">🎯 Long Word</div>
                            <div class="mode-description">Race to find the hidden long word</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="settings-footer">
                <button class="settings-btn settings-btn-cancel" @onclick="HideSettings">
                    Cancel
                </button>
                <button class="settings-btn settings-btn-save" @onclick="SaveSettings">
                    Apply & New Game
                </button>
            </div>
        </div>
    </div>
}

@code {
    private WordamentGameState? _gameState;
    private WordamentSettings _settings = new();
    private WordamentSettings _tempSettings = new(); // For settings modal
    private List<GridPosition> _selectedPath = new();
    private string _currentWord = "";
    private string _hintDisplay = ""; // Store hint text separately
    private System.Threading.Timer? _gameTimer;
    private System.Threading.Timer? _hintTimer; // Timer for hint display
    private string? _errorMessage;
    private bool _isDragging = false;
    private ElementReference gridContainer;
    private bool _showSettings = false;
    
    // NEW: Game over screen control
    private bool _showGameOverScreen = true;
    
    // NEW: Animation support for found words
    private readonly HashSet<string> _recentlyAddedWords = new();

    // NEW: All possible words functionality
    private List<WordamentFoundWord>? _allPossibleWords = null;
    private bool _isLoadingWords = false;
    private bool _showAllWords = false;

    // Add reference for JavaScript interop
    private DotNetObjectReference<WordamentGame>? _dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            DebugHelper.Log("Wordament: OnInitializedAsync started");
            
            // Create DotNet reference for JavaScript callbacks
            _dotNetHelper = DotNetObjectReference.Create(this);
            
            // Load settings first from storage
            try
            {
                var savedSettings = await StateService.LoadWordamentSettingsAsync();
                if (savedSettings != null)
                {
                    _settings = savedSettings;
                    DebugHelper.Log($"Settings loaded from storage: GameMode={_settings.GameMode}");
                }
                else
                {
                    _settings = GameService.GetDefaultSettings();
                    DebugHelper.Log("Using default settings");
                }
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"Error loading settings, using defaults: {ex}");
                _settings = GameService.GetDefaultSettings();
            }
            
            _tempSettings = new WordamentSettings
            {
                GameDurationMinutes = _settings.GameDurationMinutes,
                MinWordLength = _settings.MinWordLength,
                ShowTimer = _settings.ShowTimer,
                AllowDiagonalMovement = _settings.AllowDiagonalMovement,
                ShowWordScores = _settings.ShowWordScores,
                IsDebugEnabled = _settings.IsDebugEnabled,
                GameMode = _settings.GameMode
            };

            // Try to restore previous game state
            var savedState = await StateService.LoadWordamentStateAsync();
            bool stateRestored = false;

            if (savedState?.GameState != null && savedState.GameState.IsGameActive)
            {
                DebugHelper.Log($"Restoring Wordament state - Score: {savedState.GameState.Score}, Words: {savedState.GameState.FoundWords.Count}");
                stateRestored = RestoreFromSavedState(savedState);
            }

            if (!stateRestored)
            {
                DebugHelper.Log("No saved state or restoration failed, starting new game...");
                await StartNewGame();
            }
            else
            {
                DebugHelper.Log("Wordament state successfully restored");
                _errorMessage = null;
                StateHasChanged();
            }
            
            DebugHelper.Log("Wordament: Initialization completed successfully");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to initialize game: {ex.Message}";
            DebugHelper.LogError($"Wordament initialization error: {ex}");
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            try
            {
                // Register this game component with the state manager and JavaScript
                await JSRuntime.InvokeVoidAsync("registerWordamentBlazorComponent", _dotNetHelper);
                DebugHelper.Log("Wordament registered with JavaScript");
                
                // Initialize Wordament-specific functionality
                await JSRuntime.InvokeVoidAsync("initializeWordament");
                DebugHelper.Log("Wordament JavaScript initialized");
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"Error initializing Wordament JavaScript: {ex}");
            }
        }
    }

    // NEW: Load all possible words from original word
    private async Task LoadAllPossibleWords()
    {
        if (_gameState == null || string.IsNullOrEmpty(_gameState.OriginalWord) || _isLoadingWords)
            return;

        try
        {
            _isLoadingWords = true;
            StateHasChanged();

            DebugHelper.Log($"Loading all possible words using optimized tree-pruning method for original word: '{_gameState.OriginalWord}'");
            
            // FIXED: Use the optimized tree-pruning subword method designed specifically for finding words from letters
            _allPossibleWords = await GameService.GetOriginalWordSubwordsOptimizedAsync(_gameState.OriginalWord, _settings.MinWordLength);
            
            DebugHelper.Log($"Loaded {_allPossibleWords.Count} possible words that can be formed from '{_gameState.OriginalWord}' using optimized tree-pruning");
            
            _isLoadingWords = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error loading all possible words: {ex}");
            _errorMessage = $"Error loading word list: {ex.Message}";
            _isLoadingWords = false;
            StateHasChanged();
        }
    }

    // NEW: Get completion percentage
    private int GetCompletionPercentage()
    {
        if (_allPossibleWords == null || _allPossibleWords.Count == 0)
            return 0;
        
        var foundCount = _gameState?.FoundWords.Count ?? 0;
        return (int)Math.Round((double)foundCount / _allPossibleWords.Count * 100);
    }

    // NEW: Get CSS class for possible words
    private string GetPossibleWordClass(WordamentFoundWord word, bool isFound)
    {
        var baseClass = word.GetDisplayClass();
        
        if (isFound)
        {
            return $"{baseClass} found-word";
        }
        else
        {
            return $"{baseClass} missed-word";
        }
    }

    // NEW: Get tooltip for possible words
    private string GetPossibleWordTooltip(WordamentFoundWord word, bool isFound)
    {
        var tooltip = $"'{word.Word}' - {word.Word.Length} letters";
        
        // Add word type information
        var typeText = word.WordType switch
        {
            FoundWordType.SubWordInGrid => "In Grid",
            FoundWordType.SubWordInLargeDictionary => "Large Dictionary",
            FoundWordType.SubWordNotInGrid => "Small Dictionary", 
            FoundWordType.SubWordNotAWord => "Not in Dictionary",
            _ => "Unknown"
        };
        tooltip += $" ({typeText})";
        
        if (isFound)
        {
            tooltip += " - ✓ Found by you!";
        }
        else
        {
            tooltip += " - Missed";
        }
        
        return tooltip;
    }

    // Settings Modal Methods
    private void ShowSettings()
    {
        _tempSettings = new WordamentSettings
        {
            GameDurationMinutes = _settings.GameDurationMinutes,
            MinWordLength = _settings.MinWordLength,
