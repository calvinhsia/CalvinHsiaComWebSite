        if (_gameState == null || !_gameState.IsGameActive) return;

        try
        {
            LogTouch($"OnDesktopDragStart called with position ({x},{y})");
            var position = new GridPosition(x, y);
            StartSelection(position);
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error in OnDesktopDragStart: {ex}");
        }
    }

    [JSInvokable]
    public async Task OnDesktopDragMove(int x, int y)
    {
