    // Helper Methods
    private async Task<GridPosition?> GetGridPositionFromEvent(double clientX, double clientY)
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<int[]>("getWordamentCellFromCoordinates", gridContainer, clientX, clientY);
            if (result != null && result.Length == 2)
            {
                var x = result[0];
                var y = result[1];
                if (x >= 0 && x < WordamentGrid.Size && y >= 0 && y < WordamentGrid.Size)
                {
                    return new GridPosition(x, y);
                }
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error getting grid position: {ex}");
        }
        return null;
    }

    private void StartSelection(GridPosition position)
    {
        _selectedPath.Clear();
        _selectedPath.Add(position);
        _isDragging = true;
        
        // Clear the last submitted word when starting a new selection (like WordScape)
        if (_gameState != null)
        {
            _gameState.LastSubmittedWord = "";
            _gameState.LastSubmittedWordType = FoundWordType.SubWordNotAWord;
            _gameState.LastSubmittedWordWasAlreadyFound = false;
        }
        
        UpdateCurrentWord();
        GameService.UpdateSelection(_selectedPath, _gameState!.Grid);
        StateHasChanged();
    }

    private async Task<bool> AddToPath(GridPosition position)
    {
        if (_selectedPath.Count == 0) return false;
        await Task.Yield();

        var lastPosition = _selectedPath.Last();
        
        if (_selectedPath.Any(p => p.Equals(position)))
        {
            if (_selectedPath.Count > 1 && _selectedPath[_selectedPath.Count - 2].Equals(position))
            {
                _selectedPath.RemoveAt(_selectedPath.Count - 1);
                UpdateCurrentWord();
                GameService.UpdateSelection(_selectedPath, _gameState!.Grid);
                StateHasChanged();
                return true;
            }
            return false;
        }

        if (_gameState!.Grid.AreAdjacent(lastPosition, position))
        {
            _selectedPath.Add(position);
            UpdateCurrentWord();
            GameService.UpdateSelection(_selectedPath, _gameState.Grid);
            StateHasChanged();
            return true;
        }
        
        return false;
    }

    private async Task EndSelection()
    {
        _isDragging = false;
        
        if (_selectedPath.Count > 0 && !string.IsNullOrEmpty(_currentWord))
        {
            if (_currentWord.Length >= _settings.MinWordLength)
            {
                await SubmitCurrentWord();
                return;
            }
        }
        
        await ClearSelection();
    }

    private void UpdateCurrentWord()
    {
        if (_gameState == null) return;
        _currentWord = GameService.GetWordFromPath(_selectedPath, _gameState.Grid);
    }

    private async Task SubmitCurrentWord()
    {
        if (_gameState == null || string.IsNullOrEmpty(_currentWord) || !_gameState.IsGameActive) return;

        try
        {
            if (_gameState.FoundWords.Any(w => w.Word.Equals(_currentWord, StringComparison.OrdinalIgnoreCase)))
            {
                // Word was already found - use special method for white background like WordScape
                GameService.UpdateLastSubmittedWordAsAlreadyFound(_gameState, _currentWord);
                
                _errorMessage = "Word already found!";
                await ClearSelection();
                return;
            }

            var foundWord = GameService.SubmitWord(_selectedPath, _gameState.Grid, _settings);
            
            if (foundWord != null)
            {
                _gameState.FoundWords.Add(foundWord);
                AnimateNewWord(foundWord.Word);
                
                // NEW: Track the submitted word for persistent display
                GameService.UpdateLastSubmittedWord(_gameState, foundWord.Word, foundWord.WordType);
                
                if (_settings.GameMode == WordamentGameMode.Timer && foundWord.Score > 0)
                {
                    _gameState.Score += foundWord.Score;
                }
                
                if (_settings.GameMode == WordamentGameMode.LongWord && 
                    foundWord.Word.Equals(_gameState.OriginalWord, StringComparison.OrdinalIgnoreCase))
                {
                    _gameState.OriginalWordFound = true;
                    _gameState.IsGameActive = false;
                    LogDebug($"GAME WON! Original word '{foundWord.Word}' found!");
                }
                
                LogDebug($"Word '{foundWord.Word}' submitted successfully - Type: {foundWord.WordType}, Score: {foundWord.Score}");
                _errorMessage = null;

                await SaveGameState();
            }
            else
            {
                // Word was rejected (likely too short) - still classify it for display
                var wordType = GameService.ValidateWordType(_currentWord);
                GameService.UpdateLastSubmittedWord(_gameState, _currentWord, wordType);
                
                _errorMessage = $"'{_currentWord}' is too short (minimum {_settings.MinWordLength} letters).";
                LogDebug($"Word submission rejected: '{_currentWord}' (likely too short)");
            }

            await ClearSelection();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error submitting word: {ex.Message}";
            DebugHelper.LogError($"Error submitting word: {ex}");
            await ClearSelection();
        }
    }

    private async Task ClearSelection()
    {
        _selectedPath.Clear();
        _currentWord = "";
        _isDragging = false;
        _errorMessage = null;
        
        if (_gameState != null)
        {
            GameService.ClearSelection(_gameState.Grid);
            _gameState.SelectedPath = _selectedPath;
            _gameState.CurrentPath = _currentWord;
            // Note: We don't clear LastSubmittedWord here - let it persist for display
            await SaveGameState();
        }
        
        StateHasChanged();
    }

    private async Task UseHint()
    {
        if (_gameState == null || _settings.GameMode != WordamentGameMode.LongWord) return;

        try
        {
            var hint = GameService.UseHint(_gameState);
            if (!string.IsNullOrEmpty(hint))
            {
                LogDebug($"Hint used: {hint}");
                
                _hintDisplay = hint;
                StateHasChanged();
                
                _hintTimer?.Dispose();
                _hintTimer = new System.Threading.Timer(_ => 
                {
                    _hintDisplay = "";
                    InvokeAsync(StateHasChanged);
                }, null, 2000, Timeout.Infinite);
                
                await SaveGameState();
            }
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error using hint: {ex}");
            _errorMessage = $"Error using hint: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task DismissGameOver()
    {
        _showGameOverScreen = false;
        
        // Load all possible words if not already loaded
        if (_gameState != null && _gameState.IsGameComplete && _allPossibleWords == null && !_isLoadingWords)
        {
            LogDebug("Game results view opened - loading all possible words");
            _ = InvokeAsync(LoadAllPossibleWords);
        }
        
        StateHasChanged();
    }

    private void ToggleSettings()
    {
        if (_showSettings)
        {
            _showSettings = false;
        }
        else
        {
            // Copy current settings to temp settings for editing
            _tempSettings = new WordamentSettings
            {
                GameMode = _settings.GameMode,
                MinWordLength = _settings.MinWordLength,
                GameDurationMinutes = _settings.GameDurationMinutes,
                IsDebugEnabled = _settings.IsDebugEnabled
            };
            _showSettings = true;
        }
        StateHasChanged();
    }

    private void CancelSettings()
    {
        _showSettings = false;
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        try
        {
            // Copy temp settings to actual settings
            _settings.GameMode = _tempSettings.GameMode;
            _settings.MinWordLength = _tempSettings.MinWordLength;
            _settings.GameDurationMinutes = _tempSettings.GameDurationMinutes;
            
            // Handle debug mode change
            var debugModeChanged = _settings.IsDebugEnabled != _tempSettings.IsDebugEnabled;
            _settings.IsDebugEnabled = _tempSettings.IsDebugEnabled;
            
            if (debugModeChanged)
            {
                DebugHelper.SetDebugMode(_settings.IsDebugEnabled);
                GameService.OnDebugModeChanged(); // Notify service of debug mode change
                LogDebug($"Debug mode changed to: {_settings.IsDebugEnabled}");
                
                // Set JavaScript debug mode to match C# debug mode
                try
                {
                    await JSRuntime.InvokeVoidAsync("setWordamentDebugMode", _settings.IsDebugEnabled, true);
                    LogDebug($"JavaScript debug mode set to: {_settings.IsDebugEnabled}");
                }
                catch (Exception jsEx)
                {
                    DebugHelper.LogError($"Error setting JavaScript debug mode: {jsEx.Message}");
                }
            }

            // Save to storage
            await StateService.SaveWordamentSettingsAsync(_settings);
            
            _showSettings = false;
            _errorMessage = debugModeChanged 
                ? $"Settings saved! Debug mode {(_settings.IsDebugEnabled ? "enabled" : "disabled")} for both C# and JavaScript. Start a new game to apply changes."
                : "Settings saved! Start a new game to apply changes.";
            
            // Auto-clear the message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _errorMessage = null;
                InvokeAsync(StateHasChanged);
            });
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving settings: {ex.Message}";
            DebugHelper.LogError($"Error saving Wordament settings: {ex}");
            StateHasChanged();
        }
    }

    private void AnimateNewWord(string word)
    {
        try
        {
            if (string.IsNullOrEmpty(word)) return;

            _recentlyAddedWords.Add(word);
            StateHasChanged();

            var timer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    _recentlyAddedWords.Remove(word);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    DebugHelper.LogError($"AnimateNewWord timer error: {ex}");
                }
            }, null, 3000, Timeout.Infinite);
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"AnimateNewWord error: {ex}");
        }
    }

    // UI Helper Methods
    private string GetCurrentWordClass()
    {
        if (string.IsNullOrEmpty(_currentWord)) return "";
        
        if (_currentWord.Length < _settings.MinWordLength) return "invalid";
        
        bool alreadyFound = _gameState?.FoundWords.Any(w => w.Word.Equals(_currentWord, StringComparison.OrdinalIgnoreCase)) ?? false;
        if (alreadyFound) return "invalid";
        
        bool isInDictionary = GameService.IsValidWordForUI(_currentWord, _settings.MinWordLength);
        return isInDictionary ? "valid" : "";
    }
    
    // NEW: Helper methods for persistent word display
    private string GetCurrentWordToDisplay()
    {
        // If currently selecting letters, show the current word being formed
        if (_isDragging && !string.IsNullOrEmpty(_currentWord))
        {
            return _currentWord;
        }
        
        // Otherwise, show the last submitted word (no timeout - persist until new word is formed)
        if (_gameState != null && !string.IsNullOrEmpty(_gameState.LastSubmittedWord))
        {
            return _gameState.LastSubmittedWord;
        }
        
        return "";
    }
    
    private string GetCurrentWordDisplayClass()
    {
        // If currently selecting letters, use dynamic validation coloring
        if (_isDragging && !string.IsNullOrEmpty(_currentWord))
        {
            return GetCurrentWordClass();
        }
        
        // Otherwise, use the classification of the last submitted word (no timeout)
        if (_gameState != null && !string.IsNullOrEmpty(_gameState.LastSubmittedWord))
        {
            // Check if it was an already found word (white background like WordScape)
            if (_gameState.LastSubmittedWordWasAlreadyFound)
            {
                return "word-already-found";
            }
            
            return GetWordTypeDisplayClass(_gameState.LastSubmittedWordType);
        }
        
        return "";
    }
    
    private string GetWordTypeDisplayClass(FoundWordType wordType)
    {
        return wordType switch
        {
            FoundWordType.SubWordInGrid => "word-in-grid",           // Dark Cyan (should match found words)
            FoundWordType.SubWordInLargeDictionary => "word-in-large-dict", // Light Sea Green
            FoundWordType.SubWordNotInGrid => "word-in-small-dict",  // Sky Blue
            FoundWordType.SubWordNotAWord => "word-not-found",       // Light Pink - includes already found words
            _ => "word-not-found"
        };
    }

    private static IOrderedEnumerable<WordamentFoundWord> SortWordsByDictionaryAndAlpha(IEnumerable<WordamentFoundWord> words)
    {
        return words
            .OrderBy(w => w.WordType == FoundWordType.SubWordInLargeDictionary ? 1 : 0)
            .ThenBy(w => w.Word, StringComparer.OrdinalIgnoreCase);
    }

    private string GetWordamentWordCssClass(WordamentFoundWord word)
    {
        var baseClass = word.GetDisplayClass();
        
        if (word.IsLongestWord) return $"{baseClass} word-longest";
        if (word.IsRareWord) return $"{baseClass} word-rare";
        if (word.Word.Length >= 6) return $"{baseClass} word-long";
        
        return baseClass;
    }

    private string GetWordamentAnimationClass(string word)
    {
        return _recentlyAddedWords.Contains(word) ? "newly-added" : "";
    }

    private string GetWordamentWordTooltip(WordamentFoundWord word)
    {
        var tooltip = $"'{word.Word}' - {word.Word.Length} letters";
        
        var typeText = word.WordType switch
        {
            FoundWordType.SubWordInGrid => "In Grid",
            FoundWordType.SubWordInLargeDictionary => "Large Dictionary",
            FoundWordType.SubWordNotInGrid => "Small Dictionary", 
            FoundWordType.SubWordNotAWord => "Not in Dictionary",
            _ => "Unknown"
        };
        tooltip += $" ({typeText})";
        
        if (_settings.GameMode == WordamentGameMode.Timer)
        {
            tooltip += $", {word.Score} points";
        }
        
        if (word.IsLongestWord) tooltip += " (Longest)";
        if (word.IsRareWord) tooltip += " (Rare)";
        
        return tooltip;
    }

    private string GetSpecialCellText(SpecialCellType type)
    {
        return type switch
        {
            SpecialCellType.DoubleLetter => "DL",
            SpecialCellType.TripleLetter => "TL",
            SpecialCellType.DoubleWord => "DW", 
            SpecialCellType.TripleWord => "TW",
            _ => ""
        };
    }

    private string FormatTime(TimeSpan time)
    {
        if (time.TotalSeconds <= 0) return "0:00";
        
        var minutes = (int)time.TotalMinutes;
        var seconds = time.Seconds;
        return $"{minutes}:{seconds:D2}";
    }

    private string GetCellClass(WordamentCell cell)
    {
        var classes = new List<string>();
        
        if (cell.IsSelected) classes.Add("selected");
        if (cell.IsHighlighted) classes.Add("highlighted");
        if (!_gameState?.IsGameActive ?? true) classes.Add("disabled");
        
        if (cell.IsSpecial)
        {
            classes.Add("special");
            classes.Add(cell.SpecialType switch
            {
                SpecialCellType.DoubleLetter => "double-letter",
                SpecialCellType.TripleLetter => "triple-letter", 
                SpecialCellType.DoubleWord => "double-word",
                SpecialCellType.TripleWord => "triple-word",
                _ => ""
            });
        }
        
        var result = string.Join(" ", classes.Where(c => !string.IsNullOrEmpty(c)));
        return result;
    }

