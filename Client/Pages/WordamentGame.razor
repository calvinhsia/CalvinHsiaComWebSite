    // Helper method to get words that the user missed
    private List<WordamentFoundWord> GetMissedWords()
    {
        if (_allPossibleWords == null || _gameState == null) return new List<WordamentFoundWord>();
        
        return _allPossibleWords.Where(w => !_gameState.FoundWords.Any(fw => fw.Word.Equals(w.Word, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    public void Dispose()
    {
        try
        {
            _gameTimer?.Dispose();
            _gameTimer = null;
            
            _hintTimer?.Dispose();
            _hintTimer = null;
            
            if (_gameState != null)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await SaveGameState();
                    }
                    catch (Exception ex)
                    {
                        DebugHelper.LogError($"Error saving state on dispose: {ex}");
                    }
                });
            }

            _dotNetHelper?.Dispose();
            _jsInitialized = false; // Reset JavaScript initialization flag
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"Error during disposal: {ex}");
        }
    }
