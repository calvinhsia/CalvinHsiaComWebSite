@page "/hearts"
@using Microsoft.AspNetCore.Authorization
@using Client.Games.Cards.Models
@using Client.Games.Cards.Services
@using WordScapeBlazorWasm.Services
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@inject RandomService RandomService
@inject CssLoaderService CssLoader
@inject Client.Services.ApplicationInsightsLogger AppInsights
@implements IAsyncDisposable
@attribute [AllowAnonymous]

<PageTitle>Hearts - Card Game</PageTitle>

<div class="hearts-container">
    <!-- Top Controls -->
    <div class="hearts-controls">
        <div class="hearts-stats">
            <span class="stat-item">Round: @_game.RoundNumber</span>
            <span class="stat-item">Pass: @GetPassDirectionDisplay()</span>
            @if (_game.Phase == HeartsPhase.GameEnd)
            {
                var winner = _game.GetWinner();
                <span class="stat-item win-message">🎉 @(winner?.Name ?? "Unknown") Wins!</span>
            }
        </div>
        <div class="hearts-buttons">
            <button @onclick="NewGame" class="btn-game" title="Start new game">🔄 New Game</button>
        </div>
    </div>

    <!-- Game Area -->
    <div class="hearts-game">
        <!-- Scoreboard -->
        <div class="scoreboard">
            <h4>Scores</h4>
            @foreach (var player in _game.Players)
            {
                <div class="player-score @(player.IsHuman ? "human" : "")">
                    <span class="player-name">@player.Name</span>
                    <span class="score-value">@player.TotalScore</span>
                    @if (_game.Phase == HeartsPhase.RoundEnd || _game.Phase == HeartsPhase.GameEnd)
                    {
                        <span class="round-score">(+@player.RoundScore)</span>
                    }
                </div>
            }
        </div>

        <!-- Main Game Board -->
        <div class="hearts-board">
            <!-- Top Player (North - Player 2) -->
            <div class="player-area player-north">
                <div class="player-label">@_game.Players[2].Name</div>
                <div class="player-cards">
                    @for (int i = 0; i < _game.Players[2].Hand.Count; i++)
                    {
                        <PlayingCard ShowBack="true" IsMini="true" />
                    }
                </div>
                @if (_game.CurrentPlayerIndex == 2 && _game.Phase == HeartsPhase.Playing && !_game.HasCompletedTrick && !_isCollectingTrick)
                {
                    <div class="turn-indicator">⬆️ Thinking...</div>
                }
            </div>

            <!-- Left Player (West - Player 1) -->
            <div class="player-area player-west">
                <div class="player-label">@_game.Players[1].Name</div>
                <div class="player-cards vertical">
                    @for (int i = 0; i < _game.Players[1].Hand.Count; i++)
                    {
                        <PlayingCard ShowBack="true" IsMini="true" />
                    }
                </div>
                @if (_game.CurrentPlayerIndex == 1 && _game.Phase == HeartsPhase.Playing && !_game.HasCompletedTrick && !_isCollectingTrick)
                {
                    <div class="turn-indicator">⬅️ Thinking...</div>
                }
            </div>

            <!-- Center Trick Area -->
            <div class="trick-area">
                @if (_game.HasCompletedTrick || _game.CurrentTrick.Count > 0)
                {
                    <!-- PRIORITY: Show trick cards (including 13th trick before RoundEnd message) -->
                    <div class="trick-cards">
                        @{
                            // Show LastCompletedTrick if it has cards (so we can see the 4th card before collection)
                            // Otherwise show CurrentTrick (cards 1-3 as they're being played)
                            var trickToShow = _game.HasCompletedTrick 
                                ? _game.LastCompletedTrick 
                                : _game.CurrentTrick;
                            var winnerIndex = _isCollectingTrick ? _game.LastTrickWinnerIndex : -1;
                        }
                        @foreach (var (playerIndex, card) in trickToShow)
                        {
                            var position = GetTrickPosition(playerIndex);
                            var animateIn = _animatingCardPlayers.Contains(playerIndex) ? $"animate-from-{position}" : "";
                            var collectTo = _isCollectingTrick && winnerIndex >= 0 ? $"collect-to-{GetTrickPosition(winnerIndex)}" : "";
                            <div class="trick-card @position @animateIn @collectTo">
                                <PlayingCard CardData="@card" />
                            </div>
                        }
                    </div>
                    @if (_game.HeartsBroken)
                    {
                        <div class="hearts-broken">♥ Hearts Broken!</div>
                    }
                }
                else if (_game.Phase == HeartsPhase.Passing)
                {
                    <div class="phase-message">
                        <h3>Pass 3 Cards @GetPassDirectionDisplay()</h3>
                        <p>Select 3 cards from your hand</p>
                        @if (_game.Players[0].CardsToPass.Count == 3)
                        {
                            <button @onclick="ExecutePass" class="btn-pass">Pass Cards</button>
                        }
                    </div>
                }
                else if (_game.Phase == HeartsPhase.RoundEnd)
                {
                    <div class="phase-message">
                        <h3>Round Complete!</h3>
                        <p>Click to continue</p>
                        <button @onclick="StartNextRound" class="btn-continue">Continue</button>
                    </div>
                }
                else if (_game.Phase == HeartsPhase.GameEnd)
                {
                    <div class="phase-message">
                        <h3>Game Over!</h3>
                        <p>@_game.GetWinner()?.Name wins with @_game.GetWinner()?.TotalScore points!</p>
                    </div>
                }
            </div>

            <!-- Right Player (East - Player 3) -->
            <div class="player-area player-east">
                <div class="player-label">@_game.Players[3].Name</div>
                <div class="player-cards vertical">
                    @for (int i = 0; i < _game.Players[3].Hand.Count; i++)
                    {
                        <PlayingCard ShowBack="true" IsMini="true" />
                    }
                </div>
                @if (_game.CurrentPlayerIndex == 3 && _game.Phase == HeartsPhase.Playing && !_game.HasCompletedTrick && !_isCollectingTrick)
                {
                    <div class="turn-indicator">➡️ Thinking...</div>
                }
            </div>

            <!-- Bottom Player (You - Player 0) -->
            <div class="player-area player-south">
                @if (_game.CurrentPlayerIndex == 0 && _game.Phase == HeartsPhase.Playing && !_game.HasCompletedTrick && !_isCollectingTrick)
                {
                    <div class="turn-indicator">Your Turn!</div>
                }
                <div class="player-hand">
                    @for (int i = 0; i < _game.Players[0].Hand.Count; i++)
                    {
                        var card = _game.Players[0].Hand[i];
                        var cardIndex = i;
                        var isSelected = _game.Players[0].CardsToPass.Contains(card);
                        var isPlayable = _game.Phase == HeartsPhase.Playing && 
                                        _game.CurrentPlayerIndex == 0 && 
                                        _game.CanPlayCard(0, card);
                        <PlayingCard @key="card"
                                     CardData="@card"
                                     IsSelected="@isSelected"
                                     CssClass="@($"hand-card {(isPlayable ? "playable" : "")}")"
                                     OnClick="@(() => OnCardClick(cardIndex))" />
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Instructions -->
    <div class="hearts-info">
        <p>
            <strong>Hearts</strong> - Avoid taking hearts (1 pt each) and the Queen of Spades (13 pts).
            Lowest score wins when someone reaches @_game.GameEndScore points.
        </p>
        <p>
            💡 <strong>Tips:</strong> Must follow suit if possible. Hearts can't be led until broken.
            "Shooting the Moon" (taking all 26 pts) gives everyone else 26 points instead!
        </p>
    </div>
</div>

@code {
    private HeartsGameService _game = null!;
    private DotNetObjectReference<Hearts>? _dotNetRef;
    private System.Threading.Timer? _aiTimer;
    private bool _aiPlaying = false;

    // Animation state
    private HashSet<int> _animatingCardPlayers = new(); // Players whose cards should animate in
    private bool _isCollectingTrick = false;
    private bool _isTrickAnimating = false;  // True during entire trick completion sequence
    private const int CardPlayDelayMs = 600;  // Delay between each card play
    private const int TrickViewDelayMs = 1200; // Time to view completed trick before collection
    private const int CollectAnimationMs = 500; // Collection animation duration

    protected override void OnInitialized()
    {
        DebugHelper.Log($"[Hearts v4] OnInitialized - fixed card flickering with @key", true);
        var random = RandomService.GetRandom();
        _game = new HeartsGameService(random);
        
        // AI players select their cards to pass
        InitializeAIPass();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load CSS on demand
            await CssLoader.LoadCssFilesAsync(
                (GameCss.PlayingCards.Path, GameCss.PlayingCards.Version),
                (GameCss.Hearts.Path, GameCss.Hearts.Version));
            _ = AppInsights.TrackPageActivationAsync("Hearts");

            _dotNetRef = DotNetObjectReference.Create(this);
            DebugHelper.Log("[Hearts] Component rendered", true);
            
            // Start AI timer for playing phase
            _aiTimer = new System.Threading.Timer(AITimerCallback, null, 500, 1000);
        }
        await Task.CompletedTask;
    }

    private void InitializeAIPass()
    {
        if (_game.Phase == HeartsPhase.Passing)
        {
            for (int i = 1; i < 4; i++)
            {
                _game.AISelectCardsToPass(i);
            }
        }
    }

    private void AITimerCallback(object? state)
    {
        if (_aiPlaying || _isCollectingTrick || _isTrickAnimating) return;

        // Quick check - if it's human's turn and no uncollected trick, skip entirely
        if (_game.CurrentPlayerIndex == 0 && !_game.HasCompletedTrick) return;

        InvokeAsync(async () =>
        {
            // Handle any uncollected completed trick first
            if (_game.HasCompletedTrick && !_isCollectingTrick && !_isTrickAnimating)
            {
                DebugHelper.Log("[Hearts v4] AI timer found uncollected trick, collecting...", true);
                await HandleTrickCompletionAsync();
                return;
            }

            if (_game.Phase == HeartsPhase.Playing && 
                _game.CurrentPlayerIndex != 0 && 
                !_isCollectingTrick &&
                !_isTrickAnimating &&
                !_game.HasCompletedTrick)
            {
                await PlaySingleAICardAsync();
            }
        });
    }

    private async Task PlaySingleAICardAsync()
    {
        if (_aiPlaying || _isCollectingTrick || _isTrickAnimating) return;
        if (_game.Phase != HeartsPhase.Playing || _game.CurrentPlayerIndex == 0) return;
        if (_game.HasCompletedTrick) return; // Don't play if there's an uncollected trick

        _aiPlaying = true;

        try
        {
            var playerIndex = _game.CurrentPlayerIndex;
            var trickCountBefore = _game.CurrentTrick.Count;
            var played = _game.AIPlayCard(playerIndex);

            if (played != null)
            {
                // Mark this card for fly-in animation
                _animatingCardPlayers.Add(playerIndex);
                DebugHelper.Log($"[Hearts v2] AI {_game.Players[playerIndex].Name} played {played}", true);
                StateHasChanged();

                // Wait for animation
                await Task.Delay(CardPlayDelayMs);

                // Clear animation flag
                _animatingCardPlayers.Remove(playerIndex);

                // Check if trick is complete (4 cards were played, now reset to 0 or fewer)
                if (_game.CurrentTrick.Count == 0 && trickCountBefore == 3)
                {
                    // Trick just completed - show collection animation
                    await HandleTrickCompletionAsync();
                }

                StateHasChanged();
            }
        }
        finally
        {
            _aiPlaying = false;
        }
    }

    private async Task HandleTrickCompletionAsync()
    {
        if (!_game.HasCompletedTrick || _game.LastTrickWinnerIndex < 0 || _game.LastTrickWinnerIndex >= _game.Players.Count) return;

        // Block all AI play during the entire trick completion sequence
        _isTrickAnimating = true;

        try
        {
            // Capture winner index at start to avoid race conditions
            var winnerIndex = _game.LastTrickWinnerIndex;
            
            // Show the completed trick for a moment so player can see all cards
            _isCollectingTrick = false;  // Not collecting yet, just viewing
            StateHasChanged();
            await Task.Delay(TrickViewDelayMs);

            // Now trigger collection animation
            _isCollectingTrick = true;
            DebugHelper.Log($"[Hearts v5] Trick won by {_game.Players[winnerIndex].Name}", true);
            StateHasChanged();

            // Wait for collection animation
            await Task.Delay(CollectAnimationMs);

            // Clear completed trick state
            _isCollectingTrick = false;
            _game.ClearCompletedTrick();
            StateHasChanged();
        }
        finally
        {
            _isTrickAnimating = false;
        }
    }

    private async Task ShowTrickCollectionAsync()
    {
        // Called when human plays the 4th card - trick was just completed
        await HandleTrickCompletionAsync();
    }

    private void PlayAITurn()
    {
        // Legacy method - now async version is preferred
        // Keep for compatibility during transition
        if (_aiPlaying || _isCollectingTrick || _isTrickAnimating) return;
        _ = PlaySingleAICardAsync();
    }

    private void NewGame()
    {
        DebugHelper.Log("[Hearts] Starting new game", true);

        // Clear all animation state
        _animatingCardPlayers.Clear();
        _isCollectingTrick = false;
        _isTrickAnimating = false;
        _aiPlaying = false;

        // Clear any completed trick from previous game
        _game.ClearCompletedTrick();

        _game.InitializeGame();
        InitializeAIPass();
        StateHasChanged();
    }

    private void StartNextRound()
    {
        // Clear animation state
        _animatingCardPlayers.Clear();
        _isCollectingTrick = false;
        _isTrickAnimating = false;

        _game.StartNewRound();
        InitializeAIPass();
        StateHasChanged();
    }

    private async void OnCardClick(int cardIndex)
    {
        var card = _game.Players[0].Hand[cardIndex];

        if (_game.Phase == HeartsPhase.Passing)
        {
            // Toggle card selection for passing
            _game.SelectCardToPass(0, card);

            // Log selected cards for debugging
            var selectedCards = _game.Players[0].CardsToPass;
            DebugHelper.Log($"[Hearts v2] Card clicked: {card}. Selected count: {selectedCards.Count}", true);
            foreach (var c in selectedCards)
            {
                DebugHelper.Log($"[Hearts v2]   - Selected: {c}", true);
            }

            StateHasChanged();
        }
        else if (_game.Phase == HeartsPhase.Playing && _game.CurrentPlayerIndex == 0 && !_isCollectingTrick && !_isTrickAnimating)
        {
            // Try to play the card
            if (_game.CanPlayCard(0, card))
            {
                var trickCountBefore = _game.CurrentTrick.Count;
                _game.PlayCard(0, card);

                // Mark for animation
                _animatingCardPlayers.Add(0);
                DebugHelper.Log($"[Hearts v2] You played {card}", true);
                StateHasChanged();

                // Wait for card animation
                await Task.Delay(CardPlayDelayMs);
                _animatingCardPlayers.Remove(0);

                // Check if trick just completed (we were the 4th card)
                if (_game.CurrentTrick.Count == 0 && trickCountBefore == 3)
                {
                    // The trick was just completed and cleared
                    // Show the completed trick briefly (need to restore it visually)
                    await ShowTrickCollectionAsync();
                }

                StateHasChanged();
            }
        }
    }

    private async Task ExecutePass()
    {
        if (_game.Players[0].CardsToPass.Count != 3) return;
        
        bool success = _game.ExecutePass();
        if (success)
        {
            DebugHelper.Log("[Hearts] Cards passed", true);
            StateHasChanged();
            
            // Give a moment then let AI play if needed
            await Task.Delay(500);
            PlayAITurn();
        }
    }

    private string GetPassDirectionDisplay()
    {
        return _game.CurrentPassDirection switch
        {
            PassDirection.Left => "← Left",
            PassDirection.Right => "→ Right",
            PassDirection.Across => "↑ Across",
            PassDirection.NoPass => "No Pass",
            _ => ""
        };
    }

    private string GetTrickPosition(int playerIndex)
    {
        return playerIndex switch
        {
            0 => "south",
            1 => "west",
            2 => "north",
            3 => "east",
            _ => ""
        };
    }

    public async ValueTask DisposeAsync()
    {
        _aiTimer?.Dispose();
        _dotNetRef?.Dispose();
        await Task.CompletedTask;
    }
}
