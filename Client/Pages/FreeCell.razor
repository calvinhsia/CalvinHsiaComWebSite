@page "/freecell"
@page "/freecell/{GameId:int}"
@using Microsoft.AspNetCore.Authorization
@using Client.Games.Cards.Models
@using Client.Games.Cards.Services
@using WordScapeBlazorWasm.Services
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@inject RandomService RandomService
@inject GameStateService GameStateService
@inject CssLoaderService CssLoader
@implements IAsyncDisposable
@attribute [AllowAnonymous]

<PageTitle>FreeCell #@_game.GameId - Card Game</PageTitle>

<!-- Win Animation Canvas - OUTSIDE the container to avoid overflow clipping -->
@if (_showWinAnimation)
{
    <canvas id="win-animation-canvas" class="win-animation-canvas"></canvas>
}

<div class="freecell-container" @ref="_containerRef" tabindex="0" @onkeydown="OnKeyDown" @onclick="OnContainerClick">
    <!-- Top Controls -->
    <div class="freecell-controls">
        <div class="freecell-buttons">
            <div class="new-game-dropdown" @onclick:stopPropagation="true">
                <button @onclick="ToggleNewGameMenu" class="btn-game" title="Start new game (N)">🔄 New</button>
                @if (_showNewGameMenu)
                {
                    <div class="dropdown-menu">
                        <button @onclick="ReplayCurrentGame" class="dropdown-item">🔁 Replay #@_game.GameId</button>
                        <button @onclick="NewRandomGame" class="dropdown-item">🎲 Random Game</button>
                    </div>
                }
            </div>
            <button @onclick="Undo" class="btn-game" disabled="@(!_game.CanUndo)" title="Undo last move (Z)">↩️ Undo</button>
        </div>
        <div class="freecell-stats">
            <span class="stat-item" title="Game ID - share this number to play the same game">Game #@_game.GameId</span>
            <span class="stat-item">Moves: @_game.MoveCount</span>
            <span class="stat-item">Max Move: @_game.MaxMovableCards cards</span>
            @if (_game.IsGameWon)
            {
                <span class="stat-item win-message">🎉 You Win!</span>
            }
            else if (_game.IsStalemate)
            {
                <span class="stat-item stalemate-message">😢 No moves available!</span>
            }
        </div>
    </div>

    <!-- Keyboard Help Panel -->
    @if (_showHelp)
    {
        <div class="keyboard-help">
            <h4>⌨️ Keyboard Shortcuts</h4>
            <div class="help-grid">
                <div><kbd>1</kbd>-<kbd>8</kbd></div><div>Select/move to tableau column</div>
                <div><kbd>1</kbd>-<kbd>8</kbd> (again)</div><div>Select more cards in stack</div>
                <div><kbd>↑</kbd> <kbd>↓</kbd></div><div>Adjust selection depth</div>
                <div><kbd>Q</kbd><kbd>W</kbd><kbd>E</kbd><kbd>R</kbd></div><div>Select/move to free cell 1-4</div>
                <div><kbd>U</kbd><kbd>I</kbd><kbd>O</kbd><kbd>P</kbd></div><div>Move to foundation 1-4</div>
                <div><kbd>Space</kbd></div><div>Auto-move selected to foundation</div>
                <div><kbd>Z</kbd></div><div>Undo last move</div>
                <div><kbd>Esc</kbd></div><div>Clear selection</div>
                <div><kbd>A</kbd></div><div>Auto-complete</div>
                <div><kbd>N</kbd></div><div>New game</div>
            </div>
            <button @onclick="ToggleHelp" class="btn-close-help">Close</button>
        </div>
    }

    <!-- Game Area -->
    <div class="freecell-game">
        <!-- Top Row: Free Cells and Foundations -->
        <div class="freecell-top-row">
            <!-- 4 Free Cells (Q, W, E, R) -->
            @for (int f = 0; f < 4; f++)
            {
                var cellIndex = f;
                var card = _game.FreeCells[f];
                var keyLabel = f switch { 0 => "Q", 1 => "W", 2 => "E", 3 => "R", _ => "" };
                <div class="card-pile free-cell" @onclick="() => OnFreeCellClick(cellIndex)">
                    <span class="key-hint">@keyLabel</span>
                    @if (card != null)
                    {
                        <PlayingCard CardData="@card" IsSelected="@IsSelected(0, cellIndex, 0)" />
                    }
                    else
                    {
                        <div class="card card-empty free-cell-empty">
                            <span class="cell-label">Free</span>
                        </div>
                    }
                </div>
            }

            <!-- Spacer -->
            <div class="spacer"></div>

            <!-- 4 Foundation Piles (U, I, O, P) -->
            @for (int f = 0; f < 4; f++)
            {
                var foundationIndex = f;
                var foundation = _game.Foundations[f];
                var keyLabel = f switch { 0 => "U", 1 => "I", 2 => "O", 3 => "P", _ => "" };
                <div class="card-pile foundation-pile" @onclick="() => OnFoundationClick(foundationIndex)">
                    <span class="key-hint">@keyLabel</span>
                    @if (foundation.Count > 0)
                    {
                        var card = foundation[^1];
                        <PlayingCard CardData="@card" />
                    }
                    else
                    {
                        var suitSymbol = f switch { 0 => "\u2665", 1 => "\u2666", 2 => "\u2663", 3 => "\u2660", _ => "" };
                        var suitColor = f < 2 ? "red" : "black";
                        <div class="card card-empty foundation-empty">
                            <span class="foundation-suit @suitColor">@suitSymbol</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tableau (8 columns, keys 1-8) -->
        <div class="freecell-tableau">
            @for (int col = 0; col < 8; col++)
            {
                var columnIndex = col;
                var column = _game.Tableau[col];
                <div class="tableau-column" @onclick="() => OnTableauColumnClick(columnIndex)">
                    <span class="key-hint">@(col + 1)</span>
                    @if (column.Count == 0)
                    {
                        <div class="card card-empty tableau-empty"></div>
                    }
                    else
                    {
                        @for (int row = 0; row < column.Count; row++)
                        {
                            var card = column[row];
                            var cardRow = row;
                            
                            <PlayingCard CardData="@card" 
                                         IsSelected="@IsSelected(1, columnIndex, cardRow)"
                                         CssClass="tableau-card"
                                         StopPropagation="true"
                                         OnClick="@(() => OnTableauCardClick(columnIndex, cardRow))"
                                         CardRow="@cardRow" RowOffset="@_rowOffset" />
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- Instructions -->
    <div class="freecell-info">
        <h4>📖 How to Play</h4>
        <p>
            <strong>Goal:</strong> Move all 52 cards to the four foundation piles, building each suit from Ace to King.
        </p>
        <p>
            <strong>Rules:</strong>
        </p>
        <ul>
            <li><strong>Tableau:</strong> Build down in alternating colors (red on black, black on red)</li>
            <li><strong>Free Cells:</strong> Temporarily hold one card each - use strategically!</li>
            <li><strong>Foundations:</strong> Build up by suit (A→2→3→...→K)</li>
            <li><strong>Moving Stacks:</strong> You can move up to <strong>@_game.MaxMovableCards</strong> cards at once (based on empty free cells and columns)</li>
        </ul>

        <h4>🎮 Controls</h4>
        <div class="controls-section">
            <div class="control-group">
                <h5>🖱️ Mouse / Touch</h5>
                <ul>
                    <li><strong>Click:</strong> Select a card, then click destination</li>
                    <li><strong>Double-click:</strong> Auto-move card to foundation</li>
                    <li><strong>Drag & Drop:</strong> Drag cards to move them</li>
                </ul>
            </div>
            <div class="control-group">
                <h5>⌨️ Keyboard</h5>
                <ul>
                    <li><kbd>1</kbd>-<kbd>8</kbd> — Select/move to tableau column</li>
                    <li><kbd>1</kbd>-<kbd>8</kbd> (repeat) — Select more cards in stack</li>
                    <li><kbd>↑</kbd> <kbd>↓</kbd> — Adjust selection depth</li>
                    <li><kbd>Q</kbd> <kbd>W</kbd> <kbd>E</kbd> <kbd>R</kbd> — Select/move to free cell</li>
                    <li><kbd>U</kbd> <kbd>I</kbd> <kbd>O</kbd> <kbd>P</kbd> — Move to foundation</li>
                    <li><kbd>Space</kbd> — Auto-move selected to foundation</li>
                    <li><kbd>Z</kbd> — Undo last move</li>
                    <li><kbd>Esc</kbd> — Clear selection</li>
                    <li><kbd>A</kbd> — Auto-complete all possible moves</li>
                    <li><kbd>N</kbd> — New game</li>
                    <li><kbd>?</kbd> — Show keyboard help</li>
                </ul>
            </div>
        </div>

        <p class="tip">
            💡 <strong>Tip:</strong> Keep free cells open as long as possible - they're your lifeline for complex moves!
        </p>
        <p class="tip">
            🎯 <strong>Classic FreeCell:</strong> Game IDs match Microsoft FreeCell - Game #1 deals the same cards here as in classic FreeCell.
            To play a specific game, add the game number to the URL: <code>/freecell/1</code> for Game #1.
        </p>
        <p class="tip">
            ⚠️ <strong>Unsolvable Games:</strong> Of the original 32,000 Microsoft FreeCell games, only 8 are proven unsolvable:
            <strong>#11982</strong>, #146692, #186216, #455889, #495505, #512118, #517776, and #781948.
        </p>
    </div>
</div>

@code {
    [Parameter]
    public int? GameId { get; set; }

    private FreeCellGameService _game = null!;
    private DotNetObjectReference<FreeCell>? _dotNetRef;
    private ElementReference _containerRef;
    private DateTime _lastClickTime = DateTime.MinValue;
    private (int type, int index, int cardIndex)? _lastClickTarget;
    private const int DoubleClickThresholdMs = 400;
    private bool _showHelp = false;
    private bool _showWinAnimation = false;
    private bool _wasGameWon = false;
    private bool _isAutoSolving = false;
    private bool _stateLoaded = false;
    private bool _showNewGameMenu = false;
    private int _rowOffset = 22; // Default, will be set based on viewport width

    protected override void OnInitialized()
    {
        DebugHelper.Log($"[FreeCell] OnInitialized with GameId={GameId}", true);
        _game = new FreeCellGameService();
        
        if (GameId.HasValue)
        {
            // Initialize with specific game ID from URL - don't try to load saved state
            _game.InitializeGame(GameId.Value);
            _stateLoaded = true; // Skip loading saved state
            DebugHelper.Log($"[FreeCell] Initialized game #{GameId.Value} from URL", true);
        }
        // else: Don't initialize yet - wait for OnAfterRenderAsync to try loading saved state first
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load CSS on demand
            await CssLoader.LoadCssFilesAsync(
                (GameCss.PlayingCards.Path, GameCss.PlayingCards.Version),
                (GameCss.FreeCell.Path, GameCss.FreeCell.Version));

            // Detect viewport width and set appropriate row offset
            try
            {
                var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
                // Desktop (>768px): larger cards need more offset
                // Mobile (<=768px): smaller cards need less offset
                _rowOffset = width > 768 ? 38 : 17;
                DebugHelper.Log($"[FreeCell] Viewport width={width}, rowOffset={_rowOffset}", true);
            }
            catch
            {
                _rowOffset = 22; // Fallback
            }

            // Try to load saved state if no specific GameId in URL
            if (!_stateLoaded && !GameId.HasValue)
            {
                var savedState = await GameStateService.LoadFreeCellStateAsync();
                if (savedState != null)
                {
                    _game.RestoreState(savedState);
                    DebugHelper.Log($"[FreeCell] Restored game #{_game.GameId} with {_game.MoveCount} moves", true);
                }
                else
                {
                    // No saved state - now initialize a new game
                    _game.InitializeGame();
                    DebugHelper.Log($"[FreeCell] No saved state, new game #{_game.GameId}", true);
                }
                _stateLoaded = true;
                StateHasChanged();
            }

            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registerFreeCellBlazorComponent", _dotNetRef);
            await JSRuntime.InvokeVoidAsync("initializeFreeCell");
            
            // Focus the container for keyboard input
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.freecell-container')?.focus()");
            }
            catch { }
            
            DebugHelper.Log($"[FreeCell] JavaScript initialized", true);
        }

        // Check if game was just won
        if (_game.IsGameWon && !_wasGameWon)
        {
            DebugHelper.Log("[FreeCell] Win detected! Starting animation...", true);
            _wasGameWon = true;
            _showWinAnimation = true;
            // Clear saved state on win
            await GameStateService.ClearFreeCellStateAsync();
            StateHasChanged();
            await Task.Delay(100); // Let canvas render
            await JSRuntime.InvokeVoidAsync("startFreeCellWinAnimation");
        }

        // Check if game became trivially winnable (auto-solve)
        var (isWinnable, _) = _game.IsTriviallyWinnableWithReason();
        
        if (!_game.IsGameWon && !_isAutoSolving && isWinnable)
        {
            DebugHelper.Log("[FreeCell] Game is trivially winnable - starting auto-solve", true);
            _isAutoSolving = true;
            await Task.Delay(500); // Brief pause before auto-solve
            await AutoSolveWithAnimation();
            _isAutoSolving = false;
        }
    }

    private void ToggleHelp()
    {
        _showHelp = !_showHelp;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        DebugHelper.Log($"[FreeCell] Key pressed: {e.Key}", true);

        switch (e.Key.ToUpperInvariant())
        {
            // Tableau columns 1-8
            case "1": case "2": case "3": case "4":
            case "5": case "6": case "7": case "8":
                int col = int.Parse(e.Key) - 1;
                HandleTableauKey(col);
                break;

            // Free cells Q, W, E, R (0-3)
            case "Q": HandleFreeCellKey(0); break;
            case "W": HandleFreeCellKey(1); break;
            case "E": HandleFreeCellKey(2); break;
            case "R": HandleFreeCellKey(3); break;

            // Foundations U, I, O, P (0-3)
            case "U": HandleFoundationKey(0); break;
            case "I": HandleFoundationKey(1); break;
            case "O": HandleFoundationKey(2); break;
            case "P": HandleFoundationKey(3); break;

            // Arrow keys - adjust selection depth in tableau
            case "ARROWUP":
                AdjustSelectionDepth(-1); // Select more cards (deeper)
                break;
            case "ARROWDOWN":
                AdjustSelectionDepth(1); // Select fewer cards (shallower)
                break;

            // Space - auto-move selected to foundation
            case " ":
                if (_game.Selection != null)
                {
                    var (st, si, ci) = _game.Selection.Value;
                    _game.TryAutoMoveToFoundation(st, si, ci);
                    _game.ClearSelection();
                }
                break;

            // Z - Undo
            case "Z":
                Undo();
                break;

            // A - Auto-complete (still available via keyboard)
            case "A":
                await AutoComplete();
                break;

            // N - New game menu toggle
            case "N":
                ToggleNewGameMenu();
                break;

            // ? or / - Toggle help
            case "?":
            case "/":
                ToggleHelp();
                break;
                
            // Escape - clear selection or close menus
            case "ESCAPE":
                if (_showNewGameMenu)
                {
                    _showNewGameMenu = false;
                }
                else
                {
                    _game.ClearSelection();
                }
                break;
        }

        StateHasChanged();
    }

    private void Undo()
    {
        if (_game.CanUndo)
        {
            _game.Undo();
            DebugHelper.Log($"[FreeCell] Undo - {_game.UndoCount} moves remaining in history", true);
        }
    }

    private void HandleTableauKey(int columnIndex)
    {
        var column = _game.Tableau[columnIndex];

        if (_game.Selection != null)
        {
            var (sourceType, sourceIndex, sourceCardIndex) = _game.Selection.Value;

            // If already selected in this column, select deeper (more cards)
            if (sourceType == 1 && sourceIndex == columnIndex)
            {
                // Press same column again to select one card deeper
                if (sourceCardIndex > 0)
                {
                    // Check if the deeper selection would still be a valid sequence
                    int newCardIndex = sourceCardIndex - 1;
                    if (_game.IsValidTableauSequence(columnIndex, newCardIndex))
                    {
                        _game.Select(1, columnIndex, newCardIndex);
                    }
                    // If not valid, keep current selection
                }
                return;
            }

            // Try to move to this column
            bool success = _game.TryMove(1, columnIndex);
            if (success)
            {
                _game.ClearSelection();
            }
            else if (column.Count > 0)
            {
                // Select the top card of this column instead
                _game.ClearSelection();
                _game.Select(1, columnIndex, column.Count - 1);
            }
        }
        else if (column.Count > 0)
        {
            // Select the top card of this column
            _game.Select(1, columnIndex, column.Count - 1);
        }
    }

    private void AdjustSelectionDepth(int delta)
    {
        if (_game.Selection == null) return;

        var (sourceType, sourceIndex, sourceCardIndex) = _game.Selection.Value;

        // Only works for tableau selections
        if (sourceType != 1) return;

        var column = _game.Tableau[sourceIndex];
        if (column.Count == 0) return;

        int newCardIndex = sourceCardIndex + delta;

        // Clamp to valid range
        if (newCardIndex < 0) newCardIndex = 0;
        if (newCardIndex >= column.Count) newCardIndex = column.Count - 1;

        // Check if the new selection forms a valid sequence
        if (_game.IsValidTableauSequence(sourceIndex, newCardIndex))
        {
            _game.Select(1, sourceIndex, newCardIndex);
        }
    }

    private void HandleFreeCellKey(int cellIndex)
    {
        var card = _game.FreeCells[cellIndex];

        if (_game.Selection != null)
        {
            // Try to move to this free cell
            bool success = _game.TryMove(0, cellIndex);
            if (success)
            {
                _game.ClearSelection();
            }
            else if (card != null)
            {
                // Select the card in this free cell instead
                _game.ClearSelection();
                _game.Select(0, cellIndex, 0);
            }
        }
        else if (card != null)
        {
            // Select the card in this free cell
            _game.Select(0, cellIndex, 0);
        }
    }

    private void HandleFoundationKey(int foundationIndex)
    {
        if (_game.Selection != null)
        {
            // Try to move to this foundation
            _game.TryMove(2, foundationIndex);
            _game.ClearSelection();
        }
        // Can't select from foundation in FreeCell typically
    }

    private async Task NewGame()
    {
        _game.InitializeGame();
        await GameStateService.ClearFreeCellStateAsync();
        await JSRuntime.InvokeVoidAsync("resetFreeCellGameState");
        DebugHelper.Log($"[FreeCell] New game started: #{_game.GameId}", true);
        _wasGameWon = false;
        _showWinAnimation = false;
        _showNewGameMenu = false;
        StateHasChanged();
    }

    private void ToggleNewGameMenu()
    {
        _showNewGameMenu = !_showNewGameMenu;
        DebugHelper.Log($"[FreeCell] ToggleNewGameMenu: _showNewGameMenu={_showNewGameMenu}", true);
        StateHasChanged();
    }
    
    private void OnContainerClick()
    {
        // Dismiss the new game menu when clicking outside of it
        if (_showNewGameMenu)
        {
            _showNewGameMenu = false;
            StateHasChanged();
        }
    }

    private async Task ReplayCurrentGame()
    {
        int currentGameId = _game.GameId;
        _game.InitializeGame(currentGameId);
        await GameStateService.ClearFreeCellStateAsync();
        await JSRuntime.InvokeVoidAsync("resetFreeCellGameState");
        DebugHelper.Log($"[FreeCell] Replaying game #{currentGameId}", true);
        _wasGameWon = false;
        _showWinAnimation = false;
        _showNewGameMenu = false;
        StateHasChanged();
    }

    private async Task NewRandomGame()
    {
        _game.InitializeGame();
        await GameStateService.ClearFreeCellStateAsync();
        await JSRuntime.InvokeVoidAsync("resetFreeCellGameState");
        DebugHelper.Log($"[FreeCell] New random game: #{_game.GameId}", true);
        _wasGameWon = false;
        _showWinAnimation = false;
        _showNewGameMenu = false;
        StateHasChanged();
    }

    private void OnFreeCellClick(int cellIndex)
    {
        var card = _game.FreeCells[cellIndex];

        // Check for double-click
        if (card != null && IsDoubleClick(0, cellIndex, 0))
        {
            _game.TryAutoMoveToFoundation(0, cellIndex);
            _game.ClearSelection();
            StateHasChanged();
            return;
        }

        if (_game.Selection != null)
        {
            bool success = _game.TryMove(0, cellIndex);
            if (!success && card != null)
            {
                _game.ClearSelection();
                _game.Select(0, cellIndex, 0);
            }
        }
        else if (card != null)
        {
            _game.Select(0, cellIndex, 0);
        }
        StateHasChanged();
    }

    private void OnFoundationClick(int foundationIndex)
    {
        if (_game.Selection != null)
        {
            _game.TryMove(2, foundationIndex);
            _game.ClearSelection();
        }
        StateHasChanged();
    }

    private void OnTableauColumnClick(int columnIndex)
    {
        if (_game.Selection != null)
        {
            _game.TryMove(1, columnIndex);
            _game.ClearSelection();
        }
        StateHasChanged();
    }

    private void OnTableauCardClick(int columnIndex, int cardIndex)
    {
        var column = _game.Tableau[columnIndex];
        if (cardIndex >= column.Count) return;

        // Check for double-click on top card
        if (cardIndex == column.Count - 1 && IsDoubleClick(1, columnIndex, cardIndex))
        {
            _game.TryAutoMoveToFoundation(1, columnIndex, cardIndex);
            _game.ClearSelection();
            StateHasChanged();
            return;
        }

        if (_game.Selection != null)
        {
            var (sourceType, sourceIndex, sourceCardIndex) = _game.Selection.Value;

            if (sourceType == 1 && sourceIndex == columnIndex && sourceCardIndex == cardIndex)
            {
                _game.ClearSelection();
                StateHasChanged();
                return;
            }

            bool success = _game.TryMove(1, columnIndex);
            if (!success)
            {
                _game.ClearSelection();
                _game.Select(1, columnIndex, cardIndex);
            }
        }
        else
        {
            _game.Select(1, columnIndex, cardIndex);
        }
        StateHasChanged();
    }

    private bool IsDoubleClick(int type, int index, int cardIndex)
    {
        var now = DateTime.Now;
        var isDoubleClick = _lastClickTarget.HasValue &&
                           _lastClickTarget.Value == (type, index, cardIndex) &&
                           (now - _lastClickTime).TotalMilliseconds < DoubleClickThresholdMs;
        
        _lastClickTime = now;
        _lastClickTarget = (type, index, cardIndex);
        
        if (isDoubleClick)
        {
            _lastClickTarget = null;
            DebugHelper.Log($"[FreeCell] Double-click detected on ({type}, {index}, {cardIndex})", true);
        }
        
        return isDoubleClick;
    }

    /// <summary>
    /// Called from JavaScript when a drag-and-drop operation completes
    /// </summary>
    [JSInvokable]
    public void OnDragDrop(int sourceType, int sourceIndex, int cardIndex, int targetType, int targetIndex)
    {
        DebugHelper.Log($"[FreeCell] OnDragDrop: source=({sourceType},{sourceIndex},{cardIndex}) target=({targetType},{targetIndex})", true);
        
        _game.Select(sourceType, sourceIndex, cardIndex >= 0 ? cardIndex : 0);
        bool success = _game.TryMove(targetType, targetIndex);
        
        DebugHelper.Log($"[FreeCell] Move result: {success}", true);
        
        _game.ClearSelection();
        StateHasChanged();
    }

    /// <summary>
    /// Called from JavaScript on double-click/double-tap
    /// </summary>
    [JSInvokable]
    public void OnDoubleClick(int sourceType, int sourceIndex, int cardIndex)
    {
        DebugHelper.Log($"[FreeCell] OnDoubleClick from JS: ({sourceType},{sourceIndex},{cardIndex})", true);
        
        _game.TryAutoMoveToFoundation(sourceType, sourceIndex, cardIndex);
        _game.ClearSelection();
        StateHasChanged();
    }

    private bool IsSelected(int sourceType, int sourceIndex, int cardIndex)
    {
        if (_game.Selection == null) return false;
        var (st, si, ci) = _game.Selection.Value;

        if (sourceType == 1 && st == 1 && si == sourceIndex)
        {
            // For tableau, highlight the selected card and all cards on top
            return cardIndex >= ci;
        }

        return st == sourceType && si == sourceIndex && ci == cardIndex;
    }

    private async Task AutoComplete()
    {
        DebugHelper.Log($"[FreeCell] AutoComplete called", true);
        
        // Check if game is trivially winnable - if so, auto-solve with animation
        var (isWinnable, reason) = _game.IsTriviallyWinnableWithReason();
        DebugHelper.Log($"[FreeCell] AutoComplete check: isWinnable={isWinnable}, reason={reason}", true);
        
        // Log full tableau state for diagnosis
        for (int col = 0; col < 8; col++)
        {
            if (_game.Tableau[col].Count > 0)
            {
                var cards = string.Join(" ", _game.Tableau[col].Select(c => $"{c}({c.Rank})"));
                DebugHelper.Log($"[FreeCell] Column {col + 1}: {cards}", true);
            }
            else
            {
                DebugHelper.Log($"[FreeCell] Column {col + 1}: empty", true);
            }
        }
        
        if (isWinnable)
        {
            DebugHelper.Log($"[FreeCell] Game is trivially winnable - starting auto-solve", true);
            await AutoSolveWithAnimation();
            return;
        }

        DebugHelper.Log($"[FreeCell] Not trivially winnable - trying AutoMoveToFoundations", true);
        
        // Log current state for debugging - show what cards are accessible and what's needed
        for (int i = 0; i < 8; i++)
        {
            if (_game.Tableau[i].Count > 0)
            {
                var topCard = _game.Tableau[i][^1];
                DebugHelper.Log($"[FreeCell] Tableau {i + 1} top: {topCard}", true);
            }
        }

        // Just make as many safe moves as possible
        int movesMade = _game.AutoMoveToFoundations();
        DebugHelper.Log($"[FreeCell] AutoMoveToFoundations made {movesMade} moves", true);
        
        if (movesMade > 0)
        {
            // Re-check if now trivially winnable after auto-moves
            var (newWinnable, newReason) = _game.IsTriviallyWinnableWithReason();
            DebugHelper.Log($"[FreeCell] After auto-moves: isWinnable={newWinnable}, reason={newReason}", true);
            
            if (newWinnable)
            {
                DebugHelper.Log($"[FreeCell] Now trivially winnable - starting auto-solve", true);
                await AutoSolveWithAnimation();
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private async Task AutoSolveWithAnimation()
    {
        DebugHelper.Log($"[FreeCell] AutoSolveWithAnimation starting", true);
        
        // Disable touch/drag in JavaScript during auto-solve
        try
        {
            await JSRuntime.InvokeVoidAsync("setFreeCellAutoSolving", true);
        }
        catch { }
        
        try
        {
            while (!_game.IsGameWon)
            {
                var result = _game.AutoSolveStep();
                if (result == null)
                {
                    DebugHelper.Log($"[FreeCell] AutoSolveStep returned null - no more moves", true);
                    break;
                }
                
                var (sourceType, sourceIndex, card) = result.Value;
                DebugHelper.Log($"[FreeCell] Auto-moved {card} from {(sourceType == 0 ? "free cell" : "tableau")} {sourceIndex + 1}", true);
                
                StateHasChanged();
                await Task.Delay(100); // Animation delay
            }
            
            // Check if we won and trigger win animation directly
            if (_game.IsGameWon && !_wasGameWon)
            {
                DebugHelper.Log($"[FreeCell] Game won during auto-solve! Starting win animation.", true);
                _wasGameWon = true;
                _showWinAnimation = true;
                await GameStateService.ClearFreeCellStateAsync();
                StateHasChanged();
                await Task.Delay(100); // Let canvas render
                await JSRuntime.InvokeVoidAsync("startFreeCellWinAnimation");
            }
        }
        finally
        {
            // Re-enable touch/drag after auto-solve completes
            try
            {
                await JSRuntime.InvokeVoidAsync("setFreeCellAutoSolving", false);
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Save game state when navigating away (unless game is won)
        if (!_game.IsGameWon)
        {
            try
            {
                var state = _game.SerializeState();
                await GameStateService.SaveFreeCellStateAsync(state);
                DebugHelper.Log($"[FreeCell] Saved game #{_game.GameId} on dispose (moves: {_game.MoveCount})", true);
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"[FreeCell] Error saving state: {ex.Message}");
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("cleanupFreeCell");
            await JSRuntime.InvokeVoidAsync("stopFreeCellWinAnimation");
        }
        catch
        {
            // Ignore JS interop errors during disposal
        }

        _dotNetRef?.Dispose();
    }
}
