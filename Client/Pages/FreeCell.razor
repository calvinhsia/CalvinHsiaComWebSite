    /// <summary>
    /// Runs the solver and populates hint data without closing menus. Used by auto-show hints.
    /// </summary>
    private async Task ShowHintQuiet()
    {
        if (_game.IsGameWon || _isAutoSolving || _isAutoMoving) return;

        try
        {
            var solver = CreateSolverWithHistory();
            var moves = solver.FindMoves();
            if (moves.Count > 0)
            {
                moves.Sort((a, b) => b.mValue.CompareTo(a.mValue));
                _solverHintMoves = moves;
                _solverHintText = null;
            }
            else
            {
                _solverHintMoves = null;
                _solverHintText = "No moves found";
            }
        }
        catch (Exception ex)
        {
            _solverHintText = $"Solver error: {ex.Message}";
        }
        StateHasChanged();
    }

    /// <summary>
    /// If auto-show hints is enabled, refreshes hints after a move. Fire-and-forget safe.
    /// Also restarts the background solver to pre-compute solution from the new position.
    /// </summary>
    private void TryAutoShowHints()
    {
        // Track the current board state in the persistent visited-states set before
        // restarting the solver. This captures every position the user passes through,
        // including undo-branch states that leave the linear MoveHistory.
        TrackCurrentState();
        if (_autoShowHints)
        {
            _ = ShowHintQuiet();
        }
        RestartBackgroundSolver();
    }

    /// <summary>
    /// Computes the Zobrist hash of the current game state and adds it to the persistent
    /// visited-states set. O(52) — negligible cost per call.
    /// </summary>
    private void TrackCurrentState()
    {
        _game.UseNumericHash = true;
        _game.InitIncrementalHash();
        _userVisitedStates.Add(_game.IncrementalHashValue);
    }

    /// <summary>
    /// Validates that _userVisitedStates is consistent with the game's MoveHistory.
    /// Replays all moves from a fresh game and cross-checks:
    /// 1. Incremental hash (ApplyMoveFast) matches full recompute (InitIncrementalHash) at each step
    /// 2. Each replayed state is/isn't in _userVisitedStates
    /// 3. Final replayed board hash matches current live board
    /// Press V during gameplay to trigger. Results logged to browser console.
    /// </summary>
    private void ValidateVisitedStates()
    {
        _showOptionsMenu = false;
        DebugHelper.Log($"[FreeCell Validate] === Game #{_game.GameId}, {_game.MoveHistory.Count} moves, {_userVisitedStates.Count} visited hashes ===", true);

        var result = FreeCellGameBase.ValidateHashTable(
            _game.GameId,
            _game.MoveHistory,
            _userVisitedStates,
            _game);

        foreach (var w in result.Warnings)
            DebugHelper.Log($"[FreeCell Validate] {w}", true);

        DebugHelper.Log($"[FreeCell Validate] Moves replayed: {result.MovesReplayed}", true);
        DebugHelper.Log($"[FreeCell Validate] Unique replay states: {result.UniqueReplayStates}", true);
        DebugHelper.Log($"[FreeCell Validate] Duplicate states: {result.DuplicateStates}", true);
        DebugHelper.Log($"[FreeCell Validate] Incremental vs full mismatches: {result.IncrementalVsFullMismatches}", true);
        DebugHelper.Log($"[FreeCell Validate] Missing from visitedStates: {result.MissingFromVisited} (auto-move intermediates expected)", true);
        DebugHelper.Log($"[FreeCell Validate] Extra in visitedStates: {result.ExtraInVisited} (undo branches expected)", true);
        DebugHelper.Log($"[FreeCell Validate] Final hash match: {(result.FinalHashMatch ? "YES" : "NO")} (live={result.LiveHash:X16} replay={result.ReplayHash:X16})", true);

        if (result.IsValid)
            DebugHelper.Log($"[FreeCell Validate] RESULT: Hash table is consistent", true);
        else
            DebugHelper.Log($"[FreeCell Validate] RESULT: ISSUES FOUND — see warnings above", true);
    }

    /// <summary>
    /// Creates a solver pre-populated with the user's visited states and move history.
    /// </summary>
    private FreeCellSolver CreateSolverWithHistory(Action<Func<string>>? loggerAction = null)
    {
        var priorMoves = FreeCellGameService.ParseMoveHistory(_game.MoveHistory);
        return new FreeCellSolver(_game, loggerAction,
            preVisitedStates: _userVisitedStates,
            priorMoveHistory: priorMoves);
    }

    /// <summary>
    /// Cancels any running background solver and starts a fresh one for the current position.
    /// If the moves made since the solution was computed match the beginning of the pre-computed
    /// solution, trims the matched prefix instead of re-solving from scratch.
    /// </summary>
    private void RestartBackgroundSolver()
    {
        // Optimization: if the moves made since the solution was computed match
        // the beginning of the pre-computed solution, trim them instead of re-solving.
        var doOptimization = true; // temporary turn off while testing
        if (doOptimization && _backgroundSolutionMoves is { Count: > 0 } &&
            !_backgroundSolveInProgress &&
            _game.MoveHistory.Count > _backgroundSolutionMoveCount)
        {
            try
            {
                int newMoveCount = _game.MoveHistory.Count - _backgroundSolutionMoveCount;
                if (newMoveCount <= _backgroundSolutionMoves.Count)
                {
                    bool allMatch = true;
                    for (int i = 0; i < newMoveCount; i++)
                    {
                        var histMove = FreeCellGameService.ParseMoveHistoryEntry(
                            _game.MoveHistory[_backgroundSolutionMoveCount + i]);
                        var solMove = _backgroundSolutionMoves[i];
                        if (histMove.sourceType != solMove.sourceType ||
                            histMove.sourceIndex != solMove.sourceIndex ||
                            histMove.targetType != solMove.targetType ||
                            histMove.targetIndex != solMove.targetIndex ||
                            histMove.cardCount != solMove.cardCount)
                        {
                            allMatch = false;
                            break;
                        }
                    }
                    if (allMatch)
                    {
                        var trimmed = _backgroundSolutionMoves.GetRange(newMoveCount, _backgroundSolutionMoves.Count - newMoveCount);
                        _backgroundSolutionMoves = trimmed;
                        _backgroundSolutionFirstMove = trimmed.Count > 0 ? trimmed[0] : null;
                        _backgroundSolutionMoveCount = _game.MoveHistory.Count;
                        StateHasChanged();
                        return;
                    }
                }
            }
            catch
            {
                // Parse failure — fall through to full restart
            }
        }

        _backgroundSolveCts?.Cancel();
        _backgroundSolveCts?.Dispose();
        _backgroundSolveCts = null;
        _backgroundSolutionMoves = null;
        _backgroundSolutionFirstMove = null;
        _backgroundSolveNoSolution = false;
        _backgroundSolveInProgress = false;

        if (_game.IsGameWon || _isAutoSolving || _isAutoMoving) return;

        _ = RunBackgroundSolverAsync();
    }

    /// <summary>
    /// Runs the solver in the background, yielding periodically so the UI stays responsive.
    /// </summary>
    private async Task RunBackgroundSolverAsync()
    {
        _backgroundSolveCts = new CancellationTokenSource();
        _backgroundSolveInProgress = true;
        StateHasChanged();

        try
        {
            var solver = CreateSolverWithHistory();
            solver.CancellationToken = _backgroundSolveCts.Token;

            // Yield periodically so UI stays responsive on single-threaded WASM.
            // Each Task.Delay(1) costs ~4ms (browser setTimeout floor). Original modulo 200 caused
            // ~2,220 yields for hard games (~444K ops) = ~8.9s overhead. Modulo 5000 → ~89 yields ≈ 356ms.
            // Integer increment+modulo is ~1-2ns per check; Stopwatch.ElapsedMilliseconds uses JS interop per read.
            int opCount = 0;
            solver.OnDoMove += async (_) => { if (++opCount % 5000 == 0) await Task.Delay(1); };
            solver.OnUndoMove += async (_) => { if (++opCount % 5000 == 0) await Task.Delay(1); };

            var allMoves = await solver.FindSolutionAsync();
            // Strip prior-history prefix seeded in the constructor;
            // only store the NEW moves from the current position.
            int priorCount = _game.MoveHistory.Count;
            var solutionMoves = priorCount < allMoves.Count
                ? allMoves.GetRange(priorCount, allMoves.Count - priorCount)
                : allMoves;
            _backgroundSolutionMoves = solutionMoves;
            _backgroundSolutionFirstMove = solutionMoves.Count > 0 ? solutionMoves[0] : null;
            _backgroundSolutionMoveCount = _game.MoveHistory.Count;
            _backgroundSolveNoSolution = false;
        }
        catch (OperationCanceledException)
        {
            return; // Cancelled — don't update state
        }
        catch
        {
            // Shared preVisitedStates may block solution paths that pass through
            // previously-visited states (e.g., after roundtrip moves). Retry without
            // history constraints so the solver can explore all reachable states.
            try
            {
                var retrySolver = new FreeCellSolver(_game, loggerAction: null);
                retrySolver.CancellationToken = _backgroundSolveCts!.Token;
                int retryOpCount = 0;
                retrySolver.OnDoMove += async (_) => { if (++retryOpCount % 5000 == 0) await Task.Delay(1); };
                retrySolver.OnUndoMove += async (_) => { if (++retryOpCount % 5000 == 0) await Task.Delay(1); };

                var retryMoves = await retrySolver.FindSolutionAsync();
                _backgroundSolutionMoves = retryMoves;
                _backgroundSolutionFirstMove = retryMoves.Count > 0 ? retryMoves[0] : null;
                _backgroundSolutionMoveCount = _game.MoveHistory.Count;
                _backgroundSolveNoSolution = false;
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch
            {
                _backgroundSolveNoSolution = true;
            }
        }
        finally
        {
            _backgroundSolveInProgress = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Returns true if the given hint move matches the first move of the pre-computed background solution.
    /// </summary>
    private bool IsSolutionMove(FreeCellMove move)
    {
        var sol = _backgroundSolutionFirstMove;
        if (sol == null) return false;
        return move.sourceType == sol.sourceType &&
               move.sourceIndex == sol.sourceIndex &&
               move.targetType == sol.targetType &&
               move.targetIndex == sol.targetIndex &&
               move.cardCount == sol.cardCount;
    }

    private static MarkupString RenderCardHtml(Card? card)
    {
        if (card == null) return new MarkupString("?");
        var suitClass = card.IsRed ? "suit-red" : "suit-black";
        return new MarkupString($"{card.RankDisplay}<span class=\"{suitClass}\">{card.SuitSymbol}</span>");
    }

    private static string FormatMoveLocation(SourceType type, int index) => type switch
    {
        SourceType.FreeCell => $"Free Cell {index}",
        SourceType.Tableau => $"Col {index}",
        SourceType.Foundation => "Foundation",
        _ => "?"
    };

    private async Task ShowHint()
    {
        _showOptionsMenu = false;
        if (_game.IsGameWon || _isAutoSolving) return;

        _solverHintMoves = null;
        _solverHintText = "Thinking...";
        StateHasChanged();
        await Task.Delay(1); // yield so UI updates

        try
        {
            var solver = CreateSolverWithHistory();
            var moves = solver.FindMoves();
            if (moves.Count > 0)
            {
                moves.Sort((a, b) => b.mValue.CompareTo(a.mValue));
                _solverHintMoves = moves;
                _solverHintText = null; // display via _solverHintMoves
            }
            else
            {
                _solverHintMoves = null;
                _solverHintText = "No moves found";
            }
        }
        catch (Exception ex)
        {
            _solverHintText = $"Solver error: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task StartAutoSolve()
    {
        _showOptionsMenu = false;
        if (_game.IsGameWon || _isAutoSolving) return;

        ClearHint();
        // Cancel background solver — we'll use its result if available
        _backgroundSolveCts?.Cancel();
        _backgroundSolveCts?.Dispose();
        _backgroundSolveCts = null;
        _backgroundSolveInProgress = false;

        _isAutoSolving = true;
        _autoSolveCts = new CancellationTokenSource();
        StateHasChanged();

        // Disable touch/drag during auto-solve
        try { await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", true); } catch { }

        try
        {
            // Reuse pre-computed background solution if available
            List<FreeCellMove> solutionMoves;
            if (_backgroundSolutionMoves != null)
            {
                solutionMoves = _backgroundSolutionMoves;
                DebugHelper.Log($"[FreeCell] Auto-solve using pre-computed solution ({solutionMoves.Count} moves)");
            }
            else
            {
                FreeCellSolver solver;
                List<FreeCellMove> allMoves;
                try
                {
                    solver = CreateSolverWithHistory();
                    solver.CancellationToken = _autoSolveCts.Token;
                    allMoves = await solver.FindSolutionAsync();
                    // Strip prior-history prefix seeded in the constructor
                    int priorCount = _game.MoveHistory.Count;
                    solutionMoves = priorCount < allMoves.Count
                        ? allMoves.GetRange(priorCount, allMoves.Count - priorCount)
                        : allMoves;
                }
                catch (OperationCanceledException) { throw; }
                catch
                {
                    // Retry without history constraints
                    solver = new FreeCellSolver(_game, loggerAction: null);
                    solver.CancellationToken = _autoSolveCts.Token;
                    allMoves = await solver.FindSolutionAsync();
                    solutionMoves = allMoves;
                }
            }

            // Apply each move to the real game with animated card movement
            foreach (var move in solutionMoves)
            {
                _autoSolveCts.Token.ThrowIfCancellationRequested();

                // Determine source card index in the DOM before the move is applied
                int srcCardIdx = move.sourceType == SourceType.Tableau
                    ? _game.Tableau[move.sourceIndex].Count - move.cardCount
                    : 0;
                string imageUrl = move.CardMoved?.ImageUrl ?? "";

                // Animate the card flying from source to destination
                int animDuration = Math.Min(200, _autoSolveDelay);
                await AnimateCardMoveAsync((int)move.sourceType, move.sourceIndex, srcCardIdx,
                    (int)move.targetType, move.targetIndex, imageUrl, animDuration);

                // Apply the move on the real game via Select + TryMove so undo stack is preserved
                move.ApplyMove(_game);
                StateHasChanged();

                // Wait remaining delay after animation
                int remainingDelay = _autoSolveDelay - animDuration;
                if (remainingDelay > 0)
                    await Task.Delay(remainingDelay, _autoSolveCts.Token);
            }

            // Check for win
            if (_game.IsGameWon && !_wasGameWon)
            {
                _wasGameWon = true;
                _showWinAnimation = true;
                await GameStateService.ClearFreeCellStateAsync();
                StateHasChanged();
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("startFreeCellWinAnimation");
            }
        }
        catch (OperationCanceledException)
        {
            DebugHelper.Log("[FreeCell] Auto-solve cancelled by user");
        }
        catch (Exception ex)
        {
            DebugHelper.Log($"[FreeCell] Auto-solve error: {ex.Message}");
            _backgroundSolveNoSolution = true;
            _solverHintText = "No solution found";
        }
        finally
        {
            _isAutoSolving = false;
            _autoSolveCts?.Dispose();
            _autoSolveCts = null;
            try { await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", false); } catch { }
            StateHasChanged();
        }
    }

    private void CancelAutoSolve()
    {
        _autoSolveCts?.Cancel();
    }

    private async Task ExportToClipboard()
    {
        _showOptionsMenu = false;
        try
        {
            var dump = _game.ToDumpString(includeMoveHistory: true);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", dump);
            DebugHelper.Log($"[FreeCell] Exported game #{_game.GameId} to clipboard ({_game.MoveCount} moves, {_game.MoveHistory.Count} history entries)");
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"[FreeCell] Export to clipboard failed: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task ImportFromClipboard()
    {
        _showOptionsMenu = false;
        try
        {
            var clipText = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
            if (string.IsNullOrWhiteSpace(clipText))
            {
                DebugHelper.Log("[FreeCell] Import: clipboard is empty");
                return;
            }
            CancelAutoSolve();
            ClearHint();
            var imported = FreeCellGameService.FromDumpString(clipText);
            _game = imported;
            _userVisitedStates.Clear();
            TrackCurrentState();
            _wasGameWon = false;
            _showWinAnimation = false;
            await GameStateService.ClearFreeCellStateAsync();
            await JSRuntime.InvokeVoidAsync("resetFreeCellGameState");
            try { await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", false); } catch { }
            DebugHelper.Log($"[FreeCell] Imported game #{_game.GameId} from clipboard ({_game.MoveCount} moves)");
            RestartBackgroundSolver();
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"[FreeCell] Import from clipboard failed: {ex.Message}");
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Cancel background solver if running
        _backgroundSolveCts?.Cancel();
        _backgroundSolveCts?.Dispose();
        _backgroundSolveCts = null;

        // Cancel auto-solve if running
        _autoSolveCts?.Cancel();
        _autoSolveCts?.Dispose();
        _autoSolveCts = null;

        // Save game state when navigating away (unless game is won)
        if (!_game.IsGameWon)
        {
            try
            {
                var state = _game.SerializeState();
                await GameStateService.SaveFreeCellStateAsync(state);
                DebugHelper.Log($"[FreeCell] Saved game #{_game.GameId} on dispose (moves: {_game.MoveCount})");
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"[FreeCell] Error saving state: {ex.Message}");
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("cleanupFreeCell");
            await JSRuntime.InvokeVoidAsync("stopFreeCellWinAnimation");
            // Re-enable interactions in case win animation had disabled them
            try
            {
                await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", false);
            }
            catch { }
        }
        catch
        {
            // Ignore JS interop errors during disposal
        }

        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public Task<string> GetCurrentFreeCellJson()
    {
        try
        {
            var dto = _game.SerializeState();
            var json = JsonSerializer.Serialize(dto, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            return Task.FromResult(json);
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"[FreeCell] GetCurrentFreeCellJson error: {ex.Message}");
            return Task.FromResult(string.Empty);
        }
    }

    [JSInvokable]
    public Task<bool> LoadGameFromJson(string json)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var state = JsonSerializer.Deserialize<FreeCellGameState>(json, options);
            if (state != null)
            {
                _game.RestoreState(state);
                StateHasChanged();
                DebugHelper.Log($"[FreeCell] Loaded game state from JSON (GameId={_game.GameId})");
                return Task.FromResult(true);
            }
            return Task.FromResult(false);
        }
        catch (Exception ex)
        {
            DebugHelper.LogError($"[FreeCell] LoadGameFromJson error: {ex.Message}");
            return Task.FromResult(false);
        }
    }
}
