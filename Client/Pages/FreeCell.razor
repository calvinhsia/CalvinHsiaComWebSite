    /// </summary>
    [JSInvokable]
    public void OnDoubleClick(int sourceType, int sourceIndex, int cardIndex)
    {
        CloseAllMenus();
        DebugHelper.Log($"[FreeCell] OnDoubleClick from JS: ({sourceType},{sourceIndex},{cardIndex})");
        // Ignore double-clicks while win animation or auto-solve is running
        if (_showWinAnimation || _isAutoMoving)
        {
            DebugHelper.Log("[FreeCell] Ignoring OnDoubleClick during win animation or auto-solve");
            return;
        }

        _game.TryAutoMoveToFoundation((SourceType)sourceType, sourceIndex, cardIndex);
        _game.ClearSelection();
        TryAutoMoveIfEnabled();
        StateHasChanged();
    }

