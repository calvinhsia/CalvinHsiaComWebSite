    private bool IsSelected(SourceType sourceType, int sourceIndex, int cardIndex)
    {
        if (_game.Selection == null) return false;
        var (st, si, ci) = _game.Selection.Value;

        if (sourceType == SourceType.Tableau && st == SourceType.Tableau && si == sourceIndex)
        {
            // For tableau, highlight the selected card and all cards on top
            return cardIndex >= ci;
        }

        return st == sourceType && si == sourceIndex && ci == cardIndex;
    }

    private async Task AutoComplete()
    {
        DebugHelper.Log($"[FreeCell] AutoComplete called");

        // Check if game is trivially winnable - if so, auto-solve with animation
        var (isWinnable, reason) = _game.IsTriviallyWinnableWithReason();
        DebugHelper.Log($"[FreeCell] AutoComplete check: isWinnable={isWinnable}, reason={reason}");

        // Log full tableau state for diagnosis
        for (int col = 0; col < 8; col++)
        {
            if (_game.Tableau[col].Count > 0)
            {
                var cards = string.Join(" ", _game.Tableau[col].Select(c => $"{c}({c.Rank})"));
                DebugHelper.Log($"[FreeCell] Column {col + 1}: {cards}");
            }
            else
            {
                DebugHelper.Log($"[FreeCell] Column {col + 1}: empty");
            }
        }

        if (isWinnable)
        {
            DebugHelper.Log($"[FreeCell] Game is trivially winnable - starting auto-solve");
            await AutoMoveWithAnimation();
            return;
        }

        DebugHelper.Log($"[FreeCell] Not trivially winnable - trying AutoMoveToFoundations");

        // Log current state for debugging - show what cards are accessible and what's needed
        for (int i = 0; i < 8; i++)
        {
            if (_game.Tableau[i].Count > 0)
            {
                var topCard = _game.Tableau[i][^1];
                DebugHelper.Log($"[FreeCell] Tableau {i + 1} top: {topCard}");
            }
        }

        // Just make as many safe moves as possible
        int movesMade = _game.AutoMoveToFoundations();
        DebugHelper.Log($"[FreeCell] AutoMoveToFoundations made {movesMade} moves");

        if (movesMade > 0)
        {
            // Re-check if now trivially winnable after auto-moves
            var (newWinnable, newReason) = _game.IsTriviallyWinnableWithReason();
            DebugHelper.Log($"[FreeCell] After auto-moves: isWinnable={newWinnable}, reason={newReason}");

            if (newWinnable)
            {
                DebugHelper.Log($"[FreeCell] Now trivially winnable - starting auto-solve");
                await AutoMoveWithAnimation();
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private async Task AutoMoveWithAnimation()
    {
        DebugHelper.Log($"[FreeCell] AutoMoveWithAnimation starting");

        // Disable touch/drag in JavaScript during auto-solve
        try
        {
            await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", true);
        }
        catch { }

        try
        {
            while (!_game.IsGameWon)
            {
                // Peek at next move so we can animate before applying
                var nextMove = _game.GetNextFoundationMove();
                if (nextMove == null)
                {
                    DebugHelper.Log($"[FreeCell] AutoMoveStep returned null - no more moves");
                    break;
                }

                var sType = nextMove.Value.SourceType;
                var sIdx = nextMove.Value.SourceIndex;
                var cIdx = nextMove.Value.CardIndex;
                Card? card = sType switch
                {
                    SourceType.FreeCell => _game.FreeCells[sIdx],
                    SourceType.Tableau => _game.Tableau[sIdx].Count > 0 ? _game.Tableau[sIdx][^1] : null,
                    _ => null
                };

                if (card != null)
                {
                    int foundationIdx = _game.CanMoveToAnyFoundation(card);
                    if (foundationIdx >= 0)
                    {
                        await AnimateCardMoveAsync((int)sType, sIdx, cIdx, (int)SourceType.Foundation, foundationIdx, card.ImageUrl, 100);
                    }
                }

                var result = _game.AutoMoveStep();
                if (result == null) break;

                StateHasChanged();
            }

            // Check if we won and trigger win animation directly
            if (_game.IsGameWon && !_wasGameWon)
            {
                DebugHelper.Log($"[FreeCell] Game won during auto-solve! Starting win animation.");
                _wasGameWon = true;
                _showWinAnimation = true;
                await GameStateService.ClearFreeCellStateAsync();
                StateHasChanged();
                await Task.Delay(100); // Let canvas render
                await JSRuntime.InvokeVoidAsync("startFreeCellWinAnimation");
            }
        }
        finally
        {
            // Re-enable touch/drag after auto-solve completes
            try
            {
                await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", false);
            }
            catch { }
        }
    }

