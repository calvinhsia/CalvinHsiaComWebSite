    private void OnTableauCardClick(int columnIndex, int cardIndex)
    {
        CloseAllMenus();
        if (_isAutoSolving) return;
        var column = _game.Tableau[columnIndex];
        if (cardIndex >= column.Count) return;

        // Check for double-click on top card
        if (cardIndex == column.Count - 1 && IsDoubleClick(SourceType.Tableau, columnIndex, cardIndex))
        {
            _game.TryAutoMoveToFoundation(SourceType.Tableau, columnIndex, cardIndex);
            _game.ClearSelection();
            TryAutoMoveIfEnabled();
            StateHasChanged();
            return;
        }

        if (_game.Selection != null)
        {
            var (sourceType, sourceIndex, sourceCardIndex) = _game.Selection.Value;

            if (sourceType == SourceType.Tableau && sourceIndex == columnIndex && sourceCardIndex == cardIndex)
            {
                _game.ClearSelection();
                StateHasChanged();
                return;
            }

            bool success = _game.TryMove(SourceType.Tableau, columnIndex);
            if (success)
            {
                // Don't auto-move if user intentionally moved from foundation to tableau
                if (sourceType != SourceType.Foundation)
                {
                    TryAutoMoveIfEnabled();
                }
            }
            else
            {
                _game.ClearSelection();
                _game.Select(SourceType.Tableau, columnIndex, cardIndex);
            }
        }
        else
        {
            _game.Select(SourceType.Tableau, columnIndex, cardIndex);
        }
        StateHasChanged();
    }

    private bool IsDoubleClick(SourceType type, int index, int cardIndex)
    {
        var now = DateTime.Now;
        var isDoubleClick = _lastClickTarget.HasValue &&
                           _lastClickTarget.Value == (type, index, cardIndex) &&
                           (now - _lastClickTime).TotalMilliseconds < DoubleClickThresholdMs;

        _lastClickTime = now;
        _lastClickTarget = (type, index, cardIndex);

        if (isDoubleClick)
        {
            _lastClickTarget = null;
            DebugHelper.Log($"[FreeCell] Double-click detected on ({type}, {index}, {cardIndex})");
        }

        return isDoubleClick;
    }

    /// <summary>
    /// Animates a card flying from source to destination via JS interop.
    /// </summary>
    private async Task AnimateCardMoveAsync(int sourceType, int sourceIndex, int cardIndex, int targetType, int targetIndex, string cardImageUrl, int durationMs)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("animateFreeCellCard", sourceType, sourceIndex, cardIndex, targetType, targetIndex, cardImageUrl, durationMs);
        }
        catch { /* animation is best-effort */ }
    }

    /// <summary>
    /// Automatically moves eligible cards to foundation if the option is enabled.
    /// Animates each move so the user can see cards moving.
    /// </summary>
    private async Task TryAutoMoveIfEnabledAsync()
    {
        if (!_autoMoveToFoundation) return;

        int movesMade = 0;

        // Keep moving cards until no more safe moves
        while (true)
        {
            // Peek at what move will happen so we can animate first
            var nextMove = _game.GetNextFoundationMove();
            if (nextMove == null) break;

            var sType = nextMove.Value.SourceType;
            var sIdx = nextMove.Value.SourceIndex;
            var cIdx = nextMove.Value.CardIndex;
            Card? card = sType switch
            {
                SourceType.FreeCell => _game.FreeCells[sIdx],
                SourceType.Tableau => _game.Tableau[sIdx].Count > 0 ? _game.Tableau[sIdx][^1] : null,
                _ => null
            };
            if (card == null) break;

            int foundationIdx = _game.CanMoveToAnyFoundation(card);
            if (foundationIdx < 0) break;

            // Animate the card flying to the foundation
            await AnimateCardMoveAsync((int)sType, sIdx, cIdx, (int)SourceType.Foundation, foundationIdx, card.ImageUrl, 150);

            // Apply the actual move
            var result = _game.AutoMoveStep();
            if (result == null) break;
            movesMade++;
            StateHasChanged();
        }

        if (movesMade > 0)
        {
            DebugHelper.Log($"[FreeCell] Auto-moved {movesMade} cards to foundation");
        }

        // Show hints after auto-moves are done so hints reflect the post-auto-move state
        TryAutoShowHints();
    }

    /// <summary>
    /// Synchronous version for backwards compatibility - just triggers the async version
    /// </summary>
    private void TryAutoMoveIfEnabled()
    {
        if (_autoMoveToFoundation)
        {
            // Fire and forget - the async method will call TryAutoShowHints after auto-moves complete
            _ = TryAutoMoveIfEnabledAsync();
        }
        else
        {
            // No auto-move, show hints immediately on current state
            TryAutoShowHints();
        }
    }

    /// <summary>
    /// Called from JavaScript when a drag-and-drop operation completes
    /// </summary>
    [JSInvokable]
    public void OnDragDrop(int sourceType, int sourceIndex, int cardIndex, int targetType, int targetIndex)
    {
        CloseAllMenus();
        DebugHelper.Log($"[FreeCell] OnDragDrop: source=({sourceType},{sourceIndex},{cardIndex}) target=({targetType},{targetIndex})");
        // Ignore drag/drop while win animation or auto-solve is running
        if (_showWinAnimation || _isAutoMoving)
        {
            DebugHelper.Log("[FreeCell] Ignoring OnDragDrop during win animation or auto-solve");
            _game.ClearSelection();
            StateHasChanged();
            return;
        }

        _game.Select((SourceType)sourceType, sourceIndex, cardIndex >= 0 ? cardIndex : 0);
        bool success = _game.TryMove((SourceType)targetType, targetIndex);

        DebugHelper.Log($"[FreeCell] Move result: {success}");

        _game.ClearSelection();
        if (success)
        {
            // Don't auto-move if user intentionally moved from foundation to tableau
            // This is a valid strategy to temporarily move cards back
            if (!((SourceType)sourceType == SourceType.Foundation && (SourceType)targetType == SourceType.Tableau)) // Foundation to Tableau
            {
                TryAutoMoveIfEnabled();
            }
        }
        StateHasChanged();
    }

    /// <summary>
