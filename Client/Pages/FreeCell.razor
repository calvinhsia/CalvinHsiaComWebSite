    private void OnFreeCellClick(int cellIndex)
    {
        CloseAllMenus();
        if (_isAutoSolving) return;
        var card = _game.FreeCells[cellIndex];

        // Check for double-click
        if (card != null && IsDoubleClick(SourceType.FreeCell, cellIndex, 0))
        {
            _game.TryAutoMoveToFoundation(SourceType.FreeCell, cellIndex);
            _game.ClearSelection();
            TryAutoMoveIfEnabled();
            StateHasChanged();
            return;
        }

        if (_game.Selection != null)
        {
            bool success = _game.TryMove(SourceType.FreeCell, cellIndex);
            if (success)
            {
                TryAutoMoveIfEnabled();
            }
            else if (card != null)
            {
                _game.ClearSelection();
                _game.Select(SourceType.FreeCell, cellIndex, 0);
            }
        }
        else if (card != null)
        {
            _game.Select(SourceType.FreeCell, cellIndex, 0);
        }
        StateHasChanged();
    }

