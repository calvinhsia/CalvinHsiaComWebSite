@page "/freecell"
@page "/freecell/{GameId:int}"
@using Microsoft.AspNetCore.Authorization
@using Client.Games.Cards.Models
@using Client.Games.Cards.Services
@using WordScapeBlazorWasm.Services
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@inject RandomService RandomService
@inject GameStateService GameStateService
@inject NavigationManager NavigationManager
@inject CssLoaderService CssLoader
@using System.Text.Json
@implements IAsyncDisposable
@attribute [AllowAnonymous]

<PageTitle>FreeCell #@_game.GameId - Card Game</PageTitle>

<!-- Win Animation Canvas - OUTSIDE the container to avoid overflow clipping -->
@if (_showWinAnimation)
{
    <canvas id="win-animation-canvas" class="win-animation-canvas"></canvas>
}

<div class="freecell-container" @ref="_containerRef" tabindex="0" @onkeydown="OnKeyDown" @onclick="OnContainerClick">
    <!-- Top Controls -->
    <div class="freecell-controls">
        <div class="freecell-buttons">
            <div class="new-game-dropdown" @onclick:stopPropagation="true">
                <button @onclick="ToggleNewGameMenu" class="btn-game" title="Start new game (N)">🔄 New</button>
                @if (_showNewGameMenu)
                {
                    <div class="dropdown-menu">
                        <button @onclick="ReplayCurrentGame" class="dropdown-item">🔁 Replay #@_game.GameId</button>
                        <button @onclick="NewRandomGame" class="dropdown-item">🎲 Random Game</button>
                    </div>
                }
            </div>
            <button @onclick="Undo" class="btn-game" disabled="@(!_game.CanUndo)" title="Undo last move (Z)">↩️ Undo</button>
            <div class="options-dropdown" @onclick:stopPropagation="true">
                <button @onclick="ToggleOptionsMenu" class="btn-game" title="Game options">⚙️ Options</button>
                @if (_showOptionsMenu)
                {
                    <div class="dropdown-menu options-menu">
                        <label class="dropdown-item checkbox-item">
                            <input type="checkbox" @bind="_autoMoveToFoundation" @bind:after="SaveSettingsAsync" />
                            <span>Auto-move to foundation</span>
                        </label>
                        <label class="dropdown-item checkbox-item">
                            <input type="checkbox" @bind="_autoShowHints" @bind:after="OnAutoShowHintsChanged" />
                            <span>Auto-show hints</span>
                        </label>
                        <button @onclick="ShowHint" class="dropdown-item" disabled="@(_isAutoSolving || _game.IsGameWon)">💡 Show Hint</button>
                        <div class="dropdown-item solver-delay-item">
                            <span>Solve delay: @(_autoSolveDelay)ms</span>
                            <input type="range" min="50" max="2000" step="50" @bind="_autoSolveDelay" @bind:after="SaveSettingsAsync" />
                        </div>
                        <button @onclick="StartAutoSolve" class="dropdown-item" disabled="@(_isAutoSolving || _game.IsGameWon)">🤖 Auto-Solve</button>
                        <button @onclick="ExportToClipboard" class="dropdown-item">📋 Export to Clipboard</button>
                        <button @onclick="ImportFromClipboard" class="dropdown-item">📥 Import from Clipboard</button>
                        <label class="dropdown-item checkbox-item">
                            <input type="checkbox" @bind="_debugMode" @bind:after="OnDebugModeChanged" />
                            <span>Debug mode</span>
                        </label>
                        <button @onclick="ValidateVisitedStates" class="dropdown-item">🔍 Validate Hashes</button>
                    </div>
                }
            </div>
        </div>
        @* Capture ALL async-mutable fields once at the top of render to prevent
           race conditions from fire-and-forget async operations triggering
           StateHasChanged between field reads. *@
        @{
            var snapSolution = _backgroundSolutionMoves;
            var snapSolveInProgress = _backgroundSolveInProgress;
            var snapNoSolution = _backgroundSolveNoSolution;
            var hintMoves = _solverHintMoves;
            var hintText = _solverHintText;
        }
        <div class="freecell-stats">
            <span class="stat-item" title="Game ID - share this number to play the same game">Game #@_game.GameId</span>
            <span class="stat-item">Moves: @_game.MoveCount</span>
            <span class="stat-item">Max Move: @_game.MaxMovableCards cards</span>
            @if (_game.IsGameWon)
            {
                <span class="stat-item win-message">🎉 You Win!</span>
            }
            else if (_game.IsStalemate)
            {
                <span class="stat-item stalemate-message">😢 No moves available!</span>
            }
            else if (snapNoSolution)
            {
                <span class="stat-item no-solution-message">😞 No solution found</span>
            }
            @if (!_game.IsGameWon && !_game.IsStalemate)
            {
                @if (snapSolveInProgress)
                {
                    <span class="stat-item solving-message" title="Background solver is analyzing the position...">🔍</span>
                }
                else if (snapSolution != null)
                {
                    <span class="stat-item solved-message" title="Solution found from current position">✅ @(snapSolution?.Count ?? 0) moves</span>
                }
            }
        </div>
    </div>
    @if (hintText != null || hintMoves != null)
    {
        <div class="solver-hint-banner">
            <div class="solver-hint-content">
                @if (hintMoves != null)
                {
                    <div class="solver-hint-header">
                        <span>
                            💡 @(hintMoves?.Count ?? 0) move(s) found
                            @if (snapSolution != null)
                            {
                                <text> — ✅ Solution: @(snapSolution?.Count ?? 0) moves</text>
                            }
                        </span>
                        <button @onclick="ClearHint" class="btn-close-hint" title="Dismiss (H)">✕</button>
                    </div>
                    <div class="solver-hint-list">
                        @foreach (var move in hintMoves ?? [])
                        {
                            @if (move != null)
                            {
                                <div class="solver-hint-move @(IsSolutionMove(move) ? "hint-solution-move" : "")">
                                    <span class="hint-card">@RenderCardHtml(move.CardMoved)</span>
                                    <span class="hint-desc">@FormatMoveLocation(move.sourceType, move.sourceIndex)→@FormatMoveLocation(move.targetType, move.targetIndex)@(move.cardCount > 1 ? $" ({move.cardCount})" : "")</span>
                                    <span class="hint-mvalue">@move.mValue</span>
                                    @if (move.PendingSequenceMoves is { Count: > 0 })
                                    {
                                        <span class="hint-pending">@foreach (var p in move.PendingSequenceMoves){<span>@RenderCardHtml(p.CardMoved)→@FormatMoveLocation(p.targetType, p.targetIndex)</span>}</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <span>💡 @hintText</span>
                    <button @onclick="ClearHint" class="btn-close-hint" title="Dismiss">✕</button>
                }
            </div>
        </div>
    }

    @* Auto-solve cancel bar *@
    @if (_isAutoSolving)
    {
        <div class="auto-solve-banner">
            <span>🤖 Auto-solving...</span>
            <button @onclick="CancelAutoSolve" class="btn-cancel-solve">Cancel</button>
        </div>
    }

    <!-- Keyboard Help Panel -->
    @if (_showHelp)
    {
        <div class="keyboard-help">
            <h4>⌨️ Keyboard Shortcuts</h4>
            <div class="help-grid">
                <div><kbd>0</kbd>-<kbd>7</kbd></div><div>Select/move to tableau column</div>
                <div><kbd>0</kbd>-<kbd>7</kbd> (again)</div><div>Select more cards in stack</div>
                <div><kbd>↑</kbd> <kbd>↓</kbd></div><div>Adjust selection depth</div>
                <div><kbd>8</kbd></div><div>Move to free cell / cycle free cells as source</div>
                <div><kbd>Q</kbd><kbd>W</kbd><kbd>E</kbd><kbd>R</kbd></div><div>Select/move to free cell 1-4</div>
                <div><kbd>U</kbd><kbd>I</kbd><kbd>O</kbd><kbd>P</kbd></div><div>Move to foundation 1-4</div>
                <div><kbd>Space</kbd></div><div>Auto-move selected to foundation</div>
                <div><kbd>Z</kbd></div><div>Undo last move</div>
                <div><kbd>Esc</kbd></div><div>Clear selection</div>
                <div><kbd>A</kbd></div><div>Auto-complete</div>
                <div><kbd>H</kbd></div><div>Show solver hint</div>
                <div><kbd>S</kbd></div><div>Auto-solve</div>
                <div><kbd>N</kbd></div><div>New game</div>
            </div>
            <div class="help-section">
                <h5>💀 Unsolvable Games</h5>
                <p class="help-note">Verified impossible - hardcoded to match classic Windows FreeCell:</p>
                <div class="unsolvable-games">
                    <a href="#" @onclick="() => NavigateToGame(11982)" @onclick:preventDefault="true">#11982 - The Famous One</a>
                </div>
                <p class="help-note" style="margin-top: 12px;">Custom impossible layout:</p>
                <div class="unsolvable-games">
                    <a href="#" class="custom-impossible" @onclick="() => NavigateToGame(999999)" @onclick:preventDefault="true">#999999 - 4 Kings Buried</a>
                </div>
            </div>
            <button @onclick="ToggleHelp" class="btn-close-help">Close</button>
        </div>
    }

    <!-- Game Area -->
    <div class="freecell-game">
        <!-- Top Row: Free Cells and Foundations -->
        <div class="freecell-top-row">
            <!-- 4 Free Cells (Q, W, E, R) -->
            @for (int f = 0; f < 4; f++)
            {
                var cellIndex = f;
                var card = _game.FreeCells[f];
                var keyLabel = f switch { 0 => "Q", 1 => "W", 2 => "E", 3 => "R", _ => "" };
                <div class="card-pile free-cell" @onclick="() => OnFreeCellClick(cellIndex)">
                    <span class="key-hint">@keyLabel</span>
                    @if (card != null)
                    {
                        <PlayingCard CardData="@card" IsSelected="@IsSelected(SourceType.FreeCell, cellIndex, 0)" />
                    }
                    else
                    {
                        <div class="card card-empty free-cell-empty">
                            <span class="cell-label">Free</span>
                        </div>
                    }
                </div>
            }

            <!-- Spacer -->
            <div class="spacer"></div>

            <!-- 4 Foundation Piles (U, I, O, P) -->
            @for (int f = 0; f < 4; f++)
            {
                var foundationIndex = f;
                var foundation = _game.Foundations[f];
                var keyLabel = f switch { 0 => "U", 1 => "I", 2 => "O", 3 => "P", _ => "" };
                <div class="card-pile foundation-pile" @onclick="() => OnFoundationClick(foundationIndex)">
                    <span class="key-hint">@keyLabel</span>
                    @if (foundation.Count > 0)
                    {
                        var card = foundation[^1];
                        <PlayingCard CardData="@card" IsSelected="@IsSelected(SourceType.Foundation, foundationIndex, foundation.Count - 1)" />
                    }
                    else
                    {
                        var suitSymbol = f switch { 0 => "\u2665", 1 => "\u2666", 2 => "\u2663", 3 => "\u2660", _ => "" };
                        var suitColor = f < 2 ? "red" : "black";
                        <div class="card card-empty foundation-empty">
                            <span class="foundation-suit @suitColor">@suitSymbol</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tableau (8 columns, keys 0-7) -->
        <div class="freecell-tableau">
            @for (int col = 0; col < 8; col++)
            {
                var columnIndex = col;
                var column = _game.Tableau[col];
                <div class="tableau-column" @onclick="() => OnTableauColumnClick(columnIndex)">
                    <span class="key-hint">@col</span>
                    @if (column.Count == 0)
                    {
                        <div class="card card-empty tableau-empty"></div>
                    }
                    else
                    {
                        @for (int row = 0; row < column.Count; row++)
                        {
                            var card = column[row];
                            var cardRow = row;
                            
                            <PlayingCard CardData="@card" 
                                         IsSelected="@IsSelected(SourceType.Tableau, columnIndex, cardRow)"
                                         CssClass="tableau-card"
                                         StopPropagation="true"
                                         OnClick="@(() => OnTableauCardClick(columnIndex, cardRow))"
                                         CardRow="@cardRow" RowOffset="@_rowOffset" />
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- Instructions -->
    <div class="freecell-info">
        <h4>📖 How to Play</h4>
        <p>
            <strong>Goal:</strong> Move all 52 cards to the four foundation piles, building each suit from Ace to King.
        </p>
        <p>
            <strong>Rules:</strong>
        </p>
        <ul>
            <li><strong>Tableau:</strong> Build down in alternating colors (red on black, black on red)</li>
            <li><strong>Free Cells:</strong> Temporarily hold one card each - use strategically!</li>
            <li><strong>Foundations:</strong> Build up by suit (A→2→3→...→K)</li>
            <li><strong>Moving Stacks:</strong> You can move up to <strong>@_game.MaxMovableCards</strong> cards at once (based on empty free cells and columns)</li>
        </ul>

        <h4>🎮 Controls</h4>
        <div class="controls-section">
            <div class="control-group">
                <h5>🖱️ Mouse / Touch</h5>
                <ul>
                    <li><strong>Click:</strong> Select a card, then click destination</li>
                    <li><strong>Double-click:</strong> Auto-move card to foundation</li>
                    <li><strong>Drag & Drop:</strong> Drag cards to move them</li>
                </ul>
            </div>
            <div class="control-group">
                <h5>⌨️ Keyboard</h5>
                <ul>
                    <li><kbd>0</kbd>-<kbd>7</kbd> — Select/move to tableau column</li>
                    <li><kbd>0</kbd>-<kbd>7</kbd> (repeat) — Select more cards in stack</li>
                    <li><kbd>↑</kbd> <kbd>↓</kbd> — Adjust selection depth</li>
                    <li><kbd>8</kbd> — Move to free cell / cycle free cells as source</li>
                    <li><kbd>Q</kbd> <kbd>W</kbd> <kbd>E</kbd> <kbd>R</kbd> — Select/move to free cell</li>
                    <li><kbd>U</kbd> <kbd>I</kbd> <kbd>O</kbd> <kbd>P</kbd> — Move to foundation</li>
                    <li><kbd>Space</kbd> — Auto-move selected to foundation</li>
                    <li><kbd>Z</kbd> — Undo last move</li>
                    <li><kbd>Esc</kbd> — Clear selection</li>
                    <li><kbd>A</kbd> — Auto-complete all possible moves</li>
                    <li><kbd>H</kbd> — Show solver hints</li>
                    <li><kbd>S</kbd> — Auto-solve</li>
                    <li><kbd>N</kbd> — New game</li>
                    <li><kbd>?</kbd> — Show keyboard help</li>
                </ul>
            </div>
        </div>

        <p class="tip">
            💡 <strong>Tip:</strong> Keep free cells open as long as possible - they're your lifeline for complex moves!
        </p>
        <p class="tip">
            🎯 <strong>Game IDs:</strong> Each game number produces a unique, reproducible layout.
            To play a specific game, add the game number to the URL: <code>/freecell/1</code> for Game #1.
        </p>
        <p class="tip">
            ⚠️ <strong>Unsolvable Games:</strong> <a href="#" @onclick="() => NavigateToGame(11982)" @onclick:preventDefault="true"><strong>Game #11982</strong></a> is the famous unsolvable
            FreeCell deal from classic Windows FreeCell. Also try <a href="#" @onclick="() => NavigateToGame(999999)" @onclick:preventDefault="true"><strong>Game #999999</strong></a> - a custom
            layout with all 4 kings buried at the bottom!
        </p>
    </div>
</div>

@code {
    [Parameter]
    public int? GameId { get; set; }

    private FreeCellGameService _game = null!;
    private DotNetObjectReference<FreeCell>? _dotNetRef;
    private ElementReference _containerRef;
    private DateTime _lastClickTime = DateTime.MinValue;
    private (SourceType type, int index, int cardIndex)? _lastClickTarget;
    private const int DoubleClickThresholdMs = 400;
    private bool _showHelp = false;
    private bool _showWinAnimation = false;
    private bool _wasGameWon = false;
    private bool _isAutoMoving = false;
    private bool _stateLoaded = false;
    private bool _showNewGameMenu = false;
    private bool _showOptionsMenu = false;
    private int _rowOffset = 22; // Default, will be set based on viewport width
    private bool _autoMoveToFoundation = true; // New option for auto-move (default: enabled)
    private bool _autoShowHints = false; // Auto-show solver hints after each move
    private bool _debugMode = false; // Debug mode - enables verbose JS console logging
    private int? _lastGameId; // Track previous GameId to detect parameter changes
    private int _freeCellCycleIndex = -1; // Track cycling through free cells with "8" key

    // Solver hint and auto-solve state
    private List<FreeCellMove>? _solverHintMoves;
    private string? _solverHintText;
    private bool _isAutoSolving;
    private int _autoSolveDelay = 500; // ms between moves
    private CancellationTokenSource? _autoSolveCts;

    // Background solver state - runs while user plays to pre-compute solution
    private CancellationTokenSource? _backgroundSolveCts;
    private List<FreeCellMove>? _backgroundSolutionMoves;
    private FreeCellMove? _backgroundSolutionFirstMove;
    private int _backgroundSolutionMoveCount; // MoveHistory.Count when solution was computed
    private bool _backgroundSolveInProgress;
    private bool _backgroundSolveNoSolution;

    // Persistent visited-states set (Zobrist hashes) shared across solver restarts.
    // Tracks every board state the user has been through, including undo-branch states
    // that are no longer in the linear MoveHistory. Prevents the solver from reverting
    // the user's moves by treating these positions as already-explored.
    private HashSet<ulong> _userVisitedStates = new();

    protected override void OnInitialized()
    {
        DebugHelper.Log($"[FreeCell] OnInitialized with GameId={GameId}");
        _game = new FreeCellGameService();
        _lastGameId = GameId;

        if (GameId.HasValue)
        {
            // Initialize with specific game ID from URL - don't try to load saved state
            _game.InitializeGame(GameId.Value);
            _userVisitedStates.Clear();
            TrackCurrentState();
            _stateLoaded = true; // Skip loading saved state
            DebugHelper.Log($"[FreeCell] Initialized game #{GameId.Value} from URL");
        }
        // else: Don't initialize yet - wait for OnAfterRenderAsync to try loading saved state first
    }

    protected override void OnParametersSet()
    {
        DebugHelper.Log($"[FreeCell] OnParametersSet: _lastGameId={_lastGameId}, GameId={GameId}, _wasGameWon={_wasGameWon}");

        // Handle navigation between different game IDs (e.g., clicking links to unsolvable games)
        // Also reinitialize if navigating to the same game after a win (replay)
        if (GameId.HasValue && (_lastGameId != GameId || _wasGameWon))
        {
            DebugHelper.Log($"[FreeCell] GameId parameter changed from {_lastGameId} to {GameId} - reinitializing game");
            _game.InitializeGame(GameId.Value);
            _userVisitedStates.Clear();
            TrackCurrentState();
            _wasGameWon = false;
            _showWinAnimation = false;
            _stateLoaded = true;
            _lastGameId = GameId;
            RestartBackgroundSolver();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load CSS on demand
            await CssLoader.LoadCssFilesAsync(
                (GameCss.PlayingCards.Path, GameCss.PlayingCards.Version),
                (GameCss.FreeCell.Path, GameCss.FreeCell.Version));

            // Load saved settings
            var savedSettings = await GameStateService.LoadFreeCellSettingsAsync();
            if (savedSettings != null)
            {
                _autoMoveToFoundation = savedSettings.AutoMoveToFoundation;
                _autoShowHints = savedSettings.AutoShowHints;
                _autoSolveDelay = savedSettings.AutoSolveDelay > 0 ? savedSettings.AutoSolveDelay : 500;
                _debugMode = savedSettings.DebugMode;
                DebugHelper.SetDebugMode(_debugMode);
                DebugHelper.Log($"[FreeCell] Loaded settings - AutoMoveToFoundation: {_autoMoveToFoundation}, AutoShowHints: {_autoShowHints}, AutoSolveDelay: {_autoSolveDelay}, DebugMode: {_debugMode}");
            }

            // Detect viewport width and set appropriate row offset
            try
            {
                var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
                // Desktop (>768px): larger cards need more offset
                // Mobile (<=768px): smaller cards need less offset
                _rowOffset = width > 768 ? 38 : 17;
                DebugHelper.Log($"[FreeCell] Viewport width={width}, rowOffset={_rowOffset}");
            }
            catch
            {
                _rowOffset = 22; // Fallback
            }

            // Try to load saved state if no specific GameId in URL
            if (!_stateLoaded && !GameId.HasValue)
            {
                var savedState = await GameStateService.LoadFreeCellStateAsync();
                if (savedState != null)
                {
                    _game.RestoreState(savedState);
                    DebugHelper.Log($"[FreeCell] Restored game #{_game.GameId} with {_game.MoveCount} moves");
                }
                else
                {
                    // No saved state - now initialize a new game
                    _game.InitializeGame();
                    DebugHelper.Log($"[FreeCell] No saved state, new game #{_game.GameId}");
                }
                _stateLoaded = true;
                StateHasChanged();
            }

            // Track the initial game state before starting the background solver
            TrackCurrentState();

            // Start background solver to pre-compute solution
            RestartBackgroundSolver();

            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registerFreeCellBlazorComponent", _dotNetRef);

            // Sync debug mode to JavaScript
            if (_debugMode)
            {
                try { await JSRuntime.InvokeVoidAsync("setFreeCellDebug", true); } catch { }
            }

            // Initialize handlers only on first render
            try
            {
                await JSRuntime.InvokeVoidAsync("initializeFreeCell");
                DebugHelper.Log($"[FreeCell] Touch/pen handlers initialized");
            }
            catch (Exception ex)
            {
                DebugHelper.LogError($"[FreeCell] Error initializing handlers: {ex.Message}");
            }

            // Focus the container for keyboard input
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.freecell-container')?.focus()");
            }
            catch { }
        }

        // Check if game was just won
        if (_game.IsGameWon && !_wasGameWon)
        {
            DebugHelper.Log("[FreeCell] Win detected! Starting animation...");
            _wasGameWon = true;
            _showWinAnimation = true;
            // Clear saved state on win
            await GameStateService.ClearFreeCellStateAsync();
            StateHasChanged();
            await Task.Delay(100); // Let canvas render
            // Disable touch/drag interactions during win animation
            try
            {
                await JSRuntime.InvokeVoidAsync("setFreeCellAutoMoving", true);
            }
            catch { }

            await JSRuntime.InvokeVoidAsync("startFreeCellWinAnimation");
        }

        // Check if game became trivially winnable (auto-solve) - only when auto-move is enabled
        var (isWinnable, _) = _game.IsTriviallyWinnableWithReason();

        if (_autoMoveToFoundation && !_game.IsGameWon && !_isAutoMoving && isWinnable)
        {
            DebugHelper.Log("[FreeCell] Game is trivially winnable - starting auto-solve");
            _isAutoMoving = true;
            await Task.Delay(500); // Brief pause before auto-solve
            await AutoMoveWithAnimation();
            _isAutoMoving = false;
        }
    }

    private void ToggleHelp()
    {
        _showHelp = !_showHelp;
    }

    private void NavigateToGame(int gameId)
    {
        // Close any open overlays and navigate via Blazor router
        _showHelp = false;
        _showNewGameMenu = false;
        _showOptionsMenu = false;
        NavigationManager.NavigateTo($"/freecell/{gameId}");
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        DebugHelper.Log($"[FreeCell] Key pressed: {e.Key}");

        // Allow Escape to cancel auto-solve; block other keys during auto-solve
        if (_isAutoSolving)
        {
            if (e.Key == "Escape") CancelAutoSolve();
            return;
        }

        switch (e.Key.ToUpperInvariant())
        {
            // Tableau columns 0-7
            case "0": case "1": case "2": case "3":
            case "4": case "5": case "6": case "7":
                int col = int.Parse(e.Key);
                HandleTableauKey(col);
                break;

            // Free cell cycling with 8 key
            case "8":
                HandleFreeCellCycleKey();
                break;

            // Free cells Q, W, E, R (0-3)
            case "Q": HandleFreeCellKey(0); break;
            case "W": HandleFreeCellKey(1); break;
            case "E": HandleFreeCellKey(2); break;
            case "R": HandleFreeCellKey(3); break;

            // Foundations U, I, O, P (0-3)
            case "U": HandleFoundationKey(0); break;
            case "I": HandleFoundationKey(1); break;
            case "O": HandleFoundationKey(2); break;
            case "P": HandleFoundationKey(3); break;

            // Arrow keys - adjust selection depth in tableau
            case "ARROWUP":
                AdjustSelectionDepth(-1); // Select more cards (deeper)
                break;
            case "ARROWDOWN":
                AdjustSelectionDepth(1); // Select fewer cards (shallower)
                break;

            // Space - auto-move selected to foundation
            case " ":
                if (_game.Selection != null)
                {
                    var (st, si, ci) = _game.Selection.Value;
                    _game.TryAutoMoveToFoundation(st, si, ci);
                    _game.ClearSelection();
                    TryAutoMoveIfEnabled();
                }
                break;

            // Z - Undo
            case "Z":
                Undo();
                break;

            // A - Auto-complete (still available via keyboard)
            case "A":
                await AutoComplete();
                break;

            // H - Show solver hint
            case "H":
                await ShowHint();
                break;

            // S - Auto-solve
            case "S":
                await StartAutoSolve();
                break;

            // N - New game menu toggle
            case "N":
                ToggleNewGameMenu();
                break;

            // V - Validate hash table
            case "V":
                ValidateVisitedStates();
                break;

            // ? or / - Toggle help
            case "?":
            case "/":
                ToggleHelp();
                break;

            // Escape - clear selection or close menus
            case "ESCAPE":
                if (_showNewGameMenu)
                {
                    _showNewGameMenu = false;
                }
                else if (_showOptionsMenu)
                {
                    _showOptionsMenu = false;
                }
                else
                {
                    _game.ClearSelection();
                }
                break;
        }

        StateHasChanged();
    }

    private void Undo()
    {
        if (_game.CanUndo)
        {
            _game.Undo();
            ClearHint();
            TryAutoShowHints();
            DebugHelper.Log($"[FreeCell] Undo - {_game.UndoCount} moves remaining in history");
        }
    }

    private void HandleTableauKey(int columnIndex)
    {
        var column = _game.Tableau[columnIndex];

        if (_game.Selection != null)
        {
            var (sourceType, sourceIndex, sourceCardIndex) = (_game.Selection.Value.SourceType, _game.Selection.Value.SourceIndex, _game.Selection.Value.CardIndex);

            // If already selected in this column, select deeper (more cards)
            if (sourceType == SourceType.Tableau && sourceIndex == columnIndex)
            {
                // Press same column again to select one card deeper
                if (sourceCardIndex > 0)
                {
                    int newCardIndex = sourceCardIndex - 1;
                    if (_game.IsValidTableauSequence(columnIndex, newCardIndex))
                    {
                        _game.Select(SourceType.Tableau, columnIndex, newCardIndex);
                        return;
                    }
                }
                // Can't go deeper - deselect
                _game.ClearSelection();
                return;
            }

            // Try to move to this column
            bool success = _game.TryMove(SourceType.Tableau, columnIndex);
            if (success)
            {
                _game.ClearSelection();
                // Don't auto-move if user intentionally moved from foundation to tableau
                if (sourceType != SourceType.Foundation)
                {
                    TryAutoMoveIfEnabled();
                }
            }
            else if (column.Count > 0)
            {
                // Select the top card of this column instead
                _game.ClearSelection();
                _game.Select(SourceType.Tableau, columnIndex, column.Count - 1);
            }
        }
        else if (column.Count > 0)
        {
            // Select the top card of this column
            _game.Select(SourceType.Tableau, columnIndex, column.Count - 1);
        }
    }

    private void AdjustSelectionDepth(int delta)
    {
        if (_game.Selection == null) return;

        var (sourceType, sourceIndex, sourceCardIndex) = (_game.Selection.Value.SourceType, _game.Selection.Value.SourceIndex, _game.Selection.Value.CardIndex);

        // Only works for tableau selections
        if (sourceType != SourceType.Tableau) return;

        var column = _game.Tableau[sourceIndex];
        if (column.Count == 0) return;

        int newCardIndex = sourceCardIndex + delta;

        // Clamp to valid range
        if (newCardIndex < 0) newCardIndex = 0;
        if (newCardIndex >= column.Count) newCardIndex = column.Count - 1;

        // Check if the new selection forms a valid sequence
        if (_game.IsValidTableauSequence(sourceIndex, newCardIndex))
        {
            _game.Select(SourceType.Tableau, sourceIndex, newCardIndex);
        }
    }

    private void HandleFreeCellKey(int cellIndex)
    {
        var card = _game.FreeCells[cellIndex];

        if (_game.Selection != null)
        {
            // Try to move to this free cell
            bool success = _game.TryMove(SourceType.FreeCell, cellIndex);
            if (success)
            {
                _game.ClearSelection();
                TryAutoMoveIfEnabled();
            }
            else if (card != null)
            {
                // Select the card in this free cell instead
                _game.ClearSelection();
                _game.Select(SourceType.FreeCell, cellIndex, 0);
            }
        }
        else if (card != null)
        {
            // Select the card in this free cell
            _game.Select(SourceType.FreeCell, cellIndex, 0);
        }
    }

    private void HandleFreeCellCycleKey()
    {
        if (_game.Selection != null)
        {
            var (sourceType, sourceIndex, _) = _game.Selection.Value;

            // If a free cell is already selected, cycle to the next non-empty free cell
            if (sourceType == SourceType.FreeCell)
            {
                _freeCellCycleIndex = sourceIndex;
                for (int attempt = 0; attempt < 4; attempt++)
                {
                    _freeCellCycleIndex = (_freeCellCycleIndex + 1) % 4;
                    if (_game.FreeCells[_freeCellCycleIndex] != null)
                    {
                        _game.Select(SourceType.FreeCell, _freeCellCycleIndex, 0);
                        return;
                    }
                }
                // No other non-empty free cells - keep current selection
                return;
            }

            // Non-freecell source selected: move to first empty free cell
            for (int i = 0; i < 4; i++)
            {
                if (_game.FreeCells[i] == null)
                {
                    bool success = _game.TryMove(SourceType.FreeCell, i);
                    if (success)
                    {
                        _game.ClearSelection();
                        TryAutoMoveIfEnabled();
                    }
                    return;
                }
            }
            // No empty free cells - do nothing
        }
        else
        {
            // Source mode: cycle through non-empty free cells
            // Find the next non-empty free cell after _freeCellCycleIndex
            for (int attempt = 0; attempt < 4; attempt++)
            {
                _freeCellCycleIndex = (_freeCellCycleIndex + 1) % 4;
                if (_game.FreeCells[_freeCellCycleIndex] != null)
                {
                    _game.Select(SourceType.FreeCell, _freeCellCycleIndex, 0);
                    return;
                }
            }
            // No non-empty free cells found
        }
    }

    private void HandleFoundationKey(int foundationIndex)
    {
        if (_game.Selection != null)
        {
            var (sourceType, sourceIndex, _) = _game.Selection.Value;

            // If the same foundation is already selected, deselect
            if (sourceType == SourceType.Foundation && sourceIndex == foundationIndex)
            {
                _game.ClearSelection();
                return;
            }

            // Try to move to this foundation
            bool success = _game.TryMove(SourceType.Foundation, foundationIndex);
            _game.ClearSelection();
            if (success)
            {
                TryAutoMoveIfEnabled();
            }
        }
        else if (_game.Foundations[foundationIndex].Count > 0)
        {
            // Select the top card of this foundation as a source
            _game.Select(SourceType.Foundation, foundationIndex, _game.Foundations[foundationIndex].Count - 1);
        }
    }

