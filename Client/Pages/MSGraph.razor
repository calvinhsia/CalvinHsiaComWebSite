    *
    */
    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("GraphAPI");
        try
        {
            var metadataversion = "v1.0"; // "v1.0" or "beta"
            var dataRequest = await _httpClient.GetAsync($"https://graph.microsoft.com/{metadataversion}/me");

            if (dataRequest.IsSuccessStatusCode)
            {
                var userData = System.Text.Json.JsonDocument.Parse(await dataRequest.Content.ReadAsStreamAsync());
                userDisplayName = userData.RootElement.GetProperty("displayName").GetString();
                foreach (var hdr in dataRequest.RequestMessage.Headers)
                {
                    foreach (var val in hdr.Value)
                    {
                        Console.WriteLine($"Hdr = {hdr.Key} =  {val}");
                    }
                }


            }
            var filesRequest = await _httpClient.GetAsync($"https://graph.microsoft.com/{metadataversion}/me/drive/root/children");
            if (filesRequest.IsSuccessStatusCode)
            {
                files = await filesRequest.Content.ReadAsStringAsync();
            }
            else
            {
                files = filesRequest.StatusCode.ToString();
                filesErrorMessage = await filesRequest.Content.ReadAsStringAsync();   
            }


            //            var mailRequest = await _httpClient.GetAsync($"https://graph.microsoft.com/{metadataversion}/me/messages");
            var mailRequest = await _httpClient.GetAsync($"https://graph.microsoft.com/{metadataversion}/me/messages?$select=subject,receivedDateTime,sender&$top=10");
            var stat = mailRequest.StatusCode;
            if (mailRequest.IsSuccessStatusCode)
            {
                var mailData = System.Text.Json.JsonDocument.Parse(await mailRequest.Content.ReadAsStreamAsync());
                var messagesArray = mailData.RootElement.GetProperty("value").EnumerateArray();

                foreach (var m in messagesArray)
                {
                    var message = new MailMessage();
                    message.Subject = m.GetProperty("subject").GetString();
                    message.Sender = m.GetProperty("sender").GetProperty("emailAddress").GetProperty("address").GetString();
                    message.ReceivedTime = m.GetProperty("receivedDateTime").GetDateTime();
                    messages.Add(message);
                }
            }
            else
            {

                var content = await mailRequest.Content.ReadAsStringAsync();
                errorMessage = content;
                Console.WriteLine(content);

            }
        }
        catch (AccessTokenNotAvailableException ex)
        {
            // Tokens are not valid - redirect the user to log in again
            ex.Redirect();
        }
    }

    public class MailMessage
    {
        public string Subject;
        public string Sender;
        public DateTime ReceivedTime;
    }
}