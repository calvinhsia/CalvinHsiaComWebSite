@page "/PictureQuery"
@page "/PictureQuery/{PageNumber:int}"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Web;
@using WordScapeBlazorWasm.Services

<AuthorizeView>
    <Authorized>
        <div class="compact-query-form">
            <div class="filter-row">
                <div class="filter-item">
                    <label>Filter:</label>
                    <div class="filter-input-container">
                        <input id="NotesFilter" @bind="@notesFilter" @bind:event="oninput" @bind:after="OnFilterChanged"
                            title="Start with |; for OR.\nStart With '$' for filename search ('$^(.*)\.avi')\n Start with '^' for regex e.g. '^.*(pui|hallie).*'  (CaseIgnore)" 
                            size="25" @onfocus="ShowHistory" @onblur="HideHistoryDelayed" />
                        @if (showFilterHistory && filterHistory.Count > 0)
                        {
                            <div class="filter-history-dropdown">
                                @foreach (var historyItem in filterHistory)
                                {
                                    <div class="filter-history-item" @onmousedown="() => SelectFromHistory(historyItem)" 
                                         title="@historyItem">
                                        @historyItem
                                    </div>
                                }
                                @if (filterHistory.Count > 0)
                                {
                                    <div class="filter-history-clear" @onmousedown="ClearFilterHistory" title="Clear history">
                                        🗑️ Clear History
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="filter-item">
                    <label>Type:</label>
                    <input id="MediaType" @bind="@mediaType" placeholder="pic|mov" size="6"/>
                </div>
                <div class="filter-item">
                    <label>From:</label>
                    <input id="date1" @bind="@date1" size="8"/>
                </div>
                <div class="filter-item">
                    <label>To:</label>
                    <input id="date2" @bind="@date2" size="8"/>
                </div>
                <div class="album-controls">
                    @if (!isGuestUser)
                    {
                        <input type="checkbox" id="publishToAlbum" @bind="@publishToAlbum" />
                        <label for="publishToAlbum">Album</label>
                        @if (publishToAlbum)
                        {
                            <input id="albumName" @bind="@albumName" @oninput="OnAlbumNameChanged" placeholder="Album name" size="15" />
                            <input id="albumMaxItems" type="number" @bind="@albumMaxItems" min="1" max="100000" size="4" title="Max items" />
                        }
                    }
                </div>
                    <button @onclick="DoQueryAsync" disabled="@(isQuerying || isPublishing || isResuming || !userMailResolved)" class="query-btn">
                        @if (isQuerying)
                        {
                            <span>Querying...</span>
                        }
                        else if (isPublishing)
                        {
                            <span>Creating Album...</span>
                        }
                        else if (isResuming)
                        {
                            <span>Resuming Album...</span>
                        }
                        else
                        {
                            <span>🔍 Query</span>
                        }
                    </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="status-line">@((MarkupString)statusMessage)</div>
        }

        @if (isPublishing && albumProgress != null)
        {
            <div class="progress-compact">
                <div class="progress-info">
                    <span><strong>Album:</strong> @(albumProgress.TotalItems > 0 ? Math.Round((double)albumProgress.CompletedItems / albumProgress.TotalItems * 100, 1) : 0)% | Added: @albumProgress.SuccessfullyAdded | Exists: @albumProgress.AlreadyExists | Failed: @albumProgress.FailedToAdd</span>
                    @if (albumProgress.CompletedItems > 0 && albumProgress.CompletedItems < albumProgress.TotalItems)
                    {
                        var remainingTime = CalculateRemainingTime();
                        var completionTime = CalculateCompletionTime();
                        var remainingItems = albumProgress.TotalItems - albumProgress.CompletedItems;
                        <span class="eta-display">
                            <strong>Progress:</strong> @albumProgress.CompletedItems/@albumProgress.TotalItems items (@remainingItems left) | 
                            <strong>ETA:</strong> @FormatTimeSpan(remainingTime) | 
                            <strong>Done at:</strong> @completionTime.ToString("h:mm:ss tt")
                        </span>
                    }
                </div>
                
                <!-- Timer Section -->
                <div class="timer-info">
                    @if (albumProgress.CompletedItems > 0)
                    {
                        var avgTime = GetAverageProcessingTimeMs();
                        var lastItemTime = itemProcessingTimes.LastOrDefault();
                        <span class="timer-display">
                            <strong>Timing:</strong> 
                            Last: @(Math.Round(lastItemTime / 1000, 1))s | 
                            Avg: @(Math.Round(avgTime / 1000, 1))s/item
                        </span>
                    }
                </div>
                
                <button class="cancel-btn" @onclick="CancelAlbumCreation" title="Cancel album creation">✕ Cancel</button>
                <div class="progress-bar-mini">
                    <div class="progress-fill" style="width: @(albumProgress.TotalItems > 0 ? Math.Round((double)albumProgress.CompletedItems / albumProgress.TotalItems * 100, 1) : 0)%"></div>
                </div>
            </div>
        }

        @{
            NumberPerRow = 1;
            if (browserDimensions.Width > 2000)
            {
                NumberPerRow = 3;
            } else if (browserDimensions.Width > 800)
            {
                NumberPerRow = 2;
            }
            if (myPixes.Count > 0)
            {
                <div class="info-line">Pg={@this.PageNumber} | Results=@NumberTotalPix | PerPage=@NumberPerPage | MaxPix=@maxpix</div>
            }
            if (myPixes.Count > NumberPerPage)
            {
                <div class="pagination-compact">
                @for (int i = 1; i <= (NumberTotalPix + NumberPerPage - 1)/ NumberPerPage ; i++ )
                {
                    var pix = myPixes[i * NumberPerPage - NumberPerPage];
                    <a href="PictureQuery/@i" title="@pix.ToString()">@i</a>
                    if (i % (30 * NumberPerRow) == 0)
                    {
                        <br/>
                    }
                }
                </div>
            }
            var cntr = 0;
        }
        <div id="lightbox" class="lightbox-overlay @(showLightbox ? "lightbox-visible" : "")">
            <div class="lightbox-toolbar">
                <button class="lightbox-btn" @onclick="LightboxClose">← Back</button>
                <span class="lightbox-title">@mainPix?.AltText</span>
                <button class="lightbox-btn rotate-btn" @onclick="RotateCurrentMediaAsync" title="Rotate 90° CW"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></button>
                <button class="lightbox-btn" @onclick="MyImgClickMain" disabled="@(mainPix == null)">⬇ Download</button>
            </div>
            <div class="lightbox-body">
                <div class="lightbox-media" id="lightboxMedia">
                    <img id="imageMain" class="lightbox-img" />
                    <div id="videoWrapper" class="video-wrapper">
                        <video id="myVideo" class="lightbox-video" playsinline data-mime-type="video/mp4">
                            video tag not supported
                        </video>
                    </div>
                    <div id="videoControls" class="video-controls" style="display:none">
                        <button id="vcPlayPause" class="vc-btn" onclick="window.vcTogglePlay()">▶</button>
                        <span id="vcTime" class="vc-time">0:00 / 0:00</span>
                        <input id="vcSeek" class="vc-seek" type="range" min="0" max="100" value="0" step="0.1"
                               oninput="window.vcSeek(this.value)" />
                        <button id="vcMute" class="vc-btn" onclick="window.vcToggleMute()">🔊</button>
                        <button id="vcFs" class="vc-btn" onclick="window.vcFullscreen()" title="Fullscreen">⛶</button>
                    </div>
                    <button class="lightbox-nav lightbox-prev" @onclick="LightboxPrev" disabled="@(lightboxIndex <= 0)">❮</button>
                    <button class="lightbox-nav lightbox-next" @onclick="LightboxNext" disabled="@(lightboxIndex >= myPixes.Count - 1)">❯</button>
                </div>
            </div>
            <div class="lightbox-footer">
                <span class="lightbox-counter">@(lightboxIndex + 1) / @myPixes.Count</span>
                @if (myPixes.Count > 1)
                {
                    <input type="range" class="lightbox-slider" min="0" max="@(myPixes.Count - 1)"
                           value="@lightboxIndex"
                           @oninput="OnSliderInput"
                           @onchange="OnSliderChange" />
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="spinner-overlay">
                <div class="spinner"></div>
            </div>
        }

        <table class="table">
            <tbody>
                @foreach (var pix in myPixes.Skip((PageNumber - 1) * NumberPerPage).Take(NumberPerPage))
                {
                    var imgname = $"image{cntr}";
                    if (cntr % NumberPerRow == 0)
                    {
                        @:<tr>
                    }
                    <td style="vertical-align:top;"><img id="@imgname" title="@pix.AltText" @onclick="()=> MyThumbClick(pix)" style="max-width:360px;max-height:270px;width:auto;height:auto;object-fit:contain;cursor:pointer;" />@pix.AltText</td>
                    cntr++;
                    if (cntr % NumberPerRow == NumberPerRow-1 || cntr == NumberPerPage)
                    {
                        @:</tr>
                    }
                }
            </tbody>
        </table>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <h4>🔒 Authentication Required</h4>
            <p>You need to be logged in to access the Picture Query feature.</p>
            <a href="authentication/login" class="btn btn-primary">
                <i class="oi oi-account-login"></i> Sign In
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .lightbox-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: #000;
        z-index: 9999;
        flex-direction: column;
    }

    .lightbox-visible {
        display: flex !important;
    }

    .lightbox-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        background: rgba(0,0,0,0.85);
        color: white;
        flex-shrink: 0;
        min-height: 44px;
    }

    .lightbox-title {
        flex: 1;
        text-align: center;
        font-size: 13px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0 10px;
        color: #ddd;
    }

    .lightbox-btn {
        background: rgba(255,255,255,0.15);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
        padding: 5px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        white-space: nowrap;
    }

    .lightbox-btn:hover:not(:disabled) {
        background: rgba(255,255,255,0.3);
    }

    .lightbox-btn:disabled {
        opacity: 0.4;
        cursor: default;
    }

    .lightbox-body {
        flex: 1;
        overflow: hidden;
        position: relative;
    }

    .lightbox-media {
        width: 100%;
        height: 100%;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lightbox-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: none;
        touch-action: pinch-zoom;
    }

    .lightbox-video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: none;
    }

    /* Wrapper that receives the CSS rotation — video lives inside */
    .video-wrapper {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: none;           /* shown by JS when a video is loaded */
        align-items: center;
        justify-content: center;
    }

    /* Custom video controls — sit outside the rotating wrapper */
    .video-controls {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        z-index: 20;
        background: rgba(0,0,0,0.65);
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
    }
    .vc-btn {
        background: none;
        border: none;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        padding: 2px 6px;
        flex-shrink: 0;
    }
    .vc-btn:hover { color: #ccc; }
    .vc-time {
        color: #ddd;
        font-size: 12px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .vc-seek {
        flex: 1;
        accent-color: #aaa;
        cursor: pointer;
        min-width: 0;
    }
    .rotate-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
    }

    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0,0,0,0.45);
        color: white;
        border: none;
        font-size: 2rem;
        padding: 14px 18px;
        cursor: pointer;
        z-index: 10;
        border-radius: 4px;
        transition: background 0.2s;
        line-height: 1;
    }

    .lightbox-prev { left: 8px; }
    .lightbox-next { right: 8px; }

    .lightbox-nav:hover:not(:disabled) {
        background: rgba(0,0,0,0.75);
    }

    .lightbox-nav:disabled {
        opacity: 0.15;
        cursor: default;
    }

    .lightbox-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        background: rgba(0,0,0,0.75);
        padding: 4px 12px 6px;
        flex-shrink: 0;
    }

    .lightbox-counter {
        color: rgba(255,255,255,0.7);
        font-size: 12px;
    }

    .lightbox-slider {
        width: min(600px, 90vw);
        accent-color: #aaa;
        cursor: pointer;
    }

    .filter-input-container {
        position: relative;
        display: inline-block;
    }

    .filter-history-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #ccc;
        border-top: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
    }

    .filter-history-item {
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .filter-history-item:hover {
        background-color: #f5f5f5;
    }

    .filter-history-item:last-of-type {
        border-bottom: none;
    }

    .filter-history-clear {
        padding: 8px 12px;
        cursor: pointer;
        background-color: #f8f9fa;
        color: #6c757d;
        font-size: 12px;
        border-top: 1px solid #e9ecef;
        text-align: center;
    }

    .filter-history-clear:hover {
        background-color: #e9ecef;
    }
</style>

<script type="text/javascript">
    window.getDimensions = () => {
        return {
            width: window.innerWidth,
            height: window.innerHeight
        }
    };
    window.setElementVisible = async (imageElementId, visibility) => {
        const imageCtrl = document.getElementById(imageElementId);
        if (imageCtrl) {
            imageCtrl.style.display = visibility;
        }
    };

    window.clearImageSrc = (imageElementId) => {
        const el = document.getElementById(imageElementId);
        if (el) {
            el.removeAttribute('src');
            el.style.display = 'block';
            el.style.background = '#e9ecef';
            el.style.minWidth = '120px';
            el.style.minHeight = '90px';
        }
    };

    // Reads the rotation angle (0/90/180/270) from an MP4 file's tkhd box.
    // Tries the first 128 KB first (moov-before-mdat, streaming-optimised files).
    // If not found, fetches the last 128 KB using the known fileSize (moov-after-mdat,
    // typical phone recordings). fileSize comes from Graph metadata — no Content-Range needed.
    async function getMp4RotationFromUrl(url, fileSize) {
        const CHUNK = 131072; // 128 KB
        try {
            // ── Pass 1: start of file ──────────────────────────────────────────
            let resp = await fetch(url, { headers: { Range: `bytes=0-${CHUNK - 1}` } });
            if (!resp.ok && resp.status !== 206) return 0;
            let buf = await resp.arrayBuffer();
            let deg = scanBufferForTkhdRotation(buf, 0);
            if (deg !== null) return deg;

            // ── Pass 2: end of file (moov after mdat — large phone recordings) ─
            // Use fileSize from Graph metadata — avoids depending on Content-Range header
            // which some CDNs omit when returning 200 instead of 206.
            if (fileSize > CHUNK) {
                const tailStart = fileSize - CHUNK;
                console.log(`[Mp4Rotation] pass1 found no tkhd; fetching tail bytes=${tailStart}-${fileSize-1}`);
                resp = await fetch(url, { headers: { Range: `bytes=${tailStart}-${fileSize - 1}` } });
                if (resp.ok || resp.status === 206) {
                    buf = await resp.arrayBuffer();
                    deg = scanBufferForTkhdRotation(buf, tailStart);
                    if (deg !== null) return deg;
                }
            }
        } catch(e) {
            console.warn('[Mp4Rotation] failed to read:', e);
        }
        return 0;
    }

    // Walks MP4 boxes in buf looking for a tkhd with a non-identity rotation matrix.
    // bufOffset is the byte position of buf[0] within the original file (used for logging only).
    // Returns the CSS rotation degrees (0/90/180/270), or null if no non-identity tkhd found.
    function scanBufferForTkhdRotation(buf, bufOffset) {
        const view = new DataView(buf);
        const len = view.byteLength;

        // If this is a tail chunk the buf may start mid-mdat.
        // Find the 'moov' FourCC and back up 4 bytes to the box size field.
        function findFourCC(fourcc) {
            const b = [fourcc.charCodeAt(0), fourcc.charCodeAt(1), fourcc.charCodeAt(2), fourcc.charCodeAt(3)];
            for (let i = 4; i < len - 3; i++)
                if (view.getUint8(i)===b[0] && view.getUint8(i+1)===b[1] &&
                    view.getUint8(i+2)===b[2] && view.getUint8(i+3)===b[3])
                    return i - 4; // return start of box (size field)
            return -1;
        }

        function walkBoxes(i, limit, depth) {
            while (i + 8 <= limit) {
                const boxSize = view.getUint32(i);
                const boxType = String.fromCharCode(
                    view.getUint8(i+4), view.getUint8(i+5),
                    view.getUint8(i+6), view.getUint8(i+7));
                if (boxSize < 8) break;

                if (boxType === 'tkhd') {
                    const version = view.getUint8(i + 8);
                    // tkhd matrix offset:
                    //   v0: size(4)+type(4)+ver(1)+flags(3)+ctime(4)+mtime(4)+trackid(4)+reserved(4)+duration(4)+reserved(8)+layer(2)+altgrp(2)+vol(2)+reserved(2) = 48
                    //   v1: same but ctime/mtime/duration are 8 bytes each → 60
                    const matrixOffset = i + (version === 1 ? 60 : 48);
                    if (matrixOffset + 36 > len) { i += boxSize; continue; }
                    const a = view.getInt32(matrixOffset)      / 65536;
                    const b = view.getInt32(matrixOffset + 4)  / 65536;
                    const c = view.getInt32(matrixOffset + 12) / 65536;
                    const d = view.getInt32(matrixOffset + 16) / 65536;
                    const ra = Math.round(a), rb = Math.round(b),
                          rc = Math.round(c), rd = Math.round(d);
                    console.log(`[Mp4Rotation] tkhd at buf+${i} (file+${bufOffset+i}) v=${version} matrix a=${ra} b=${rb} c=${rc} d=${rd}`);
                    // Skip identity matrix (audio track or unrotated video)
                    if (ra === 1 && rb === 0 && rc === 0 && rd === 1) { i += boxSize; continue; }
                    let deg = 0;
                    if      (ra=== 0 && rb=== 1 && rc===-1 && rd=== 0) deg =  90;
                    else if (ra===-1 && rb=== 0 && rc=== 0 && rd===-1) deg = 180;
                    else if (ra=== 0 && rb===-1 && rc=== 1 && rd=== 0) deg = 270;
                    console.log(`[Mp4Rotation] detected rotation=${deg}deg`);
                    if (typeof appInsights !== 'undefined') {
                        try { appInsights.trackEvent({ name: 'Video_Mp4Rotation', properties: { deg: String(deg), a: String(ra), b: String(rb), c: String(rc), d: String(rd) } }); } catch {}
                    }
                    return deg;
                }
                // Recurse into container boxes
                if (['moov','trak','mdia','minf','stbl'].includes(boxType)) {
                    const result = walkBoxes(i + 8, i + boxSize, depth + 1);
                    if (result !== null) return result;
                }
                i += boxSize;
            }
            return null; // not found in this buffer
        }

        // Try walking from offset 0 (works when moov is at the start)
        let result = walkBoxes(0, len, 0);
        if (result !== null) return result;

        // buf may be a tail chunk starting mid-mdat — search for 'moov' FourCC
        const moovStart = findFourCC('moov');
        if (moovStart >= 0) {
            console.log(`[Mp4Rotation] found moov at buf+${moovStart} (file+${bufOffset + moovStart})`);
            result = walkBoxes(moovStart, len, 0);
            if (result !== null) return result;
        }
        return null;
    }

    // Sets a video element's src to a direct streaming URL (no blob, supports range requests).
    // The browser streams natively — ideal for large video files on mobile.
    window.setVideoUrl = async (videoElementId, url, mimeType, graphRotation, fileSize) => {
        const video = document.getElementById(videoElementId);
        if (!video) return;
        // Revoke any previous blob URL
        if (video._blobUrl) {
            URL.revokeObjectURL(video._blobUrl);
            video._blobUrl = null;
        }
        video._mutedRetry = false;
        video.muted = false;
        video._manualRotation = 0;
        const wrapper  = document.getElementById('videoWrapper');
        const controls = document.getElementById('videoControls');
        if (!url) {
            video.removeAttribute('src');
            video.load();
            video.style.display = 'none';
            if (wrapper)  { wrapper.style.display = 'none'; wrapper.style.transform = ''; wrapper.style.width='100%'; wrapper.style.height='100%'; wrapper.style.position=''; wrapper.style.left=''; wrapper.style.top=''; }
            if (controls) controls.style.display = 'none';
            return;
        }
        video.style.display = 'block';
        if (wrapper)  { wrapper.style.display = 'flex'; }
        if (controls) { controls.style.display = 'flex'; }
        attachVideoControlHooks(video);
        video.dataset.mimeType = mimeType || 'video/mp4';
        video.dataset.fileName = videoElementId;
        const trackVideoEvent = (name, extra) => {
            const props = {
                fileName: video.dataset.fileName || videoElementId,
                mimeType: video.dataset.mimeType,
                readyState: String(video.readyState),
                networkState: String(video.networkState),
                duration: String(video.duration),
                currentTime: String(video.currentTime),
                userAgent: navigator.userAgent,
                ...extra
            };
            console.log(`[VideoEvent] ${name}`, props);
            if (typeof appInsights !== 'undefined') {
                try { appInsights.trackEvent({ name: `Video_${name}`, properties: props }); } catch {}
            }
        };
        // Use Graph rotation if provided, otherwise parse the MP4 header directly.
        // fileSize (from Graph metadata) is passed to avoid depending on Content-Range headers
        // which some CDNs omit when returning 200 instead of 206.
        const rotation = (graphRotation && graphRotation !== 0)
            ? graphRotation
            : await getMp4RotationFromUrl(url, fileSize || 0);
        applyVideoRotation(video, rotation);
        trackVideoEvent('Loaded', { rotation: String(rotation), hasUrl: String(!!url), graphRotation: String(graphRotation || 0), fileSize: String(fileSize || 0), windowW: String(window.innerWidth), windowH: String(window.innerHeight) });
        video.onerror = () => {
            const err = video.error;
            trackVideoEvent('Error', { errorCode: String(err?.code), errorMessage: err?.message ?? '' });
            console.error(`[setVideoUrl] video error code=${err?.code} message=${err?.message}`);
            if (err?.code === 4 && !video._mutedRetry) {
                console.warn(`[setVideoUrl] AAC not supported, retrying muted`);
                video._mutedRetry = true;
                video.muted = true;
                video.load();
                video.oncanplay = () => {
                    video.oncanplay = null;
                    video.play().catch(e => console.warn(`[setVideoUrl] muted retry play() failed: ${e.message}`));
                };
            }
        };
        video.oncanplay = () => {
            video.oncanplay = null;
            video.play().catch(e => {
                trackVideoEvent('PlayFailed', { errorName: e.name, errorMessage: e.message });
                console.warn(`[setVideoUrl] play() failed: ${e.name}: ${e.message}`);
            });
        };
        video.src = url;
        video.load();
    };

    // ── Video rotation ──────────────────────────────────────────────────────────
    // The <video> element lives inside #videoWrapper.  We rotate the WRAPPER, not
    // the video itself, so the native <video> controls are replaced by custom ones
    // (#videoControls) that sit outside the wrapper and are never rotated.
    function applyVideoRotation(video, degrees) {
        const wrapper = document.getElementById('videoWrapper');
        if (!wrapper) return;

        // Full reset
        wrapper.style.transform = '';
        wrapper.style.width     = '100%';
        wrapper.style.height    = '100%';
        wrapper.style.position  = 'absolute';
        wrapper.style.top       = '0';
        wrapper.style.left      = '0';
        video.style.width  = '100%';
        video.style.height = '100%';

        const norm = ((degrees % 360) + 360) % 360;
        if (norm === 0) {
            console.log('[VideoRotation] no rotation needed');
            return;
        }

        wrapper.style.transform = `rotate(${norm}deg)`;

        if (norm === 90 || norm === 270) {
            // Defer dimension read until the browser has finished layout so
            // clientWidth/Height are non-zero (fixes mobile first-load blank).
            let swapAttempts = 0;
            const doSwap = () => {
                swapAttempts++;
                const container = document.getElementById('lightboxMedia');
                const W = container ? container.clientWidth  : window.innerWidth;
                const H = container ? container.clientHeight : window.innerHeight;
                // Also read lightbox-body in case lightboxMedia reports 0
                const body = container ? container.parentElement : null;
                const BW = body ? body.clientWidth  : 0;
                const BH = body ? body.clientHeight : 0;
                const vW = video.videoWidth  || 0;
                const vH = video.videoHeight || 0;
                console.log(`[VideoRotation] doSwap attempt=${swapAttempts} container=${W}x${H} body=${BW}x${BH} video=${vW}x${vH} norm=${norm}`);
                if (W === 0 || H === 0) {
                    if (swapAttempts < 30) { requestAnimationFrame(doSwap); return; }
                    // Fall back to window dimensions after 30 frames
                    console.warn('[VideoRotation] container still 0 after 30 frames, using window dimensions');
                }
                const useW = W || window.innerWidth;
                const useH = H || window.innerHeight;
                // After 90°/270° the wrapper's pre-rotation width maps to on-screen height.
                // Give the wrapper H×W so after rotation it visually fills W×H.
                wrapper.style.width  = useH + 'px';
                wrapper.style.height = useW + 'px';
                wrapper.style.left   = Math.round((useW - useH) / 2) + 'px';
                wrapper.style.top    = Math.round((useH - useW) / 2) + 'px';
                const props = {
                    norm: String(norm), attempts: String(swapAttempts),
                    containerW: String(W), containerH: String(H),
                    bodyW: String(BW), bodyH: String(BH),
                    videoNaturalW: String(vW), videoNaturalH: String(vH),
                    wrapperW: wrapper.style.width, wrapperH: wrapper.style.height,
                    wrapperLeft: wrapper.style.left, wrapperTop: wrapper.style.top,
                    windowW: String(window.innerWidth), windowH: String(window.innerHeight)
                };
                console.log('[VideoRotation] RotationApplied', props);
                if (typeof appInsights !== 'undefined') {
                    try { appInsights.trackEvent({ name: 'Video_RotationApplied', properties: props }); } catch {}
                }
            };
            requestAnimationFrame(doSwap);
        }
        console.log(`[VideoRotation] wrapper rotated ${norm}deg`);
    }

    // Returns the current rotation stored on the video element.
    window.getVideoRotation = (videoElementId) => {
        const v = document.getElementById(videoElementId);
        return v ? (v._manualRotation || 0) : 0;
    };

    // Sets rotation from cache (C# calls this when navigating to a previously-rotated item).
    window.setVideoRotation = (videoElementId, degrees) => {
        const v = document.getElementById(videoElementId);
        if (!v) return;
        v._manualRotation = degrees || 0;
        applyVideoRotation(v, v._manualRotation);
    };

    // Manual rotate button — adds 90° CW and returns the new angle so C# can cache it.
    window.rotateVideoBy90 = (videoElementId) => {
        const video = document.getElementById(videoElementId);
        if (!video) return 0;
        const next = ((video._manualRotation || 0) + 90) % 360;
        video._manualRotation = next;
        applyVideoRotation(video, next);
        console.log(`[VideoRotation] manual rotate → ${next}deg`);
        return next;
    };

    // Image rotation — preserves rotation across pinch-zoom by storing separately.
    window.setImageRotation = (imageElementId, degrees) => {
        const img = document.getElementById(imageElementId);
        if (!img) return;
        img._rotation = degrees || 0;
        img._applyTransform && img._applyTransform();
    };

    window.rotateImageBy90 = (imageElementId) => {
        const img = document.getElementById(imageElementId);
        if (!img) return 0;
        img._rotation = (((img._rotation || 0) + 90) % 360);
        img._applyTransform && img._applyTransform();
        console.log(`[ImageRotation] manual rotate → ${img._rotation}deg`);
        return img._rotation;
    };

    // ── Custom video controls ───────────────────────────────────────────────────
    function fmtTime(s) {
        if (isNaN(s) || !isFinite(s)) return '0:00';
        const m = Math.floor(s / 60), sec = Math.floor(s % 60);
        return `${m}:${sec.toString().padStart(2,'0')}`;
    }
    window.vcTogglePlay = () => {
        const v = document.getElementById('myVideo');
        if (!v) return;
        v.paused ? v.play() : v.pause();
    };
    window.vcSeek = (val) => {
        const v = document.getElementById('myVideo');
        if (v && v.duration) v.currentTime = val / 100 * v.duration;
    };
    window.vcToggleMute = () => {
        const v = document.getElementById('myVideo');
        if (!v) return;
        v.muted = !v.muted;
        const btn = document.getElementById('vcMute');
        if (btn) btn.textContent = v.muted ? '🔇' : '🔊';
    };
    window.vcFullscreen = () => {
        const v = document.getElementById('myVideo');
        if (!v) return;
        if (v.requestFullscreen) v.requestFullscreen();
        else if (v.webkitRequestFullscreen) v.webkitRequestFullscreen();
    };
    // Attach live-update hooks to a video element (called each time a new video is loaded).
    function attachVideoControlHooks(video) {
        const playBtn = document.getElementById('vcPlayPause');
        const seekEl  = document.getElementById('vcSeek');
        const timeEl  = document.getElementById('vcTime');
        const muteBtn = document.getElementById('vcMute');
        video.addEventListener('play',  () => { if (playBtn) playBtn.textContent = '⏸'; });
        video.addEventListener('pause', () => { if (playBtn) playBtn.textContent = '▶'; });
        video.addEventListener('timeupdate', () => {
            if (seekEl && video.duration)
                seekEl.value = String(video.currentTime / video.duration * 100);
            if (timeEl)
                timeEl.textContent = `${fmtTime(video.currentTime)} / ${fmtTime(video.duration)}`;
        });
        video.addEventListener('volumechange', () => {
            if (muteBtn) muteBtn.textContent = video.muted ? '🔇' : '🔊';
        });
    }

    window.setImageSrc = async (imageElementId, imageStream) => {
        const imageCtrl = document.getElementById(imageElementId);
        if (imageCtrl) {

            if (imageStream === 'null') {
                // Revoke any previous video blob URL before clearing the element
                if (imageCtrl.tagName === 'VIDEO' && imageCtrl._blobUrl) {
                    URL.revokeObjectURL(imageCtrl._blobUrl);
                    imageCtrl._blobUrl = null;
                }
                imageCtrl._mutedRetry = false;
                imageCtrl._manualRotation = 0;
                if (imageCtrl.tagName === 'VIDEO') {
                    const wr = document.getElementById('videoWrapper');
                    const vc = document.getElementById('videoControls');
                    if (wr)  { wr.style.display='none'; wr.style.transform=''; wr.style.width='100%'; wr.style.height='100%'; wr.style.position=''; wr.style.left=''; wr.style.top=''; }
                    if (vc)  vc.style.display='none';
                }
                if (imageCtrl.tagName === 'IMG') {
                    imageCtrl._rotation = 0;
                    imageCtrl.style.transform = '';
                }
                imageCtrl.src = null;
                imageCtrl.style.display = "none";
            }
            else {
                try {
                    const arrayBuffer = await imageStream.arrayBuffer();
                    console.log(`[setImageSrc] ${imageElementId} arrayBuffer size=${arrayBuffer.byteLength} tag=${imageCtrl.tagName}`);
                    if (imageCtrl.tagName === 'VIDEO') {
                        // Reset mute state from any previous play before loading new content.
                        imageCtrl.muted = false;
                        imageCtrl._mutedRetry = false;
                        // Determine MIME type from element's data attribute set by C# before calling setImageSrc
                        const mimeType = imageCtrl.dataset.mimeType || 'video/mp4';
                        const blob = new Blob([arrayBuffer], { type: mimeType });
                        const url = URL.createObjectURL(blob);
                        console.log(`[setImageSrc] video blob size=${blob.size} type=${mimeType} url=${url}`);
                        // Revoke any previous blob URL now that we have a new one
                        if (imageCtrl._blobUrl) {
                            URL.revokeObjectURL(imageCtrl._blobUrl);
                        }
                        imageCtrl._blobUrl = url;  // keep reference; revoked when cleared or replaced
                        imageCtrl.dataset.fileName = imageElementId;  // for telemetry identification
                        imageCtrl.style.display = "block";
                        // Show wrapper and custom controls (same as setVideoUrl path)
                        const wr2 = document.getElementById('videoWrapper');
                        const vc2 = document.getElementById('videoControls');
                        if (wr2)  wr2.style.display = 'flex';
                        if (vc2)  vc2.style.display = 'flex';
                        attachVideoControlHooks(imageCtrl);
                        // Helper: fire-and-forget telemetry to App Insights
                        const trackVideoEvent = (name, extra) => {
                            const props = {
                                fileName: imageCtrl.dataset.fileName || imageElementId,
                                mimeType,
                                blobSize: String(blob.size),
                                readyState: String(imageCtrl.readyState),
                                networkState: String(imageCtrl.networkState),
                                duration: String(imageCtrl.duration),
                                currentTime: String(imageCtrl.currentTime),
                                userAgent: navigator.userAgent,
                                ...extra
                            };
                            console.log(`[VideoEvent] ${name}`, props);
                            if (typeof appInsights !== 'undefined') {
                                try { appInsights.trackEvent({ name: `Video_${name}`, properties: props }); } catch {}
                            }
                        };
                        // Wait for canplay before calling play() — avoids NotSupportedError/AbortError
                        imageCtrl.oncanplay = () => {
                            console.log(`[setImageSrc] canplay fired readyState=${imageCtrl.readyState} networkState=${imageCtrl.networkState}`);
                            imageCtrl.oncanplay = null;
                            imageCtrl.play().then(() => {
                                console.log(`[setImageSrc] play() succeeded`);
                            }).catch(e => {
                                trackVideoEvent('PlayFailed', { errorName: e.name, errorMessage: e.message });
                                console.warn(`[setImageSrc] play() failed: ${e.name}: ${e.message}`);
                            });
                        };
                        imageCtrl.oncanplaythrough = () => {
                            console.log(`[setImageSrc] canplaythrough readyState=${imageCtrl.readyState}`);
                        };
                        imageCtrl.onerror = () => {
                            const err = imageCtrl.error;
                            trackVideoEvent('Error', { errorCode: String(err?.code), errorMessage: err?.message ?? '' });
                            console.error(`[setImageSrc] video error code=${err?.code} message=${err?.message}`);
                            // errorCode 4 = MEDIA_ERR_SRC_NOT_SUPPORTED — common on Android when AAC
                            // audio codec is not supported. Retry with muted=true to let the browser
                            // skip audio decoding and still play the video track.
                            if (err?.code === 4 && !imageCtrl._mutedRetry) {
                                console.warn(`[setImageSrc] AAC not supported on this device, retrying muted`);
                                imageCtrl._mutedRetry = true;
                                imageCtrl.muted = true;
                                imageCtrl.load();
                                imageCtrl.oncanplay = () => {
                                    imageCtrl.oncanplay = null;
                                    imageCtrl.play().catch(e => console.warn(`[setImageSrc] muted retry play() failed: ${e.message}`));
                                };
                            }
                        };
                        imageCtrl.onstalled = () => {
                            trackVideoEvent('Stalled', {});
                            console.warn(`[setImageSrc] video stalled`);
                        };
                        imageCtrl.onwaiting = () => {
                            // waiting = needs more data; normal briefly but useful on mobile
                            console.log(`[setImageSrc] video waiting readyState=${imageCtrl.readyState}`);
                        };
                        imageCtrl.onemptied = () => {
                            trackVideoEvent('Emptied', {});
                            console.warn(`[setImageSrc] video emptied (src reset while playing)`);
                        };
                        imageCtrl.onended = () => {
                            console.log(`[setImageSrc] video ended`);
                        };
                        // Do NOT revoke on loadeddata — the browser needs the blob URL
                        // for the entire playback duration. Revoke only when src is cleared.
                        imageCtrl.onloadeddata = null;
                        imageCtrl.src = url;
                        imageCtrl.load();
                    } else {
                        const blob = new Blob([arrayBuffer]);
                        const url = URL.createObjectURL(blob);
                        imageCtrl.onload = () => { URL.revokeObjectURL(url); };
                        imageCtrl.src = url;
                        imageCtrl.style.display = "block";
                    }
                } catch (e) {
                    console.error(`[setImageSrc] exception: ${e}`);
                    imageCtrl.src = null;
                }
            }
        }
    };
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? '';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    }

    // Wake Lock API functions — use window._wakeLock to avoid re-declaration errors on re-render
    if (!window.requestWakeLock) {
        window._wakeLock = null;

        window.requestWakeLock = async () => {
            try {
                if ('wakeLock' in navigator) {
                    window._wakeLock = await navigator.wakeLock.request('screen');
                    console.log('Screen wake lock is active');

                    window._wakeLock.addEventListener('release', () => {
                        console.log('Screen wake lock was released');
                    });

                    return true;
                } else {
                    console.log('Wake Lock API not supported');
                    return false;
                }
            } catch (err) {
                console.error(`Failed to request wake lock: ${err.name}, ${err.message}`);
                return false;
            }
        };

        window.releaseWakeLock = async () => {
            try {
                if (window._wakeLock !== null) {
                    await window._wakeLock.release();
                    window._wakeLock = null;
                    console.log('Screen wake lock released');
                    return true;
                }
                return false;
            } catch (err) {
                console.error(`Failed to release wake lock: ${err.name}, ${err.message}`);
                return false;
            }
        };

        window.isWakeLockSupported = () => {
            return 'wakeLock' in navigator;
        };

        window.isWakeLockActive = () => {
            return window._wakeLock !== null && !window._wakeLock.released;
        };

        // Re-request wake lock when page becomes visible again (if it was previously active)
        document.addEventListener('visibilitychange', async () => {
            if (window._wakeLock !== null && document.visibilityState === 'visible') {
                try {
                    window._wakeLock = await navigator.wakeLock.request('screen');
                    console.log('Screen wake lock re-acquired after page became visible');
                } catch (err) {
                    console.error(`Failed to re-acquire wake lock: ${err.name}, ${err.message}`);
                }
            }
        });
    }

    // Pinch-zoom for lightbox image (works on desktop with wheel too)
    if (!window._lightboxZoomInit) {
        window._lightboxZoomInit = true;
        window.initLightboxZoom = () => {
            const img = document.getElementById('imageMain');
            if (!img || img._zoomInited) return;
            img._zoomInited = true;
            let scale = 1, tx = 0, ty = 0;
            let lastDist = 0, lastTx = 0, lastTy = 0;
            let pointers = [];

            function applyTransform() {
                const rot = img._rotation || 0;
                const rotStr = rot ? ` rotate(${rot}deg)` : '';
                img.style.transform = `translate(${tx}px,${ty}px) scale(${scale})${rotStr}`;
                img.style.transformOrigin = 'center center';
            }
            img._applyTransform = applyTransform;

            // Mouse wheel zoom (desktop)
            img.addEventListener('wheel', e => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 1.1 : 0.91;
                scale = Math.max(1, Math.min(10, scale * delta));
                if (scale === 1) { tx = 0; ty = 0; }
                applyTransform();
            }, { passive: false });

            // Touch events for pinch+pan
            img.addEventListener('touchstart', e => {
                pointers = [...e.touches];
                if (pointers.length === 2) {
                    lastDist = Math.hypot(
                        pointers[0].clientX - pointers[1].clientX,
                        pointers[0].clientY - pointers[1].clientY);
                }
                lastTx = tx; lastTy = ty;
            }, { passive: true });

            img.addEventListener('touchmove', e => {
                if (e.touches.length === 2) {
                    e.preventDefault();
                    const dist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY);
                    if (lastDist > 0) {
                        scale = Math.max(1, Math.min(10, scale * (dist / lastDist)));
                        lastDist = dist;
                    }
                    applyTransform();
                } else if (e.touches.length === 1 && scale > 1) {
                    e.preventDefault();
                    const dx = e.touches[0].clientX - pointers[0].clientX;
                    const dy = e.touches[0].clientY - pointers[0].clientY;
                    tx = lastTx + dx; ty = lastTy + dy;
                    applyTransform();
                }
            }, { passive: false });

            img.addEventListener('touchend', e => {
                if (e.touches.length < 2) lastDist = 0;
                if (scale <= 1) { scale = 1; tx = 0; ty = 0; applyTransform(); }
                pointers = [...e.touches];
                lastTx = tx; lastTy = ty;
            }, { passive: true });

            // Double-tap or double-click to reset zoom
            let lastTap = 0;
            img.addEventListener('click', () => {
                const now = Date.now();
                if (now - lastTap < 300) { scale = 1; tx = 0; ty = 0; applyTransform(); }
                lastTap = now;
            });
        };
    }

    // Reset zoom when a new image is set — guard so this only runs once per page load
    if (!window._origSetImageSrc) {
        window._origSetImageSrc = window.setImageSrc;
        window.setImageSrc = async (id, stream) => {
            await window._origSetImageSrc(id, stream);
            if (id === 'imageMain') {
                const img = document.getElementById('imageMain');
                if (img) { img.style.transform = ''; img._zoomInited = false; img._rotation = 0; img._applyTransform = null; }
                setTimeout(() => window.initLightboxZoom && window.initLightboxZoom(), 50);
            }
        };
    }
</script>
