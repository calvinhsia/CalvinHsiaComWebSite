@page "/logo"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@using WordScapeBlazorWasm.Games.Logo.Models
@inject LogoGameService GameService
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Logo - Turtle Graphics Programming</PageTitle>

<div class="logo-game-container">
    <!-- Header -->
    <div class="logo-header">
        <h1>
            <!-- Simple SVG Turtle Icon -->
            <svg width="40" height="40" viewBox="0 0 40 40" style="margin-right: 10px; vertical-align: middle;">
                <g fill="#2c3e50">
                    <!-- Turtle shell -->
                    <ellipse cx="20" cy="22" rx="12" ry="10" fill="#27ae60"/>
                    <!-- Turtle head -->
                    <circle cx="20" cy="12" r="6" fill="#2ecc71"/>
                    <!-- Turtle legs -->
                    <ellipse cx="12" cy="28" rx="3" ry="2" fill="#2c3e50"/>
                    <ellipse cx="28" cy="28" rx="3" ry="2" fill="#2c3e50"/>
                    <ellipse cx="14" cy="16" rx="2" ry="3" fill="#2c3e50"/>
                    <ellipse cx="26" cy="16" rx="2" ry="3" fill="#2c3e50"/>
                    <!-- Turtle tail -->
                    <ellipse cx="20" cy="32" rx="2" ry="3" fill="#2c3e50"/>
                    <!-- Shell pattern -->
                    <path d="M 15 20 Q 20 18 25 20 Q 20 24 15 20" fill="#229954"/>
                    <!-- Eyes -->
                    <circle cx="18" cy="10" r="1" fill="black"/>
                    <circle cx="22" cy="10" r="1" fill="black"/>
                </g>
            </svg>
            Logo Turtle Graphics
        </h1>
        <p class="subtitle">Program the turtle to draw amazing graphics!</p>
    </div>

    <!-- Debug Toggle -->
    <div class="logo-debug-panel">
        <label class="logo-debug-toggle">
            <input type="checkbox" @bind="_debugEnabled" @bind:after="ToggleDebug" />
            <span class="logo-debug-label">🔧 Debug Mode (@(_debugEnabled ? "ON" : "OFF"))</span>
        </label>
    </div>

    <!-- Main Content -->
    <div class="logo-main-content">
        <!-- Code Editor Section -->
        <div class="logo-editor-section">
            <!-- Code Editor -->
            <div class="logo-code-editor">
                <div class="logo-editor-header">
                    <h3>Logo Code Editor</h3>
                    <div class="logo-editor-actions">
                        <button @onclick="ClearCode">Clear</button>
                        <button @onclick="LoadExample">Example</button>
                        <button @onclick="SaveImage">Save Image</button>
                    </div>
                </div>
                <textarea class="logo-code-textarea" 
                          @bind="_currentCode" 
                          @bind:event="oninput"
                          placeholder="Enter Logo commands here...&#10;Example:&#10;repeat 4 [&#10;  fd 100&#10;  rt 90&#10;]"
                          spellcheck="false"></textarea>
            </div>

            <!-- Run Controls -->
            <div class="logo-run-section">
                <button class="logo-run-button" 
                        @onclick="RunCode" 
                        disabled="@_gameState.IsRunning">
                    @if (_gameState.IsRunning)
                    {
                        <span class="logo-loading"></span>
                        <span>Running...</span>
                    }
                    else
                    {
                        <span>▶ Run Code</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="logo-status @_statusClass">
                        @_statusMessage
                    </div>
                }
            </div>

            <!-- Examples -->
            <div class="logo-examples">
                <div class="logo-examples-header">
                    <h3>Example Programs</h3>
                </div>
                <div class="logo-examples-list">
                    @foreach (var example in LogoExamples.Programs)
                    {
                        <div class="logo-example-item" @onclick="() => LoadExampleProgram(example)">
                            <div class="logo-example-name">@example.Name</div>
                            <div class="logo-example-description">@example.Description</div>
                            <div class="logo-example-tags">
                                @foreach (var tag in example.Tags)
                                {
                                    <span class="logo-example-tag">@tag</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Help -->
            <div class="logo-help">
                <div class="logo-help-header">
                    <h3>Logo Commands Reference</h3>
                </div>
                <div class="logo-help-content">
                    <div class="logo-help-section">
                        <h4>Movement Commands</h4>
                        <div class="logo-command-list">
                            <span class="logo-command">fd 100</span>
                            <span class="logo-command-desc">Move forward 100 steps</span>
                            <span class="logo-command">bk 50</span>
                            <span class="logo-command-desc">Move backward 50 steps</span>
                            <span class="logo-command">rt 90</span>
                            <span class="logo-command-desc">Turn right 90 degrees</span>
                            <span class="logo-command">lt 45</span>
                            <span class="logo-command-desc">Turn left 45 degrees</span>
                        </div>
                    </div>
                    
                    <div class="logo-help-section">
                        <h4>Pen Commands</h4>
                        <div class="logo-command-list">
                            <span class="logo-command">pu</span>
                            <span class="logo-command-desc">Pen up (stop drawing)</span>
                            <span class="logo-command">pd</span>
                            <span class="logo-command-desc">Pen down (start drawing)</span>
                            <span class="logo-command">setpencolor "red"</span>
                            <span class="logo-command-desc">Set pen color</span>
                            <span class="logo-command">setpenwidth 5</span>
                            <span class="logo-command-desc">Set pen thickness</span>
                        </div>
                    </div>

                    <div class="logo-help-section">
                        <h4>Control Commands</h4>
                        <div class="logo-command-list">
                            <span class="logo-command">repeat 4 [fd 100 rt 90]</span>
                            <span class="logo-command-desc">Repeat commands</span>
                            <span class="logo-command">for i 1 50 [fd :i rt 91]</span>
                            <span class="logo-command-desc">For loop with variable</span>
                            <span class="logo-command">home</span>
                            <span class="logo-command-desc">Go to center</span>
                            <span class="logo-command">cs</span>
                            <span class="logo-command-desc">Clear screen</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Canvas Section -->
        <div class="logo-canvas-section">
            <div class="logo-canvas-container">
                <canvas id="logoCanvas" class="logo-canvas" width="500" height="500"></canvas>
            </div>
            
            <div class="logo-turtle-info">
                @GameService.GetCurrentPosition(_gameState)
            </div>

            <div class="logo-controls">
                <button @onclick="ClearCanvas">🗑️ Clear</button>
                <button @onclick="ShowGrid" class="@(_showGrid ? "success" : "")">
                    @(_showGrid ? "✓" : "") Grid
                </button>
                <button @onclick="GoHome">🏠 Home</button>
                <button @onclick="ToggleTurtle" class="@(_gameState.Turtle.IsVisible ? "success" : "")">
                    👀 @(_gameState.Turtle.IsVisible ? "Hide" : "Show") Turtle
                </button>
                <button @onclick="AnimateDrawing">🎬 Animate</button>
            </div>
        </div>
    </div>
</div>

@code {
    private LogoGameState _gameState = new();
    private string _currentCode = @"; Welcome to Logo!
; Draw a simple square to get started
repeat 4 [
  fd 100
  rt 90
]";
    private string _statusMessage = "";
    private string _statusClass = "";
    private bool _showGrid = false;
    private bool _isInitialized = false;
    private bool _debugEnabled = false;

    private async Task ToggleDebug()
    {
        DebugHelper.SetDebugMode(_debugEnabled);
        DebugHelper.Log($"Debug mode toggled: {(_debugEnabled ? "ON" : "OFF")}", true);
        StateHasChanged();
    }

    private async Task InitializeLogoAsync()
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss.fff");
        try
        {
            DebugHelper.Log($"{timestamp} Starting initialization...");
            
            // Set JavaScript debug mode to match C# debug mode
            await JSRuntime.InvokeVoidAsync("setLogoDebug", DebugHelper.IsDebugEnabled);
            
            // Initialize the game state
            _gameState = GameService.CreateNewGame();
            DebugHelper.Log($"{timestamp} Game state created");

            // Add a small delay to ensure DOM is fully rendered
            await Task.Delay(200);

            // Check if the canvas element exists
            var canvasExists = await JSRuntime.InvokeAsync<bool>("eval", "!!document.getElementById('logoCanvas')");
            DebugHelper.Log($"{timestamp} Canvas element exists: {canvasExists}");
            
            if (!canvasExists)
            {
                SetStatus("Canvas element not found", "error");
                return;
            }

            // Check if the JavaScript function exists
            var jsExists = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.initLogoCanvas === 'function'");
            DebugHelper.Log($"{timestamp} JavaScript function exists: {jsExists}");
            
            if (!jsExists)
            {
                SetStatus("Logo JavaScript not loaded", "error");
                DebugHelper.Log($"{timestamp} JavaScript function not found - trying to load it");
                
                // Try to check what JS functions are available
                var availableFunctions = await JSRuntime.InvokeAsync<string>("eval", @"
                    Object.keys(window).filter(key => key.includes('logo')).join(', ')
                ");
                DebugHelper.Log($"{timestamp} Available logo functions: {availableFunctions}");
                
                return;
            }

            // Initialize JavaScript canvas
            DebugHelper.Log($"{timestamp} Calling initLogoCanvas...");
            var success = await JSRuntime.InvokeAsync<bool>("initLogoCanvas", "logoCanvas");
            DebugHelper.Log($"{timestamp} initLogoCanvas returned: {success}");
            
            if (success)
            {
                _isInitialized = true;
                SetStatus("Logo initialized. Ready to draw!", "success");
                DebugHelper.Log($"{timestamp} Canvas initialized successfully - _isInitialized set to true");
                
                // Draw initial state (turtle at center)
                await UpdateCanvas();
            }
            else
            {
                SetStatus("Failed to initialize Logo canvas", "error");
                DebugHelper.Log($"{timestamp} Canvas initialization failed");
                
                // Try to get more debug info
                var debugInfo = await JSRuntime.InvokeAsync<object>("logoDebugState");
                DebugHelper.Log($"{timestamp} Debug info after failed init: {debugInfo}");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Initialization error: {ex.Message}", "error");
            DebugHelper.LogError($"{timestamp} Initialization exception: {ex.Message}");
            DebugHelper.LogError($"{timestamp} Stack trace: {ex.StackTrace}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RunCode()
    {
        if (!_isInitialized || _gameState.IsRunning)
        {
            DebugHelper.Log($"RunCode called but not ready: initialized={_isInitialized}, running={_gameState.IsRunning}");
            return;
        }

        try
        {
            SetStatus("Running Logo code...", "running");
            StateHasChanged();

            // Store the current code in game state
            _gameState.CurrentCode = _currentCode;

            // Execute the Logo code
            var success = await GameService.ExecuteCodeAsync(_gameState, _currentCode);

            if (success)
            {
                SetStatus($"Code executed successfully! Drew {_gameState.DrawingElements.Count} elements.", "success");
                await UpdateCanvas();
            }
            else
            {
                SetStatus($"Error: {_gameState.LastError}", "error");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Execution error: {ex.Message}", "error");
            DebugHelper.LogError($"RunCode exception: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ClearCanvas()
    {
        try
        {
            // Reset game state
            _gameState = GameService.CreateNewGame();
            
            // Clear JavaScript canvas
            await JSRuntime.InvokeVoidAsync("logoClearCanvas");
            
            // Redraw turtle and grid if needed
            await UpdateCanvas();
            
            SetStatus("Canvas cleared", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Clear error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private void ClearCode()
    {
        _currentCode = "";
        SetStatus("Code cleared", "success");
        StateHasChanged();
    }

    private async Task ShowGrid()
    {
        _showGrid = !_showGrid;
        
        try
        {
            if (_showGrid)
            {
                await JSRuntime.InvokeVoidAsync("logoDrawGrid", 25);
                SetStatus("Grid shown", "success");
            }
            else
            {
                await UpdateCanvas();
                SetStatus("Grid hidden", "success");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Grid error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private async Task GoHome()
    {
        try
        {
            // Reset turtle to home position
            _gameState.Turtle.X = 250;
            _gameState.Turtle.Y = 250;
            _gameState.Turtle.Heading = 0;
            
            await UpdateCanvas();
            SetStatus("Turtle returned home", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Home error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private async Task ToggleTurtle()
    {
        _gameState.Turtle.IsVisible = !_gameState.Turtle.IsVisible;
        await UpdateCanvas();
        
        var status = _gameState.Turtle.IsVisible ? "shown" : "hidden";
        SetStatus($"Turtle {status}", "success");
        StateHasChanged();
    }

    private async Task AnimateDrawing()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("logoAnimateDrawing", _gameState, 100);
            SetStatus("Animation started", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Animation error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private async Task SaveImage()
    {
        try
        {
            var filename = $"logo-drawing-{DateTime.Now:yyyyMMdd-HHmmss}.png";
            await JSRuntime.InvokeVoidAsync("logoSaveImage", filename);
            SetStatus($"Image saved as {filename}", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Save error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private void LoadExample()
    {
        var examples = LogoExamples.Programs;
        var randomExample = examples[Random.Shared.Next(examples.Count)];
        LoadExampleProgram(randomExample);
    }

    private void LoadExampleProgram(LogoProgram program)
    {
        _currentCode = program.Code;
        SetStatus($"Loaded example: {program.Name}", "success");
        StateHasChanged();
    }

    private async Task UpdateCanvas()
    {
        if (!_isInitialized) 
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("logoDrawCanvas", _gameState);
            
            if (_showGrid)
            {
                await JSRuntime.InvokeVoidAsync("logoDrawGrid", 25);
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Canvas update error: {ex.Message}", "error");
            Console.WriteLine($"[Logo] UpdateCanvas error: {ex.Message}");
        }
    }

    private void SetStatus(string message, string className)
    {
        _statusMessage = message;
        _statusClass = className;
        
        // Clear status after a few seconds for non-error messages
        if (className != "error")
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                if (_statusMessage == message) // Only clear if it hasn't changed
                {
                    _statusMessage = "";
                    _statusClass = "";
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize debug state first
            await JSRuntime.InvokeVoidAsync("eval", "window.initializeDebugToggle?.();");
            StateHasChanged(); // Force UI update
            
            await InitializeLogoAsync();
        }
    }

    public void Dispose()
    {
        // Clean up resources if needed
    }
}