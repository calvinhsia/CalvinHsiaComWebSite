@page "/logo"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Models
@using WordScapeBlazorWasm.Services
@using WordScapeBlazorWasm.Games.Logo.Models
@inject LogoGameService GameService
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Logo - Turtle Graphics Programming</PageTitle>

<div class="logo-game-container">
    <!-- Header -->
    <div class="logo-header">
        <h1>
            <!-- Simple SVG Turtle Icon -->
            <svg width="40" height="40" viewBox="0 0 40 40" style="margin-right: 10px; vertical-align: middle;">
                <g fill="#2c3e50">
                    <!-- Turtle shell -->
                    <ellipse cx="20" cy="22" rx="12" ry="10" fill="#27ae60"/>
                    <!-- Turtle head -->
                    <circle cx="20" cy="12" r="6" fill="#2ecc71"/>
                    <!-- Turtle legs -->
                    <ellipse cx="12" cy="28" rx="3" ry="2" fill="#2c3e50"/>
                    <ellipse cx="28" cy="28" rx="3" ry="2" fill="#2c3e50"/>
                    <ellipse cx="14" cy="16" rx="2" ry="3" fill="#2c3e50"/>
                    <ellipse cx="26" cy="16" rx="2" ry="3" fill="#2c3e50"/>
                    <!-- Turtle tail -->
                    <ellipse cx="20" cy="32" rx="2" ry="3" fill="#2c3e50"/>
                    <!-- Shell pattern -->
                    <path d="M 15 20 Q 20 18 25 20 Q 20 24 15 20" fill="#229954"/>
                    <!-- Eyes -->
                    <circle cx="18" cy="10" r="1" fill="black"/>
                    <circle cx="22" cy="10" r="1" fill="black"/>
                </g>
            </svg>
            Logo Turtle Graphics
        </h1>
        <p class="subtitle">Program the turtle to draw amazing graphics!</p>
    </div>

    <!-- Main Content -->
    <div class="logo-main-content">
        <!-- Code Editor Section -->
        <div class="logo-editor-section">
            <!-- Code Editor -->
            <div class="logo-code-editor">
                <div class="logo-editor-header">
                    <h3>Logo Code Editor</h3>
                    <div class="logo-editor-actions">
                        <button @onclick="ClearCode">Clear</button>
                        <button @onclick="LoadExample">Example</button>
                        <button @onclick="SaveImage">Save Image</button>
                    </div>
                </div>
                <textarea class="logo-code-textarea" 
                          @bind="_currentCode" 
                          @bind:event="oninput"
                          placeholder="Enter Logo commands here...&#10;Example:&#10;repeat 4 [&#10;  fd 100&#10;  rt 90&#10;]"
                          spellcheck="false"></textarea>
            </div>

            <!-- Run Controls -->
            <div class="logo-run-section">
                <button class="logo-run-button" 
                        @onclick="RunCode" 
                        disabled="@_gameState.IsRunning">
                    @if (_gameState.IsRunning)
                    {
                        <span class="logo-loading"></span>
                        <span>Running...</span>
                    }
                    else
                    {
                        <span>▶ Run Code</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="logo-status @_statusClass">
                        @_statusMessage
                    </div>
                }
            </div>

            <!-- Examples -->
            <div class="logo-examples">
                <div class="logo-examples-header">
                    <h3>Example Programs</h3>
                </div>
                <div class="logo-examples-list">
                    @foreach (var example in LogoExamples.Programs)
                    {
                        <div class="logo-example-item" @onclick="() => LoadExampleProgram(example)">
                            <div class="logo-example-name">@example.Name</div>
                            <div class="logo-example-description">@example.Description</div>
                            <div class="logo-example-tags">
                                @foreach (var tag in example.Tags)
                                {
                                    <span class="logo-example-tag">@tag</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Help -->
            <div class="logo-help">
                <div class="logo-help-header">
                    <h3>Logo Commands Reference</h3>
                </div>
                <div class="logo-help-content">
                    <div class="logo-help-section">
                        <h4>Movement Commands</h4>
                        <div class="logo-command-list">
                            <span class="logo-command">fd 100</span>
                            <span class="logo-command-desc">Move forward 100 steps</span>
                            <span class="logo-command">bk 50</span>
                            <span class="logo-command-desc">Move backward 50 steps</span>
                            <span class="logo-command">rt 90</span>
                            <span class="logo-command-desc">Turn right 90 degrees</span>
                            <span class="logo-command">lt 45</span>
                            <span class="logo-command-desc">Turn left 45 degrees</span>
                        </div>
                    </div>
                    
                    <div class="logo-help-section">
                        <h4>Pen Commands</h4>
                        <div class="logo-command-list">
                            <span class="logo-command">pu</span>
                            <span class="logo-command-desc">Pen up (stop drawing)</span>
                            <span class="logo-command">pd</span>
                            <span class="logo-command-desc">Pen down (start drawing)</span>
                            <span class="logo-command">setpencolor "red"</span>
                            <span class="logo-command-desc">Set pen color</span>
                            <span class="logo-command">setpenwidth 5</span>
                            <span class="logo-command-desc">Set pen thickness</span>
                        </div>
                    </div>

                    <div class="logo-help-section">
                        <h4>Control Commands</h4>
                        <div class="logo-command-list">
                            <span class="logo-command">repeat 4 [fd 100 rt 90]</span>
                            <span class="logo-command-desc">Repeat commands</span>
                            <span class="logo-command">home</span>
                            <span class="logo-command-desc">Go to center</span>
                            <span class="logo-command">cs</span>
                            <span class="logo-command-desc">Clear screen</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Canvas Section -->
        <div class="logo-canvas-section">
            <div class="logo-canvas-container">
                <canvas id="logoCanvas" class="logo-canvas" width="500" height="500"></canvas>
            </div>
            
            <div class="logo-turtle-info">
                @GameService.GetCurrentPosition(_gameState)
            </div>

            <div class="logo-controls">
                <button @onclick="ClearCanvas">🗑️ Clear</button>
                <button @onclick="ShowGrid" class="@(_showGrid ? "success" : "")">
                    @(_showGrid ? "✓" : "") Grid
                </button>
                <button @onclick="GoHome">🏠 Home</button>
                <button @onclick="ToggleTurtle" class="@(_gameState.Turtle.IsVisible ? "success" : "")">
                    👀 @(_gameState.Turtle.IsVisible ? "Hide" : "Show") Turtle
                </button>
                <button @onclick="AnimateDrawing">🎬 Animate</button>
                <button @onclick="TestDraw" style="background: #f39c12;">🎨 Test Draw</button>
                <button @onclick="DebugCanvas" style="background: #e67e22;">🔧 Debug</button>
            </div>
        </div>
    </div>
</div>

@code {
    private LogoGameState _gameState = new();
    private string _currentCode = @"; Welcome to Logo!
; Draw a simple square to get started
repeat 4 [
  fd 100
  rt 90
]";
    private string _statusMessage = "";
    private string _statusClass = "";
    private bool _showGrid = false;
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeLogoAsync();
            
            // Add automatic test to help with debugging
            if (_isInitialized)
            {
                await Task.Delay(500); // Wait a bit after initialization
                await RunSimpleTest();
            }
        }
    }

    private async Task InitializeLogoAsync()
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss.fff");
        try
        {
            Console.WriteLine($"[Logo] {timestamp} Starting initialization...");
            
            // Initialize the game state
            _gameState = GameService.CreateNewGame();
            Console.WriteLine($"[Logo] {timestamp} Game state created");

            // Add a small delay to ensure DOM is fully rendered
            await Task.Delay(200);

            // Check if the canvas element exists
            var canvasExists = await JSRuntime.InvokeAsync<bool>("eval", "!!document.getElementById('logoCanvas')");
            Console.WriteLine($"[Logo] {timestamp} Canvas element exists: {canvasExists}");
            
            if (!canvasExists)
            {
                SetStatus("Canvas element not found", "error");
                return;
            }

            // Check if the JavaScript function exists
            var jsExists = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.initLogoCanvas === 'function'");
            Console.WriteLine($"[Logo] {timestamp} JavaScript function exists: {jsExists}");
            
            if (!jsExists)
            {
                SetStatus("Logo JavaScript not loaded", "error");
                Console.WriteLine($"[Logo] {timestamp} JavaScript function not found - trying to load it");
                
                // Try to check what JS functions are available
                var availableFunctions = await JSRuntime.InvokeAsync<string>("eval", @"
                    Object.keys(window).filter(key => key.includes('logo')).join(', ')
                ");
                Console.WriteLine($"[Logo] {timestamp} Available logo functions: {availableFunctions}");
                
                return;
            }

            // Initialize JavaScript canvas
            Console.WriteLine($"[Logo] {timestamp} Calling initLogoCanvas...");
            var success = await JSRuntime.InvokeAsync<bool>("initLogoCanvas", "logoCanvas");
            Console.WriteLine($"[Logo] {timestamp} initLogoCanvas returned: {success}");
            
            if (success)
            {
                _isInitialized = true;
                SetStatus("Logo initialized. Ready to draw!", "success");
                Console.WriteLine($"[Logo] {timestamp} Canvas initialized successfully - _isInitialized set to true");
                
                // Draw initial state (turtle at center)
                await UpdateCanvas();
            }
            else
            {
                SetStatus("Failed to initialize Logo canvas", "error");
                Console.WriteLine($"[Logo] {timestamp} Canvas initialization failed");
                
                // Try to get more debug info
                var debugInfo = await JSRuntime.InvokeAsync<object>("logoDebugState");
                Console.WriteLine($"[Logo] {timestamp} Debug info after failed init: {debugInfo}");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Initialization error: {ex.Message}", "error");
            Console.WriteLine($"[Logo] {timestamp} Initialization exception: {ex.Message}");
            Console.WriteLine($"[Logo] {timestamp} Stack trace: {ex.StackTrace}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RunCode()
    {
        if (!_isInitialized || _gameState.IsRunning)
        {
            Console.WriteLine($"[Logo] RunCode called but not ready: initialized={_isInitialized}, running={_gameState.IsRunning}");
            return;
        }

        try
        {
            SetStatus("Running Logo code...", "running");
            StateHasChanged();

            // Store the current code in game state
            _gameState.CurrentCode = _currentCode;

            // Execute the Logo code
            var success = await GameService.ExecuteCodeAsync(_gameState, _currentCode);

            if (success)
            {
                SetStatus($"Code executed successfully! Drew {_gameState.DrawingElements.Count} elements.", "success");
                await UpdateCanvas();
            }
            else
            {
                SetStatus($"Error: {_gameState.LastError}", "error");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Execution error: {ex.Message}", "error");
            Console.WriteLine($"[Logo] RunCode exception: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ClearCanvas()
    {
        try
        {
            // Reset game state
            _gameState = GameService.CreateNewGame();
            
            // Clear JavaScript canvas
            await JSRuntime.InvokeVoidAsync("logoClearCanvas");
            
            // Redraw turtle and grid if needed
            await UpdateCanvas();
            
            SetStatus("Canvas cleared", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Clear error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private void ClearCode()
    {
        _currentCode = "";
        SetStatus("Code cleared", "success");
        StateHasChanged();
    }

    private async Task ShowGrid()
    {
        _showGrid = !_showGrid;
        
        try
        {
            if (_showGrid)
            {
                await JSRuntime.InvokeVoidAsync("logoDrawGrid", 25);
                SetStatus("Grid shown", "success");
            }
            else
            {
                await UpdateCanvas();
                SetStatus("Grid hidden", "success");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Grid error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private async Task GoHome()
    {
        try
        {
            // Reset turtle to home position
            _gameState.Turtle.X = 250;
            _gameState.Turtle.Y = 250;
            _gameState.Turtle.Heading = 0;
            
            await UpdateCanvas();
            SetStatus("Turtle returned home", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Home error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private async Task ToggleTurtle()
    {
        _gameState.Turtle.IsVisible = !_gameState.Turtle.IsVisible;
        await UpdateCanvas();
        
        var status = _gameState.Turtle.IsVisible ? "shown" : "hidden";
        SetStatus($"Turtle {status}", "success");
        StateHasChanged();
    }

    private async Task AnimateDrawing()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("logoAnimateDrawing", _gameState, 100);
            SetStatus("Animation started", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Animation error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private async Task SaveImage()
    {
        try
        {
            var filename = $"logo-drawing-{DateTime.Now:yyyyMMdd-HHmmss}.png";
            await JSRuntime.InvokeVoidAsync("logoSaveImage", filename);
            SetStatus($"Image saved as {filename}", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Save error: {ex.Message}", "error");
        }
        StateHasChanged();
    }

    private void LoadExample()
    {
        var examples = LogoExamples.Programs;
        var randomExample = examples[Random.Shared.Next(examples.Count)];
        LoadExampleProgram(randomExample);
    }

    private void LoadExampleProgram(LogoProgram program)
    {
        _currentCode = program.Code;
        SetStatus($"Loaded example: {program.Name}", "success");
        StateHasChanged();
    }

    private async Task UpdateCanvas()
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss.fff");
        Console.WriteLine($"[Logo] {timestamp} UpdateCanvas called, _isInitialized: {_isInitialized}");
        
        if (!_isInitialized) 
        {
            Console.WriteLine($"[Logo] {timestamp} UpdateCanvas skipped - not initialized");
            return;
        }

        try
        {
            Console.WriteLine($"[Logo] {timestamp} UpdateCanvas: calling logoDrawCanvas with {_gameState.DrawingElements.Count} elements");
            Console.WriteLine($"[Logo] {timestamp} GameState details: Turtle at ({_gameState.Turtle.X:F1}, {_gameState.Turtle.Y:F1})");
            
            await JSRuntime.InvokeVoidAsync("logoDrawCanvas", _gameState);
            Console.WriteLine($"[Logo] {timestamp} logoDrawCanvas call completed");
            
            if (_showGrid)
            {
                Console.WriteLine($"[Logo] {timestamp} Drawing grid");
                await JSRuntime.InvokeVoidAsync("logoDrawGrid", 25);
            }
            
            Console.WriteLine($"[Logo] {timestamp} UpdateCanvas completed successfully");
        }
        catch (Exception ex)
        {
            SetStatus($"Canvas update error: {ex.Message}", "error");
            Console.WriteLine($"[Logo] {timestamp} UpdateCanvas exception: {ex.Message}");
            Console.WriteLine($"[Logo] {timestamp} UpdateCanvas stack trace: {ex.StackTrace}");
        }
    }

    private void SetStatus(string message, string className)
    {
        _statusMessage = message;
        _statusClass = className;
        
        // Clear status after a few seconds for non-error messages
        if (className != "error")
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                if (_statusMessage == message) // Only clear if it hasn't changed
                {
                    _statusMessage = "";
                    _statusClass = "";
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
    }

    private async Task TestDraw()
    {
        try
        {
            Console.WriteLine("[Logo] Starting test draw...");
            
            // Try a direct canvas draw without using Logo functions
            await JSRuntime.InvokeVoidAsync("eval", @"
                const canvas = document.getElementById('logoCanvas');
                if (canvas) {
                    console.log('[Logo] Canvas found for test draw');
                    const ctx = canvas.getContext('2d');
                    if (ctx) {
                        console.log('[Logo] Context acquired for test draw');
                        
                        // Clear canvas
                        ctx.fillStyle = 'white';
                        ctx.fillRect(0, 0, canvas.width, canvas.height);
                        
                        // Draw test shapes
                        ctx.fillStyle = 'red';
                        ctx.fillRect(50, 50, 100, 100);
                        
                        ctx.strokeStyle = 'blue';
                        ctx.lineWidth = 3;
                        ctx.beginPath();
                        ctx.moveTo(200, 200);
                        ctx.lineTo(300, 300);
                        ctx.stroke();
                        
                        ctx.fillStyle = 'green';
                        ctx.beginPath();  
                        ctx.arc(400, 100, 30, 0, 2 * Math.PI);
                        ctx.fill();
                        
                        console.log('[Logo] Test shapes drawn successfully');
                    } else {
                        console.log('[Logo] Could not get canvas context');
                    }
                } else {
                    console.log('[Logo] Canvas element not found for test draw');
                }
            ");
            
            SetStatus("Test draw completed", "success");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Logo] Test draw error: {ex.Message}");
            SetStatus($"Test draw error: {ex.Message}", "error");
        }
    }

    private async Task DebugCanvas()
    {
        try
        {
            Console.WriteLine("[Logo] Starting debug...");
            
            // Check C# state
            Console.WriteLine($"[Logo] C# _isInitialized: {_isInitialized}");
            Console.WriteLine($"[Logo] Drawing elements count: {_gameState.DrawingElements.Count}");
            Console.WriteLine($"[Logo] Turtle position: ({_gameState.Turtle.X}, {_gameState.Turtle.Y})");
            
            // Check JavaScript state
            var jsState = await JSRuntime.InvokeAsync<object>("logoDebugState");
            Console.WriteLine($"[Logo] JavaScript state returned: {jsState}");
            
            // Try to get canvas element info
            var canvasExists = await JSRuntime.InvokeAsync<bool>("eval", "!!document.getElementById('logoCanvas')");
            Console.WriteLine($"[Logo] Canvas element exists: {canvasExists}");
            
            // Check canvas dimensions
            if (canvasExists)
            {
                var canvasInfo = await JSRuntime.InvokeAsync<object>("eval", @"
                    const canvas = document.getElementById('logoCanvas');
                    return {
                        width: canvas.width,
                        height: canvas.height,
                        offsetWidth: canvas.offsetWidth,
                        offsetHeight: canvas.offsetHeight,
                        hasContext: !!canvas.getContext('2d')
                    };
                ");
                Console.WriteLine($"[Logo] Canvas info: {canvasInfo}");
            }
            
            // Test a simple draw
            await TestDraw();
            
            SetStatus("Debug info logged to console", "success");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Logo] Debug error: {ex.Message}");
            SetStatus($"Debug error: {ex.Message}", "error");
        }
    }

    private async Task RunSimpleTest()
    {
        try
        {
            Console.WriteLine("[Logo] === STARTING AUTOMATIC SIMPLE TEST ===");
            
            // Test with a very simple command first
            var testCode = "fd 100";
            Console.WriteLine($"[Logo] Testing simple command: '{testCode}'");
            
            // Reset to fresh state
            _gameState = GameService.CreateNewGame();
            Console.WriteLine($"[Logo] Fresh game state - turtle at ({_gameState.Turtle.X}, {_gameState.Turtle.Y})");
            
            var testSuccess = await GameService.ExecuteCodeAsync(_gameState, testCode);
            Console.WriteLine($"[Logo] Simple test result: success={testSuccess}, elements={_gameState.DrawingElements.Count}");
            
            if (testSuccess && _gameState.DrawingElements.Count > 0)
            {
                Console.WriteLine("[Logo] ✅ Simple test PASSED - Logo parsing works!");
                await UpdateCanvas();
                SetStatus($"Simple test passed! Drew {_gameState.DrawingElements.Count} elements.", "success");
                
                // Wait and test the default repeat code
                await Task.Delay(2000);
                Console.WriteLine("[Logo] Now testing default repeat code...");
                
                // Reset and try the default code
                _gameState = GameService.CreateNewGame();
                var defaultSuccess = await GameService.ExecuteCodeAsync(_gameState, _currentCode);
                Console.WriteLine($"[Logo] Default code test result: success={defaultSuccess}, elements={_gameState.DrawingElements.Count}");
                
                if (defaultSuccess && _gameState.DrawingElements.Count > 0)
                {
                    Console.WriteLine("[Logo] ✅ Default test PASSED!");
                    await UpdateCanvas();
                    SetStatus($"All tests passed! Drew {_gameState.DrawingElements.Count} elements.", "success");
                }
                else
                {
                    Console.WriteLine("[Logo] ❌ Default test FAILED - issue with repeat parsing");
                    SetStatus("Simple command works but repeat doesn't", "error");
                }
            }
            else
            {
                Console.WriteLine("[Logo] ❌ Simple test FAILED - basic Logo parsing broken");
                SetStatus("Logo parsing is broken", "error");
                
                // Try manual debugging
                Console.WriteLine("[Logo] === MANUAL PARSING DEBUG ===");
                var commands = await JSRuntime.InvokeAsync<object>("eval", @"
                    // Test Logo parsing manually
                    try {
                        const gameService = DotNet.createJSObjectReference(arguments[0]);
                        console.log('[Logo] Manual test - service exists:', !!gameService);
                        return { success: true, message: 'JSInterop working' };
                    } catch (e) {
                        console.error('[Logo] Manual test error:', e);
                        return { success: false, error: e.message };
                    }
                ");
                Console.WriteLine($"[Logo] Manual debug result: {commands}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Logo] Auto-test error: {ex.Message}");
            Console.WriteLine($"[Logo] Stack trace: {ex.StackTrace}");
            SetStatus($"Test error: {ex.Message}", "error");
        }
    }

    public void Dispose()
    {
        // Clean up resources if needed
    }
}