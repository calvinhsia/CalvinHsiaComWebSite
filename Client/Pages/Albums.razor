		display: flex;
		flex-direction: column;
		gap: 5px;
		margin-bottom: 10px;
	}

	.info-item {
		font-size: 13px;
		color: #6c757d;
	}

	.album-description {
		font-size: 14px;
		color: #495057;
		background: #f8f9fa;
		padding: 8px 12px;
		border-radius: 4px;
		border-left: 3px solid #007bff;
		max-height: 60px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
