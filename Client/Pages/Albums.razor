@page "/Albums"
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject IAccessTokenProvider TokenProvider

<PageTitle>My Albums</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="album-manager">
            <div class="header-section">
                <h1>My Photo Albums</h1>
                <div class="header-actions">
                    <button @onclick="RefreshAlbumsAsync" disabled="@isLoading" class="refresh-btn">
                        @if (isLoading)
                        {
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>Refresh</span>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-info">
                    @statusMessage
                </div>
            }

            @if (isLoading && loadingProgress != null)
            {
                <div class="progress-compact">
                    <div class="progress-info">
                        <span><strong>Loading Albums:</strong> @(loadingProgress.TotalItems > 0 ? Math.Round((double)loadingProgress.CompletedItems / loadingProgress.TotalItems * 100, 1) : 0)% | Processing: @loadingProgress.CompletedItems/@loadingProgress.TotalItems</span>
                        <span class="current-step">@loadingProgress.CurrentStep</span>
                    </div>
                    <div class="progress-bar-mini">
                        <div class="progress-fill" style="width: @(loadingProgress.TotalItems > 0 ? Math.Round((double)loadingProgress.CompletedItems / loadingProgress.TotalItems * 100, 1) : 0)%"></div>
                    </div>
                </div>
            }

            @if (albums.Any())
            {
                <div class="albums-header-info">
                    <span class="cache-info">
                        @if (lastFetched.HasValue)
                        {
                            <small class="text-muted">Last updated: @lastFetched.Value.ToString("MMM dd, yyyy h:mm tt")</small>
                        }
                        <small class="text-muted">(@albums.Count albums)</small>
                    </span>
                </div>

                <div class="albums-grid">
                    @foreach (var album in albums.OrderByDescending(a => a.CreatedDateTime ?? DateTime.MinValue))
                    {
                        <div class="album-card">
                            <div class="album-header">
                                <h3 class="album-name" title="@album.Name">@album.Name</h3>
                                <div class="album-actions">
                                    <button @onclick="() => OpenAlbumInNewWindow(album)"
                                            class="view-btn"
                                            title="Open album in new window">
                                        View
                                    </button>
                                    <button @onclick="() => CopyShareLinkAsync(album)"
                                            class="copy-btn"
                                            title="Copy share link">
                                        Copy Link
                                    </button>
                                </div>
                            </div>

                            <div class="album-details">
                                <div class="album-info">
                                    <span class="info-item">
                                        <strong>Items:</strong> @album.ChildCount
                                    </span>
                                    <span class="info-item">
                                        <strong>Created:</strong> @album.CreatedDateTime?.ToString("MMM dd, yyyy")
                                    </span>
                                    <span class="info-item">
                                        <strong>Modified:</strong> @album.LastModifiedDateTime?.ToString("MMM dd, yyyy")
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(album.Description))
                                {
                                    <div class="album-description" title="@album.Description">
                                        @album.Description
                                    </div>
                                }
                            </div>

                            <div class="album-thumbnail">
                                @if (!string.IsNullOrEmpty(album.ThumbnailUrl))
                                {
                                    <img src="@album.ThumbnailUrl" alt="Album thumbnail" class="thumbnail-image" />
                                }
                                else
                                {
                                    <div class="placeholder-thumbnail">Photo</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!isLoading)
            {
                <div class="empty-state">
                    <div class="empty-icon">No Albums</div>
                    <h3>No Albums Found</h3>
                    <p>You haven't created any photo albums yet.</p>
                    <p>Use the <a href="/PictureQuery" class="link">Picture Query</a> page to create albums from your photos.</p>
                </div>
            }

            @if (isLoading && loadingProgress == null)
            {
                <div class="loading-spinner">
                    <div class="spinner"></div>
                    <p>Initializing...</p>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to view your photo albums.</p>
            <a href="authentication/login" class="btn btn-primary">
                <span class="oi oi-account-login"></span> Sign In
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

