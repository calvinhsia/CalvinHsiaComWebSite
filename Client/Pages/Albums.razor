			align-items: stretch;
		}

		.album-header {
			flex-direction: column;
			gap: 15px;
		}

		.album-actions {
			justify-content: flex-start;
		}

		.albums-header-info {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
		}

		.cache-info {
