@code {
    // Static fields to preserve data across navigation
    private static List<AlbumInfo> _cachedAlbums = new();
    private static DateTime? _lastFetched = null;
    private static readonly object _cacheLock = new object();

    // Instance fields
    private List<AlbumInfo> albums = new();
    private DateTime? lastFetched = null;
    private bool isLoading = false;
    private string statusMessage = string.Empty;
    private HttpClient? _httpClient;
    private const string MSGraphEndPoint = @"https://graph.microsoft.com/v1.0/";

    // Progress tracking
    private LoadingProgress? loadingProgress = null;

    // Cache expiry time - albums will be considered fresh for 5 minutes
    private static readonly TimeSpan CacheExpiry = TimeSpan.FromMinutes(5);

    private class LoadingProgress
    {
        public int TotalItems { get; set; }
        public int CompletedItems { get; set; }
        public string CurrentStep { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("GraphAPI");

        // Load from cache if available and not expired
        lock (_cacheLock)
        {
            if (_cachedAlbums.Any() && _lastFetched.HasValue && 
                DateTime.Now - _lastFetched.Value < CacheExpiry)
            {
                albums = new List<AlbumInfo>(_cachedAlbums);
                lastFetched = _lastFetched;
                statusMessage = "Loaded from cache";
                return;
            }
        }

        // Cache is empty or expired, fetch fresh data
        await LoadAlbumsAsync();
    }

    private async Task RefreshAlbumsAsync()
    {
        // Force refresh - clear cache and fetch new data
        lock (_cacheLock)
        {
            _cachedAlbums.Clear();
            _lastFetched = null;
        }
        
        await LoadAlbumsAsync();
    }

    private async Task LoadAlbumsAsync()
    {
        if (isLoading) return;

        isLoading = true;
        statusMessage = string.Empty;
        loadingProgress = new LoadingProgress
        {
            TotalItems = 0,
            CompletedItems = 0,
            CurrentStep = "Initializing..."
        };
        StateHasChanged();

        try
        {
            var tokenResult = await TokenProvider.RequestAccessToken();
            if (!tokenResult.TryGetToken(out var token))
            {
                statusMessage = "Unable to get authentication token.";
                return;
            }

            using var httpClient = new HttpClient();
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token.Value);

            loadingProgress.CurrentStep = "Fetching album list...";
            StateHasChanged();

            // Get all bundles (albums) from OneDrive
            var response = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/bundles");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var bundlesResponse = JsonConvert.DeserializeObject<dynamic>(json);

                var newAlbums = new List<AlbumInfo>();
                var albumBundles = new List<dynamic>();

                if (bundlesResponse?.value != null)
                {
                    // First pass: collect album bundles
                    foreach (var bundle in bundlesResponse.value)
                    {
                        if (bundle?.bundle?.album != null)
                        {
                            albumBundles.Add(bundle);
                        }
                    }
                }

                // Update progress with total count
                loadingProgress.TotalItems = albumBundles.Count;
                loadingProgress.CurrentStep = $"Processing {albumBundles.Count} albums...";
                StateHasChanged();

                // Second pass: process each album with progress updates
                foreach (var bundle in albumBundles)
                {
                    var albumInfo = new AlbumInfo
                    {
                        Id = bundle.id?.ToString() ?? string.Empty,
                        Name = bundle.name?.ToString() ?? "Unnamed Album",
                        Description = bundle.description?.ToString(),
                        CreatedDateTime = DateTime.TryParse(bundle.createdDateTime?.ToString(), out DateTime created) ? created : null,
                        LastModifiedDateTime = DateTime.TryParse(bundle.lastModifiedDateTime?.ToString(), out DateTime modified) ? modified : null,
                        ChildCount = bundle.folder?.childCount ?? 0
                    };

                    loadingProgress.CurrentStep = $"Getting thumbnail for '{albumInfo.Name}'...";
                    StateHasChanged();

                    // Try to get thumbnail by getting the first child item
                    albumInfo.ThumbnailUrl = await GetAlbumThumbnailAsync(httpClient, albumInfo.Id);

                    loadingProgress.CurrentStep = $"Getting share link for '{albumInfo.Name}'...";
                    StateHasChanged();

                    // Get or create share link
                    albumInfo.ShareUrl = await GetOrCreateShareLinkAsync(httpClient, albumInfo.Id);

                    newAlbums.Add(albumInfo);
                    
                    // Update progress
                    loadingProgress.CompletedItems++;
                    loadingProgress.CurrentStep = $"Completed '{albumInfo.Name}' ({loadingProgress.CompletedItems}/{loadingProgress.TotalItems})";
                    StateHasChanged();

                    // Small delay to allow UI updates
                    await Task.Delay(50);
                }

                // Update both instance and static cache
                albums = newAlbums;
                var fetchTime = DateTime.Now;
                lastFetched = fetchTime;

                lock (_cacheLock)
                {
                    _cachedAlbums = new List<AlbumInfo>(newAlbums);
                    _lastFetched = fetchTime;
                }

                if (!albums.Any())
                {
                    statusMessage = "No photo albums found. Create albums using the Picture Query page.";
                }
                else
                {
                    var thumbCount = albums.Count(a => !string.IsNullOrEmpty(a.ThumbnailUrl));
                    statusMessage = $"Loaded {albums.Count} albums successfully ({thumbCount} with thumbnails)";
                    
                    // Clear success message after 3 seconds
                    _ = Task.Delay(3000).ContinueWith((Task _) =>
                    {
                        InvokeAsync(() =>
                        {
                            if (statusMessage.Contains("Loaded") && statusMessage.Contains("successfully"))
                            {
                                statusMessage = string.Empty;
                                StateHasChanged();
                            }
                        });
                    });
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                statusMessage = $"Error loading albums: {response.StatusCode} - {errorContent}";
            }
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading albums: {ex.Message}";
            Console.WriteLine($"Error in LoadAlbumsAsync: {ex}");
        }
        finally
        {
            isLoading = false;
            loadingProgress = null;
            StateHasChanged();
        }
    }

    private async Task<string?> GetAlbumThumbnailAsync(HttpClient httpClient, string albumId)
    {
        try
        {
            // First attempt: Try to get children without filter (the filter might be causing the 400 error)
            var childrenResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{albumId}/children?$top=10");
            
            if (childrenResponse.IsSuccessStatusCode)
            {
                var childrenJson = await childrenResponse.Content.ReadAsStringAsync();
                var childrenData = JsonConvert.DeserializeObject<dynamic>(childrenJson);

                if (childrenData?.value != null && childrenData.value.Count > 0)
                {
                    // Look for image files in the children
                    foreach (var child in childrenData.value)
                    {
                        var fileName = child.name?.ToString() ?? "";
                        var mimeType = child.file?.mimeType?.ToString() ?? "";
                        
                        // Check if this is an image file
                        if (IsImageFile(fileName, mimeType))
                        {
                            var imageId = child.id?.ToString();
                            if (!string.IsNullOrEmpty(imageId))
                            {
                                // Try to get thumbnail for this image
                                var thumbnailUrl = await GetImageThumbnailAsync(httpClient, imageId);
                                if (!string.IsNullOrEmpty(thumbnailUrl))
                                {
                                    Console.WriteLine($"Found thumbnail for album {albumId}: {thumbnailUrl}");
                                    return thumbnailUrl;
                                }
                            }
                        }
                    }
                }
            }
            else
            {
                // Log the error for debugging
                var errorContent = await childrenResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"Error getting album children for {albumId}: {childrenResponse.StatusCode} - {errorContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting thumbnail for album {albumId}: {ex.Message}");
        }

        return null;
    }

    private bool IsImageFile(string fileName, string mimeType)
    {
        // Check by MIME type first
        if (!string.IsNullOrEmpty(mimeType) && 
            (mimeType.StartsWith("image/") || 
             mimeType == "image/jpeg" || 
             mimeType == "image/jpg" || 
             mimeType == "image/png" || 
             mimeType == "image/gif" || 
             mimeType == "image/bmp" || 
             mimeType == "image/webp"))
        {
            return true;
        }

        // Fallback to file extension check
        if (!string.IsNullOrEmpty(fileName))
        {
            var extension = System.IO.Path.GetExtension(fileName).ToLowerInvariant();
            return extension is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp";
        }

        return false;
    }

    private async Task<string?> GetImageThumbnailAsync(HttpClient httpClient, string imageId)
    {
        try
        {
            // Get thumbnail for this specific image
            var thumbnailResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{imageId}/thumbnails");
            if (thumbnailResponse.IsSuccessStatusCode)
            {
                var thumbnailJson = await thumbnailResponse.Content.ReadAsStringAsync();
                var thumbnailData = JsonConvert.DeserializeObject<dynamic>(thumbnailJson);

                if (thumbnailData?.value != null && thumbnailData.value.Count > 0)
                {
                    var firstThumbnail = thumbnailData.value[0];
                    // Try medium first, then small as fallback
                    return firstThumbnail?.medium?.url?.ToString() ?? 
                           firstThumbnail?.small?.url?.ToString() ?? 
                           firstThumbnail?.large?.url?.ToString();
                }
            }
            else
            {
                var errorContent = await thumbnailResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"Error getting thumbnail for image {imageId}: {thumbnailResponse.StatusCode} - {errorContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception getting thumbnail for image {imageId}: {ex.Message}");
        }

        return null;
    }

    private async Task<string> GetOrCreateShareLinkAsync(HttpClient httpClient, string bundleId)
    {
        try
        {
            // First try to get existing sharing links
            var existingLinksResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{bundleId}/permissions");

            if (existingLinksResponse.IsSuccessStatusCode)
            {
                var existingLinksJson = await existingLinksResponse.Content.ReadAsStringAsync();
                var linksData = JsonConvert.DeserializeObject<dynamic>(existingLinksJson);

                if (linksData?.value != null)
                {
                    foreach (var permission in linksData.value)
                    {
                        if (permission?.link?.webUrl != null)
                        {
                            return permission.link.webUrl.ToString();
                        }
                    }
                }
            }

            // No existing link found, create a new one
            var linkRequest = new
            {
                type = "view",
                scope = "anonymous"
            };

            var json = JsonConvert.SerializeObject(linkRequest);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await httpClient.PostAsync($"{MSGraphEndPoint}me/drive/items/{bundleId}/createLink", content);

            if (response.IsSuccessStatusCode)
            {
                var responseJson = await response.Content.ReadAsStringAsync();
                var linkResponse = JsonConvert.DeserializeObject<dynamic>(responseJson);

                return linkResponse?.link?.webUrl?.ToString() ?? $"https://onedrive.live.com/?id={bundleId}";
            }
            else
            {
                Console.WriteLine($"Could not create share link for bundle {bundleId}: {response.StatusCode}");
                return $"https://onedrive.live.com/?id={bundleId}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting/creating share link for bundle {bundleId}: {ex.Message}");
            return $"https://onedrive.live.com/?id={bundleId}";
        }
    }

    private async Task OpenAlbumInNewWindow(AlbumInfo album)
    {
        if (!string.IsNullOrEmpty(album.ShareUrl))
        {
            await JS.InvokeVoidAsync("open", album.ShareUrl, "_blank");
        }
    }

    private async Task CopyShareLinkAsync(AlbumInfo album)
    {
        if (!string.IsNullOrEmpty(album.ShareUrl))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", album.ShareUrl);
                statusMessage = $"Share link copied to clipboard for album '{album.Name}'";
                StateHasChanged();

                // Clear the message after 3 seconds using explicit Task parameter
                _ = Task.Delay(3000).ContinueWith((Task _) =>
                {
                    InvokeAsync(() =>
                    {
                        if (statusMessage.Contains("copied to clipboard"))
                        {
                            statusMessage = string.Empty;
                            StateHasChanged();
                        }
                    });
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error copying to clipboard: {ex.Message}");
                statusMessage = $"Could not copy link to clipboard. Link: {album.ShareUrl}";
                StateHasChanged();
            }
        }
    }

    public class AlbumInfo
