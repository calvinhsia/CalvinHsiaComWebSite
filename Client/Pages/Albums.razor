</style>

@code {
	// Static fields to preserve data across navigation
	private static List<AlbumInfo> _cachedAlbums = new();
	private static DateTime? _lastFetched = null;
	private static readonly object _cacheLock = new object();

	// Instance fields
	private List<AlbumInfo> albums = new();
	private DateTime? lastFetched = null;
	private bool isLoading = false;
	private string statusMessage = string.Empty;
	private HttpClient? _httpClient;
	private const string MSGraphEndPoint = @"https://graph.microsoft.com/v1.0/";

	// Progressive loading fields
	private string currentStep = string.Empty;
	private int totalAlbumsToProcess = 0;

	// Cache expiry time - albums will be considered fresh for 5 minutes
	private static readonly TimeSpan CacheExpiry = TimeSpan.FromMinutes(5);

	protected override async Task OnInitializedAsync()
	{
		_httpClient = HttpClientFactory.CreateClient("GraphAPI");

		// Load from cache if available and not expired
		lock (_cacheLock)
		{
			if (_cachedAlbums.Any() && _lastFetched.HasValue &&
				DateTime.Now - _lastFetched.Value < CacheExpiry)
			{
				albums = new List<AlbumInfo>(_cachedAlbums);
				lastFetched = _lastFetched;
				statusMessage = "Loaded from cache";
				return;
			}
		}

		// Cache is empty or expired, fetch fresh data
		await LoadAlbumsAsync();
	}

	private async Task RefreshAlbumsAsync()
	{
		// Force refresh - clear cache and fetch new data
		lock (_cacheLock)
		{
			_cachedAlbums.Clear();
			_lastFetched = null;
		}

		await LoadAlbumsAsync();
	}

	private async Task LoadAlbumsAsync()
	{
		if (isLoading) return;

		isLoading = true;
		statusMessage = string.Empty;
		albums.Clear();
		currentStep = "Initializing...";
		totalAlbumsToProcess = 0;
		StateHasChanged();

		try
		{
			// Use shared AuthTokenHelper for centralized token expiration handling
			var token = await AuthToken.GetAccessTokenAsync(showExpiredMessage: false);
			if (string.IsNullOrEmpty(token))
			{
				statusMessage = "Session expired. Redirecting to sign in...";
				StateHasChanged();
				// AuthTokenHelper already handles the redirect
				return;
			}

			using var httpClient = new HttpClient();
			httpClient.DefaultRequestHeaders.Authorization =
			new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

			currentStep = "Fetching album list...";
			StateHasChanged();

			// Get all bundles (albums) from OneDrive
			var response = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/bundles");

			if (response.IsSuccessStatusCode)
			{
				var json = await response.Content.ReadAsStringAsync();
				var bundlesResponse = JsonConvert.DeserializeObject<dynamic>(json);

				var albumBundles = new List<dynamic>();

				if (bundlesResponse?.value != null)
				{
					// First pass: collect album bundles
					foreach (var bundle in bundlesResponse.value)
					{
						if (bundle?.bundle?.album != null)
						{
							albumBundles.Add(bundle);
						}
					}
				}

				totalAlbumsToProcess = albumBundles.Count;
				currentStep = $"Found {totalAlbumsToProcess} albums. Processing...";
				StateHasChanged();

				// Process each album and add to UI progressively
				// Process each album and add to UI progressively
				foreach (var bundle in albumBundles)
				{
					// Extract the coverImageItemId if available
					var coverImageItemId = bundle.bundle?.album?.coverImageItemId?.ToString();

					var albumInfo = new AlbumInfo
					{
						Id = bundle.id?.ToString() ?? string.Empty,
						Name = bundle.name?.ToString() ?? "Unnamed Album",
						Description = bundle.description?.ToString(),
						CreatedDateTime = DateTime.TryParse(bundle.createdDateTime?.ToString(), out DateTime created) ? created : null,
						LastModifiedDateTime = DateTime.TryParse(bundle.lastModifiedDateTime?.ToString(), out DateTime modified) ? modified : null,
						ChildCount = bundle.folder?.childCount ?? 0,
						IsNew = true,
						IsLoadingThumbnail = true
					};

					// Add album to UI immediately
					albums.Add(albumInfo);
					currentStep = $"Loading '{albumInfo.Name}'...";
					StateHasChanged();

					// Load thumbnail in background, passing the coverImageItemId
					_ = Task.Run(async () =>
					{
						albumInfo.ThumbnailUrl = await GetAlbumThumbnailAsync(httpClient, albumInfo.Id, coverImageItemId);
						albumInfo.IsLoadingThumbnail = false;
						albumInfo.IsNew = false;
						await InvokeAsync(StateHasChanged);
					});

					// Small delay to allow UI to update smoothly
					await Task.Delay(100);
				}

				// Update cache with all loaded albums
				var fetchTime = DateTime.Now;
				lastFetched = fetchTime;

				// Create cache copy without loading states
				var cacheAlbums = albums.Select(a => new AlbumInfo
				{
					Id = a.Id,
					Name = a.Name,
					Description = a.Description,
					CreatedDateTime = a.CreatedDateTime,
					LastModifiedDateTime = a.LastModifiedDateTime,
					ChildCount = a.ChildCount,
					ThumbnailUrl = a.ThumbnailUrl,
					ShareUrl = a.ShareUrl
				}).ToList();

				lock (_cacheLock)
				{
					_cachedAlbums = cacheAlbums;
					_lastFetched = fetchTime;
				}

				if (!albums.Any())
				{
					statusMessage = "No photo albums found. Create albums using the Picture Query page.";
				}
				else
				{
					statusMessage = $"Loaded {albums.Count} albums successfully";

					// Clear success message after 3 seconds
					_ = Task.Delay(3000).ContinueWith((Task _) =>
					{
						InvokeAsync(() =>
						{
							if (statusMessage.Contains("Loaded") && statusMessage.Contains("successfully"))
							{
								statusMessage = string.Empty;
								StateHasChanged();
							}
						});
					});
				}
			}
			else
			{
				var errorContent = await response.Content.ReadAsStringAsync();
				statusMessage = $"Error loading albums: {response.StatusCode} - {errorContent}";
			}
		}
		catch (Exception ex)
		{
			statusMessage = $"Error loading albums: {ex.Message}";
			Console.WriteLine($"Error in LoadAlbumsAsync: {ex}");
		}
		finally
		{
			isLoading = false;
			currentStep = string.Empty;
			StateHasChanged();
		}
	}

	private async Task<string?> GetAlbumThumbnailAsync(HttpClient httpClient, string albumId, string? coverImageItemId = null)
	{
		try
		{
			// Method 1: Use the coverImageItemId if provided (most efficient)
			if (!string.IsNullOrEmpty(coverImageItemId))
			{
				var coverThumbnailUrl = await GetImageThumbnailAsync(httpClient, coverImageItemId);
				if (!string.IsNullOrEmpty(coverThumbnailUrl))
				{
					return coverThumbnailUrl;
				}
			}
			return null; // if no coverImageItemId, leave thumb blank so I can tell it doesn't have one yet

			// Method 2: Try to get album cover photo directly from the bundle/album
			var albumResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{albumId}?$expand=bundle");

			if (albumResponse.IsSuccessStatusCode)
			{
				var albumJson = await albumResponse.Content.ReadAsStringAsync();
				var albumData = JsonConvert.DeserializeObject<dynamic>(albumJson);

				// Check if the album bundle has cover photo information
				if (albumData?.bundle?.album?.coverImageItemId != null)
				{
					var coverPhotoId = albumData.bundle.album.coverImageItemId.ToString();
					if (!string.IsNullOrEmpty(coverPhotoId))
					{
						var coverThumbnailUrl = await GetImageThumbnailAsync(httpClient, coverPhotoId);
						if (!string.IsNullOrEmpty(coverThumbnailUrl))
						{
							return coverThumbnailUrl;
						}
					}
				}
			}

			// Method 3: Try to get thumbnail directly from the album bundle item
			var thumbnailResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{albumId}/thumbnails");

			if (thumbnailResponse.IsSuccessStatusCode)
			{
				var thumbnailJson = await thumbnailResponse.Content.ReadAsStringAsync();
				var thumbnailData = JsonConvert.DeserializeObject<dynamic>(thumbnailJson);

				if (thumbnailData?.value != null && thumbnailData.value.Count > 0)
				{
					var firstThumbnail = thumbnailData.value[0];
					var thumbnailUrl = firstThumbnail?.medium?.url?.ToString() ??
									   firstThumbnail?.small?.url?.ToString() ??
									   firstThumbnail?.large?.url?.ToString();

					if (!string.IsNullOrEmpty(thumbnailUrl))
					{
						return thumbnailUrl;
					}
				}
			}

			// Method 4: Fallback - Get first image from album children (existing logic)
			var childrenResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{albumId}/children?$top=10&$filter=file ne null&$orderby=name");

			if (childrenResponse.IsSuccessStatusCode)
			{
				var childrenJson = await childrenResponse.Content.ReadAsStringAsync();
				var childrenData = JsonConvert.DeserializeObject<dynamic>(childrenJson);

				if (childrenData?.value != null && childrenData.value.Count > 0)
				{
					foreach (var child in childrenData.value)
					{
						var fileName = child.name?.ToString() ?? "";
						var mimeType = child.file?.mimeType?.ToString() ?? "";

						if (IsImageFile(fileName, mimeType))
						{
							var imageId = child.id?.ToString();
							if (!string.IsNullOrEmpty(imageId))
							{
								var thumbnailUrl = await GetImageThumbnailAsync(httpClient, imageId);
								if (!string.IsNullOrEmpty(thumbnailUrl))
								{
									return thumbnailUrl;
								}
							}
						}
					}
				}
			}

			// Method 5: Final fallback - try to get any available thumbnail from the bundle
			var bundleThumbnailResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{albumId}/thumbnails?select=c64x64,c240x240,c480x480");

			if (bundleThumbnailResponse.IsSuccessStatusCode)
			{
				var bundleThumbnailJson = await bundleThumbnailResponse.Content.ReadAsStringAsync();
				var bundleThumbnailData = JsonConvert.DeserializeObject<dynamic>(bundleThumbnailJson);

				if (bundleThumbnailData?.value != null && bundleThumbnailData.value.Count > 0)
				{
					var thumbnail = bundleThumbnailData.value[0];
					return thumbnail?.c240x240?.url?.ToString() ??
						   thumbnail?.c480x480?.url?.ToString() ??
						   thumbnail?.c64x64?.url?.ToString();
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error getting thumbnail for album {albumId}: {ex.Message}");
		}

		return null;
	}

	private bool IsImageFile(string fileName, string mimeType)
	{
		// Check by MIME type first
		if (!string.IsNullOrEmpty(mimeType) &&
			(mimeType.StartsWith("image/") ||
			 mimeType == "image/jpeg" ||
			 mimeType == "image/jpg" ||
			 mimeType == "image/png" ||
			 mimeType == "image/gif" ||
			 mimeType == "image/bmp" ||
			 mimeType == "image/webp"))
		{
			return true;
		}

		// Fallback to file extension check
		if (!string.IsNullOrEmpty(fileName))
		{
			var extension = System.IO.Path.GetExtension(fileName).ToLowerInvariant();
			return extension is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp";
		}

		return false;
	}

	private async Task<string?> GetImageThumbnailAsync(HttpClient httpClient, string imageId)
	{
		try
		{
			var thumbnailResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{imageId}/thumbnails");
			if (thumbnailResponse.IsSuccessStatusCode)
			{
				var thumbnailJson = await thumbnailResponse.Content.ReadAsStringAsync();
				var thumbnailData = JsonConvert.DeserializeObject<dynamic>(thumbnailJson);

				if (thumbnailData?.value != null && thumbnailData.value.Count > 0)
				{
					var firstThumbnail = thumbnailData.value[0];
					return firstThumbnail?.medium?.url?.ToString() ??
						   firstThumbnail?.small?.url?.ToString() ??
						   firstThumbnail?.large?.url?.ToString();
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Exception getting thumbnail for image {imageId}: {ex.Message}");
		}

		return null;
	}

	// Lazy loading share links - only fetch when user clicks
	private async Task<string> GetOrCreateShareLinkAsync(AlbumInfo album)
	{
		if (!string.IsNullOrEmpty(album.ShareUrl))
		{
			return album.ShareUrl; // Already have it
		}

		try
		{
			// Use shared AuthTokenHelper for centralized token expiration handling
			var token = await AuthToken.GetAccessTokenAsync(showExpiredMessage: false);
			if (string.IsNullOrEmpty(token))
			{
				Console.WriteLine("Token expired while getting share link");
				// AuthTokenHelper already handles the redirect
				return $"https://onedrive.live.com/?id={album.Id}";
			}

			using var httpClient = new HttpClient();
			httpClient.DefaultRequestHeaders.Authorization =
				new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

			// First try to get existing sharing links
			var existingLinksResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{album.Id}/permissions");

			if (existingLinksResponse.IsSuccessStatusCode)
			{
				var existingLinksJson = await existingLinksResponse.Content.ReadAsStringAsync();
				var linksData = JsonConvert.DeserializeObject<dynamic>(existingLinksJson);

				if (linksData?.value != null)
				{
					foreach (var permission in linksData.value)
					{
						if (permission?.link?.webUrl != null)
						{
							album.ShareUrl = permission.link.webUrl.ToString();
							return album.ShareUrl;
						}
					}
				}
			}

			// No existing link found, create a new one
			var linkRequest = new
			{
				type = "view",
				scope = "anonymous"
			};

			var json = JsonConvert.SerializeObject(linkRequest);
			var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

			var response = await httpClient.PostAsync($"{MSGraphEndPoint}me/drive/items/{album.Id}/createLink", content);

			if (response.IsSuccessStatusCode)
			{
				var responseJson = await response.Content.ReadAsStringAsync();
				var linkResponse = JsonConvert.DeserializeObject<dynamic>(responseJson);

				album.ShareUrl = linkResponse?.link?.webUrl?.ToString() ?? $"https://onedrive.live.com/?id={album.Id}";
				return album.ShareUrl;
			}
			else
			{
				Console.WriteLine($"Could not create share link for bundle {album.Id}: {response.StatusCode}");
				album.ShareUrl = $"https://onedrive.live.com/?id={album.Id}";
				return album.ShareUrl;
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error getting/creating share link for bundle {album.Id}: {ex.Message}");
			album.ShareUrl = $"https://onedrive.live.com/?id={album.Id}";
			return album.ShareUrl;
		}
	}

	private async Task OpenAlbumInNewWindow(AlbumInfo album)
	{
		album.IsLoadingShareUrl = true;
		StateHasChanged();

		try
		{
			var shareUrl = await GetOrCreateShareLinkAsync(album);
			await JS.InvokeVoidAsync("open", shareUrl, "_blank");
		}
		finally
		{
			album.IsLoadingShareUrl = false;
			StateHasChanged();
		}
	}

	private async Task CopyShareLinkAsync(AlbumInfo album)
	{
		album.IsLoadingShareUrl = true;
		StateHasChanged();

		try
		{
			var shareUrl = await GetOrCreateShareLinkAsync(album);
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
			statusMessage = $"Share link copied to clipboard for album '{album.Name}'";
			StateHasChanged();

			// Clear the message after 3 seconds using explicit Task parameter
			_ = Task.Delay(3000).ContinueWith((Task _) =>
			{
				InvokeAsync(() =>
				{
					if (statusMessage.Contains("copied to clipboard"))
					{
						statusMessage = string.Empty;
						StateHasChanged();
					}
				});
			});
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error copying to clipboard: {ex.Message}");
			statusMessage = $"Could not copy link to clipboard";
			StateHasChanged();
		}
		finally
		{
			album.IsLoadingShareUrl = false;
			StateHasChanged();
		}
	}

	public class AlbumInfo
	{
		public string Id { get; set; } = string.Empty;
		public string Name { get; set; } = string.Empty;
		public string? Description { get; set; }
		public DateTime? CreatedDateTime { get; set; }
		public DateTime? LastModifiedDateTime { get; set; }
		public int ChildCount { get; set; }
		public string? ThumbnailUrl { get; set; }
		public string ShareUrl { get; set; } = string.Empty;

		// UI state properties
		public bool IsNew { get; set; } = false;
		public bool IsLoadingThumbnail { get; set; } = false;
		public bool IsLoadingShareUrl { get; set; } = false;
	}
}

