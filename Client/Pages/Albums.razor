@code {
	// Static fields to preserve data across navigation
	private static List<AlbumInfo> _cachedAlbums = new();
	private static DateTime? _lastFetched = null;
	private static readonly object _cacheLock = new object();
	
	// Semaphore to limit concurrent thumbnail loading (max 5 at a time)
	private static readonly SemaphoreSlim _thumbnailSemaphore = new SemaphoreSlim(5, 5);

	// Instance fields
	private List<AlbumInfo> albums = new();
	private DateTime? lastFetched = null;
	private bool isLoading = false;
	private string statusMessage = string.Empty;
	private HttpClient? _httpClient;
	private const string MSGraphEndPoint = @"https://graph.microsoft.com/v1.0/";

	// Progressive loading fields
	private string currentStep = string.Empty;
	private int totalAlbumsToProcess = 0;

	// CancellationTokenSource for thumbnail loading
	private CancellationTokenSource? _thumbnailCancellationSource;

	// Cache expiry time - albums will be considered fresh for 5 minutes
	private static readonly TimeSpan CacheExpiry = TimeSpan.FromMinutes(5);

	protected override async Task OnInitializedAsync()
	{
		_httpClient = HttpClientFactory.CreateClient("GraphAPI");

		// Load from cache if available and not expired
		lock (_cacheLock)
		{
			if (_cachedAlbums.Any() && _lastFetched.HasValue &&
				DateTime.Now - _lastFetched.Value < CacheExpiry)
			{
				albums = new List<AlbumInfo>(_cachedAlbums);
				lastFetched = _lastFetched;
				statusMessage = "Loaded from cache";
				return;
			}
		}

		// Cache is empty or expired, fetch fresh data
		await LoadAlbumsAsync();
	}

	private async Task RefreshAlbumsAsync()
	{
		Console.WriteLine($"🔄 RefreshAlbumsAsync called");

		// Cancel any pending thumbnail loads
		_thumbnailCancellationSource?.Cancel();
		_thumbnailCancellationSource?.Dispose();
		_thumbnailCancellationSource = new CancellationTokenSource();

		// Force refresh - clear cache and fetch new data
		lock (_cacheLock)
		{
			Console.WriteLine($"🔄 Clearing cache. Current cached albums: {_cachedAlbums.Count}");
			_cachedAlbums.Clear();
			_lastFetched = null;
		}

		await LoadAlbumsAsync();
	}

	private async Task LoadAlbumsAsync()
	{
		if (isLoading) return;

		isLoading = true;
		statusMessage = string.Empty;
		albums.Clear();
		currentStep = "Initializing...";
		totalAlbumsToProcess = 0;
		StateHasChanged();

		// Cancel any existing thumbnail operations and create new cancellation source
		_thumbnailCancellationSource?.Cancel();
		_thumbnailCancellationSource?.Dispose();
		_thumbnailCancellationSource = new CancellationTokenSource();

		try
		{
			// Use shared AuthTokenHelper for centralized token expiration handling
			var token = await AuthToken.GetAccessTokenAsync(showExpiredMessage: false);
			if (string.IsNullOrEmpty(token))
			{
				statusMessage = "Session expired. Redirecting to sign in...";
				StateHasChanged();
				return;
			}

			using var httpClient = new HttpClient();
			httpClient.DefaultRequestHeaders.Authorization =
			new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

			currentStep = "Fetching album list...";
			StateHasChanged();

			// Get all bundles (albums) from OneDrive
			var response = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/bundles");

			if (response.IsSuccessStatusCode)
			{
				var json = await response.Content.ReadAsStringAsync();
				using var doc = JsonDocument.Parse(json);
				var root = doc.RootElement;

				var albumBundles = new List<JsonElement>();

				if (root.TryGetProperty("value", out var valueArray))
				{
					// First pass: collect album bundles
					foreach (var bundle in valueArray.EnumerateArray())
					{
						if (bundle.TryGetProperty("bundle", out var bundleObj) &&
							bundleObj.TryGetProperty("album", out _))
						{
							albumBundles.Add(bundle);
						}
					}
				}

				totalAlbumsToProcess = albumBundles.Count;
				currentStep = $"Found {totalAlbumsToProcess} albums. Processing...";
				StateHasChanged();

				// Process each album and add to UI progressively
				foreach (var bundle in albumBundles)
				{
					// Extract the coverImageItemId if available
					string? coverImageItemId = null;
					if (bundle.TryGetProperty("bundle", out var bundleObj) &&
						bundleObj.TryGetProperty("album", out var albumObj) &&
						albumObj.TryGetProperty("coverImageItemId", out var coverEl))
					{
						coverImageItemId = coverEl.GetString();
					}

					var albumInfo = new AlbumInfo
					{
						Id = bundle.TryGetProperty("id", out var idEl) ? idEl.GetString() ?? string.Empty : string.Empty,
						Name = bundle.TryGetProperty("name", out var nameEl) ? nameEl.GetString() ?? "Unnamed Album" : "Unnamed Album",
						Description = bundle.TryGetProperty("description", out var descEl) ? descEl.GetString() : null,
						CreatedDateTime = bundle.TryGetProperty("createdDateTime", out var createdEl) && 
							DateTime.TryParse(createdEl.GetString(), out DateTime created) ? created : null,
						LastModifiedDateTime = bundle.TryGetProperty("lastModifiedDateTime", out var modifiedEl) && 
							DateTime.TryParse(modifiedEl.GetString(), out DateTime modified) ? modified : null,
						ChildCount = bundle.TryGetProperty("folder", out var folderEl) && 
							folderEl.TryGetProperty("childCount", out var countEl) ? countEl.GetInt32() : 0,
						IsNew = true,
						IsLoadingThumbnail = true
					};

					// Add album to UI immediately
					albums.Add(albumInfo);
					currentStep = $"Loading '{albumInfo.Name}'...";
					StateHasChanged();

					// Load thumbnail in background with cancellation support and concurrency limiting
					_ = Task.Run(async () =>
					{
						// Wait for semaphore slot (max 5 concurrent thumbnail loads)
						await _thumbnailSemaphore.WaitAsync(_thumbnailCancellationSource.Token);
						
						try
						{
							if (_thumbnailCancellationSource != null && !_thumbnailCancellationSource.Token.IsCancellationRequested)
							{
								// Create a dedicated HttpClient for thumbnail loading to avoid cancellation issues
								using var thumbHttpClient = new HttpClient();
								thumbHttpClient.DefaultRequestHeaders.Authorization =
									new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
								thumbHttpClient.Timeout = TimeSpan.FromSeconds(30);

								albumInfo.ThumbnailUrl = await GetAlbumThumbnailAsync(thumbHttpClient, albumInfo.Id, coverImageItemId, _thumbnailCancellationSource.Token);
							}
						}
						catch (OperationCanceledException)
						{
							// Ignore cancellation - this is expected when navigating away or refreshing
							Console.WriteLine($"Thumbnail load canceled for album {albumInfo.Name}");
						}
						catch (Exception ex)
						{
							Console.WriteLine($"Error loading thumbnail for album {albumInfo.Name}: {ex.Message}");
						}
						finally
						{
							// Always release the semaphore slot
							_thumbnailSemaphore.Release();
							
							albumInfo.IsLoadingThumbnail = false;
							albumInfo.IsNew = false;
							await InvokeAsync(StateHasChanged);
						}
					}, _thumbnailCancellationSource.Token);

					// Small delay to allow UI to update smoothly
					await Task.Delay(100);
				}

				// Update cache with all loaded albums
				var fetchTime = DateTime.Now;
				lastFetched = fetchTime;

				// Create cache copy without loading states
				var cacheAlbums = albums.Select(a => new AlbumInfo
				{
					Id = a.Id,
					Name = a.Name,
					Description = a.Description,
					CreatedDateTime = a.CreatedDateTime,
					LastModifiedDateTime = a.LastModifiedDateTime,
					ChildCount = a.ChildCount,
					ThumbnailUrl = a.ThumbnailUrl,
					ShareUrl = a.ShareUrl
				}).ToList();

				lock (_cacheLock)
				{
					_cachedAlbums = cacheAlbums;
					_lastFetched = fetchTime;
				}

				if (!albums.Any())
				{
					statusMessage = "No photo albums found. Create albums using the Picture Query page.";
				}
				else
				{
					statusMessage = $"Loaded {albums.Count} albums successfully";

					// Clear success message after 3 seconds
					_ = Task.Delay(3000).ContinueWith((Task _) =>
					{
						InvokeAsync(() =>
						{
							if (statusMessage.Contains("Loaded") && statusMessage.Contains("successfully"))
							{
								statusMessage = string.Empty;
								StateHasChanged();
							}
						});
					});
				}
			}
			else
			{
				var errorContent = await response.Content.ReadAsStringAsync();
				statusMessage = $"Error loading albums: {response.StatusCode} - {errorContent}";
			}
		}
		catch (Exception ex)
		{
			statusMessage = $"Error loading albums: {ex.Message}";
			Console.WriteLine($"Error in LoadAlbumsAsync: {ex}");
		}
		finally
		{
			isLoading = false;
			currentStep = string.Empty;
			StateHasChanged();
		}
	}

	private async Task<string?> GetAlbumThumbnailAsync(HttpClient httpClient, string albumId, string? coverImageItemId = null, CancellationToken cancellationToken = default)
	{
		try
		{
			// Method 1: Use the coverImageItemId if provided (most efficient)
			if (!string.IsNullOrEmpty(coverImageItemId))
			{
				var coverThumbnailUrl = await GetImageThumbnailAsync(httpClient, coverImageItemId, cancellationToken);
				if (!string.IsNullOrEmpty(coverThumbnailUrl))
				{
					return coverThumbnailUrl;
				}
			}
			return null; // if no coverImageItemId, leave thumb blank so I can tell it doesn't have one yet
		}
		catch (OperationCanceledException)
		{
			// Expected when cancellation is requested - just return null
			return null;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error getting thumbnail for album {albumId}: {ex.Message}");
		}

		return null;
	}

	private async Task<string?> GetImageThumbnailAsync(HttpClient httpClient, string imageId, CancellationToken cancellationToken = default)
	{
		try
		{
			var thumbnailResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{imageId}/thumbnails", cancellationToken);
			if (thumbnailResponse.IsSuccessStatusCode)
			{
				var thumbnailJson = await thumbnailResponse.Content.ReadAsStringAsync();
				using var doc = JsonDocument.Parse(thumbnailJson);
				var root = doc.RootElement;

				if (root.TryGetProperty("value", out var valueArray))
				{
					foreach (var thumb in valueArray.EnumerateArray())
					{
						// Try medium first, then small, then large
						if (thumb.TryGetProperty("medium", out var medium) && 
							medium.TryGetProperty("url", out var mediumUrl))
							return mediumUrl.GetString();
						if (thumb.TryGetProperty("small", out var small) && 
							small.TryGetProperty("url", out var smallUrl))
							return smallUrl.GetString();
						if (thumb.TryGetProperty("large", out var large) && 
							large.TryGetProperty("url", out var largeUrl))
							return largeUrl.GetString();
					}
				}
			}
		}
		catch (OperationCanceledException)
		{
			// Expected when cancellation is requested
			throw;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Exception getting thumbnail for image {imageId}: {ex.Message}");
		}

		return null;
	}

	// Lazy loading share links - only fetch when user clicks
	private async Task<string> GetOrCreateShareLinkAsync(AlbumInfo album)
	{
		if (!string.IsNullOrEmpty(album.ShareUrl))
		{
			return album.ShareUrl; // Already have it
		}

		try
		{
			// Use shared AuthTokenHelper for centralized token expiration handling
			var token = await AuthToken.GetAccessTokenAsync(showExpiredMessage: false);
			if (string.IsNullOrEmpty(token))
			{
				Console.WriteLine("Token expired while getting share link");
				// AuthTokenHelper already handles the redirect
				return $"https://onedrive.live.com/?id={album.Id}";
			}

			using var httpClient = new HttpClient();
			httpClient.DefaultRequestHeaders.Authorization =
				new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

			// First try to get existing sharing links
			var existingLinksResponse = await httpClient.GetAsync($"{MSGraphEndPoint}me/drive/items/{album.Id}/permissions");

			if (existingLinksResponse.IsSuccessStatusCode)
			{
				var existingLinksJson = await existingLinksResponse.Content.ReadAsStringAsync();
				using var doc = JsonDocument.Parse(existingLinksJson);

				if (doc.RootElement.TryGetProperty("value", out var permissions))
				{
					foreach (var permission in permissions.EnumerateArray())
					{
						if (permission.TryGetProperty("link", out var link) &&
							link.TryGetProperty("webUrl", out var webUrl))
						{
							album.ShareUrl = webUrl.GetString() ?? string.Empty;
							return album.ShareUrl;
						}
					}
				}
			}

			// No existing link found, create a new one
			var linkRequest = new
			{
				type = "view",
				scope = "anonymous"
			};

			var json = JsonSerializer.Serialize(linkRequest);
			var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

			var response = await httpClient.PostAsync($"{MSGraphEndPoint}me/drive/items/{album.Id}/createLink", content);

			if (response.IsSuccessStatusCode)
			{
				var responseJson = await response.Content.ReadAsStringAsync();
				using var respDoc = JsonDocument.Parse(responseJson);
				
				if (respDoc.RootElement.TryGetProperty("link", out var linkProp) &&
					linkProp.TryGetProperty("webUrl", out var webUrlProp))
				{
					album.ShareUrl = webUrlProp.GetString() ?? $"https://onedrive.live.com/?id={album.Id}";
				}
				else
				{
					album.ShareUrl = $"https://onedrive.live.com/?id={album.Id}";
				}
				
				return album.ShareUrl;
			}
			else
			{
				Console.WriteLine($"Could not create share link for bundle {album.Id}: {response.StatusCode}");
				album.ShareUrl = $"https://onedrive.live.com/?id={album.Id}";
				return album.ShareUrl;
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error getting/creating share link for bundle {album.Id}: {ex.Message}");
			album.ShareUrl = $"https://onedrive.live.com/?id={album.Id}";
			return album.ShareUrl;
		}
	}

	private async Task OpenAlbumInNewWindow(AlbumInfo album)
	{
		album.IsLoadingShareUrl = true;
		StateHasChanged();

		try
		{
			var shareUrl = await GetOrCreateShareLinkAsync(album);
			await JS.InvokeVoidAsync("open", shareUrl, "_blank");
		}
		finally
		{
			album.IsLoadingShareUrl = false;
			StateHasChanged();
		}
	}

	private async Task CopyShareLinkAsync(AlbumInfo album)
	{
		album.IsLoadingShareUrl = true;
		StateHasChanged();

		try
		{
			var shareUrl = await GetOrCreateShareLinkAsync(album);
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
			statusMessage = $"Share link copied to clipboard for album '{album.Name}'";
			StateHasChanged();

			// Clear the message after 3 seconds using explicit Task parameter
			_ = Task.Delay(3000).ContinueWith((Task _) =>
			{
				InvokeAsync(() =>
				{
					if (statusMessage.Contains("copied to clipboard"))
					{
						statusMessage = string.Empty;
						StateHasChanged();
					}
				});
			});
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error copying to clipboard: {ex.Message}");
			statusMessage = $"Could not copy link to clipboard";
			StateHasChanged();
		}
		finally
		{
			album.IsLoadingShareUrl = false;
			StateHasChanged();
		}
	}

	public void Dispose()
	{
		// Cancel any pending thumbnail operations when component is disposed
		_thumbnailCancellationSource?.Cancel();
		_thumbnailCancellationSource?.Dispose();
	}

	public class AlbumInfo
	{
		public string Id { get; set; } = string.Empty;
		public string Name { get; set; } = string.Empty;
		public string? Description { get; set; }
		public DateTime? CreatedDateTime { get; set; }
		public DateTime? LastModifiedDateTime { get; set; }
		public int ChildCount { get; set; }
		public string? ThumbnailUrl { get; set; }
		public string ShareUrl { get; set; } = string.Empty;

		// UI state properties
		public bool IsNew { get; set; } = false;
		public bool IsLoadingThumbnail { get; set; } = false;
		public bool IsLoadingShareUrl { get; set; } = false;
	}
}

