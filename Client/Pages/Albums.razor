	.album-actions {
		display: flex;
		gap: 8px;
		flex-shrink: 0;
	}

	.view-btn, .copy-btn {
		padding: 6px 12px;
		border: none;
		border-radius: 4px;
		cursor: pointer;
		font-size: 12px;
		font-weight: 500;
		transition: all 0.2s;
		text-decoration: none;
		display: inline-block;
