@page "/cartoon"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Services
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Cartoon - Interactive Drawing</PageTitle>

<div class="cartoon-container">
	<!-- Top Controls: Authoring Tools -->
	<div class="cartoon-controls-top">
		<div class="cartoon-mode-buttons">
			<label class="mode-btn @(_currentMode == DrawMode.Drag ? "active" : "")" title="Click and drag to draw">
				<input type="radio" name="drawMode" checked="@(_currentMode == DrawMode.Drag)" @onchange="() => SetMode(DrawMode.Drag)" />
				✋ Drag
			</label>
			<label class="mode-btn @(_currentMode == DrawMode.Draw ? "active" : "")" title="Click-to-click line drawing">
				<input type="radio" name="drawMode" checked="@(_currentMode == DrawMode.Draw)" @onchange="() => SetMode(DrawMode.Draw)" />
				✏️ Draw
			</label>
		</div>

		<div class="cartoon-pen-controls">
			<label title="Pen thickness">
				<span>Thick:</span>
				<input type="range" id="penThickness" min="1" max="20" step="0.5"
					 @bind="_penThickness" @bind:event="oninput" style="width: 70px;" />
				<span class="val">@_penThickness.ToString("F1")</span>
			</label>

			<label title="Pen color">
				<span>Color:</span>
				<input type="color" id="penColor" @bind="_penColor" @bind:event="oninput" style="width: 45px;" />
			</label>
		</div>

		<div class="cartoon-frame-buttons">
			<button @onclick="AddFrame" class="btn-sm" title="Create new frame">📸 Add Frame</button>
			<button @onclick="DeleteCurrentFrame" disabled="@(_userFrames.Count <= 1)" class="btn-sm" title="Delete current frame">🗑️ Del</button>
		</div>

		<div class="cartoon-frame-info">
			Frame @(_currentUserFrameIndex + 1)/@(_userFrames.Count)
		</div>
	</div>

	<!-- Large Canvas Area -->
	<div class="cartoon-canvas-section">
		<canvas id="cartoonCanvas" class="cartoon-canvas"
				@onmousedown="OnPointerDown"
				@onmousemove="OnPointerMove"
				@onmouseup="OnPointerUp"
				@onmouseleave="OnPointerUp"
				@ontouchstart="OnPointerDown"
				@ontouchmove="OnPointerMove"
				@ontouchend="OnPointerUp"
				@ontouchcancel="OnPointerUp">
		</canvas>
	</div>

	<!-- Bottom Controls: Playback and Actions -->
	<div class="cartoon-controls-bottom">
		<button @onclick="TogglePlayback" class="btn-play-sm" disabled="@(_userFrames.Count < 2)" title="Play/Pause animation">
			@if (_isPlaying)
			{
				<span>⏸️ Pause</span>
			}
			else
			{
				<span>▶️ Play</span>
			}
		</button>

		<label title="Animation speed">
			<span>Speed:</span>
			<input type="range" id="frameDelay" min="50" max="1000" step="50"
				   @bind="_frameDelay" @bind:event="oninput" style="width: 70px;" />
			<span class="val">@(_frameDelay)ms</span>
		</label>

		<label title="Interpolated frames between user frames">
			<span>Between:</span>
			<input type="range" id="betweenFrames" min="0" max="200" step="1"
				   @bind="_betweenFrames" @bind:event="oninput" style="width: 70px;" />
			<span class="val">@_betweenFrames</span>
		</label>

		<div class="cartoon-action-buttons">
			<button @onclick="ClearCurrentFrame" class="btn-sm" title="Clear current frame">🧹 Clear</button>
			<button @onclick="Demo" class="btn-demo-sm" title="Load demo animation with curves">🎨 Demo</button>
			<button @onclick="Reset" class="btn-reset-sm" title="Clear all frames">🔄 Reset</button>
		</div>
	</div>

	<!-- Multi-Row Timeline -->
	<div class="cartoon-timeline">
		@for (int i = 0; i < _userFrames.Count; i++)
		{
			var frameIndex = i;
			<div class="frame-thumb @(frameIndex == _currentUserFrameIndex ? "active" : "")"
				 @onclick="() => SelectFrame(frameIndex)"
				 title="Frame @(frameIndex + 1)">
				<div class="thumb-num">@(frameIndex + 1)</div>
				<canvas class="thumb-canvas" id="thumbnail_@frameIndex" width="60" height="45"></canvas>
			</div>
		}
	</div>
</div>

@code {
	private enum DrawMode { Draw, Drag }
	private enum DemoType { Alphabet, Credits, History }

	// NEW: Point structure for cleaner coordinate handling
	private record struct Point(double X, double Y);

	private class CartoonLine
	{
		public Point Start { get; set; }
		public Point End { get; set; }
		public double Thickness { get; set; }
		public string Color { get; set; } = "#000000";

		public CartoonLine Clone()
		{
			return new CartoonLine
			{
				Start = this.Start,
				End = this.End,
				Thickness = this.Thickness,
				Color = this.Color
			};
		}
	}

	private class CartoonFrame
	{
		public List<CartoonLine> Lines { get; set; } = new();

		public CartoonFrame Clone()
		{
			var frame = new CartoonFrame();
			foreach (var line in Lines)
				frame.Lines.Add(line.Clone());
			return frame;
		}
	}

	// NEW: Persistent state class for serialization
	[Serializable]
	private class CartoonPersistentState
	{
		public List<CartoonFrame> Frames { get; set; } = new();
		public int CurrentFrameIndex { get; set; }
		public int BetweenFrames { get; set; } = 20;
		public double PenThickness { get; set; } = 2.0;
		public string PenColor { get; set; } = "#000000";
		public DrawMode CurrentMode { get; set; } = DrawMode.Drag;
		public int FrameDelay { get; set; } = 100;
		public DemoType CurrentDemoType { get; set; } = DemoType.Alphabet;
		public DateTime LastSaved { get; set; } = DateTime.Now;
	}

	private List<CartoonFrame> _userFrames = new();
	private int _currentUserFrameIndex = 0;
	private int _currentPlaybackUserFrameIndex = 0;
	private int _currentBetweenIndex = 0;
	private int _betweenFrames = 20;
	private DrawMode _currentMode = DrawMode.Drag; // Default to Drag mode
	private bool _isDrawing = false;
	private double _lastX = 0;
	private double _lastY = 0;
	private double _penThickness = 2.0;
	private string _penColor = "#000000";
	private bool _isPlaying = false;
	private System.Threading.Timer? _playbackTimer;
	private int _frameDelay = 100;
	private bool _isInitialized = false;
	private static Cartoon? _currentInstance; // Track current instance for JS callbacks
	private static double _lastDemoWidth = 0;
	private static double _lastDemoHeight = 0;
	private static DemoType _currentDemoType = DemoType.Alphabet;

	// NEW: Persistence constants
	private const string CARTOON_STATE_KEY = "cartoon_state";

	protected override void OnInitialized()
	{
		_currentInstance = this;
		base.OnInitialized();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			DebugHelper.Log("[Cartoon] OnAfterRenderAsync - First render starting", true);
			
			await JSRuntime.InvokeVoidAsync("initCartoonCanvas", "cartoonCanvas");
			_isInitialized = true;
			
			DebugHelper.Log("[Cartoon] Canvas initialized, setting up resize listener", true);
			
			// Set up resize listener with diagnostics and demo regeneration
			await JSRuntime.InvokeVoidAsync("eval", @"
				let resizeTimeout;
				let lastCanvasWidth = 0;
				let lastCanvasHeight = 0;
				
				window.resizeCartoonCanvas = function() {
					const canvas = document.getElementById('cartoonCanvas');
					if (!canvas) {
						console.log('[Cartoon] Canvas not found!');
						return;
					}
					
					const container = canvas.parentElement;
					const containerWidth = container.clientWidth;
					
					// Maintain 3:2 aspect ratio (1200:800)
					const aspectRatio = 1200 / 800;
					const newWidth = containerWidth;
					const newHeight = newWidth / aspectRatio;
					
					// Only resize if dimensions changed significantly
					if (Math.abs(canvas.width - newWidth) > 10) {
						console.log('[Cartoon] Resizing canvas from', canvas.width, 'x', canvas.height, 'to', newWidth, 'x', newHeight);
						
						// Save current drawing
						const tempCanvas = document.createElement('canvas');
						tempCanvas.width = canvas.width;
						tempCanvas.height = canvas.height;
						const tempCtx = tempCanvas.getContext('2d');
						tempCtx.drawImage(canvas, 0, 0);
						
						// Resize canvas
						canvas.width = newWidth;
						canvas.height = newHeight;
						
						// Restore drawing scaled
						const ctx = canvas.getContext('2d');
						ctx.fillStyle = 'white';
						ctx.fillRect(0, 0, canvas.width, canvas.height);
						ctx.drawImage(tempCanvas, 0, 0, tempCanvas.width, tempCanvas.height, 
									 0, 0, canvas.width, canvas.height);
						
						// Re-apply drawing properties
						ctx.lineCap = 'round';
						ctx.lineJoin = 'round';
						
						console.log('[Cartoon] Resize complete. New canvas dimensions:', canvas.width, 'x', canvas.height);
						
						// Store new dimensions
						lastCanvasWidth = canvas.width;
						lastCanvasHeight = canvas.height;
						
						// Clear any pending timeout
						if (resizeTimeout) {
							clearTimeout(resizeTimeout);
						}
						
						// Wait 2 seconds after resize stops, then regenerate demo
						resizeTimeout = setTimeout(() => {
							console.log('[Cartoon] Resize settled. Triggering demo regeneration...');
							// Call back to Blazor to regenerate demo with new dimensions
							DotNet.invokeMethodAsync('Client', 'RegenerateDemoForNewSize', lastCanvasWidth, lastCanvasHeight);
						}, 2000);
					}
				};
				
				// Initial resize
				console.log('[Cartoon] Running initial resize');
				window.resizeCartoonCanvas();
				
				// Add resize listener
				window.addEventListener('resize', function() {
					console.log('[Cartoon] Window resize event fired');
					window.resizeCartoonCanvas();
				});
				console.log('[Cartoon] Resize listener installed');
			");
			
			DebugHelper.Log("[Cartoon] Resize setup complete, attempting to restore state", true);
			
			// NEW: Try to restore saved state first
			var restoredState = await LoadCartoonState();
			if (restoredState != null && restoredState.Frames.Count > 0)
			{
				DebugHelper.Log($"[Cartoon] Restoring saved state with {restoredState.Frames.Count} frames", true);
				
				// Restore frames and settings
				_userFrames = restoredState.Frames;
				_currentUserFrameIndex = Math.Min(restoredState.CurrentFrameIndex, _userFrames.Count - 1);
				_betweenFrames = restoredState.BetweenFrames;
				_penThickness = restoredState.PenThickness;
				_penColor = restoredState.PenColor;
				_currentMode = restoredState.CurrentMode;
				_frameDelay = restoredState.FrameDelay;
				_currentDemoType = restoredState.CurrentDemoType;
				
				// Redraw current frame
				await RedrawCurrentFrame();
				
				// Update all thumbnails
				for (int i = 0; i < _userFrames.Count; i++)
					await UpdateThumbnail(i);
				
				DebugHelper.Log("[Cartoon] State restored successfully", true);
			}
			else
			{
				DebugHelper.Log("[Cartoon] No saved state found, loading demo", true);
				
				// Automatically load and play demo
				await Demo();
				await Task.Delay(100); // Brief delay to ensure frames are ready
				_isPlaying = true;
				StartPlayback();
			}
			
			DebugHelper.Log("[Cartoon] Initialization complete", true);
			
			StateHasChanged();
		}
	}

	// NEW: Save current cartoon state to localStorage
	private async Task SaveCartoonState()
	{
		try
		{
			if (!_isInitialized || _userFrames.Count == 0) return;

			var state = new CartoonPersistentState
			{
				Frames = _userFrames.Select(f => f.Clone()).ToList(),
				CurrentFrameIndex = _currentUserFrameIndex,
				BetweenFrames = _betweenFrames,
				PenThickness = _penThickness,
				PenColor = _penColor,
				CurrentMode = _currentMode,
				FrameDelay = _frameDelay,
				CurrentDemoType = _currentDemoType,
				LastSaved = DateTime.Now
			};

			var json = System.Text.Json.JsonSerializer.Serialize(state);
			await JSRuntime.InvokeVoidAsync("localStorage.setItem", CARTOON_STATE_KEY, json);
			
			DebugHelper.Log($"[Cartoon] State saved - {_userFrames.Count} frames", false);
		}
		catch (Exception ex)
		{
			DebugHelper.Log($"[Cartoon] Error saving state: {ex.Message}", true);
		}
	}

	// NEW: Load cartoon state from localStorage
	private async Task<CartoonPersistentState?> LoadCartoonState()
	{
		try
		{
			var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", CARTOON_STATE_KEY);
			if (!string.IsNullOrEmpty(json))
			{
				var state = System.Text.Json.JsonSerializer.Deserialize<CartoonPersistentState>(json);
				DebugHelper.Log($"[Cartoon] State loaded - {state?.Frames?.Count ?? 0} frames", true);
				return state;
			}
		}
		catch (Exception ex)
		{
			DebugHelper.Log($"[Cartoon] Error loading state: {ex.Message}", true);
		}
		return null;
	}

	// NEW: Clear saved state
	private async Task ClearCartoonState()
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("localStorage.removeItem", CARTOON_STATE_KEY);
			DebugHelper.Log("[Cartoon] State cleared", true);
		}
		catch (Exception ex)
		{
			DebugHelper.Log($"[Cartoon] Error clearing state: {ex.Message}", true);
		}
	}

	private void SetMode(DrawMode mode)
	{
		_currentMode = mode;
		_ = SaveCartoonState(); // Auto-save
		StateHasChanged();
	}

	// On-the-fly interpolation - no pre-generation needed!
	private CartoonFrame InterpolateFrame(int userFrameIndex, int betweenIndex)
	{
		if (_userFrames.Count < 2 || betweenIndex == 0)
			return _userFrames[userFrameIndex].Clone();

		var leftFrame = _userFrames[userFrameIndex];
		var rightFrameIndex = (userFrameIndex + 1) % _userFrames.Count;
		var rightFrame = _userFrames[rightFrameIndex];

		// If either frame is empty, just return the non-empty one (or empty if both are empty)
		if (leftFrame.Lines.Count == 0 && rightFrame.Lines.Count == 0)
			return new CartoonFrame();
		if (leftFrame.Lines.Count == 0)
			return rightFrame.Clone();
		if (rightFrame.Lines.Count == 0)
			return leftFrame.Clone();

		var nBetween = _betweenFrames + 1;
		double t = (double)betweenIndex / nBetween;

		var interpolatedFrame = new CartoonFrame();
		int maxLines = Math.Max(leftFrame.Lines.Count, rightFrame.Lines.Count);

		for (int i = 0; i < maxLines; i++)
		{
			var lineLeft = i < leftFrame.Lines.Count ? leftFrame.Lines[i] : leftFrame.Lines[leftFrame.Lines.Count - 1];
			var lineRight = i < rightFrame.Lines.Count ? rightFrame.Lines[i] : rightFrame.Lines[rightFrame.Lines.Count - 1];

			interpolatedFrame.Lines.Add(new CartoonLine
			{
				Start = new Point(
					lineLeft.Start.X + betweenIndex * (lineRight.Start.X - lineLeft.Start.X) / nBetween,
					lineLeft.Start.Y + betweenIndex * (lineRight.Start.Y - lineLeft.Start.Y) / nBetween
				),
				End = new Point(
					lineLeft.End.X + betweenIndex * (lineRight.End.X - lineLeft.End.X) / nBetween,
					lineLeft.End.Y + betweenIndex * (lineRight.End.Y - lineLeft.End.Y) / nBetween
				),
				Thickness = lineLeft.Thickness + betweenIndex * (lineRight.Thickness - lineLeft.Thickness) / nBetween,
				Color = lineLeft.Color
			});
		}

		return interpolatedFrame;
	}

	private async Task OnPointerDown(EventArgs e)
	{
		if (!_isInitialized || _isPlaying) return;

		double x = 0, y = 0;
		if (e is MouseEventArgs me)
		{
			x = me.OffsetX;
			y = me.OffsetY;
		}
		else if (e is TouchEventArgs te && te.Touches.Length > 0)
		{
			var rect = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>(
		   "eval", "document.getElementById('cartoonCanvas').getBoundingClientRect()");

			// Get touch position relative to canvas
			var touchX = te.Touches[0].ClientX - rect.GetProperty("left").GetDouble();
			var touchY = te.Touches[0].ClientY - rect.GetProperty("top").GetDouble();

			x = touchX;
			y = touchY;
		}

		_isDrawing = true;
		_lastX = x;
		_lastY = y;
	}

	private async Task OnPointerMove(EventArgs e)
	{
		if (!_isInitialized || !_isDrawing) return;

		double x = 0, y = 0;
		if (e is MouseEventArgs me)
		{
			x = me.OffsetX;
			y = me.OffsetY;
		}
		else if (e is TouchEventArgs te && te.Touches.Length > 0)
		{
			await JSRuntime.InvokeVoidAsync("eval", "event.preventDefault()");
			var rect = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>(
  "eval", "document.getElementById('cartoonCanvas').getBoundingClientRect()");

			// Get touch position relative to canvas
			var touchX = te.Touches[0].ClientX - rect.GetProperty("left").GetDouble();
			var touchY = te.Touches[0].ClientY - rect.GetProperty("top").GetDouble();

			x = touchX;
			y = touchY;
		}

		if (_currentMode == DrawMode.Drag)
		{
			var line = new CartoonLine
			{
				Start = new Point(_lastX, _lastY),
				End = new Point(x, y),
				Thickness = _penThickness,
				Color = _penColor
			};
			_userFrames[_currentUserFrameIndex].Lines.Add(line);
			await DrawLine(line);
			_lastX = x;
			_lastY = y;
		}
		else
		{
			await DrawPreviewLine(_lastX, _lastY, x, y);
		}
	}

	private async Task OnPointerUp(EventArgs e)
	{
		if (!_isInitialized || !_isDrawing) return;

		if (_currentMode == DrawMode.Draw)
		{
			double x = 0, y = 0;
			if (e is MouseEventArgs me)
			{
				x = me.OffsetX;
				y = me.OffsetY;
			}
			else if (e is TouchEventArgs te && te.ChangedTouches.Length > 0)
			{
				var rect = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>(
						  "eval", "document.getElementById('cartoonCanvas').getBoundingClientRect()");

				// Get the canvas element's displayed size
				var displayWidth = rect.GetProperty("width").GetDouble();
				var displayHeight = rect.GetProperty("height").GetDouble();

				// Canvas internal size is 1200x800
				const double canvasWidth = 1200;
				const double canvasHeight = 800;

				// Calculate scale ratios
				var scaleX = canvasWidth / displayWidth;
				var scaleY = canvasHeight / displayHeight;

				// Get touch position relative to canvas and scale it
				var touchX = te.ChangedTouches[0].ClientX - rect.GetProperty("left").GetDouble();
				var touchY = te.ChangedTouches[0].ClientY - rect.GetProperty("top").GetDouble();

				x = touchX * scaleX;
				y = touchY * scaleY;
			}

			if (x != 0 || y != 0) // Only add line if we got valid coordinates
			{
				var line = new CartoonLine
				{
					Start = new Point(_lastX, _lastY),
					End = new Point(x, y),
					Thickness = _penThickness,
					Color = _penColor
				};
				_userFrames[_currentUserFrameIndex].Lines.Add(line);
				await RedrawCurrentFrame();
			}
		}

		_isDrawing = false;
		
		// NEW: Auto-save after completing a drawing stroke
		await SaveCartoonState();
	}

	private async Task DrawLine(CartoonLine line)
	{
		await JSRuntime.InvokeVoidAsync("cartoonDrawLine",
			line.Start.X, line.Start.Y, line.End.X, line.End.Y, line.Thickness, line.Color);
	}

	private async Task DrawPreviewLine(double x1, double y1, double x2, double y2)
	{
		await JSRuntime.InvokeVoidAsync("cartoonDrawPreviewLine",
			x1, y1, x2, y2, _penThickness, _penColor);
	}

	private async Task RedrawCurrentFrame()
	{
		if (!_isInitialized) return;
		await JSRuntime.InvokeVoidAsync("cartoonClearCanvas");
		var frame = _userFrames[_currentUserFrameIndex];
		foreach (var line in frame.Lines)
			await DrawLine(line);
		await UpdateThumbnail(_currentUserFrameIndex);
	}

	private async Task DrawFrame(CartoonFrame frame)
	{
		if (!_isInitialized) return;
		await JSRuntime.InvokeVoidAsync("cartoonClearCanvas");
		foreach (var line in frame.Lines)
			await DrawLine(line);
	}

	private async Task UpdateThumbnail(int frameIndex)
	{
		if (!_isInitialized) return;
		try
		{
			await JSRuntime.InvokeVoidAsync("cartoonUpdateThumbnail",
				frameIndex, _userFrames[frameIndex].Lines.ToArray());
		}
		catch { }
	}

	private async Task AddFrame()
	{
		_userFrames.Add(new CartoonFrame());
		_currentUserFrameIndex = _userFrames.Count - 1;
		await RedrawCurrentFrame();
		await SaveCartoonState(); // Auto-save
		StateHasChanged();
	}

	private async Task DeleteCurrentFrame()
	{
		if (_userFrames.Count <= 1) return;
		_userFrames.RemoveAt(_currentUserFrameIndex);
		if (_currentUserFrameIndex >= _userFrames.Count)
			_currentUserFrameIndex = _userFrames.Count - 1;
		await RedrawCurrentFrame();
		await SaveCartoonState(); // Auto-save
		StateHasChanged();
	}

	private async Task ClearCurrentFrame()
	{
		_userFrames[_currentUserFrameIndex].Lines.Clear();
		await RedrawCurrentFrame();
		await SaveCartoonState(); // Auto-save
		StateHasChanged();
	}

	private async Task Reset()
	{
		StopPlayback();
		_userFrames.Clear();
		_userFrames.Add(new CartoonFrame());
		_currentUserFrameIndex = 0;
		await RedrawCurrentFrame();
		await ClearCartoonState(); // Clear saved state on reset
		StateHasChanged();
	}

	private async Task Demo()
	{
		StopPlayback();

		// Get current canvas dimensions from JavaScript
		var canvasDimensions = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>(
			"eval", "(() => { const c = document.getElementById('cartoonCanvas'); return { width: c.width, height: c.height }; })()");
		
		double canvasWidth = canvasDimensions.GetProperty("width").GetDouble();
		double canvasHeight = canvasDimensions.GetProperty("height").GetDouble();
		
		DebugHelper.Log($"[Cartoon] Generating demo for canvas size: {canvasWidth}x{canvasHeight}", true);

		// Clear saved state when loading a demo
		await ClearCartoonState();

		// Cycle through demo types
		var rand = new Random();
		_currentDemoType = (DemoType)(((int)_currentDemoType + 1) % 3);
		
		switch (_currentDemoType)
		{
			case DemoType.Alphabet:
				await GenerateAlphabetDemo(canvasWidth, canvasHeight, rand);
				break;
			case DemoType.Credits:
				await GenerateWordDemo(canvasWidth, canvasHeight, rand, 
					"A Cartoon Animation Program by Calvin Hsia");
				break;
			case DemoType.History:
				await GenerateWordDemo(canvasWidth, canvasHeight, rand, 
					"Demonstrated at Honolulu Academy of Arts in 1984");
				break;
		}

		_currentUserFrameIndex = 0;
		await RedrawCurrentFrame();

		for (int i = 0; i < _userFrames.Count; i++)
			await UpdateThumbnail(i);

		// Auto-play after loading demo
		if (_userFrames.Count >= 2)
		{
			_isPlaying = true;
			StartPlayback();
		}

		// Save demo state (so it persists, but Reset will clear it)
		await SaveCartoonState();

		StateHasChanged();
	}

	private async Task GenerateAlphabetDemo(double canvasWidth, double canvasHeight, Random rand)
	{
		_userFrames.Clear();
		int nFrames = 26; // One frame per letter A-Z
		double centerX = canvasWidth / 2;
		double centerY = canvasHeight / 2;
		double scale = Math.Min(canvasWidth, canvasHeight) * 0.4;

		for (int nFrame = 0; nFrame < nFrames; nFrame++)
		{
			var frame = new CartoonFrame();
			char letter = (char)('A' + nFrame);
			
			// Random position offset for animation variety
			double offsetX = centerX + (rand.NextDouble() - 0.5) * (canvasWidth * 0.2);
			double offsetY = centerY + (rand.NextDouble() - 0.5) * (canvasHeight * 0.2);
			double letterScale = scale * (0.9 + rand.NextDouble() * 0.2);
			
			var lines = GetLetterLines(letter, offsetX, offsetY, letterScale);
			
			foreach (var (start, end) in lines)
			{
				frame.Lines.Add(new CartoonLine
				{
					Start = start,
					End = end,
					Thickness = 8 + rand.NextDouble() * 4,
					Color = $"#{rand.Next(0x1000000):X6}"
				});
			}

			_userFrames.Add(frame);
		}
	}

	private async Task GenerateWordDemo(double canvasWidth, double canvasHeight, Random rand, string sentence)
	{
		_userFrames.Clear();
		var words = sentence.Split(' ', StringSplitOptions.RemoveEmptyEntries);
		
		double scale = Math.Min(canvasWidth, canvasHeight) * 0.15; // Smaller for multiple characters
		
		foreach (var word in words)
		{
			var frame = new CartoonFrame();
			
			// Calculate total width needed for the word
			int charCount = word.Length;
			double charSpacing = scale * 1.2;
			double totalWidth = charCount * charSpacing;
			double startX = (canvasWidth - totalWidth) / 2;
			double centerY = canvasHeight / 2;
			
			// Random color for the whole word
			string wordColor = $"#{rand.Next(0x1000000):X6}";
			
			for (int i = 0; i < word.Length; i++)
			{
				char c = word[i];
				double x = startX + (i + 0.5) * charSpacing;
				double y = centerY + (rand.NextDouble() - 0.5) * (canvasHeight * 0.1); // Slight vertical variation
				
				var lines = GetLetterLines(c, x, y, scale);
				
				foreach (var (start, end) in lines)
				{
					frame.Lines.Add(new CartoonLine
					{
						Start = start,
						End = end,
						Thickness = 6 + rand.NextDouble() * 3,
						Color = wordColor
					});
				}
			}
			
			_userFrames.Add(frame);
		}
	}

	/// <summary>
	/// Called from JavaScript when canvas resize has settled (debounced)
	/// Regenerates demo with new canvas dimensions only if size actually changed
	/// </summary>
	[JSInvokable("RegenerateDemoForNewSize")]
	public static async Task RegenerateDemoForNewSize(double width, double height)
	{
		DebugHelper.Log($"[Cartoon] RegenerateDemoForNewSize called: {width}x{height}", true);
		
		// Only regenerate if size actually changed
		if (Math.Abs(width - _lastDemoWidth) < 10 && Math.Abs(height - _lastDemoHeight) < 10)
		{
			DebugHelper.Log("[Cartoon] Size unchanged, skipping regeneration", true);
			return;
		}
		
		_lastDemoWidth = width;
		_lastDemoHeight = height;
		
		if (_currentInstance != null && _currentInstance._isInitialized)
		{
			DebugHelper.Log("[Cartoon] Regenerating demo with new dimensions", true);
			await _currentInstance.Demo();
		}
		else
		{
			DebugHelper.Log("[Cartoon] No active instance to regenerate demo", true);
		}
	}
	
	private List<(Point start, Point end)> GetLetterLines(char letter, double x, double y, double scale)
	{
		var lines = new List<(Point, Point)>();
		double s = scale / 100.0; // Normalize scale

		// Convert to uppercase for the switch, but preserve original for spacing adjustments
		char upperLetter = char.ToUpper(letter);
		bool isLowerCase = char.IsLower(letter);
		
		// Adjust vertical position for lowercase letters (smaller, sitting on baseline)
		double yOffset = isLowerCase ? y + (15 * s) : y; // Lower position for lowercase
		double heightScale = isLowerCase ? 0.6 : 1.0; // Smaller height for lowercase

		switch (upperLetter)
		{
			case 'A':
				if (isLowerCase)
				{
					// Lowercase 'a' - circular with tail
					lines.Add((new Point(x + 30 * s, yOffset - 20 * s * heightScale), new Point(x + 10 * s, yOffset - 30 * s * heightScale))); // Top left
					lines.Add((new Point(x + 10 * s, yOffset - 30 * s * heightScale), new Point(x - 10 * s, yOffset - 30 * s * heightScale))); // Top
					lines.Add((new Point(x - 10 * s, yOffset - 30 * s * heightScale), new Point(x - 30 * s, yOffset - 10 * s * heightScale))); // Top left curve
					lines.Add((new Point(x - 30 * s, yOffset - 10 * s * heightScale), new Point(x - 30 * s, yOffset + 10 * s * heightScale))); // Left
					lines.Add((new Point(x - 30 * s, yOffset + 10 * s * heightScale), new Point(x - 10 * s, yOffset + 30 * s * heightScale))); // Bottom left
					lines.Add((new Point(x - 10 * s, yOffset + 30 * s * heightScale), new Point(x + 10 * s, yOffset + 30 * s * heightScale))); // Bottom
					lines.Add((new Point(x + 10 * s, yOffset + 30 * s * heightScale), new Point(x + 30 * s, yOffset + 10 * s * heightScale))); // Bottom right
					lines.Add((new Point(x + 30 * s, yOffset + 10 * s * heightScale), new Point(x + 30 * s, yOffset + 30 * s * heightScale))); // Tail down
				}
				else
				{
					// Uppercase 'A'
					lines.Add((new Point(x - 50 * s, y + 50 * s), new Point(x, y - 50 * s))); // Left diagonal
					lines.Add((new Point(x, y - 50 * s), new Point(x + 50 * s, y + 50 * s))); // Right diagonal
					lines.Add((new Point(x - 25 * s, y), new Point(x + 25 * s, y))); // Cross bar
				}
				break;
			case 'B':
				if (isLowerCase)
				{
					// Lowercase 'b' - tall stem with circular bowl
					lines.Add((new Point(x - 30 * s, y - 50 * s), new Point(x - 30 * s, yOffset + 30 * s * heightScale))); // Tall stem
					lines.Add((new Point(x - 30 * s, yOffset - 30 * s * heightScale), new Point(x + 10 * s, yOffset - 30 * s * heightScale))); // Top of bowl
					lines.Add((new Point(x + 10 * s, yOffset - 30 * s * heightScale), new Point(x + 30 * s, yOffset - 10 * s * heightScale))); // Top right curve
					lines.Add((new Point(x + 30 * s, yOffset - 10 * s * heightScale), new Point(x + 30 * s, yOffset + 10 * s * heightScale))); // Right side
					lines.Add((new Point(x + 30 * s, yOffset + 10 * s * heightScale), new Point(x + 10 * s, yOffset + 30 * s * heightScale))); // Bottom right curve
					lines.Add((new Point(x + 10 * s, yOffset + 30 * s * heightScale), new Point(x - 30 * s, yOffset + 30 * s * heightScale))); // Bottom
				}
				else
				{
					// Uppercase 'B'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Vertical
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x + 20 * s, y - 50 * s))); // Top
					lines.Add((new Point(x + 20 * s, y - 50 * s), new Point(x + 40 * s, y - 25 * s))); // Top curve
					lines.Add((new Point(x + 40 * s, y - 25 * s), new Point(x - 40 * s, y))); // To middle
					lines.Add((new Point(x - 40 * s, y), new Point(x + 30 * s, y))); // Middle
					lines.Add((new Point(x + 30 * s, y), new Point(x + 40 * s, y + 25 * s))); // Bottom curve
					lines.Add((new Point(x + 40 * s, y + 25 * s), new Point(x - 40 * s, y + 50 * s))); // To bottom
				}
				break;
			case 'C':
				if (isLowerCase)
				{
					// Lowercase 'c' - simple arc
					lines.Add((new Point(x + 30 * s, yOffset - 20 * s * heightScale), new Point(x, yOffset - 30 * s * heightScale))); // Top
					lines.Add((new Point(x, yOffset - 30 * s * heightScale), new Point(x - 30 * s, yOffset))); // Top left curve
					lines.Add((new Point(x - 30 * s, yOffset), new Point(x, yOffset + 30 * s * heightScale))); // Bottom left curve
					lines.Add((new Point(x, yOffset + 30 * s * heightScale), new Point(x + 30 * s, yOffset + 20 * s * heightScale))); // Bottom
				}
				else
				{
					// Uppercase 'C'
					lines.Add((new Point(x + 40 * s, y - 40 * s), new Point(x - 20 * s, y - 40 * s))); // Top
					lines.Add((new Point(x - 20 * s, y - 40 * s), new Point(x - 40 * s, y - 20 * s))); // Top curve
					lines.Add((new Point(x - 40 * s, y - 20 * s), new Point(x - 40 * s, y + 20 * s))); // Left
					lines.Add((new Point(x - 40 * s, y + 20 * s), new Point(x - 20 * s, y + 40 * s))); // Bottom curve
					lines.Add((new Point(x - 20 * s, y + 40 * s), new Point(x + 40 * s, y + 40 * s))); // Bottom
				}
				break;
			case 'D':
				if (isLowerCase)
				{
					// Lowercase 'd' - circular bowl with tall stem on right
					lines.Add((new Point(x + 30 * s, y - 50 * s), new Point(x + 30 * s, yOffset + 30 * s * heightScale))); // Tall stem
					lines.Add((new Point(x - 10 * s, yOffset - 30 * s * heightScale), new Point(x + 30 * s, yOffset - 30 * s * heightScale))); // Top
					lines.Add((new Point(x - 10 * s, yOffset - 30 * s * heightScale), new Point(x - 30 * s, yOffset - 10 * s * heightScale))); // Top left curve
					lines.Add((new Point(x - 30 * s, yOffset - 10 * s * heightScale), new Point(x - 30 * s, yOffset + 10 * s * heightScale))); // Left
					lines.Add((new Point(x - 30 * s, yOffset + 10 * s * heightScale), new Point(x - 10 * s, yOffset + 30 * s * heightScale))); // Bottom left curve
					lines.Add((new Point(x - 10 * s, yOffset + 30 * s * heightScale), new Point(x + 30 * s, yOffset + 30 * s * heightScale))); // Bottom
				}
				else
				{
					// Uppercase 'D'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Vertical
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x + 20 * s, y - 50 * s))); // Top
					lines.Add((new Point(x + 20 * s, y - 50 * s), new Point(x + 40 * s, y - 20 * s))); // Top curve
					lines.Add((new Point(x + 40 * s, y - 20 * s), new Point(x + 40 * s, y + 20 * s))); // Right
					lines.Add((new Point(x + 40 * s, y + 20 * s), new Point(x + 20 * s, y + 50 * s))); // Bottom curve
					lines.Add((new Point(x + 20 * s, y + 50 * s), new Point(x - 40 * s, y + 50 * s))); // Bottom
				}
				break;
			case 'E':
				if (isLowerCase)
				{
					// Lowercase 'e' - circular with horizontal bar
					lines.Add((new Point(x - 30 * s, yOffset), new Point(x + 30 * s, yOffset))); // Horizontal bar
					lines.Add((new Point(x + 30 * s, yOffset), new Point(x + 20 * s, yOffset - 30 * s * heightScale))); // Top right
					lines.Add((new Point(x + 20 * s, yOffset - 30 * s * heightScale), new Point(x - 10 * s, yOffset - 30 * s * heightScale))); // Top
					lines.Add((new Point(x - 10 * s, yOffset - 30 * s * heightScale), new Point(x - 30 * s, yOffset - 10 * s * heightScale))); // Top left
					lines.Add((new Point(x - 30 * s, yOffset - 10 * s * heightScale), new Point(x - 30 * s, yOffset + 10 * s * heightScale))); // Left
					lines.Add((new Point(x - 30 * s, yOffset + 10 * s * heightScale), new Point(x - 10 * s, yOffset + 30 * s * heightScale))); // Bottom left
					lines.Add((new Point(x - 10 * s, yOffset + 30 * s * heightScale), new Point(x + 20 * s, yOffset + 30 * s * heightScale))); // Bottom
					lines.Add((new Point(x + 20 * s, yOffset + 30 * s * heightScale), new Point(x + 30 * s, yOffset + 20 * s * heightScale))); // Bottom right
				}
				else
				{
					// Uppercase 'E'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Vertical
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x + 40 * s, y - 50 * s))); // Top
					lines.Add((new Point(x - 40 * s, y), new Point(x + 30 * s, y))); // Middle
					lines.Add((new Point(x - 40 * s, y + 50 * s), new Point(x + 40 * s, y + 50 * s))); // Bottom
				}
				break;
			case 'F':
				if (isLowerCase)
				{
					// Lowercase 'f' - hook at top with crossbar
					lines.Add((new Point(x + 10 * s, y - 50 * s), new Point(x - 10 * s, y - 50 * s))); // Top hook
					lines.Add((new Point(x - 10 * s, y - 50 * s), new Point(x - 20 * s, y - 40 * s))); // Hook curve
					lines.Add((new Point(x - 20 * s, y - 40 * s), new Point(x - 20 * s, yOffset + 30 * s * heightScale))); // Stem
					lines.Add((new Point(x - 35 * s, yOffset - 10 * s * heightScale), new Point(x + 5 * s, yOffset - 10 * s * heightScale))); // Crossbar
				}
				else
				{
					// Uppercase 'F'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Vertical
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x + 40 * s, y - 50 * s))); // Top
					lines.Add((new Point(x - 40 * s, y), new Point(x + 30 * s, y))); // Middle
				}
				break;
			case 'G':
				if (isLowerCase)
				{
					// Lowercase 'g' - circular bowl with descender
					lines.Add((new Point(x + 30 * s, yOffset - 30 * s * heightScale), new Point(x + 10 * s, yOffset - 30 * s * heightScale))); // Top
					lines.Add((new Point(x + 10 * s, yOffset - 30 * s * heightScale), new Point(x - 10 * s, yOffset - 20 * s * heightScale))); // Top left
					lines.Add((new Point(x - 10 * s, yOffset - 20 * s * heightScale), new Point(x - 30 * s, yOffset))); // Left top curve
					lines.Add((new Point(x - 30 * s, yOffset), new Point(x - 10 * s, yOffset + 20 * s * heightScale))); // Left bottom curve
					lines.Add((new Point(x - 10 * s, yOffset + 20 * s * heightScale), new Point(x + 10 * s, yOffset + 30 * s * heightScale))); // Bottom
					lines.Add((new Point(x + 10 * s, yOffset + 30 * s * heightScale), new Point(x + 30 * s, yOffset + 10 * s * heightScale))); // Bottom right curve
					lines.Add((new Point(x + 30 * s, yOffset + 10 * s * heightScale), new Point(x + 30 * s, y + 40 * s))); // Descender down
					lines.Add((new Point(x + 30 * s, y + 40 * s), new Point(x + 10 * s, y + 50 * s))); // Descender curve
					lines.Add((new Point(x + 10 * s, y + 50 * s), new Point(x - 10 * s, y + 50 * s))); // Descender bottom
				}
				else
				{
					// Uppercase 'G'
					lines.Add((new Point(x + 40 * s, y - 40 * s), new Point(x - 20 * s, y - 40 * s))); // Top
					lines.Add((new Point(x - 20 * s, y - 40 * s), new Point(x - 40 * s, y - 20 * s))); // Top curve
					lines.Add((new Point(x - 40 * s, y - 20 * s), new Point(x - 40 * s, y + 20 * s))); // Left
					lines.Add((new Point(x - 40 * s, y + 20 * s), new Point(x - 20 * s, y + 40 * s))); // Bottom curve
					lines.Add((new Point(x - 20 * s, y + 40 * s), new Point(x + 40 * s, y + 40 * s))); // Bottom
					lines.Add((new Point(x + 40 * s, y + 40 * s), new Point(x + 40 * s, y))); // Right
					lines.Add((new Point(x + 40 * s, y), new Point(x + 10 * s, y))); // Middle bar
				}
				break;
			case 'H':
				if (isLowerCase)
				{
					// Lowercase 'h' - tall stem with right hump
					lines.Add((new Point(x - 30 * s, y - 50 * s), new Point(x - 30 * s, yOffset + 30 * s * heightScale))); // Tall stem
					lines.Add((new Point(x - 30 * s, yOffset - 20 * s * heightScale), new Point(x, yOffset - 30 * s * heightScale))); // Top of hump
					lines.Add((new Point(x, yOffset - 30 * s * heightScale), new Point(x + 30 * s, yOffset - 10 * s * heightScale))); // Curve
					lines.Add((new Point(x + 30 * s, yOffset - 10 * s * heightScale), new Point(x + 30 * s, yOffset + 30 * s * heightScale))); // Right stem
				}
				else
				{
					// Uppercase 'H'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Left vertical
					lines.Add((new Point(x + 40 * s, y - 50 * s), new Point(x + 40 * s, y + 50 * s))); // Right vertical
					lines.Add((new Point(x - 40 * s, y), new Point(x + 40 * s, y))); // Cross bar
				}
				break;
			case 'I':
				if (isLowerCase)
				{
					// Lowercase 'i' - short stem with dot
					lines.Add((new Point(x, yOffset - 30 * s * heightScale), new Point(x, yOffset + 30 * s * heightScale))); // Stem
					lines.Add((new Point(x - 5 * s, y - 45 * s), new Point(x + 5 * s, y - 45 * s))); // Dot top
					lines.Add((new Point(x + 5 * s, y - 45 * s), new Point(x + 5 * s, y - 55 * s))); // Dot right
					lines.Add((new Point(x + 5 * s, y - 55 * s), new Point(x - 5 * s, y - 55 * s))); // Dot bottom
					lines.Add((new Point(x - 5 * s, y - 55 * s), new Point(x - 5 * s, y - 45 * s))); // Dot left
				}
				else
				{
					// Uppercase 'I'
					lines.Add((new Point(x, y - 50 * s), new Point(x, y + 50 * s))); // Vertical
					lines.Add((new Point(x - 30 * s, y - 50 * s), new Point(x + 30 * s, y - 50 * s))); // Top
					lines.Add((new Point(x - 30 * s, y + 50 * s), new Point(x + 30 * s, y + 50 * s))); // Bottom
				}
				break;
			case 'J':
				if (isLowerCase)
				{
					// Lowercase 'j' - stem with descender and dot
					lines.Add((new Point(x, yOffset - 30 * s * heightScale), new Point(x, y + 40 * s))); // Stem with descender
					lines.Add((new Point(x, y + 40 * s), new Point(x - 10 * s, y + 50 * s))); // Descender curve
					lines.Add((new Point(x - 10 * s, y + 50 * s), new Point(x - 20 * s, y + 50 * s))); // Descender bottom
					lines.Add((new Point(x - 5 * s, y - 45 * s), new Point(x + 5 * s, y - 45 * s))); // Dot top
					lines.Add((new Point(x + 5 * s, y - 45 * s), new Point(x + 5 * s, y - 55 * s))); // Dot right
					lines.Add((new Point(x + 5 * s, y - 55 * s), new Point(x - 5 * s, y - 55 * s))); // Dot bottom
					lines.Add((new Point(x - 5 * s, y - 55 * s), new Point(x - 5 * s, y - 45 * s))); // Dot left
				}
				else
				{
					// Uppercase 'J'
					lines.Add((new Point(x + 30 * s, y - 50 * s), new Point(x + 30 * s, y + 30 * s))); // Vertical
					lines.Add((new Point(x + 30 * s, y + 30 * s), new Point(x + 10 * s, y + 50 * s))); // Bottom curve
					lines.Add((new Point(x + 10 * s, y + 50 * s), new Point(x - 20 * s, y + 50 * s))); // Bottom
					lines.Add((new Point(x - 20 * s, y + 50 * s), new Point(x - 40 * s, y + 30 * s))); // Bottom left curve
				}
				break;
			case 'K':
				if (isLowerCase)
				{
					// Lowercase 'k' - tall stem with angled arm and leg
					lines.Add((new Point(x - 30 * s, y - 50 * s), new Point(x - 30 * s, yOffset + 30 * s * heightScale))); // Tall stem
					lines.Add((new Point(x + 30 * s, yOffset - 30 * s * heightScale), new Point(x - 30 * s, yOffset))); // Top diagonal to middle
					lines.Add((new Point(x - 30 * s, yOffset), new Point(x + 30 * s, yOffset + 30 * s * heightScale))); // Bottom diagonal from middle
				}
				else
				{
					// Uppercase 'K'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Vertical
					lines.Add((new Point(x + 40 * s, y - 50 * s), new Point(x - 40 * s, y))); // Top diagonal
					lines.Add((new Point(x - 40 * s, y), new Point(x + 40 * s, y + 50 * s))); // Bottom diagonal
				}
				break;
			case 'L':
				if (isLowerCase)
				{
					// Lowercase 'l' - simple tall stem
					lines.Add((new Point(x, y - 50 * s), new Point(x, yOffset + 30 * s * heightScale))); // Tall stem
				}
				else
				{
					// Uppercase 'L'
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x - 40 * s, y + 50 * s))); // Vertical
					lines.Add((new Point(x - 40 * s, y + 50 * s), new Point(x + 40 * s, y + 50 * s))); // Bottom
				}
				break;
			case 'M':
				if (isLowerCase)
				{
					// Lowercase 'm' - three humps
					lines.Add((new Point(x - 40 * s, yOffset + 30 * s * heightScale), new Point(x - 40 * s, yOffset - 30 * s * heightScale))); // Left stem
					lines.Add((new Point(x - 40 * s, yOffset - 20 * s * heightScale), new Point(x - 20 * s, yOffset - 30 * s * heightScale))); // First hump top
					lines.Add((new Point(x - 20 * s, yOffset - 30 * s * heightScale), new Point(x - 10 * s, yOffset - 20 * s * heightScale))); // First hump curve
					lines.Add((new Point(x - 10 * s, yOffset - 20 * s * heightScale), new Point(x - 10 * s, yOffset + 30 * s * heightScale))); // First middle stem
					lines.Add((new Point(x - 10 * s, yOffset - 20 * s * heightScale), new Point(x + 10 * s, yOffset - 30 * s * heightScale))); // Second hump top
					lines.Add((new Point(x + 10 * s, yOffset - 30 * s * heightScale), new Point(x + 20 * s, yOffset - 20 * s * heightScale))); // Second hump curve
					lines.Add((new Point(x + 20 * s, yOffset - 20 * s * heightScale), new Point(x + 20 * s, yOffset + 30 * s * heightScale))); // Second middle stem
					lines.Add((new Point(x + 20 * s, yOffset - 20 * s * heightScale), new Point(x + 35 * s, yOffset - 30 * s * heightScale))); // Third hump top
					lines.Add((new Point(x + 35 * s, yOffset - 30 * s * heightScale), new Point(x + 45 * s, yOffset - 10 * s * heightScale))); // Third hump curve
					lines.Add((new Point(x + 45 * s, yOffset - 10 * s * heightScale), new Point(x + 45 * s, yOffset + 30 * s * heightScale))); // Right stem
				}
				else
				{
					// Uppercase 'M'
					lines.Add((new Point(x - 50 * s, y + 50 * s), new Point(x - 50 * s, y - 50 * s))); // Left vertical
					lines.Add((new Point(x - 50 * s, y - 50 * s), new Point(x, y))); // Left diagonal
					lines.Add((new Point(x, y), new Point(x + 50 * s, y - 50 * s))); // Right diagonal
					lines.Add((new Point(x + 50 * s, y - 50 * s), new Point(x + 50 * s, y + 50 * s))); // Right vertical
				}
				break;
			case 'N':
				if (isLowerCase)
				{
					// Lowercase 'n' - hump like 'h' but shorter
					lines.Add((new Point(x - 30 * s, yOffset - 30 * s * heightScale), new Point(x - 30 * s, yOffset + 30 * s * heightScale))); // Left stem
					lines.Add((new Point(x - 30 * s, yOffset - 20 * s * heightScale), new Point(x, yOffset - 30 * s * heightScale))); // Top of hump
					lines.Add((new Point(x, yOffset - 30 * s * heightScale), new Point(x + 30 * s, yOffset - 10 * s * heightScale))); // Curve
					lines.Add((new Point(x + 30 * s, yOffset - 10 * s * heightScale), new Point(x + 30 * s, yOffset + 30 * s * heightScale))); // Right stem
				}
				else
				{
					// Uppercase 'N'
					lines.Add((new Point(x - 40 * s, y + 50 * s), new Point(x - 40 * s, y - 50 * s))); // Left vertical
					lines.Add((new Point(x - 40 * s, y - 50 * s), new Point(x + 40 * s, y + 50 * s))); // Diagonal
					lines.Add((new Point(x + 40 * s, y + 50 * s), new Point(x + 40 * s, y - 50 * s))); // Right vertical
				}
				break;
			case 'O':
				if (isLowerCase)
				{
