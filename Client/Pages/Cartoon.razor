				lines.Add((new Point(x + 35 * s, y - 35 * s), new Point(x + 30 * s, y - 15 * s))); // Right upper
				lines.Add((new Point(x + 30 * s, y - 15 * s), new Point(x, y))); // To center
				lines.Add((new Point(x, y), new Point(x + 35 * s, y + 15 * s))); // From center right
				lines.Add((new Point(x + 35 * s, y + 15 * s), new Point(x + 40 * s, y + 30 * s))); // Right lower
				lines.Add((new Point(x + 40 * s, y + 30 * s), new Point(x + 20 * s, y + 50 * s))); // Bottom right
				lines.Add((new Point(x + 20 * s, y + 50 * s), new Point(x - 20 * s, y + 50 * s))); // Bottom
				lines.Add((new Point(x - 20 * s, y + 50 * s), new Point(x - 40 * s, y + 30 * s))); // Bottom left
				lines.Add((new Point(x - 40 * s, y + 30 * s), new Point(x - 35 * s, y + 15 * s))); // Left lower
				lines.Add((new Point(x - 35 * s, y + 15 * s), new Point(x, y))); // To center left
				lines.Add((new Point(x, y), new Point(x - 30 * s, y - 15 * s))); // From center left
				lines.Add((new Point(x - 30 * s, y - 15 * s), new Point(x - 35 * s, y - 35 * s))); // Left upper
				lines.Add((new Point(x - 35 * s, y - 35 * s), new Point(x - 20 * s, y - 50 * s))); // Top left
				break;
			case '9':
				lines.Add((new Point(x + 40 * s, y - 20 * s), new Point(x + 40 * s, y + 20 * s))); // Right
				lines.Add((new Point(x + 40 * s, y + 20 * s), new Point(x + 10 * s, y + 50 * s))); // Bottom right
				lines.Add((new Point(x + 10 * s, y + 50 * s), new Point(x - 30 * s, y + 40 * s))); // Bottom
				lines.Add((new Point(x + 40 * s, y - 20 * s), new Point(x + 20 * s, y - 40 * s))); // Top right
				lines.Add((new Point(x + 20 * s, y - 40 * s), new Point(x - 20 * s, y - 40 * s))); // Top
				lines.Add((new Point(x - 20 * s, y - 40 * s), new Point(x - 40 * s, y - 20 * s))); // Top left
				lines.Add((new Point(x - 40 * s, y - 20 * s), new Point(x - 40 * s, y))); // Left
				lines.Add((new Point(x - 40 * s, y), new Point(x - 20 * s, y + 10 * s))); // Lower curve
				lines.Add((new Point(x - 20 * s, y + 10 * s), new Point(x + 40 * s, y + 10 * s))); // Middle horizontal
				break;
		}

		return lines;
	}

	private async Task SelectFrame(int frameIndex)
	{
		if (_isPlaying) return;
		_currentUserFrameIndex = frameIndex;
		await RedrawCurrentFrame();
		await SaveCartoonState(); // Auto-save frame selection
	}

	private async Task TogglePlayback()
	{
		_isPlaying = !_isPlaying;
		if (_isPlaying)
			StartPlayback();
		else
			StopPlayback();
		StateHasChanged();
	}

	private void StartPlayback()
	{
		_playbackTimer?.Dispose();
		_currentPlaybackUserFrameIndex = 0;
		_currentBetweenIndex = 1; // Start at first interpolated frame

		_playbackTimer = new System.Threading.Timer(async _ =>
		{
			await InvokeAsync(async () =>
			{
				// Generate frame on-the-fly!
				var frame = InterpolateFrame(_currentPlaybackUserFrameIndex, _currentBetweenIndex);
				await DrawFrame(frame);

				_currentBetweenIndex++;
				if (_currentBetweenIndex > _betweenFrames)
				{
					_currentBetweenIndex = 0;
					_currentPlaybackUserFrameIndex++;
					if (_currentPlaybackUserFrameIndex >= _userFrames.Count)
						_currentPlaybackUserFrameIndex = 0;
				}

				StateHasChanged();
			});
		}, null, 0, _frameDelay);
	}

	private void StopPlayback()
	{
		_playbackTimer?.Dispose();
		_playbackTimer = null;
		_isPlaying = false;
	}

	public void Dispose()
	{
		StopPlayback();
		
		// Save final state on dispose
		if (_isInitialized && _userFrames.Count > 0)
		{
			_ = Task.Run(async () =>
			{
				try
				{
					await SaveCartoonState();
				}
				catch (Exception ex)
				{
					DebugHelper.Log($"[Cartoon] Error saving state on dispose: {ex.Message}", true);
				}
			});
		}
	}
}
