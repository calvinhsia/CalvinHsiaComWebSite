				lines.Add((new Point(x + 40 * scale, y + 20 * scale), new Point(x + 10 * scale, y + 50 * scale))); // Bottom right
				lines.Add((new Point(x + 10 * scale, y + 50 * scale), new Point(x - 30 * scale, y + 40 * scale))); // Bottom
				lines.Add((new Point(x + 40 * scale, y - 20 * scale), new Point(x + 20 * scale, y - 40 * scale))); // Top right
				lines.Add((new Point(x + 20 * scale, y - 40 * scale), new Point(x - 20 * scale, y - 40 * scale))); // Top
				lines.Add((new Point(x - 20 * scale, y - 40 * scale), new Point(x - 40 * scale, y - 20 * scale))); // Top left
				lines.Add((new Point(x - 40 * scale, y - 20 * scale), new Point(x - 40 * scale, y))); // Left
				lines.Add((new Point(x - 40 * scale, y), new Point(x - 20 * scale, y + 10 * scale))); // Lower curve
				lines.Add((new Point(x - 20 * scale, y + 10 * scale), new Point(x + 40 * scale, y + 10 * scale))); // Middle horizontal
				break;
		}

		return lines;
	}

	private async Task SelectFrame(int frameIndex)
	{
		if (_isPlaying) return;
		_currentUserFrameIndex = frameIndex;
		await RedrawCurrentFrame();
		await SaveCartoonState(); // Auto-save frame selection
	}

	private async Task TogglePlayback()
	{
		_isPlaying = !_isPlaying;
		if (_isPlaying)
			StartPlayback();
		else
			StopPlayback();
		StateHasChanged();
	}

	private void StartPlayback()
	{
		_playbackTimer?.Dispose();
		_currentPlaybackUserFrameIndex = 0;
		_currentBetweenIndex = 1; // Start at first interpolated frame

		_playbackTimer = new System.Threading.Timer(async _ =>
		{
			await InvokeAsync(async () =>
			{
				// Generate frame on-the-fly!
				var frame = InterpolateFrame(_currentPlaybackUserFrameIndex, _currentBetweenIndex);
				await DrawFrame(frame);

				_currentBetweenIndex++;
				if (_currentBetweenIndex > _betweenFrames)
				{
					_currentBetweenIndex = 0;
					_currentPlaybackUserFrameIndex++;
					if (_currentPlaybackUserFrameIndex >= _userFrames.Count)
						_currentPlaybackUserFrameIndex = 0;
				}

				StateHasChanged();
			});
		}, null, 0, _frameDelay);
	}

	private void StopPlayback()
	{
		_playbackTimer?.Dispose();
		_playbackTimer = null;
		_isPlaying = false;
	}

	public void Dispose()
	{
		StopPlayback();

		// Save final state on dispose
		if (_isInitialized && _userFrames.Count > 0)
		{
			_ = Task.Run(async () =>
			{
				try
				{
					await SaveCartoonState();
				}
				catch (Exception ex)
				{
					DebugHelper.Log($"[Cartoon] Error saving state on dispose: {ex.Message}", true);
				}
			});
		}
	}
}
