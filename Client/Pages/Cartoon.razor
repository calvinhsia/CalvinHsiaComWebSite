					lines.Add((new Point(x - 40 * scale, y + 20 * scale), new Point(x - 40 * scale, y - 20 * scale))); // Left
					lines.Add((new Point(x - 40 * scale, y - 20 * scale), new Point(x - 20 * scale, y - 40 * scale))); // Top left
				}
				break;
			case 'P':
				if (isLowerCase)
				{
					// Lowercase 'p' - bowl on top with descender
