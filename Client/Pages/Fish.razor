@page "/fish"
@using Microsoft.AspNetCore.Authorization
@using WordScapeBlazorWasm.Services
@using WordScapeBlazorWasm.Games.Fish
@inject IJSRuntime JSRuntime
@inject DebugHelper DebugHelper
@inject RandomService RandomService
@implements IDisposable
@attribute [AllowAnonymous]

<PageTitle>Fish vs Sharks - Cellular Automata</PageTitle>

<div class="fish-container">
	<!-- Top Controls -->
	<div class="fish-controls-top" style="display: flex; flex-wrap: wrap; align-items: center; gap:8px;">
		<div class="fish-action-buttons" style="display: flex; gap:4px; align-items: center;">
			<button @onclick="TogglePause" class="btn-sm" style="padding:2px8px; min-width:0; font-size:0.95em;" title="Pause/Resume">@(_isPaused ? "▶ Resume" : "⏸ Pause")</button>
			<button @onclick="Reset" class="btn-sm" style="padding:2px8px; min-width:0; font-size:0.95em;" title="Reset simulation">🔄 Reset</button>
			<button @onclick="ExportData" class="btn-sm" style="padding:2px8px; min-width:0; font-size:0.95em;" title="Export data to CSV">💾 Export</button>
			<button @onclick="ToggleAddSharkMode" class="btn-sm" style="padding:2px8px; min-width:0; font-size:0.95em;" title="Switch add mode">@(_addSharkMode ? "🦈 Add Shark" : "🐟 Add Fish")</button>
		</div>

		<div class="fish-stats compact">
			<label style="min-width:70px;">Gen<span style="display: inline-block; min-width:35px; text-align: right;">@_generation</span></label>
			<label style="min-width:90px;">Cells/s <span style="display: inline-block; min-width:35px; text-align: right;">@((_cellsPerSecond /1000).ToString("F0"))K</span></label>
			<label style="min-width:70px;"><span class="legend-fish"></span> Fish <span style="display: inline-block; min-width:30px; text-align: right;">@_fishCount</span></label>
			<label style="min-width:80px;"><span class="legend-shark"></span> Sharks <span style="display: inline-block; min-width:30px; text-align: right;">@_sharkCount</span></label>
		</div>
	</div>

	<!-- Canvas Area -->
	<div class="fish-canvas-section">
		<canvas id="fishCanvas" class="fish-canvas"
				@onmousedown="OnCanvasMouseDown"
				@onmousemove="OnCanvasMouseMove"
				@onmouseup="OnCanvasMouseUp">
		</canvas>
	</div>

	<!-- Bottom Controls -->
	<div class="fish-controls-bottom">
		<div class="fish-control-column">
			<h4>Display</h4>
			<label>
				<input type="checkbox" @bind="_useCircles" />
				<span>Circles</span>
			</label>
			<label>
				<input type="checkbox" @bind="_torus" />
				<span>Torus (wrap edges)</span>
			</label>
			<label title="Cell width">
				<span>Cell W:</span>
				<input type="number" min="2" max="20" step="1" @bind="_cellWidth" style="width: 60px;" />
				<span style="margin-left: 5px;">(@_cols cols)</span>
			</label>
			<label title="Cell height">
				<span>Cell H:</span>
				<input type="number" min="2" max="20" step="1" @bind="_cellHeight" style="width: 60px;" />
				<span style="margin-left: 5px;">(@_rows rows)</span>
			</label>
			<label title="Total cells">
				<span>Total:</span>
				<span style="margin-left:5px;">@((_rows * _cols).ToString("N0")) cells</span>
			</label>
			<label title="Color age gradient">
				<span>Age Color:</span>
				<input type="number" min="0" max="10" step="1" @bind="_colorAgeGradient" style="width: 60px;" />
			</label>
		</div>

		<div class="fish-control-column">
			<h4>Rules</h4>
			<label>
				<input type="checkbox" @bind="_oneActionPerYear" />
				<span>One Action/Year</span>
			</label>
			<label title="Shark starvation time">
				<span>Shark Starve:</span>
				<input type="number" min="1" max="50" step="1" @bind="_sharkStarve" style="width: 60px;" />
			</label>
			<label title="Delay between generations (milliseconds)">
				<span>Delay (ms):</span>
				<input type="range" min="0" max="1000" step="10" @bind="DelayMs" @bind:event="oninput" style="width: 100px;" />
				<span class="val">@DelayMs</span>
			</label>
		</div>

		<div class="fish-control-column">
			<h4>Fish</h4>
			<label title="Fish breeding age">
				<span>Breed Age:</span>
				<input type="number" min="1" max="50" step="1" @bind="_fishBreedAge" style="width: 60px;" />
			</label>
			<label title="Fish life span">
				<span>Life Span:</span>
				<input type="number" min="1" max="100" step="1" @bind="_fishLifeLength" style="width: 60px;" />
			</label>
		</div>

		<div class="fish-control-column">
			<h4>Sharks</h4>
			<label title="Shark breeding age">
				<span>Breed Age:</span>
				<input type="number" min="1" max="50" step="1" @bind="_sharkBreedAge" style="width: 60px;" />
			</label>
			<label title="Shark life span">
				<span>Life Span:</span>
				<input type="number" min="1" max="100" step="1" @bind="_sharkLifeLength" style="width: 60px;" />
			</label>
		</div>
	</div>

	<div class="fish-info">
		<p><strong>Fish vs Sharks Cellular Automata</strong> - Based on A.K. Dewdney's Wator article, December1984 Scientific American</p>
		<p>🐟 Left-click to add fish | 🦈 Right-click to add sharks | <strong>On touch: use Add Fish/Add Shark button</strong></p>
	</div>

	<FishInstructions />
</div>

@code {
	private enum CellType { Empty, Fish, Shark }

	private class Cell
	{
		public CellType Type { get; set; }
		public int Age { get; set; }
		public int LastMeal { get; set; }
		public int LastAction { get; set; }
		public int LastBirth { get; set; }
		public bool ProcessedThisGeneration { get; set; }
	}

	private Cell[,] _cells = null!;
	private int _rows;
	private int _cols;
	private int _generation = 0;
	private int _fishCount = 0;
	private int _sharkCount = 0;
	private double _generationsPerSecond = 0;
	private double _cellsPerSecond = 0;

	// Display settings
	private bool _useCircles = false;
	private bool _torus = true;
	private int _cellWidth = 3;
	private int _cellHeight = 3;
	private int _colorAgeGradient = 1;

	// Rule settings
	private bool _oneActionPerYear = false;
	private int _sharkStarve = 6;
	private int _delayMs = 0; // delay between generations in milliseconds

	private int DelayMs
	{
		get => _delayMs;
		set
		{
			if (_delayMs != value)
			{
				_delayMs = value;
				// Restart timer with new delay if currently running
				if (!_isPaused && _animationTimer != null)
				{
					StartAnimation();
				}
			}
		}
	}

	// Fish settings
	private int _fishBreedAge = 3;
	private int _fishLifeLength = 22;
	private int _fishInitPct = 10;

	// Shark settings
	private int _sharkBreedAge = 10;
	private int _sharkLifeLength = 20;
	private int _sharkInitPct = 10;

	private bool _isPaused = true;
	private bool _isInitialized = false;
	private System.Threading.Timer? _animationTimer;
	private Random _random = null!;
	private List<string> _csvData = new();
	private DateTime _lastGenerationTime = DateTime.UtcNow;
	private int _generationsSinceLastUpdate = 0;

	// NEW: Dynamic canvas dimensions (replace hardcoded constants)
	private double _canvasWidth = 1200;
	private double _canvasHeight = 800;
	private DotNetObjectReference<Fish>? _dotNetRef;

	private bool _isMouseDown = false;
	private bool _isRightClick = false;

	// NEW: Flag to track if the first resize after load has been handled
	private bool _firstResizeHandled = false;

	private static readonly int[] _directions = { 0, 1, 2, 3 }; // Reused directions array
	private static readonly Random _shuffleRandom = new(); // For direction shuffling

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			DebugHelper.Log("[Fish] OnAfterRenderAsync - First render starting", true);

			_random = RandomService.GetRandom();
			DebugHelper.Log($"[Fish] {RandomService.GetStateDescription()}", true);

			// Create DotNet reference for JS callbacks
			_dotNetRef = DotNetObjectReference.Create(this);

			await JSRuntime.InvokeVoidAsync("initFishCanvas", "fishCanvas", _canvasWidth, _canvasHeight);
			_isInitialized = true;

			DebugHelper.Log("[Fish] Canvas initialized, setting up resize listener", true);

			// Set the component reference using dedicated helper function
			await JSRuntime.InvokeVoidAsync("setFishComponentRef", _dotNetRef);

			// Set up resize listener
			await JSRuntime.InvokeVoidAsync("setupFishResize");

			DebugHelper.Log("[Fish] Resize setup complete", true);

			// Force a resize to fill extra area on initial load
			await JSRuntime.InvokeVoidAsync("resizeFishCanvas", false);

			await InitializeWorld();

			DebugHelper.Log("[Fish] Initialization complete", true);
			// Auto-start removed from here
			StateHasChanged();
		}
	}

	// NEW: Called by JavaScript when canvas resizes
	[JSInvokable]
	public async Task OnCanvasResized(double width, double height)
	{
		DebugHelper.Log($"[Fish] Canvas resized to {width}x{height}", true);

		bool wasPaused = _isPaused;
		_isPaused = true; // Pause during resize

		_canvasWidth = width;
		_canvasHeight = height;

		// Reinitialize world with new dimensions
		await InitializeWorld();
		await RenderFrame();

		// Auto-start only on first resize after load
		if (!_firstResizeHandled)
		{
			_firstResizeHandled = true;
			_isPaused = false;
			StartAnimation();
		}
		else
		{
			_isPaused = wasPaused; // Restore pause state
			if (!_isPaused && _animationTimer == null)
			{
				StartAnimation();
			}
		}

		await InvokeAsync(StateHasChanged);
	}

	private int _cellCount; // Cached cell count

	private async ValueTask InitializeWorld()
	{
		_generation = 0;
		_fishCount = 0;
		_sharkCount = 0;
		_csvData.Clear();
		_csvData.Add("Generation,Fish,Sharks");

		// Use dynamic canvas dimensions
		_rows = (int)(_canvasHeight / _cellHeight);
		_cols = (int)(_canvasWidth / _cellWidth);
		_cellCount = _rows * _cols;
		_cells = new Cell[_rows, _cols];

		for (int row = 0; row < _rows; row++)
		{
			for (int col = 0; col < _cols; col++)
			{
				_cells[row, col] = new Cell { Type = CellType.Empty };

				var rand = _random.Next(100);
				if (rand < _fishInitPct)
				{
					_cells[row, col].Type = CellType.Fish;
					_cells[row, col].Age = 0;
					_fishCount++;
				}
				else if (rand < _fishInitPct + _sharkInitPct)
				{
					_cells[row, col].Type = CellType.Shark;
					_cells[row, col].Age = 0;
					_cells[row, col].LastMeal = _generation;
					_sharkCount++;
				}
			}
		}

		DebugHelper.Log($"[Fish] Initialized {_rows}x{_cols} world ({_canvasWidth}x{_canvasHeight} canvas) with {_fishCount} fish and {_sharkCount} sharks", true);

		await ValueTask.CompletedTask; // Make method async
	}

	private void StartAnimation()
	{
		_animationTimer?.Dispose(); // Always dispose previous timer
		_lastGenerationTime = DateTime.UtcNow;
		_generationsSinceLastUpdate = 0;
		_generationsPerSecond = 0;
		_cellsPerSecond = 0;

		_animationTimer = new System.Threading.Timer(async _ =>
		{
			if (!_isPaused && _isInitialized)
			{
				DoGeneration();
				await RenderFrame();

				// Update generations per second
				_generationsSinceLastUpdate++;
				var now = DateTime.UtcNow;
				var elapsed = (now - _lastGenerationTime).TotalSeconds;
				if (elapsed >= 0.5) // Update every half second
				{
					_generationsPerSecond = _generationsSinceLastUpdate / elapsed;
					_cellsPerSecond = _generationsPerSecond * _rows * _cols;
					_lastGenerationTime = now;
					_generationsSinceLastUpdate = 0;
				}

				// Only call StateHasChanged if populations changed
				if (_fishCount > 0 || _sharkCount > 0)
				{
					await InvokeAsync(StateHasChanged);
				}
			}
		}, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(_delayMs == 0 ? 1 : _delayMs));
	}

	private void DoGeneration()
	{
		_generation++;

		// Reset processed flags
		for (int row = 0; row < _rows; row++)
		{
			for (int col = 0; col < _cols; col++)
			{
				_cells[row, col].ProcessedThisGeneration = false;
			}
		}

		// Randomly decide scan direction
		bool forward = _random.Next(2) == 0;
		int rowStart = forward ? 0 : _rows - 1;
		int colStart = forward ? 0 : _cols - 1;
		int rowEnd = forward ? _rows : -1;
		int colEnd = forward ? _cols : -1;
		int rowInc = forward ? 1 : -1;
		int colInc = forward ? 1 : -1;

		for (int row = rowStart; row != rowEnd; row += rowInc)
		{
			for (int col = colStart; col != colEnd; col += colInc)
			{
				ProcessCell(row, col);
			}
		}

		// Record statistics
		_csvData.Add($"{_generation},{_fishCount},{_sharkCount}");
		DebugHelper.Log($"[Fish] Gen {_generation}: Fish={_fishCount}, Sharks={_sharkCount}");

		// Animation no longer stops when extinct
		// if (_fishCount ==0 && _sharkCount ==0)
		// {
		// 	_isPaused = true;
		// 	_animationTimer?.Dispose();
		// 	_animationTimer = null;
		// 	DebugHelper.Log("[Fish] Simulation ended - all populations extinct", true);
		// }
	}

	private void ProcessCell(int row, int col)
	{
		var cell = _cells[row, col];

		if (cell.ProcessedThisGeneration || cell.Type == CellType.Empty)
			return;

		cell.ProcessedThisGeneration = true;

		// Age the animal FIRST before any other processing
		cell.Age++;

		// Check survival
		if (cell.Type == CellType.Fish && cell.Age >= _fishLifeLength)
		{
			KillAnimal(row, col);
			return;
		}

		if (cell.Type == CellType.Shark)
		{
			if (cell.Age >= _sharkLifeLength || (_generation - cell.LastMeal) >= _sharkStarve)
			{
				KillAnimal(row, col);
				return;
			}
		}

		// Check if already acted this year
		if (_oneActionPerYear && cell.LastAction == _generation)
			return;

		var neighbors = GetNeighbors(row, col);

		// Sharks eat fish (manual loop, no LINQ)
		if (cell.Type == CellType.Shark)
		{
			var fishNeighbors = new List<(int row, int col)>(4);
			foreach (var n in neighbors)
			{
				var neighborCell = _cells[n.row, n.col];
				if (neighborCell.Type == CellType.Fish && neighborCell.Age > 0)
				{
					fishNeighbors.Add(n);
				}
			}
			if (fishNeighbors.Count > 0)
			{
				var target = fishNeighbors[_random.Next(fishNeighbors.Count)];

				// Shark eats the fish and moves to that cell
				_fishCount--;

				var targetCell = _cells[target.row, target.col];
				targetCell.Type = cell.Type;
				targetCell.Age = cell.Age;
				targetCell.LastMeal = _generation;
				targetCell.LastAction = _generation;
				targetCell.LastBirth = cell.LastBirth;
				targetCell.ProcessedThisGeneration = true;

				// Check if shark can breed (leave baby behind)
				if (cell.Age >= _sharkBreedAge)
				{
					// Leave a baby shark in the current cell
					cell.Age = 0;
					cell.LastBirth = _generation;
					cell.LastAction = _generation;
					cell.LastMeal = _generation;
					_sharkCount++;
				}
				else
				{
					// Shark just moves, leaving empty cell behind
					cell.Type = CellType.Empty;
				}
				return;
			}
		}

		// Movement and breeding (manual loop, no LINQ)
		var emptyNeighbors = new List<(int row, int col)>(4);
		foreach (var n in neighbors)
		{
			if (_cells[n.row, n.col].Type == CellType.Empty)
			{
				emptyNeighbors.Add(n);
			}
		}
		if (emptyNeighbors.Count > 0)
		{
			bool canBreed = (cell.Type == CellType.Fish && cell.Age >= _fishBreedAge) ||
							(cell.Type == CellType.Shark && cell.Age >= _sharkBreedAge);

			if (canBreed)
			{
				// Have a baby
				var target = emptyNeighbors[_random.Next(emptyNeighbors.Count)];
				var targetCell = _cells[target.row, target.col];
				targetCell.Type = cell.Type;
				targetCell.Age = 0;
				targetCell.LastBirth = _generation;
				targetCell.LastAction = _generation;
				if (cell.Type == CellType.Shark)
					targetCell.LastMeal = _generation;

				cell.LastBirth = _generation;
				cell.LastAction = _generation;

				if (cell.Type == CellType.Fish)
					_fishCount++;
				else
					_sharkCount++;
			}
			else
			{
				// Just move
				var target = emptyNeighbors[_random.Next(emptyNeighbors.Count)];
				var targetCell = _cells[target.row, target.col];
				targetCell.Type = cell.Type;
				targetCell.Age = cell.Age;
				targetCell.LastMeal = cell.LastMeal;
				targetCell.LastAction = _generation;
				targetCell.LastBirth = cell.LastBirth;
				targetCell.ProcessedThisGeneration = true;

				cell.Type = CellType.Empty;
			}
		}
		// If no empty neighbors, animal stays in place (already aged)
	}

	private void KillAnimal(int row, int col)
	{
		if (_cells[row, col].Type == CellType.Fish)
			_fishCount--;
		else if (_cells[row, col].Type == CellType.Shark)
			_sharkCount--;

		_cells[row, col].Type = CellType.Empty;
		_cells[row, col].Age = 0;
	}

	private List<(int row, int col)> GetNeighbors(int row, int col)
	{
		var neighbors = new List<(int row, int col)>(4);
		// Shuffle directions in-place
		for (int i = _directions.Length - 1; i > 0; i--)
		{
			int j = _shuffleRandom.Next(i + 1);
			(_directions[i], _directions[j]) = (_directions[j], _directions[i]);
		}

		foreach (var dir in _directions)
		{
			int newRow = row;
			int newCol = col;

			switch (dir)
			{
				case 0: // North
					newRow--;
					if (newRow < 0)
					{
						if (_torus) newRow = _rows - 1;
						else continue;
					}
					break;
				case 1: // South
					newRow++;
					if (newRow >= _rows)
					{
						if (_torus) newRow = 0;
						else continue;
					}
					break;
				case 2: // West
					newCol--;
					if (newCol < 0)
					{
						if (_torus) newCol = _cols - 1;
						else continue;
					}
					break;
				case 3: // East
					newCol++;
					if (newCol >= _cols)
					{
						if (_torus) newCol = 0;
						else continue;
					}
					break;
			}

			neighbors.Add((newRow, newCol));
		}

		return neighbors;
	}

	private async ValueTask RenderFrame()
	{
		try
		{
			// Use ArrayPool for cell data
			var pool = System.Buffers.ArrayPool<byte>.Shared;
			var cellData = pool.Rent(_cellCount);
			int index = 0;

			for (int row = 0; row < _rows; row++)
			{
				for (int col = 0; col < _cols; col++)
				{
					var cell = _cells[row, col];
					int type = (int)cell.Type;
					int age = Math.Min(cell.Age, 63); // Cap age at63 (6 bits)
					cellData[index++] = (byte)((type << 6) | age);
				}
			}

			// Only call JS if there are cells to render
			if (_cellCount > 0)
			{
				await JSRuntime.InvokeVoidAsync("fishRenderFrame", cellData, _rows, _cols, _cellWidth, _cellHeight, _useCircles, _colorAgeGradient);
			}
			pool.Return(cellData);
		}
		catch (Exception ex)
		{
			DebugHelper.LogError($"[Fish] Render error: {ex.Message}");
		}
	}

	private void TogglePause()
	{
		_isPaused = !_isPaused;
		if (!_isPaused)
		{
			if (_animationTimer == null)
			{
				StartAnimation();
			}
		}
		else
		{
			_animationTimer?.Dispose();
			_animationTimer = null;
		}
		StateHasChanged();
	}

	private async Task Reset()
	{
		_isPaused = true;
		_animationTimer?.Dispose();
		_animationTimer = null;
		await InitializeWorld();
		await RenderFrame();
		StateHasChanged();
	}

	private async Task ExportData()
	{
		var csv = string.Join("\n", _csvData);
		await JSRuntime.InvokeVoidAsync("downloadCsv", csv, "fish-sharks-data.csv");
		DebugHelper.Log("[Fish] Data exported", true);
	}

	private async Task OnCanvasMouseDown(MouseEventArgs e)
	{
		_isMouseDown = true;
		_isRightClick = e.Button == 2;
		await AddAnimalAtPosition(e.OffsetX, e.OffsetY);
	}

	private async Task OnCanvasMouseMove(MouseEventArgs e)
	{
		if (_isMouseDown)
		{
			await AddAnimalAtPosition(e.OffsetX, e.OffsetY);
		}
	}

	private void OnCanvasMouseUp(MouseEventArgs e)
	{
		_isMouseDown = false;
	}

	private bool _addSharkMode = false;

	private void ToggleAddSharkMode()
	{
		_addSharkMode = !_addSharkMode;
	}

	private async Task AddAnimalAtPosition(double x, double y)
	{
		if (!_isInitialized) return;

		int col = (int)(x / _cellWidth);
		int row = (int)(y / _cellHeight);

		if (row >= 0 && row < _rows && col >= 0 && col < _cols)
		{
			var cell = _cells[row, col];
			var newType = (_isMouseDown && !_isRightClick) ? (_addSharkMode ? CellType.Shark : CellType.Fish) : (_isRightClick ? CellType.Shark : CellType.Fish);

			if (cell.Type != newType)
			{
				// Remove old animal
				if (cell.Type == CellType.Fish) _fishCount--;
				else if (cell.Type == CellType.Shark) _sharkCount--;

				// Add new animal
				cell.Type = newType;
				cell.Age = 0;
				cell.LastAction = _generation;
				cell.LastBirth = _generation;

				if (newType == CellType.Fish)
				{
					_fishCount++;
				}
				else
				{
					_sharkCount++;
					cell.LastMeal = _generation;
				}

				await RenderFrame();
				StateHasChanged();
			}
		}
	}

	public void Dispose()
	{
		_animationTimer?.Dispose();
		_dotNetRef?.Dispose();
	}
}
