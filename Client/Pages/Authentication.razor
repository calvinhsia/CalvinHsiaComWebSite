@page "/authentication/{action}"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<RemoteAuthenticatorView Action="@Action">
    <LoggingIn>
        <div class="alert alert-info">
            <p>Logging in...</p>
            <div class="spinner-border spinner-border-sm ms-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </LoggingIn>
    <CompletingLoggingIn>
        <div class="alert alert-info">
            <p>Completing login...</p>
            <p>If this takes too long, <button class="btn btn-link p-0" @onclick="CheckAuthAndRedirect">check authentication status</button>.</p>
            <div class="spinner-border spinner-border-sm ms-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </CompletingLoggingIn>
    <LogInFailed>
        <div class="alert alert-warning">
            <p><strong>Authentication Status Check</strong></p>
            <p>The login process encountered an issue, but you may already be authenticated.</p>
            <div class="mt-3">
                <button class="btn btn-primary me-2" @onclick="CheckAuthAndRedirect">Check Status & Continue</button>
                <button class="btn btn-secondary me-2" @onclick="RetryLogin">Try Login Again</button>
                <a href="/" class="btn btn-outline-secondary">Return to Home</a>
            </div>
            @if (!string.IsNullOrEmpty(debugInfo))
            {
                <div class="mt-3">
                    <details>
                        <summary>Debug Information</summary>
                        <pre class="small">@debugInfo</pre>
                    </details>
                </div>
            }
        </div>
    </LogInFailed>
    <LogOut>
        <div class="alert alert-info">
            <p>Logging out...</p>
            <div class="spinner-border spinner-border-sm ms-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </LogOut>
    <CompletingLogOut>
        <div class="alert alert-info">
            <p>Completing logout...</p>
            <div class="spinner-border spinner-border-sm ms-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </CompletingLogOut>
    <LogOutSucceeded>
        <div class="alert alert-success">
            <p>You have been logged out successfully.</p>
            <button class="btn btn-primary me-2" @onclick="CompleteLogout">Continue</button>
            <a href="/" class="btn btn-outline-secondary">Return to Home</a>
        </div>
    </LogOutSucceeded>
    <LogOutFailed>
        <div class="alert alert-warning">
            <p>Logout encountered an issue, but your session will be cleared.</p>
            <button class="btn btn-primary me-2" @onclick="ForceLogout">Complete Logout</button>
            <a href="/" class="btn btn-outline-secondary">Return to Home</a>
        </div>
    </LogOutFailed>
</RemoteAuthenticatorView>

@code {
    [Parameter] public string? Action { get; set; }
    private string debugInfo = string.Empty;
    
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"Authentication page loaded with action: {Action}");
        Console.WriteLine($"Current URL: {Navigation.Uri}");
        
        debugInfo = $"Action: {Action}\nURL: {Navigation.Uri}\nTimestamp: {DateTime.Now:yyyy-MM-dd HH:mm:ss}";
        
        // Handle logout completion automatically
        if (Action?.ToLower() == "logout")
        {
            await Task.Delay(1000); // Give the logout process time to complete
            await CompleteLogout();
        }
        
        await base.OnInitializedAsync();
    }
    
    private async Task<string> GetUserAgent()
    {
        try
        {
            return await JS.InvokeAsync<string>("eval", "navigator.userAgent");
        }
        catch
        {
            return "Unknown";
        }
    }
    
    private async Task CheckAuthAndRedirect()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            Console.WriteLine($"Auth check - IsAuthenticated: {user.Identity?.IsAuthenticated}");
            Console.WriteLine($"Auth check - Name: {user.Identity?.Name}");
            
            if (user.Identity?.IsAuthenticated == true)
            {
                Console.WriteLine("User is authenticated, redirecting to home");
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                Console.WriteLine("User is not authenticated");
                debugInfo += $"\nAuth Check Result: Not authenticated";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
            debugInfo += $"\nError: {ex.Message}";
            StateHasChanged();
        }
    }
    
    private void RetryLogin()
    {
        Navigation.NavigateTo("/authentication/login", forceLoad: true);
    }
    
    private async Task CompleteLogout()
    {
        Console.WriteLine("Completing logout process...");
        await ForceLogout();
    }
    
    private async Task ForceLogout()
    {
        try
        {
            Console.WriteLine("Force logout - clearing all authentication data");
            
            await JS.InvokeVoidAsync("eval", @"
                console.log('🧹 Clearing all authentication data...');
                
                // Clear all localStorage
                localStorage.clear();
                
                // Clear all sessionStorage  
                sessionStorage.clear();
                
                // Clear any cookies
                document.cookie.split(';').forEach(function(c) { 
                    document.cookie = c.replace(/^ +/, '').replace(/=.*/, '=;expires=' + new Date().toUTCString() + ';path=/'); 
                });
                
                console.log('✅ All authentication data cleared');
            ");
            
            // Small delay then redirect
            await Task.Delay(100);
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during force logout: {ex.Message}");
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }
}
