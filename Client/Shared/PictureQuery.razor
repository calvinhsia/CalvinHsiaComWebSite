    }

    .success-count {
        color: #28a745;
        font-weight: 500;
    }

    .failure-count {
        color: #dc3545;
        font-weight: 500;
    }

    .duplicate-count {
        color: #ffc107;
        font-weight: 500;
    }

    .eta-info {
        font-weight: 500;
        color: #495057;
        display: flex;
        gap: 15px;
