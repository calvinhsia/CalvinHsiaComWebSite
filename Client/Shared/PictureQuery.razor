@page "/PictureQuery"
@page "/PictureQuery/{PageNumber:int}"
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Web;
@implements IDisposable
@inject IHttpClientFactory ClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject HttpClient Http
@inject IJSRuntime JS
@inject IAccessTokenProvider TokenProvider

<p>
    <label for="NotesFilter">Filter:</label> <input id="NotesFilter" @bind="@notesFilter" @bind:event="oninput" @bind:after="OnFilterChanged"
        title="Start with |; for OR.\nStart With '$' for filename search ('$^(.*)\.avi')\n Start with '^' for regex e.g. '^.*(pui|hallie).*'  (CaseIgnore)" 
        size="30"/>
    <label for="MediaType">MediaType:</label> <input id="MediaType" @bind="@mediaType" placeholder="pic|mov" size="4"/>
    <label for="date1">From:</label> <input id="date1" @bind="@date1" size="6"/>
    <label for="date2">To:</label> <input id="date2" @bind="@date2" size="6"/>
    <button @onclick="DoQueryAsync" disabled="@isQuerying">
        @if (isQuerying)
        {
            <span>Querying...</span>
        }
        else
        {
            <span>Query</span>
        }
    </button>
</p>
<p>
    <input type="checkbox" id="publishToAlbum" @bind="@publishToAlbum" />
    <label for="publishToAlbum">Publish results to Album</label>
    @if (publishToAlbum)
    {
        <input id="albumName" @bind="@albumName" @oninput="OnAlbumNameChanged" placeholder="Album name" size="20" title="Enter album name" />
        <label for="albumMaxItems">Max items:</label>
        <input id="albumMaxItems" type="number" @bind="@albumMaxItems" min="1" max="100000" size="4" title="Maximum number of items to include in album (1-100000)" />
    }
</p>

<div class="status-container">
    <p>@((MarkupString)statusMessage)</p>
    
    @if (isPublishing && albumProgress != null)
    {
        <div class="album-progress">
            <div class="progress-header">
                <strong>Album Creation Progress</strong>
                <div class="progress-controls">
                    <span class="progress-percentage">@(albumProgress.TotalItems > 0 ? Math.Round((double)albumProgress.CompletedItems / albumProgress.TotalItems * 100, 1) : 0)%</span>
                    <button class="cancel-button" @onclick="CancelAlbumCreation" title="Cancel album creation">
                        ✕ Cancel
                    </button>
                </div>
            </div>
            
            <div class="progress-bar-container">
                <div class="progress-bar" style="width: @(albumProgress.TotalItems > 0 ? Math.Round((double)albumProgress.CompletedItems / albumProgress.TotalItems * 100, 1) : 0)%"></div>
            </div>
            
            <div class="progress-details">
                <div class="progress-info">
                    <span>Items: @albumProgress.CompletedItems / @albumProgress.TotalItems</span>
                    <span class="success-count">✅ Added: @albumProgress.SuccessfullyAdded</span>
                    <span class="failure-count">⚠️ Failures: @albumProgress.FailedToAdd</span>
                    <span class="duplicate-count">📋 Already exists: @albumProgress.AlreadyExists</span>
                    <span>Elapsed: @FormatTimeSpan(DateTime.Now - albumStartTime)</span>
                    <span>Avg per item: @(albumProgress.CompletedItems > 0 ? FormatTimeSpan(TimeSpan.FromMilliseconds(GetAverageProcessingTimeMs())) : "calculating...")</span>
                </div>
                <div class="eta-info">
                    @if (albumProgress.CompletedItems > 0 && albumProgress.CompletedItems < albumProgress.TotalItems)
                    {
                        var remainingTime = CalculateRemainingTime();
                        var eta = DateTime.Now.Add(remainingTime);
                        <span>Time remaining: @FormatTimeSpan(remainingTime)</span>
                        <span>ETA: @eta.ToString("HH:mm:ss") (@eta.ToString("MMM dd"))</span>
                    }
                </div>
                @if (wakeLockActive)
                {
                    <div class="wake-lock-indicator">
                        <span class="wake-lock-icon">📱</span>
                        <span>Screen kept awake during album creation</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@{
    NumberPerRow = 1;
    if (browserDimensions.Width > 2000)
    {
        NumberPerRow = 3;
    } else if (browserDimensions.Width > 800)
    {
        NumberPerRow = 2;
    }
    if (myPixes.Count > 0)
    {
        <label>Pg={@this.PageNumber}#results=@NumberTotalPix #perPage=@NumberPerPage MaxPix=@maxpix </label>
    }
    if (myPixes.Count > NumberPerPage)
    {
        <div>
        @for (int i = 1; i <= (NumberTotalPix + NumberPerPage - 1)/ NumberPerPage ; i++ )
        {
            var pix = myPixes[i * NumberPerPage - NumberPerPage];
            <span><a href = "PictureQuery/@i" title="@pix.ToString()"> @i </a>&nbsp;</span>
            if (i % (30 * NumberPerRow) == 0)
            {
                <p></p>
            }
        }
        </div>
    }
    var cntr = 0;
}
<div id="MyMain" style="display:none">
    <p>
        <img id="imageMain" />
        <video width="320" height="240" id="myVideo" controls style="display:none">
            video tag not supported
        </video>
        <button @onclick="MyImgClickMain">Download</button>
        @if (mainPix != null)
        {
            <label>@mainPix.AltText</label>
        }
    </p>

</div>

@if (isLoading)
{
    <div class="spinner-overlay">
        <div class="spinner"></div>
    </div>
}

<table class="table">
    <tbody>
        @foreach (var pix in myPixes.Skip((PageNumber - 1) * NumberPerPage).Take(NumberPerPage))
        {
            var imgname = $"image{cntr}";
            if (cntr % NumberPerRow == 0)
            {
                @:<tr>
            }
            <td><img id="@imgname" title="@pix.AltText" @onclick="()=> MyThumbClick(pix)" width="300" height="225" />@pix.AltText</td>
            cntr++;
            if (cntr % NumberPerRow == NumberPerRow-1 || cntr == NumberPerPage)
            {
                @:</tr>
            }
        }
    </tbody>
</table>

<style>
    .status-container {
        margin-bottom: 20px;
    }

    .album-progress {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
        margin-top: 10px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .progress-controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .progress-percentage {
        font-weight: bold;
        color: #0066cc;
    }

    .cancel-button {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .cancel-button:hover {
