@page "/PictureQuery"
@page "/PictureQuery/{PageNumber:int}"
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Web;
@inject IHttpClientFactory ClientFactory
@inject IHttpClientFactory HttpClientFactory
@inject HttpClient Http
@inject IJSRuntime JS
@inject IAccessTokenProvider TokenProvider

<p>
    <label for="NotesFilter">Filter:</label> <input id="NotesFilter" @bind="@notesFilter"
        title="Start with |; for OR.\nStart With '$' for filename search ('$^(.*)\.avi')\n Start with '^' for regex e.g. '^.*(pui|hallie).*'  (CaseIgnore)" 
        size="30"/>
    <label for="MediaType">MediaType:</label> <input id="MediaType" @bind="@mediaType" placeholder="pic|mov" size="4"/>
    <label for="date1">From:</label> <input id="date1" @bind="@date1" size="6"/>
    <label for="date2">To:</label> <input id="date2" @bind="@date2" size="6"/>
    <button @onclick="DoQueryAsync">
        Query
    </button>
</p>
<p>
    <input type="checkbox" id="publishToAlbum" @bind="@publishToAlbum" />
    <label for="publishToAlbum">Publish results to album</label>
    @if (publishToAlbum)
    {
        <input id="albumName" @bind="@albumName" placeholder="Album name" size="20" title="Enter album name" />
    }
</p>
<p>@statusMessage</p>
@{
    NumberPerRow = 1;
    if (browserDimensions.Width > 2000)
    {
        NumberPerRow = 3;
    } else if (browserDimensions.Width > 800)
    {
        NumberPerRow = 2;
    }
    if (myPixes.Count > 0)
    {
        <label>Pg={@this.PageNumber}#results=@NumberTotalPix #perPage=@NumberPerPage MaxPix=@maxpix </label>
        @if (publishToAlbum && !string.IsNullOrWhiteSpace(albumName))
        {
            <button @onclick="PublishResultsToAlbumAsync" class="btn btn-success" disabled="@isPublishing">
                @if (isPublishing)
                {
                    <span>Publishing...</span>
                }
                else
                {
                    <span>Publish to "@albumName"</span>
                }
            </button>
        }
    }
    if (myPixes.Count > NumberPerPage)
    {
        <div>
        @for (int i = 1; i <= (NumberTotalPix + NumberPerPage - 1)/ NumberPerPage ; i++ )
        {
            var pix = myPixes[i * NumberPerPage - NumberPerPage];
            <span><a href = "PictureQuery/@i" title="@pix.ToString()"> @i </a>&nbsp;</span>
            if (i % (30 * NumberPerRow) == 0)
            {
                <p></p>
            }
        }
        </div>
    }
    var cntr = 0;
}
<div id="MyMain" style="display:none">
    <p>
        <img id="imageMain" />
        <video width="320" height="240" id="myVideo" controls style="display:none">
            video tag not supported
        </video>
        <button @onclick="MyImgClickMain">Download</button>
        @if (mainPix != null)
        {
            <label>@mainPix.AltText</label>
        }
    </p>

</div>

@if (isLoading)
{
    <div class="spinner-overlay">
        <div class="spinner"></div>
    </div>
}

<table class="table">
    <tbody>
        @foreach (var pix in myPixes.Skip((PageNumber - 1) * NumberPerPage).Take(NumberPerPage))
        {
            var imgname = $"image{cntr}";
            if (cntr % NumberPerRow == 0)
            {
                @:<tr>
            }
            <td><img id="@imgname" title="@pix.AltText" @onclick="()=> MyThumbClick(pix)" width="300" height="225" />@pix.AltText</td>
            cntr++;
            if (cntr % NumberPerRow == NumberPerRow-1 || cntr == NumberPerPage)
            {
                @:</tr>
            }
        }
    </tbody>
</table>
<script type="text/javascript">
    window.getDimensions = () => {
        return {
            width: window.innerWidth,
            height: window.innerHeight
        }
    };
    window.setElementVisible = async (imageElementId, visibility) => {
        const imageCtrl = document.getElementById(imageElementId);
        if (imageCtrl) {
            imageCtrl.style.display = visibility;
        }
    };

    window.setImageSrc = async (imageElementId, imageStream) => {
        const imageCtrl = document.getElementById(imageElementId);
        if (imageCtrl) {
            console.log(`Here in setImageSrc ${imageElementId} ${imageStream}`);
            if (imageStream === 'null') {
                imageCtrl.src = null;
                imageCtrl.style.display = "none";
            }
            else {
                try {
                    const arrayBuffer = await imageStream.arrayBuffer();
                    // For video, set correct MIME type if possible
                    let blob;
                    if (imageCtrl.tagName === 'VIDEO') {
                        blob = new Blob([arrayBuffer]);//, { type: "video/mp4" });
                    } else {
                        blob = new Blob([arrayBuffer]);
                    }
                    const url = URL.createObjectURL(blob);
                    imageCtrl.onload = () => {
                        URL.revokeObjectURL(url);
                    }
                    imageCtrl.src = url;
                    imageCtrl.style.display = "block";
                    if (imageCtrl.tagName === 'VIDEO') {
                        imageCtrl.load();
                        // Start playing immediately
                        imageCtrl.play().catch(e => {
                            // Autoplay might be blocked, log or handle if needed
                            console.log("Autoplay blocked or error: ", e);
                        });
                        console.log(`Playing video ${imageElementId} ${imageStream}`);
                    }
                } catch (e) {
                    imageCtrl.src = null;
                }
            }
        }
    };
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? '';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    }
</script>

@code {
    [Parameter]
    public int PageNumber { get; set; } = 1;
    public int NumberPerPage => NumberRowsPerPage * NumberPerRow;
    public int NumberTotalPix => myPixes.Count;
    private int NumberRowsPerPage = 10;
    private int NumberPerRow = 1; // depends on width of browser
    private int maxpix = 10000; // max # pix per query

    private string date1="1/1/1950";
    private string date2="1/1/2030";
    private string notesFilter=@"weight";
    private string mediaType="";
    private bool publishToAlbum = true;
    private string albumName = "QueryAlbum";
    private bool isPublishing = false;
    private bool shouldRender = true;
    private string imagestyle = "width:500px;height:600px";
    private string statusMessage = string.Empty;
    private HttpClient? _httpClient;
    private string userDisplayName = string.Empty;
    private List<MyPix> myPixes { get; set; } = new List<MyPix>();
    private BrowserDimensions browserDimensions = new BrowserDimensions(); //Width = 2512, Height = 1366. See a diff way using DI https://blazor.tips/blazor-how-to-ready-window-dimensions/
    const string MSGraphEndPoint = @"https://graph.microsoft.com/v1.0/"; // "v1.0" or "beta"
    bool needRefresh = false;
    MyPix? mainPix = null;
    private bool isLoading = false;
    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("GraphAPI");
        try
        {
            await LoadFiltersAsync();
            var dataRequest = await _httpClient.GetAsync($"{MSGraphEndPoint}/me");

            if (dataRequest.IsSuccessStatusCode)
            {
            }

        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
    }
    protected override bool ShouldRender()
    {
        return shouldRender;
    }
    private async Task SaveFiltersAsync()
    {
        var filters = new {
            notesFilter,
            mediaType,
            date1,
            date2,
            publishToAlbum,
            albumName
        };
        await JS.InvokeVoidAsync("localStorage.setItem", "pictureQueryFilters", JsonConvert.SerializeObject(filters));
    }

    private async Task LoadFiltersAsync()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "pictureQueryFilters");
        if (!string.IsNullOrEmpty(json))
        {
            var filters = JsonConvert.DeserializeObject<dynamic>(json);
            notesFilter = filters.notesFilter ?? notesFilter;
            mediaType = filters.mediaType ?? mediaType;
            date1 = filters.date1 ?? date1;
            date2 = filters.date2 ?? date2;
            publishToAlbum = filters.publishToAlbum ?? publishToAlbum;
            albumName = filters.albumName ?? albumName;
        }
    }
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        needRefresh = true;
        this.mainPix = null;
        var _ = JS.InvokeVoidAsync("setImageSrc", "imageMain", "null");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            try
            {
                var dimensions = await JS.InvokeAsync<BrowserDimensions>("getDimensions");
                this.browserDimensions = dimensions;
                Console.WriteLine($"Got Dimensions {dimensions}");
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.ToString());
            }
        }
        if (needRefresh) {
            needRefresh = false;
            int ndx = 0;
            Console.WriteLine("Doing Refresh");
            try
            {
                foreach (var pix in myPixes.Skip((PageNumber - 1) * NumberPerPage).Take(NumberPerPage))
                {
                    var dotnetImageStream = await GetImageStreamAsync(pix, ThumbSize:( ndx == 0 ? "medium":"medium"));
                    await JS.InvokeVoidAsync("setImageSrc", $"image{ndx}", dotnetImageStream);
                    ndx++;
                }
            }
            catch (InvalidOperationException ex)
            {
                Console.WriteLine(ex.ToString());
            }
        }
    }
    private async Task<DotNetStreamReference> GetImageStreamAsync(MyPix pix, string ThumbSize = "")
    {
        DotNetStreamReference? dotnetImageStream = null;
        if (!string.IsNullOrEmpty(ThumbSize))
        {
            if (pix.IsVideo)
            {
                var urlQuery = $"/api/GetVideoThumb/{pix.Id}";
                var response = await Http.GetAsync(urlQuery);
                var strm = await response.Content.ReadAsStreamAsync();
                dotnetImageStream = new DotNetStreamReference(strm);
            }
            else
            {
                var url = $"{MSGraphEndPoint}/me/drive/root:/{pix.FullFileName}";
                var picReq = await _httpClient!.GetAsync(url);
                var jsoncontent = await picReq.Content.ReadAsStringAsync();
                var jobj = JObject.Parse(jsoncontent);
                var picId = jobj["id"];
                // https://learn.microsoft.com/en-us/graph/api/driveitem-list-thumbnails?view=graph-rest-1.0&tabs=http#size-options
                // small = 96 longest, medium = 176 longest, large = 800 longest
                url = $"{MSGraphEndPoint}/me/drive/items/{picId}/thumbnails/0/{ThumbSize}/content";
                var thumreq = await _httpClient!.GetAsync(url);
                var strm = await thumreq.Content.ReadAsStreamAsync();
                dotnetImageStream = new DotNetStreamReference(strm);
            }
        }
        else
        {
            var url = $"{MSGraphEndPoint}/me/drive/root:/{pix.FullFileName}:/content";
            var picRequest = await _httpClient!.GetAsync(url);
            var strm = await picRequest.Content.ReadAsStreamAsync();
            dotnetImageStream = new DotNetStreamReference(strm);
        }
        Console.WriteLine($"ImgStrm {dotnetImageStream.Stream.Length}  {pix.FileName} {ThumbSize}");
        return dotnetImageStream;
    }
    private async Task resetUI() {
        this.needRefresh = false;
        this.mainPix = null;
        await JS.InvokeVoidAsync("setElementVisible", "MyMain", "none");
    }

    private async Task DoQueryAsync()
    {
        await SaveFiltersAsync();
        await this.resetUI();
        this.PageNumber = 1;
        statusMessage = "Querying...";

        var tokenRequest = new AccessTokenRequestOptions
        {
            Scopes = new[] { "https://graph.microsoft.com/Files.Read.All", "https://graph.microsoft.com/Files.ReadWrite" }
        };
        
        var tokenResult = await TokenProvider.RequestAccessToken(tokenRequest);
        
        var qpart = $"Date1={HttpUtility.UrlEncode(date1)}&Date2={HttpUtility.UrlEncode(date2)}&MaxPix={maxpix}&NotesFilter={HttpUtility.UrlEncode(notesFilter)}";
        if (!string.IsNullOrEmpty(mediaType))
        {
            qpart += $"&MediaType={mediaType.ToLower()}";
        }
        if (publishToAlbum && !string.IsNullOrWhiteSpace(albumName))
        {
            qpart += $"&PublishToAlbum=true&AlbumName={HttpUtility.UrlEncode(albumName)}";
        }
        
        var urlQuery = $"/api/QueryPix?{qpart}";
        
        var request = new HttpRequestMessage(HttpMethod.Get, urlQuery);
        if (tokenResult.TryGetToken(out var token))
        {
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token.Value);
        }
        
        var response = await Http.SendAsync(request);
        var serverJson = await response.Content.ReadAsStringAsync();
        if (response.StatusCode != System.Net.HttpStatusCode.OK)
        {
            statusMessage = serverJson;
            return;
        }
        var pixes = JsonConvert.DeserializeObject<MyPix[]>(serverJson);
        myPixes.Clear();
        this.needRefresh = true;
        if (pixes != null && pixes.Length > 0)
        {
            statusMessage = "";
            myPixes.AddRange(pixes);
        } 
        else
        {
            statusMessage = $"No results found for {qpart}";
        }
    }

    private async Task PublishResultsToAlbumAsync()
    {
        if (string.IsNullOrWhiteSpace(albumName) || myPixes.Count == 0)
            return;

        isPublishing = true;
        try
        {
            var pixIds = myPixes.Select(p => p.Id).ToArray();
            var publishRequest = new
            {
                AlbumName = albumName,
                PixIds = pixIds
            };

            var json = JsonConvert.SerializeObject(publishRequest);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            
            var response = await Http.PostAsync("/api/PublishToAlbum", content);
            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"Successfully published {pixIds.Length} items to album '{albumName}'";
            }
            else
            {
                statusMessage = $"Failed to publish to album: {responseContent}";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error publishing to album: {ex.Message}";
        }
        finally
        {
            isPublishing = false;
            StateHasChanged();
        }
    }

    private async Task MyImgClickMain() {
        Console.WriteLine($"clicked on mainimage {this.mainPix!.FileName}");
        var strm = await this.GetImageStreamAsync(this.mainPix);
        await JS.InvokeVoidAsync("downloadFileFromStream", Path.GetFileName(this.mainPix.FileName), strm);
    }
    private async Task MyThumbClick(MyPix pix)
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            this.mainPix = pix;
            await Task.Yield();
            {
                if (pix.IsVideo)
                {
                    var strm = await GetImageStreamAsync(pix, "");
                    await JS.InvokeVoidAsync("setImageSrc", "imageMain", "null");
                    await JS.InvokeVoidAsync("setImageSrc", "myVideo", strm);
                }
                else
                {
                    var dotnetImageStream = await GetImageStreamAsync(pix, "large");
                    await JS.InvokeVoidAsync("setImageSrc", "myVideo", "null");
                    await JS.InvokeVoidAsync("setImageSrc", "imageMain", dotnetImageStream);
                }
                await JS.InvokeVoidAsync("setElementVisible", "MyMain", "block");
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    public class BrowserDimensions {
        public int Width {get;set;}
        public int Height {get;set;}
        public override string ToString() => $"{this.Width}, {Height}";
    }
}

