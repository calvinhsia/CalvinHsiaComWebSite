@code {
    [Parameter]
    public int PageNumber { get; set; } = 1;
    public int NumberPerPage => NumberRowsPerPage * NumberPerRow;
    public int NumberTotalPix => myPixes.Count;
    private int NumberRowsPerPage = 10;
    private int NumberPerRow = 1; // depends on width of browser
    private int maxpix = 10000; // max # pix per query

    private string date1="1/1/1950";
    private string date2="1/1/2030";
    private string notesFilter=@"weight";
    // private string notesFilter=@"$2020\\20201025";
    private string mediaType="";
    private bool shouldRender = true;
    private string imagestyle = "width:500px;height:600px";
    private string statusMessage = string.Empty;
    private HttpClient? _httpClient;
    private string userDisplayName = string.Empty;
    private List<MyPix> myPixes { get; set; } = new List<MyPix>();
    private BrowserDimensions browserDimensions = new BrowserDimensions(); //Width = 2512, Height = 1366. See a diff way using DI https://blazor.tips/blazor-how-to-ready-window-dimensions/
    const string MSGraphEndPoint = @"https://graph.microsoft.com/v1.0/"; // "v1.0" or "beta"
    bool needRefresh = false;
    MyPix? mainPix = null;
    private bool isLoading = false;
    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("GraphAPI");
        try
        {
            await LoadFiltersAsync();
            var dataRequest = await _httpClient.GetAsync($"{MSGraphEndPoint}/me");

            if (dataRequest.IsSuccessStatusCode)
            {
            }

        }
        catch (AccessTokenNotAvailableException ex)
        {
            // Tokens are not valid - redirect the user to log in again
            ex.Redirect();
        }
    }
    protected override bool ShouldRender()
    {
        return shouldRender;
    }
    private async Task SaveFiltersAsync()
    {
        var filters = new {
            notesFilter,
            mediaType,
            date1,
            date2
        };
        await JS.InvokeVoidAsync("localStorage.setItem", "pictureQueryFilters", JsonConvert.SerializeObject(filters));
    }

    private async Task LoadFiltersAsync()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "pictureQueryFilters");
        if (!string.IsNullOrEmpty(json))
        {
            var filters = JsonConvert.DeserializeObject<dynamic>(json);
            notesFilter = filters.notesFilter ?? notesFilter;
            mediaType = filters.mediaType ?? mediaType;
            date1 = filters.date1 ?? date1;
            date2 = filters.date2 ?? date2;
        }
    }
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        needRefresh = true;
        this.mainPix = null;
        var _ = JS.InvokeVoidAsync("setImageSrc", "imageMain", "null");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        // var module = await JS.InvokeAsync<IJSObjectReference>(
        //     "import", "./Pages/MSGraph.razor.js");
        if (firstRender)
        {
            try
            {
                var dimensions = await JS.InvokeAsync<BrowserDimensions>("getDimensions");
                this.browserDimensions = dimensions;
                Console.WriteLine($"Got Dimensions {dimensions}");
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.ToString());
            }
        }
        if (needRefresh) {
            needRefresh = false;
            int ndx = 0;
            Console.WriteLine("Doing Refresh");
            try
            {
                foreach (var pix in myPixes.Skip((PageNumber - 1) * NumberPerPage).Take(NumberPerPage))
                {
                    var dotnetImageStream = await GetImageStreamAsync(pix, ThumbSize:( ndx == 0 ? "medium":"medium"));
                    await JS.InvokeVoidAsync("setImageSrc", $"image{ndx}", dotnetImageStream);
                    ndx++;
                }
                // while (ndx < NumberPerPage)
                // {
                //     await JS.InvokeVoidAsync("setImageSrc", $"image{ndx}", "null");
                //     ndx++;
                // }
            }
            catch (InvalidOperationException ex)
            {
                Console.WriteLine(ex.ToString());
            }
        }
    }
    // https://learn.microsoft.com/en-us/graph/api/driveitem-list-thumbnails?view=graph-rest-1.0&tabs=http
    private async Task<DotNetStreamReference> GetImageStreamAsync(MyPix pix, string ThumbSize = "")
    {
        DotNetStreamReference? dotnetImageStream = null;
        if (!string.IsNullOrEmpty(ThumbSize))
        {
            if (pix.IsVideo) // video thumbs are in sqlite
            {
                var urlQuery = $"/api/GetVideoThumb/{pix.Id}";
                var response = await Http.GetAsync(urlQuery);
                var strm = await response.Content.ReadAsStreamAsync();
                dotnetImageStream = new DotNetStreamReference(strm);
            }
            else
            {
                var url = $"{MSGraphEndPoint}/me/drive/root:/{pix.FullFileName}";
                var picReq = await _httpClient!.GetAsync(url);
                var jsoncontent = await picReq.Content.ReadAsStringAsync();
                var jobj = JObject.Parse(jsoncontent);
                var picId = jobj["id"];
                // https://learn.microsoft.com/en-us/graph/api/driveitem-list-thumbnails?view=graph-rest-1.0&tabs=http#size-options
                // small = 96 longest, medium = 176 longest, large = 800 longest
                url = $"{MSGraphEndPoint}/me/drive/items/{picId}/thumbnails/0/{ThumbSize}/content";
                var thumreq = await _httpClient!.GetAsync(url);
                var strm = await thumreq.Content.ReadAsStreamAsync();
                dotnetImageStream = new DotNetStreamReference(strm);
            }
        }
        else
        {
            var url = $"{MSGraphEndPoint}/me/drive/root:/{pix.FullFileName}:/content";
            var picRequest = await _httpClient!.GetAsync(url);
            var strm = await picRequest.Content.ReadAsStreamAsync();
            dotnetImageStream = new DotNetStreamReference(strm);
        }
        Console.WriteLine($"ImgStrm {dotnetImageStream.Stream.Length}  {pix.FileName} {ThumbSize}");
        return dotnetImageStream;
    }
    private async Task resetUI() {
        this.needRefresh = false;
        this.mainPix = null;
        // await JS.InvokeVoidAsync("setImageSrc", "imageMain", "null");
        // await JS.InvokeVoidAsync("setImageSrc", "myVideo", "null");
        await JS.InvokeVoidAsync("setElementVisible", "MyMain", "none");
    }

    private async Task DoQueryAsync()
    {
        await SaveFiltersAsync();
        await this.resetUI();
        this.PageNumber = 1;
        statusMessage = "Querying...";

        // https://graph.microsoft.com/v1.0/me/drive/root:/Pictures/OldPictures/2006/07/16/IMG_4493.JPG  
        // id: D69F3552CEFC21!318941
        // https://graph.microsoft.com/v1.0/me/drive/items/D69F3552CEFC21!318941/thumbnails
        // https://learn.microsoft.com/en-us/entra/identity-platform/v2-oauth2-client-creds-grant-flow
        var qpart = $"Date1={HttpUtility.UrlEncode(date1)}&Date2={HttpUtility.UrlEncode(date2)}&MaxPix={maxpix}&NotesFilter={HttpUtility.UrlEncode(notesFilter)}";
        if (!string.IsNullOrEmpty(mediaType))
        {
            qpart += $"&MediaType={mediaType.ToLower()}";
        }
        var urlQuery = $"/api/QueryPix?{qpart}";
        var response = await Http.GetAsync(urlQuery);
        var serverJson = await response.Content.ReadAsStringAsync();
        if (response.StatusCode != System.Net.HttpStatusCode.OK)
        {
            statusMessage = serverJson;
            //            this.StateHasChanged();
            return;
        }
        var pixes = JsonConvert.DeserializeObject<MyPix[]>(serverJson);
        myPixes.Clear();
        this.needRefresh = true;
        if (pixes != null && pixes.Length > 0)
        {
            statusMessage = "";
            myPixes.AddRange(pixes);
            // var dotnetImageStream = await GetImageStreamAsync(pixes[0]);
            // await JS.InvokeVoidAsync("setImageSrc", "image", dotnetImageStream);
        } 
        else
        {
            statusMessage = $"No results found for {qpart}";
        }
        //        this.StateHasChanged();
        /*
        Refused to load the image 'blob:https://calvinhsia.com/2340710b-afee-4a33-b991-aed1155bc2eb' because it violates the following Content Security Policy directive: "default-src https: 'unsafe-eval' 'unsafe-inline'".
        Note that 'img-src' was not explicitly set, so 'default-src' is used as a fallback.
    */
    }
    private async Task MyImgClickMain() {
        Console.WriteLine($"clicked on mainimage {this.mainPix!.FileName}");
        var strm = await this.GetImageStreamAsync(this.mainPix);
        // await JS.InvokeVoidAsync("newImageWindow", strm);
        //        await JS.InvokeVoidAsync("openStreamInNewPage", strm);
        // await JS.InvokeAsync<object>("open", url, "_blank");
        await JS.InvokeVoidAsync("downloadFileFromStream", Path.GetFileName(this.mainPix.FileName), strm);
    }
    private async Task MyThumbClick(MyPix pix)
    {
        isLoading = true;
        StateHasChanged(); // Force UI update so spinner shows before await
        try
        {
            this.mainPix = pix;
            await Task.Yield();
            {
                //https://learn.microsoft.com/en-us/aspnet/core/blazor/file-downloads?view=aspnetcore-8.0
                if (pix.IsVideo)
                {
                    var strm = await GetImageStreamAsync(pix, ""); // strm video.
                    await JS.InvokeVoidAsync("setImageSrc", "imageMain", "null");
                    await JS.InvokeVoidAsync("setImageSrc", "myVideo", strm);
                }
                else
                {
                    var dotnetImageStream = await GetImageStreamAsync(pix, "large");
                    await JS.InvokeVoidAsync("setImageSrc", "myVideo", "null");
                    await JS.InvokeVoidAsync("setImageSrc", "imageMain", dotnetImageStream);
                }
                await JS.InvokeVoidAsync("setElementVisible", "MyMain", "block");
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    public class BrowserDimensions {
        public int Width {get;set;}
        public int Height {get;set;}
        public override string ToString() => $"{this.Width}, {Height}";
    }
}

