@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject Client.Services.ApplicationInsightsLogger AppInsights
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="site-name">Calvin's Web Site</span>
            @if (!string.IsNullOrEmpty(GetCurrentPageName()))
            {
                <span class="page-name"> - @GetCurrentPageName()</span>
            }
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-section">
            <button class="nav-section-header" @onclick="() => ToggleSection(nameof(showWordGames))" @onclick:stopPropagation="true">
                <span class="toggle-icon">@(showWordGames ? "▼" : "▶")</span> Word Games
            </button>
            @if (showWordGames)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="wordscape">
                        <span class="oi oi-target" aria-hidden="true"></span> WordScape
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="wordament">
                        <span class="oi oi-grid-three-up" aria-hidden="true"></span> Wordament
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-section">
            <button class="nav-section-header" @onclick="() => ToggleSection(nameof(showCreativeTools))" @onclick:stopPropagation="true">
                <span class="toggle-icon">@(showCreativeTools ? "▼" : "▶")</span> Creative Tools
            </button>
            @if (showCreativeTools)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="logo">
                        <span class="oi oi-brush" aria-hidden="true"></span> Logo
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cartoon">
                        <span class="oi oi-pencil" aria-hidden="true"></span> Cartoon
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-section">
            <button class="nav-section-header" @onclick="() => ToggleSection(nameof(showSimulations))" @onclick:stopPropagation="true">
                <span class="toggle-icon">@(showSimulations ? "▼" : "▶")</span> Simulations
            </button>
            @if (showSimulations)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bounce">
                        <span class="oi oi-aperture" aria-hidden="true"></span> Bounce
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="fish">
                        <span style="color:#00c800;">🐟</span> Fish
                        <span style="color:#c80000;">🦈</span> Sharks
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="life">
                        <span style="color:#00ff88;">🧬</span> Life
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="ant">
                        <span style="color:#ff6b6b;">🐜</span> Langton's Ant
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="mandelbrot">
                        <span style="color:#8b5cf6;">🌀</span> Mandelbrot
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-section">
            <button class="nav-section-header" @onclick="() => ToggleSection(nameof(showClassicGames))" @onclick:stopPropagation="true">
                <span class="toggle-icon">@(showClassicGames ? "▼" : "▶")</span> Classic Games
            </button>
            @if (showClassicGames)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="snake">
                        <span style="color:#00ff88;">🐍</span> Snake
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tetris">
                        <span style="color:#00f0f0;">🧱</span> Tetris
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="minesweeper">
                        <span style="color:#ff6b6b;">💣</span> Minesweeper
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-section">
            <button class="nav-section-header" @onclick="() => ToggleSection(nameof(showCardGames))" @onclick:stopPropagation="true">
                <span class="toggle-icon">@(showCardGames ? "▼" : "▶")</span> Card Games
            </button>
            @if (showCardGames)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="solitaire">
                        <span style="color:#dc3545;">🃏</span> Solitaire
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="freecell">
                        <span style="color:#28a745;">🎴</span> FreeCell
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="hearts">
                        <span style="color:#e74c3c;">♥️</span> Hearts
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-section">
            <button class="nav-section-header" @onclick="() => ToggleSection(nameof(showDesktopApps))" @onclick:stopPropagation="true">
                <span class="toggle-icon">@(showDesktopApps ? "▼" : "▶")</span> Desktop Apps
            </button>
            @if (showDesktopApps)
            {
                <div class="nav-item px-3">
                    <a class="nav-link" href="https://github.com/calvinhsia/CalvinHsiaComWebSite" target="_blank">
                        <span style="color:#f1c40f;">🎵</span> Source Code for this web site
                    </a>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="https://github.com/calvinhsia/SheetMusicViewer/releases/latest" target="_blank">
                        <span style="color:#f1c40f;">🎵</span> Sheet Music Viewer
                    </a>
                </div>
            }
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Environment">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Environment
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="fetchdata">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Fetch data
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="MSgraph">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> MSGraph
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="PictureQuery">
                        <span class="oi oi-camera-slr" aria-hidden="true"></span> Picture Query
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Albums">
                        <span class="oi oi-book" aria-hidden="true"></span> Albums
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="claims-principle-data">
                        <span class="oi oi-person" aria-hidden="true"></span> Principal
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool showWordGames = true;
    private bool showCreativeTools = true;
    private bool showSimulations = true;
    private bool showClassicGames = true;
    private bool showCardGames = true;
    private bool showDesktopApps = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        
        // Also toggle the game sidebar if we're on GameLayout
        InvokeAsync(async () =>
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    if (typeof toggleGameSidebar === 'function') {
                        toggleGameSidebar();
                    }
                ");
            }
            catch
            {
                // Ignore if function doesn't exist (not on game layout)
            }
        });
    }

    private void ToggleSection(string sectionName)
    {
        switch (sectionName)
        {
            case nameof(showWordGames):
                showWordGames = !showWordGames;
                break;
            case nameof(showCreativeTools):
                showCreativeTools = !showCreativeTools;
                break;
            case nameof(showSimulations):
                showSimulations = !showSimulations;
                break;
            case nameof(showClassicGames):
                showClassicGames = !showClassicGames;
                break;
            case nameof(showCardGames):
                showCardGames = !showCardGames;
                break;
            case nameof(showDesktopApps):
                showDesktopApps = !showDesktopApps;
                break;
        }
    }

    private string GetCurrentPageName()
    {
        var uri = NavigationManager.Uri;
        var path = NavigationManager.ToBaseRelativePath(uri);
        
        return path.ToLowerInvariant() switch
        {
            "" or "/" => "",
            "wordament" => "Wordament",
            "wordscape" => "WordScape",
            "logo" => "Logo",
            "cartoon" => "Cartoon",
            "bounce" => "Bounce",
            "fish" => "Fish",
            "life" => "Life",
            "ant" => "Langton's Ant",
            "mandelbrot" => "Mandelbrot",
            "snake" => "Snake",
            "tetris" => "Tetris",
            "minesweeper" => "Minesweeper",
            "solitaire" => "Solitaire",
            "freecell" => "FreeCell",
            "hearts" => "Hearts",
            "environment" => "Environment",
            "fetchdata" => "Fetch Data",
            "msgraph" => "MSGraph",
            "picturequery" => "Picture Query",
            "albums" => "Albums",
            "claims-principle-data" => "Principal",
            "test" => "Test",
            "loginpage" => "Login",
            _ => ""
        };
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
        
        // Track page view in Application Insights
        var pageName = GetCurrentPageName();
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        
        InvokeAsync(async () =>
        {
            try
            {
                var properties = new Dictionary<string, string>
                {
                    { "page", pageName },
                    { "path", path },
                    { "url", NavigationManager.Uri }
                };
                
                await AppInsights.TrackPageView(pageName, properties);
                Console.WriteLine($"[NavMenu v2] Page navigation tracked: {pageName} ({path})");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[NavMenu v2] Failed to track page view: {ex.Message}");
            }
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
