@using Client
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar" id="game-sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <LoginDisplay/>
            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
        </div>

        <article class="content px-4 game-content">
            @Body
        </article>
    </main>
    
    <!-- Mobile sidebar overlay -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeMobileSidebar()"></div>
</div>

<style>
    /* Base layout - desktop first */
    .page {
        height: 100vh;
        overflow: hidden;
        display: flex;
        position: relative;
    }
    
    .sidebar {
        flex-shrink: 0;
    }
    
    main {
        display: flex;
        flex-direction: column;
        flex: 1;
        height: 100vh;
        overflow: hidden;
    }
    
    .top-row {
        flex-shrink: 0; /* Don't allow top bar to shrink */
        background-color: #f7f7f7;
        border-bottom: 1px solid #d6d5d5;
        justify-content: end;
    }
    
    .sidebar-overlay {
        display: none;
    }
    
    /* Game-specific content adjustments */
    .game-content {
        padding: 8px !important;
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    
    /* Make sure wordscape container can use full available height */
    .game-content .wordscape-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0;
    }
    
    /* Ensure game layout uses available space efficiently */
    .game-content .wordscape-container .game-layout {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0;
        height: 100%; /* Ensure it takes full available height */
    }
    
    /* Grid section should not grow beyond its content */
    .game-content .grid-section {
        flex-shrink: 0;
        max-height: 50vh; /* Limit grid to half viewport height */
        overflow: visible;
    }
    
    /* Wheel section should be fixed size */
    .game-content .wheel-section {
        flex-shrink: 0;
        z-index: 10;
        position: relative;
    }
    
    /* Words section should take remaining space and be scrollable */
    .game-content .words-section {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex !important;
        flex-direction: column;
        visibility: visible !important;
        opacity: 1 !important;
    }
    
    /* Ensure found words are always visible */
    .game-content .found-words {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex !important;
        flex-direction: column;
        visibility: visible !important;
        opacity: 1 !important;
    }
    
    /* Keep the found words list scrollable */
    .game-content .words-list-container {
        flex: 1;
        overflow-y: auto;
        min-height: 100px;
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    /* Mobile and narrow screen responsive behavior */
    @@media (max-width: 767.98px) {
        /* Main layout adjustments */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            z-index: 1030;
            background: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
            transform: translateX(-100%);
            transition: transform 0.3s ease-in-out;
        }
        
        .sidebar.show {
            transform: translateX(0);
        }
        
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1025;
            display: none;
        }
        
        .sidebar-overlay.show {
            display: block;
        }
        
        main {
            width: 100%;
            margin-left: 0;
        }
        
        .top-row {
            position: relative;
            z-index: 1020;
        }
        
        /* Game content mobile adjustments */
        .game-content {
            height: calc(100vh - 60px); /* Account for top bar */
            overflow: hidden;
        }
        
        .game-content .wordscape-container {
            height: 100%;
        }
        
        .game-content .game-layout {
            height: 100%;
        }
        
        .game-content .grid-section {
            max-height: 30vh;
            flex-shrink: 0;
        }
        
        .game-content .wheel-section {
            flex-shrink: 0;
        }
        
        .game-content .words-section {
            flex: 1;
            min-height: 150px;
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
    }
    
    /* Additional responsive adjustments */
    @@media (max-width: 640px) {
        .game-content {
            padding: 4px !important;
        }
        
        .sidebar {
            width: 220px;
        }
    }
    
    /* Very small screens */
    @@media (max-width: 480px) {
        .sidebar {
            width: 200px;
        }
        
        .top-row {
            padding-left: 8px !important;
            padding-right: 8px !important;
        }
    }
</style>

<script>
    // Mobile sidebar functionality
    window.closeMobileSidebar = function() {
        const sidebar = document.getElementById('game-sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        if (sidebar && overlay) {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
        }
    };
    
    // Add global function to toggle sidebar (called from NavMenu)
    window.toggleGameSidebar = function() {
        const sidebar = document.getElementById('game-sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        if (sidebar && overlay) {
            const isShowing = sidebar.classList.contains('show');
            if (isShowing) {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
            } else {
                sidebar.classList.add('show');
                overlay.classList.add('show');
            }
        }
    };
    
    // Close sidebar when clicking on overlay
    document.addEventListener('DOMContentLoaded', function() {
        const overlay = document.getElementById('sidebar-overlay');
        if (overlay) {
            overlay.addEventListener('click', closeMobileSidebar);
        }
    });
</script>