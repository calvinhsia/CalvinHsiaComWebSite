@using Client.Games.Cards.Models

<div class="playing-card @CssClass @(IsSelected ? "selected" : "") @(IsMini ? "mini" : "")"
     style="@ComputedStyle"
     @onclick="OnClick"
     @onclick:stopPropagation="@StopPropagation"
     @attributes="AdditionalAttributes">
    @if (ShowBack)
    {
        <img class="card-img" src="@Card.BackImageUrl" alt="Card back" draggable="false" />
        <div class="card-back-pattern"></div>
    }
    else if (CardData != null)
    {
        <img class="card-img" src="@CardData.ImageUrl" alt="@CardData.ToString()" draggable="false" />
        <div class="card-text @(CardData.IsRed ? "card-red" : "card-black")">
            <div class="card-corner">
                <span class="card-rank">@CardData.RankDisplay</span><span class="card-suit-small">@CardData.SuitSymbol</span>
            </div>
            <span class="card-suit-large">@CardData.SuitSymbol</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The card to display. If null and ShowBack is false, renders empty.
    /// </summary>
    [Parameter]
    public Card? CardData { get; set; }

    /// <summary>
    /// Whether to show the card back instead of the face
    /// </summary>
    [Parameter]
    public bool ShowBack { get; set; }

    /// <summary>
    /// Whether this card is currently selected
    /// </summary>
    [Parameter]
    public bool IsSelected { get; set; }

    /// <summary>
    /// Whether this is a mini card (used for opponent hands in Hearts)
    /// </summary>
    [Parameter]
    public bool IsMini { get; set; }

    /// <summary>
    /// Additional CSS classes to apply
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Click event callback
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// Whether to stop click propagation
    /// </summary>
    [Parameter]
    public bool StopPropagation { get; set; }

    /// <summary>
    /// Row index for stacking in tableau columns (sets --card-row CSS variable and position)
    /// </summary>
    [Parameter]
    public int CardRow { get; set; } = -1;

    /// <summary>
    /// Pixels per row for stacking offset (default 22px for FreeCell, 25px for Solitaire)
    /// </summary>
    [Parameter]
    public int RowOffset { get; set; } = 22;

    /// <summary>
    /// Additional HTML attributes to pass through (like style)
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedStyle
    {
        get
        {
            if (CardRow >= 0)
            {
                // Output direct positioning with calculated top value
                // Use !important to override any CSS rules
                int topPx = CardRow * RowOffset;
                return $"z-index: {CardRow} !important; position: absolute !important; left: 0 !important; top: {topPx}px !important;";
            }
            // Even when CardRow is not set, return empty string not null
            return "";
        }
    }
}
