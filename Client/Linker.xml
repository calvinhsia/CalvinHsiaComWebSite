<linker>
  <!-- Preserve types for System.Text.Json deserialization in trimmed WASM builds -->
  <assembly fullname="Shared">
    <type fullname="Client.Shared.MyPix" preserve="all" />
    <type fullname="Client.Shared.Thumbs" preserve="all" />
    <type fullname="Client.Shared.WeatherForecast" preserve="all" />
  </assembly>
  
  <!-- Preserve reflection metadata needed by MSAL authentication and JSON serialization -->
  <assembly fullname="System.Private.CoreLib">
    <type fullname="System.Reflection.NullabilityInfoContext" preserve="all" />
  </assembly>
  
  <!-- Preserve MSAL types that use reflection -->
  <assembly fullname="Microsoft.Authentication.WebAssembly.Msal" preserve="all" />
  <assembly fullname="Microsoft.AspNetCore.Components.WebAssembly.Authentication" preserve="all" />
</linker>
