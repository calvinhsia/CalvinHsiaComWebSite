<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.41.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
    <ProjectReference Include="..\Client\Client.csproj" />
  </ItemGroup>

  <!-- Automatically install Playwright browsers for local development -->
  <!-- Skip in CI/CD where pipeline handles installation explicitly -->
  <Target Name="InstallPlaywrightBrowsers" AfterTargets="Build" Condition="'$(CI)' != 'true'">
    <!-- Check if pwsh (PowerShell Core) is available -->
    <Exec Command="where pwsh" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="PwshAvailable" />
    </Exec>
    
    <!-- Use pwsh if available -->
    <Exec Command="pwsh bin/$(Configuration)/net8.0/playwright.ps1 install --with-deps chromium" Condition="'$(PwshAvailable)' == '0'" />
    
    <!-- Otherwise use Windows PowerShell -->
    <Exec Command="powershell -ExecutionPolicy Bypass -File bin/$(Configuration)/net8.0/playwright.ps1 install --with-deps chromium" Condition="'$(PwshAvailable)' != '0'" />
  </Target>

</Project>
