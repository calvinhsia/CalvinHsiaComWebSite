<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- 
    Solution-wide test run settings
    
    EXCLUDES: Only Manual tests (they wait for user to close browser)
    INCLUDES: Everything else including Automated Playwright tests
    
    Run All Tests = runs everything except Manual tests
    
    Each Playwright test has its own [Timeout] attribute for easy identification
    of which test is causing issues.
  -->

  <RunConfiguration>
    <!-- Use 1 CPU for consistent test execution (Playwright tests don't parallelize well) -->
    <MaxCpuCount>1</MaxCpuCount>
    
    <!-- Results directory relative to solution -->
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    
    <!-- Test session timeout (30 minutes) - enough for full Playwright test suite -->
    <TestSessionTimeout>1800000</TestSessionTimeout>
  </RunConfiguration>
  
  <MSTest>
    <!-- ONLY exclude Manual tests - these wait for user to close browser -->
    <!-- Automated tests run automatically and complete on their own -->
    <TestCategoryDenyList>
      <TestCategory>Manual</TestCategory>
    </TestCategoryDenyList>
    
    <!-- Sequential execution for Playwright tests -->
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
  
  <LoggerRunSettings>
    <Loggers>
      <!-- Console logger with detailed verbosity -->
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>detailed</Verbosity>
        </Configuration>
      </Logger>
      
      <!-- TRX logger for test results -->
      <Logger friendlyName="trx" enabled="True" />
    </Loggers>
  </LoggerRunSettings>
</RunSettings>
