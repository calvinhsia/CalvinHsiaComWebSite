<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- 
    Solution-wide test run settings
    Excludes Manual and Interactive tests by default to prevent accidental browser launches
    
    To run manual tests explicitly:
    - Visual Studio: Test Explorer, right-click test, Run
    - Command line: dotnet test (double dash)filter "TestCategory=Manual"
  -->

  <RunConfiguration>
    <!-- Use 1 CPU for consistent test execution -->
    <MaxCpuCount>1</MaxCpuCount>
    
    <!-- Results directory relative to solution -->
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    
    <!-- Test session timeout (10 minutes) - reasonable for CI -->
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>
  
  <MSTest>
    <!-- Exclude Manual and Interactive tests by default -->
    <!-- This prevents browser windows from opening when you click "Run All Tests" -->
    <TestCategoryDenyList>
      <TestCategory>Manual</TestCategory>
      <TestCategory>Interactive</TestCategory>
    </TestCategoryDenyList>
    
    <!-- Parallel execution disabled for Playwright tests -->
    <Parallelize>
      <Workers>1</Workers>
      <Scope>ClassLevel</Scope>
    </Parallelize>
  </MSTest>
  
  <LoggerRunSettings>
    <Loggers>
      <!-- Console logger with detailed verbosity -->
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>detailed</Verbosity>
        </Configuration>
      </Logger>
      
      <!-- TRX logger for test results -->
      <Logger friendlyName="trx" enabled="True" />
    </Loggers>
  </LoggerRunSettings>
  
  <Playwright>
    <!-- Playwright-specific settings for automated tests -->
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>true</Headless>
    </LaunchOptions>
  </Playwright>
</RunSettings>
